# TusAnkiM hesap sunucusu ayarları. Bu dosyayı .env olarak kopyalayın; .env sürüm kaydına girmez.
# Gizli değerleri buraya değil, yalnızca sunucudaki .env dosyasına yazın.

# Üretimde zorunlu; en az 32 karakter. Üretmek için: openssl rand -base64 48
# Değiştirirseniz o ana kadar gönderilmiş doğrulama/şifre kodları geçersiz olur (oturumlar etkilenmez).
ACCOUNT_SECRET=

# Sunucunun adresi ve veritabanı dosyası. Docker imajı bunları kendisi ayarlar (0.0.0.0, /data);
# yalnızca Docker'sız çalıştırırken açın, boş bırakılan bir satır imajın ayarını ezer.
# ACCOUNT_HOST=127.0.0.1
# ACCOUNT_PORT=8787
# ACCOUNT_DATABASE=/var/lib/tusankim/accounts.sqlite

# Oturum süresi (gün). Kullanıldıkça uzar; kullanılmayan oturum bu sürenin sonunda kapanır.
ACCOUNT_SESSION_DAYS=60

# Yeni hesap açılabilsin mi (1/0) ve giriş için e-posta doğrulaması zorunlu mu (1/0).
REGISTRATION_OPEN=1
EMAIL_VERIFICATION_REQUIRED=0

# Uygulamadaki gizlilik bilgisinde görünen işletmeci adı ve iletişim adresi.
OPERATOR_NAME=
CONTACT_EMAIL=

# Web sürümünün çalıştığı adresler (virgülle). iPhone uygulaması için gerekmez.
ACCOUNT_ALLOWED_ORIGINS=

# Önünde ters vekil (Caddy, nginx) varsa 1: istemci IP'si X-Forwarded-For'un son girdisinden okunur.
TRUST_PROXY=0

# SMTP (diyet uygulamasıyla aynı adlar). Boşsa doğrulama ve şifre yenileme kodu gönderilemez.
# 587 + EMAIL_USE_TLS=1 (STARTTLS) ya da 465 + EMAIL_USE_SSL=1.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=TusAnkiM <no-reply@ornek.com>

# Yalnızca geliştirme: kodları e-posta yerine sunucu konsoluna yazar. Üretimde kullanılamaz.
ACCOUNT_DEV=0
ACCOUNT_DEV_OUTBOX=0
