{
  "expo": {
    "name": "TusAnkiM",
    "slug": "tusankim",
    "owner": "smbg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-appstore.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#e8f5f0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tusankim.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTrackingDomains": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-mark.png",
        "backgroundColor": "#e8f5f0"
      },
      "package": "com.tusankim.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "tusankim",
    "plugins": [
      "expo-sqlite",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kartlara görsel eklemek için fotoğraf kitaplığı erişimi gereklidir.",
          "cameraPermission": "Kart oluştururken fotoğraf çekmek için kamera erişimi gereklidir."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Kartlara ses kaydı eklemek için mikrofon erişimi gereklidir."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "tr",
            "en"
          ]
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    },
    "extra": {
      "eas": {
        "projectId": "e9a513b4-4561-4bf2-8b6e-2bf50e09364d"
      }
    }
  }
}
