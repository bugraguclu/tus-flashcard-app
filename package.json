{
  "name": "tus-flashcard-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "verify:ios": "node scripts/verify-ios-readiness.mjs",
    "verify:app-store": "node scripts/verify-ios-readiness.mjs --app-store",
    "verify:app-store:live": "npm run verify:app-store && node scripts/verify-app-store-pages.mjs",
    "quality": "npm run check && npm run verify:ios",
    "doctor": "npx --yes expo-doctor",
    "start": "expo start",
    "share": "node scripts/share-expo-go.mjs",
    "share:dev": "node scripts/share-expo-go.mjs --dev",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:catalog-manifest": "sucrase-node scripts/build-catalog-manifest.ts",
    "pack:catalog": "node scripts/pack-catalog-asset.ts",
    "audit:catalog": "sucrase-node scripts/audit-catalog.ts",
    "share:lan": "node scripts/share-expo-go.mjs --lan",
    "share:ngrok": "node scripts/share-expo-go.mjs --ngrok"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "^57.0.24",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~58.0.6",
    "expo-image-picker": "~58.0.5",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~58.0.5",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~58.0.5",
    "expo-router": "~58.0.6",
    "expo-sharing": "~58.0.8",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "fzstd": "^0.1.1",
    "jszip": "^3.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-purchases": "^10.10.1",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-view-shot": "6.0.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "qrcode": "^1.5.4",
    "react-test-renderer": "^19.1.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "postcss": "8.5.26",
    "uuid": "11.1.1",
    "tar": "^7.5.11",
    "undici": "^6.24.0"
  },
  "private": true
}
