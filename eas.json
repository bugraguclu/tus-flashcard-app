{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "node": "24.16.0",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "node": "24.16.0",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BKA_CATALOG_PAYMENT_REQUIRED": "false"
      }
    },
    "production": {
      "environment": "production",
      "node": "24.16.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BKA_CATALOG_PAYMENT_REQUIRED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
