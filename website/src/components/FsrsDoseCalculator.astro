---
// Interactive FSRS-6 Study Dose Calculator ("Günde Ne Kadar Çalışmalısın?")
// Backed by real precomputed curves generated directly from TusAnkiM's lib/fsrsSimulator.ts!
import fsrsData from '../data/generated/fsrs-curves.json';

const initialDays = 270;
const initialPace = 60;
const initialScopeMeta = fsrsData.scopes.find((s) => s.id === 'all');
const initial = fsrsData.matrix.all['270']['60'];
const initialMega = fsrsData.matrix.mega['270']['60'];
const initialMaxVal = Math.max(
  100,
  Math.ceil(Math.max(...initial.pts.map((p) => p[1]), ...initialMega.pts.map((p) => p[1])) / 100) * 100,
);
const toSvgPoints = (pts: number[][], days: number, maxY: number) =>
  pts
    .map(([d, t]) => {
      const x = 44 + ((d - 1) / Math.max(1, days - 1)) * 498;
      const y = 150 - (t / Math.max(1, maxY)) * 130;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
const initialTusPts = toSvgPoints(initial.pts, initialDays, initialMaxVal);
const initialMegaPts = toSvgPoints(initialMega.pts, initialDays, initialMaxVal);
const initialFinSub = initial.fin
  ? initial.fin < initialDays - 14
    ? `Son ${initialDays - initial.fin} gün sadece tekrar`
    : 'Sınava tam yetişir'
  : `${initial.intro.toLocaleString('tr-TR')} kart açılır`;
const initialSummary =
  `${initialDays} günlük planda günde ${initialPace} yeni kart ile ${initialScopeMeta?.label ?? 'seçili deste'} günde ortalama ${initial.min} dakika (${initial.avg.toLocaleString('tr-TR')} kart) sürer; ` +
  `${initial.fin ? `${initial.fin}. günde tüm yeni kartlar biter` : `${initial.intro.toLocaleString('tr-TR')} kart görülür`} ve sınavda %${initial.pct.toFixed(1).replace('.', ',')} akılda kalır. ` +
  `Aynı hızda 27.341 kartlık mega deste günde ortalama ${initialMega.min} dakikaya çıkar ve ${initialMega.fin ? `${initialMega.fin}. günde biter` : `sınava yetişmez (%${initialMega.pct.toFixed(1).replace('.', ',')} kapsam)`}.`;
---
<section id="calisma-dozu" class="scroll-mt-24 py-16 sm:py-20 bg-white" aria-labelledby="dose-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
    <div class="max-w-2xl">
      <div class="section-num">Gerçek <span lang="en">FSRS-6</span> Simülatörü · Günde Ne Kadar Çalışmalısın?</div>
      <h2 id="dose-heading" class="display text-section tracking-tightest mt-2 text-ink">
        Sadece 9.575 kartla hayaline ulaş — bitmeyen destelerde boğulma
      </h2>
      <p class="text-inkMuted mt-3 leading-relaxed">
        Hedef TUS tarihini, kapsamını ve günlük yeni kart hızını seç; TusAnkiM'in gerçek <span lang="en">FSRS-6</span>
        motorunun hesapladığı günlük tekrar yükünü ve 27.341 kartlık mega desteyle farkını anında gör.
      </p>
    </div>

    <div
      class="mt-8 rounded-3xl border border-line bg-surfaceSoft p-5 sm:p-8"
      data-fsrs-calc
      data-fsrs={JSON.stringify(fsrsData)}
    >
      <!-- Controls grid -->
      <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-6 pb-6 border-b border-line">
        <!-- Horizon -->
        <div>
          <label for="fsrs-horizon" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
            1. Hedef Sınav Süresi
          </label>
          <select
            id="fsrs-horizon"
            class="w-full min-h-[2.75rem] rounded-xl border border-line bg-white px-3.5 text-sm font-semibold text-ink"
          >
            <option value="120">27 Mart 2027 · 120 gün</option>
            <option value="180">6 Aylık Plan · 180 gün</option>
            <option value="270" selected>22 Ağustos 2027 · 270 gün</option>
            <option value="365">1 Yıllık Plan · 365 gün</option>
          </select>
        </div>

        <!-- Scope -->
        <div>
          <label for="fsrs-scope" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
            2. Çalışma Kapsamı
          </label>
          <select
            id="fsrs-scope"
            class="w-full min-h-[2.75rem] rounded-xl border border-line bg-white px-3.5 text-sm font-semibold text-ink"
          >
            <option value="all" selected>Tüm BKA TUS Paketi (9.575 kart)</option>
            <option value="temel">Yalnız Temel Bilimler (3.957 kart)</option>
            <option value="klinik">Yalnız Klinik Bilimler (4.812 kart)</option>
            <option value="single">Tek Ders Odak (Ort. 800 kart)</option>
          </select>
        </div>

        <!-- Daily new cards -->
        <div class="sm:col-span-2 xl:col-span-1">
          <span class="block text-xs font-bold uppercase tracking-wider text-ink mb-2" id="fsrs-pace-label">
            3. Günlük Yeni Kart Hızı
          </span>
          <div class="grid grid-cols-3 sm:grid-cols-6 gap-1.5" role="group" aria-labelledby="fsrs-pace-label">
            {fsrsData.paces.map((p) => (
              <button
                type="button"
                data-fsrs-pace={p}
                aria-pressed={p === 60 ? 'true' : 'false'}
                class={`min-h-[2.75rem] rounded-xl text-xs font-bold tabular-nums transition cursor-pointer ${
                  p === 60
                    ? 'bg-teal text-white'
                    : 'bg-white border border-line text-ink hover:border-tealGraphic'
                }`}
              >
                {p}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Results & Mega-deck comparison -->
      <div class="mt-6 grid lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-7 space-y-5">
          <!-- KPI cards -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="rounded-2xl border border-line bg-white p-4">
              <div class="text-xs font-semibold text-inkMuted">Ort. Günlük Süre</div>
              <div class="display text-2xl text-teal mt-1 tabular-nums" data-out-min>{initial.min} dk</div>
              <div class="text-[11px] text-inkMuted mt-0.5" data-out-peak-min>Zirve: {initial.pMin} dk</div>
            </div>
            <div class="rounded-2xl border border-line bg-white p-4">
              <div class="text-xs font-semibold text-inkMuted">Ort. Günlük Kart</div>
              <div class="display text-2xl text-ink mt-1 tabular-nums" data-out-avg>{initial.avg.toLocaleString('tr-TR')}</div>
              <div class="text-[11px] text-inkMuted mt-0.5" data-out-peak>Zirve: {initial.peak.toLocaleString('tr-TR')} kart</div>
            </div>
            <div class="rounded-2xl border border-line bg-white p-4">
              <div class="text-xs font-semibold text-inkMuted">Deste Bitişi</div>
              <div class="display text-2xl text-teal mt-1 tabular-nums" data-out-fin>{initial.fin}. gün</div>
              <div class="text-[11px] text-inkMuted mt-0.5" data-out-fin-sub>{initialFinSub}</div>
            </div>
            <div class="rounded-2xl border border-line bg-white p-4">
              <div class="text-xs font-semibold text-inkMuted">Sınavda Akılda</div>
              <div class="display text-2xl text-gradeGood mt-1 tabular-nums" data-out-pct>%{initial.pct.toFixed(1).replace('.', ',')}</div>
              <div class="text-[11px] text-inkMuted mt-0.5" data-out-mem>{initial.mem.toLocaleString('tr-TR')} kart</div>
            </div>
          </div>

          <!-- Dual-line SVG chart -->
          <div class="rounded-2xl border border-line bg-white p-4 sm:p-5">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <div class="text-xs font-bold text-ink">Sınav Gününe Kadar Günlük Kart Yükü (<span lang="en">FSRS-6</span>)</div>
              <div class="flex items-center gap-4 text-[11px] font-semibold">
                <span class="inline-flex items-center gap-1.5 text-teal">
                  <span class="w-4 h-0 border-t-2 border-teal inline-block" aria-hidden="true"></span> TusAnkiM
                </span>
                <span class="inline-flex items-center gap-1.5 text-gradeAgain">
                  <span class="w-4 h-0 border-t-2 border-dashed border-gradeAgain inline-block" aria-hidden="true"></span> 27.341 Kart Mega Deste
                </span>
              </div>
            </div>

            <svg
              viewBox="0 0 560 190"
              width="560"
              height="190"
              role="img"
              aria-label="TusAnkiM ve 27.341 kartlık mega destenin sınav gününe kadar günlük tekrar yükü grafiği"
              class="w-full h-auto"
              data-fsrs-svg
            >
              <line x1="42" y1="20" x2="544" y2="20" stroke="#e9ecee" />
              <line x1="42" y1="85" x2="544" y2="85" stroke="#e9ecee" stroke-dasharray="4 4" />
              <line x1="42" y1="150" x2="544" y2="150" stroke="#dde1e4" />
              <text x="36" y="24" text-anchor="end" font-size="10" fill="#596166" data-axis-max>{initialMaxVal}</text>
              <text x="36" y="89" text-anchor="end" font-size="10" fill="#596166" data-axis-mid>{Math.round(initialMaxVal / 2)}</text>
              <text x="36" y="154" text-anchor="end" font-size="10" fill="#596166">0</text>
              <text x="48" y="172" font-size="10" fill="#596166">1. gün</text>
              <text x="293" y="172" text-anchor="middle" font-size="10" fill="#596166" data-axis-half>{Math.round(initialDays / 2)}. gün</text>
              <text x="540" y="172" text-anchor="end" font-size="10" font-weight="700" fill="#0e7469" data-axis-end>{initialDays}. gün (Sınav)</text>

              <polyline data-line-mega fill="none" stroke="#b02c25" stroke-width="2.2" stroke-dasharray="6 4" points={initialMegaPts} />
              <polyline data-line-tus fill="none" stroke="#0e7469" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" points={initialTusPts} />
            </svg>
          </div>
        </div>

        <!-- Right side-by-side comparison box -->
        <div class="lg:col-span-5 rounded-2xl border border-line bg-white p-5 sm:p-6 space-y-4">
          <div class="section-num">Neden 9.575 Kart?</div>
          <h3 class="display text-lg text-ink">Aynı günlük hızda 27.341 kartlık mega desteyle fark</h3>
          <p class="text-sm text-inkMuted leading-relaxed" aria-live="polite" data-out-summary>{initialSummary}</p>

          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="rounded-xl bg-tint p-3.5">
              <div class="text-[11px] font-bold uppercase tracking-wider text-teal">TusAnkiM</div>
              <div class="display text-xl text-ink mt-1 tabular-nums" data-cmp-tus-min>{initial.min} dk / gün</div>
              <div class="text-xs text-inkMuted mt-1" data-cmp-tus-state>{initial.fin}. günde biter · %{initial.pct.toFixed(1).replace('.', ',')} akılda</div>
            </div>
            <div class="rounded-xl bg-gradeAgainBg p-3.5">
              <div class="text-[11px] font-bold uppercase tracking-wider text-gradeAgain">27.341 Mega Deste</div>
              <div class="display text-xl text-ink mt-1 tabular-nums" data-cmp-mega-min>{initialMega.min} dk / gün</div>
              <div class="text-xs text-inkMuted mt-1" data-cmp-mega-state>Sınava yetişmez · %{initialMega.pct.toFixed(1).replace('.', ',')} akılda</div>
            </div>
          </div>

          <p class="text-xs text-inkMuted pt-3 border-t border-lineLight leading-relaxed">
            Bu eğriler tahmin değil, TusAnkiM'in gerçek <code>lib/fsrsSimulator.ts</code> (<span lang="en">FSRS-6</span>, %90 hedef hatırlama) motoruyla derleme anında hesaplanmıştır.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-fsrs-calc]').forEach((root) => {
    if (root.dataset.fsrsReady) return;
    root.dataset.fsrsReady = '1';

    type Scenario = {
      avg: number; rev: number; peak: number; min: number; pMin: number;
      intro: number; mem: number; pct: number; fin: number | null;
      pts: [number, number, number][];
    };
    type FsrsData = {
      matrix: Record<string, Record<string, Record<string, Scenario>>>;
      scopes: { id: string; label: string; cards: number }[];
    };

    const data: FsrsData = JSON.parse(root.dataset.fsrs || '{}');
    const horizonEl = root.querySelector<HTMLSelectElement>('#fsrs-horizon');
    const scopeEl = root.querySelector<HTMLSelectElement>('#fsrs-scope');
    const paceBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-fsrs-pace]')];

    const outMin = root.querySelector<HTMLElement>('[data-out-min]');
    const outPeakMin = root.querySelector<HTMLElement>('[data-out-peak-min]');
    const outAvg = root.querySelector<HTMLElement>('[data-out-avg]');
    const outPeak = root.querySelector<HTMLElement>('[data-out-peak]');
    const outFin = root.querySelector<HTMLElement>('[data-out-fin]');
    const outFinSub = root.querySelector<HTMLElement>('[data-out-fin-sub]');
    const outPct = root.querySelector<HTMLElement>('[data-out-pct]');
    const outMem = root.querySelector<HTMLElement>('[data-out-mem]');
    const outSummary = root.querySelector<HTMLElement>('[data-out-summary]');
    const cmpTusMin = root.querySelector<HTMLElement>('[data-cmp-tus-min]');
    const cmpTusState = root.querySelector<HTMLElement>('[data-cmp-tus-state]');
    const cmpMegaMin = root.querySelector<HTMLElement>('[data-cmp-mega-min]');
    const cmpMegaState = root.querySelector<HTMLElement>('[data-cmp-mega-state]');

    const axisMax = root.querySelector<SVGTextElement>('[data-axis-max]');
    const axisMid = root.querySelector<SVGTextElement>('[data-axis-mid]');
    const axisHalf = root.querySelector<SVGTextElement>('[data-axis-half]');
    const axisEnd = root.querySelector<SVGTextElement>('[data-axis-end]');
    const lineTus = root.querySelector<SVGPolylineElement>('[data-line-tus]');
    const lineMega = root.querySelector<SVGPolylineElement>('[data-line-mega]');

    let pace = '60';

    function toPoints(pts: [number, number, number][], days: number, maxY: number) {
      return pts
        .map(([d, t]) => {
          const x = 44 + ((d - 1) / Math.max(1, days - 1)) * 498;
          const y = 150 - (t / Math.max(1, maxY)) * 130;
          return `${x.toFixed(1)},${y.toFixed(1)}`;
        })
        .join(' ');
    }

    function update() {
      const horizon = horizonEl?.value || '270';
      const scope = scopeEl?.value || 'all';
      const days = Number(horizon);
      const sc = data.matrix?.[scope]?.[horizon]?.[pace];
      const mega = data.matrix?.mega?.[horizon]?.[pace];
      const scopeMeta = data.scopes.find((s) => s.id === scope);
      if (!sc || !mega) return;

      if (outMin) outMin.textContent = `${sc.min} dk`;
      if (outPeakMin) outPeakMin.textContent = `Zirve: ${sc.pMin} dk`;
      if (outAvg) outAvg.textContent = sc.avg.toLocaleString('tr-TR');
      if (outPeak) outPeak.textContent = `Zirve: ${sc.peak.toLocaleString('tr-TR')} kart`;
      if (outFin) outFin.textContent = sc.fin ? `${sc.fin}. gün` : 'Yetişmez';
      if (outFinSub) {
        outFinSub.textContent = sc.fin
          ? sc.fin < days - 14
            ? `Son ${days - sc.fin} gün sadece tekrar`
            : 'Sınava tam yetişir'
          : `${sc.intro.toLocaleString('tr-TR')} kart açılır`;
      }
      if (outPct) outPct.textContent = `%${sc.pct.toFixed(1).replace('.', ',')}`;
      if (outMem) outMem.textContent = `${sc.mem.toLocaleString('tr-TR')} kart`;

      if (cmpTusMin) cmpTusMin.textContent = `${sc.min} dk / gün`;
      if (cmpTusState) {
        cmpTusState.textContent = `${sc.fin ? `${sc.fin}. günde biter` : `${sc.intro.toLocaleString('tr-TR')} kart açılır`} · %${sc.pct.toFixed(1).replace('.', ',')} akılda`;
      }
      if (cmpMegaMin) cmpMegaMin.textContent = `${mega.min} dk / gün`;
      if (cmpMegaState) {
        cmpMegaState.textContent = `${mega.fin ? `${mega.fin}. günde biter` : 'Sınava yetişmez'} · %${mega.pct.toFixed(1).replace('.', ',')} akılda`;
      }

      const maxVal = Math.max(
        100,
        Math.ceil(Math.max(...sc.pts.map((p) => p[1]), ...mega.pts.map((p) => p[1])) / 100) * 100,
      );
      if (axisMax) axisMax.textContent = String(maxVal);
      if (axisMid) axisMid.textContent = String(Math.round(maxVal / 2));
      if (axisHalf) axisHalf.textContent = `${Math.round(days / 2)}. gün`;
      if (axisEnd) axisEnd.textContent = `${days}. gün (Sınav)`;
      if (lineTus) lineTus.setAttribute('points', toPoints(sc.pts, days, maxVal));
      if (lineMega) lineMega.setAttribute('points', toPoints(mega.pts, days, maxVal));

      if (outSummary) {
        const label = scopeMeta ? scopeMeta.label : 'seçili deste';
        const nextSummary =
          `${days} günlük planda günde ${pace} yeni kart ile ${label} günde ortalama ${sc.min} dakika (${sc.avg.toLocaleString('tr-TR')} kart) sürer; ` +
          `${sc.fin ? `${sc.fin}. günde tüm yeni kartlar biter` : `${sc.intro.toLocaleString('tr-TR')} kart görülür`} ve sınavda %${sc.pct.toFixed(1).replace('.', ',')} akılda kalır. ` +
          `Aynı hızda 27.341 kartlık mega deste günde ortalama ${mega.min} dakikaya çıkar ve ${mega.fin ? `${mega.fin}. günde biter` : `sınava yetişmez (%${mega.pct.toFixed(1).replace('.', ',')} kapsam)`}.`;
        if (outSummary.textContent !== nextSummary) {
          outSummary.textContent = nextSummary;
        }
      }
    }

    paceBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        pace = btn.dataset.fsrsPace || '60';
        paceBtns.forEach((b) => {
          const on = b === btn;
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
          b.classList.toggle('bg-teal', on);
          b.classList.toggle('text-white', on);
          b.classList.toggle('bg-white', !on);
          b.classList.toggle('border', !on);
          b.classList.toggle('border-line', !on);
          b.classList.toggle('text-ink', !on);
        });
        update();
      });
    });

    horizonEl?.addEventListener('change', update);
    scopeEl?.addEventListener('change', update);
    update();
  });
</script>
