---
// Alternating image + copy storytelling bands — ported from belif StoryBands.astro with AA-safe tokens.
import { markLatinTerms } from '../lib/richtext';

export interface StoryBand {
  img: string;
  imgAlt: string;
  imgWidth?: number;
  imgHeight?: number;
  kicker?: string;
  heading: string;
  text: string;
  bullets?: string[];
  note?: string;
  ctaLabel?: string;
  ctaHref?: string;
  flip?: boolean;
}

interface Props {
  bands: StoryBand[];
}

const { bands = [] } = Astro.props;
---
{bands.length > 0 && (
  <div class="space-y-14 sm:space-y-16 lg:space-y-24">
    {bands.map((b) => (
      <div class="grid md:grid-cols-2 gap-8 lg:gap-14 items-center">
        <div class={`rounded-3xl overflow-hidden border border-line bg-surfaceSoft ${b.flip ? 'md:order-2' : ''}`}>
          <img
            src={b.img}
            alt={b.imgAlt}
            width={b.imgWidth ?? 600}
            height={b.imgHeight ?? 440}
            loading="lazy"
            class="block w-full h-auto"
          />
        </div>
        <div class={b.flip ? 'md:order-1' : ''}>
          {b.kicker && <div class="section-num" set:html={markLatinTerms(b.kicker)}></div>}
          <h3 class="display text-subsection tracking-tightest mt-2 text-ink">{b.heading}</h3>
          <p class="text-inkMuted mt-4 leading-relaxed">{b.text}</p>
          {b.bullets && b.bullets.length > 0 && (
            <ul class="mt-5 space-y-2.5">
              {b.bullets.map((item) => (
                <li class="flex gap-3 text-sm sm:text-base text-ink">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#14998a"
                    stroke-width="2.2"
                    class="shrink-0 mt-0.5"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M9 12l2 2 4-4" />
                  </svg>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          )}
          {b.ctaLabel && b.ctaHref && (
            <a
              href={b.ctaHref}
              class="inline-flex items-center gap-1.5 mt-4 min-h-[2.75rem] py-2 text-sm font-semibold text-teal hover:text-tealDark underline underline-offset-4"
            >
              {b.ctaLabel} →
            </a>
          )}
          {b.note && <p class="text-xs text-inkMuted mt-4 pt-3 border-t border-lineLight">{b.note}</p>}
        </div>
      </div>
    ))}
  </div>
)}
