---
import { SOCIAL } from '../config';

interface Props {
  variant?: 'icons' | 'inline';
  class?: string;
}
const { variant = 'icons', class: className = '' } = Astro.props;
const inline = variant === 'inline';

const chip =
  'inline-flex items-center justify-center h-11 w-11 shrink-0 rounded-full border border-line bg-white ' +
  'text-inkMuted transition duration-200 group-hover:border-tealGraphic group-hover:text-teal ' +
  'group-hover:-translate-y-0.5 group-hover:shadow-[0_8px_20px_rgba(14,116,105,0.12)]';
---
<ul class={`flex flex-wrap items-center ${inline ? 'gap-x-8 gap-y-3' : 'gap-3'} ${className}`}>
  {SOCIAL.map((s) => (
    <li>
      <a
        href={s.url}
        target="_blank"
        rel="me noopener noreferrer"
        aria-label={`TusAnkiM ${s.name} — ${s.handle} (yeni sekmede açılır)`}
        class={`group inline-flex items-center ${inline ? 'gap-3' : ''}`}
      >
        <span class={chip}>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {s.icon === 'instagram' && (
              <>
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </>
            )}
            {s.icon === 'youtube' && (
              <>
                <path d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8z" />
                <path d="M10 9l5 3l-5 3z" />
              </>
            )}
            {s.icon === 'whatsapp' && (
              <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
            )}
          </svg>
        </span>
        {inline && (
          <span class="text-sm font-medium text-teal transition group-hover:text-tealDark">{s.handle}</span>
        )}
      </a>
    </li>
  ))}
</ul>
