---
import { SITE, WHATSAPP, LEGAL_PAGES } from '../config';
import { FOOTER_DISCOVER_IDS, FOOTER_LEGAL_IDS, page, link } from '../data/pages';
import SocialLinks from './SocialLinks.astro';

const discoverLinks = FOOTER_DISCOVER_IDS.map(page).filter((p) => p.published);
const legalLinks = FOOTER_LEGAL_IDS.map(page).filter((p) => p.published);
---
<footer class="border-t border-line bg-surface mt-16 lg:mt-24 pb-24 sm:pb-16">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 pt-12 pb-6 lg:pt-16 lg:pb-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand column -->
      <div class="sm:col-span-2">
        <a href="/" class="inline-flex items-center gap-2.5 min-h-[2.75rem] py-1">
          <img
            src="/images/app-mark.png"
            alt=""
            width="36"
            height="36"
            loading="lazy"
            class="w-9 h-9 object-contain"
          />
          <span class="display text-xl tracking-tight text-ink">TusAnkiM</span>
        </a>
        <p class="text-sm text-inkMuted max-w-md leading-relaxed mt-3">
          TUS hazırlığı için yerel öncelikli, <span lang="en">Anki</span> uyumlu (<code>.apkg</code> / <code>.colpkg</code>)
          <span lang="en">FSRS-6</span> aralıklı tekrar uygulaması. 9.575 doğrulanmış kart, Kronometre ve şeffaf TUS referans kanıtlarıyla.
        </p>
        <p class="mt-4 text-xs text-inkMuted max-w-md leading-relaxed border-l-2 border-tealGraphic pl-3">
          {SITE.disclaimer}
        </p>
        <div class="mt-6">
          <div class="section-num mb-3">Bizi Takip Et &amp; Ulaş</div>
          <SocialLinks />
        </div>
      </div>

      <!-- Discover column -->
      <div>
        <div class="section-num mb-3">Keşfet</div>
        <ul class="space-y-0.5 text-sm text-inkMuted">
          {discoverLinks.map((p) => (
            <li>
              <a href={link(p.path)} class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">
                {p.footerLabel ?? p.navLabel}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Access & Support column -->
      <div>
        <div class="section-num mb-3">Uygulama &amp; Destek</div>
        <ul class="space-y-1.5 text-sm text-inkMuted">
          <li>
            <a
              href={SITE.webAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center min-h-[2.75rem] py-2 font-semibold text-teal underline underline-offset-2 hover:text-tealDark"
            >
              Web Uygulamasını Aç →
            </a>
          </li>
          <li>iPhone &amp; Web tarayıcıda aktif</li>
          <li>Bulut eşitleme &amp; Android: <span class="font-semibold text-warm">Yakında</span></li>
          {WHATSAPP.enabled && (
            <li class="pt-2">
              <a
                href={WHATSAPP.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 min-h-[2.75rem] rounded-full border border-line bg-white px-4 py-2 text-xs font-semibold text-ink hover:border-tealGraphic hover:text-teal transition"
              >
                <span class="w-2 h-2 rounded-full bg-tealGraphic" aria-hidden="true"></span>
                7/24 WhatsApp Destek
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-line flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-inkMuted">
      <span>© {new Date().getFullYear()} TusAnkiM. Tüm hakları saklıdır.</span>
      {LEGAL_PAGES && (
        <nav aria-label="Yasal bağlantılar" class="flex flex-wrap gap-x-5 gap-y-1">
          {legalLinks.map((p) => (
            <a href={link(p.path)} class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">{p.footerLabel ?? p.navLabel}</a>
          ))}
        </nav>
      )}
      <span class="font-semibold text-ink">{SITE.tagline}</span>
    </div>
  </div>
</footer>

{WHATSAPP.enabled && (
  <a
    href={WHATSAPP.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="7/24 WhatsApp Chatbot Destek Hattı (yeni sekmede açılır)"
    class="fixed bottom-5 right-5 z-30 inline-flex items-center gap-2 rounded-full bg-teal px-4 min-h-[2.75rem] text-xs font-semibold text-white shadow-lg hover:bg-tealDark transition"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
      <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
    </svg>
    <span class="hidden sm:inline">7/24 WhatsApp Destek</span>
  </a>
)}
