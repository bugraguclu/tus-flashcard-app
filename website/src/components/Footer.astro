---
import { SITE, LEGAL_PAGES } from '../config';
import { FOOTER_CONTENT_IDS, FOOTER_LEGAL_IDS, page, link } from '../data/pages';
const contentLinks = FOOTER_CONTENT_IDS.map(page).filter((p) => p.published);
const legalLinks = FOOTER_LEGAL_IDS.map(page).filter((p) => p.published);
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <a class="footer-brand" href="/">TusAnkiM</a>
      <nav aria-label="Diğer bağlantılar">
        <a href="/tus-calisma-rehberi/">TUS Çalışma Rehberi</a>
        <a href="/calisma-plani/">Çalışma Planı</a>
        <a href="/kurucu/">Hakkımızda</a>
        <a href="/sss/">Sıkça sorulan sorular</a>
        <a href="https://www.instagram.com/tusankim/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={`mailto:${SITE.email}`}>E-posta</a>
      </nav>
    </div>
    <nav class="footer-content" aria-label="TUS içerikleri">{contentLinks.map((p) => <a href={link(p.path)}>{p.footerLabel ?? p.navLabel}</a>)}</nav>
    <p class="footer-disclaimer">{SITE.disclaimer}</p>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} TusAnkiM</span>
      {LEGAL_PAGES && <nav aria-label="Yasal bağlantılar">{legalLinks.map((p) => <a href={link(p.path)}>{p.navLabel}</a>)}</nav>}
    </div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid #dde1e4; background: #fff; color: #596166; }
  .footer-inner { width: min(1120px, calc(100% - 3rem)); margin-inline: auto; padding-block: 2rem; }
  .footer-top, .footer-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 2rem; }
  .footer-brand { color: #24292c; font-size: 1.125rem; font-weight: 600; }
  nav { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; }
  a { display: inline-flex; align-items: center; min-height: 2.75rem; font-size: .875rem; }
  a:hover { color: #0e7469; }
  .footer-content { margin-top: .5rem; padding-top: .5rem; border-top: 1px solid #e9ecee; }
  .footer-disclaimer { font-size: .8125rem; line-height: 1.75; margin-block: 1rem; }
  .footer-bottom { border-top: 1px solid #e9ecee; padding-top: 1rem; font-size: .8125rem; }
  @media (max-width: 600px) { .footer-inner { width: calc(100% - 2.5rem); } .footer-top, .footer-bottom { align-items: flex-start; flex-direction: column; } }
</style>
