---
import { SITE, LEGAL_PAGES, SOCIAL } from '../config';
import { NAV_GROUPS, FOOTER_LEGAL_IDS, page, link } from '../data/pages';
const groups = NAV_GROUPS.map((group) => ({
  ...group,
  items: group.items.map((item) => page(item.id)).filter((p) => p.published),
}));
const legalLinks = FOOTER_LEGAL_IDS.map(page).filter((p) => p.published);
const instagram = SOCIAL.find((social) => social.icon === 'instagram');
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-about">
        <a class="footer-brand" href="/">TusAnkiM</a>
        <p>{SITE.tagline}</p>
      </div>
      {groups.map((group) => (
        <nav aria-labelledby={`footer-${group.id}`}>
          <h2 id={`footer-${group.id}`}>{group.label}</h2>
          <ul role="list">
            {group.items.map((item) => <li><a href={link(item.path)}>{item.footerLabel ?? item.navLabel}</a></li>)}
          </ul>
        </nav>
      ))}
      <nav aria-labelledby="footer-kurumsal">
        <h2 id="footer-kurumsal">Kurumsal</h2>
        <ul role="list">
          <li><a href="/hakkimizda/">Hakkımızda</a></li>
          {instagram && <li><a href={instagram.url} target="_blank" rel="noopener noreferrer">Instagram</a></li>}
          <li><a href={`mailto:${SITE.email}`}>E-posta</a></li>
        </ul>
      </nav>
    </div>
    <p class="footer-disclaimer">{SITE.disclaimer}</p>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} TusAnkiM</span>
      {LEGAL_PAGES && <nav aria-label="Yasal bağlantılar">{legalLinks.map((p) => <a href={link(p.path)}>{p.footerLabel ?? p.navLabel}</a>)}</nav>}
    </div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid #dde1e4; background: #fff; color: #596166; }
  .footer-inner { width: min(1120px, calc(100% - 3rem)); margin-inline: auto; padding-block: 2.5rem 2rem; }
  .footer-grid { display: grid; grid-template-columns: 1.05fr 1fr 1.6fr .78fr .67fr; align-items: start; gap: 2rem; }
  .footer-brand { display: inline-flex; align-items: center; color: #24292c; font-size: 1.125rem; font-weight: 600; line-height: 1.5rem; min-height: 1.5rem; margin-bottom: .5rem; }
  .footer-about p { font-size: .875rem; line-height: 1.4; padding-block: .5rem; }
  h2 { color: #24292c; font-size: .8125rem; font-weight: 600; line-height: 1.5rem; margin-bottom: .5rem; }
  ul { display: grid; gap: .125rem; }
  li a { display: inline-flex; align-items: center; min-height: 2.25rem; padding-block: .375rem; font-size: .875rem; line-height: 1.4; }
  a:hover { color: #0e7469; }
  .footer-disclaimer { font-size: .8125rem; line-height: 1.75; margin-block: 1.5rem 1rem; padding-top: 1rem; border-top: 1px solid #e9ecee; }
  .footer-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 2rem; border-top: 1px solid #e9ecee; padding-top: 1rem; font-size: .8125rem; }
  .footer-bottom nav { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; }
  .footer-bottom nav a { display: inline-flex; align-items: center; min-height: 2.75rem; font-size: .875rem; }
  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-about { grid-column: 1 / -1; }
  }
  @media (max-width: 600px), (pointer: coarse) {
    .footer-brand { min-height: 2.75rem; margin-bottom: 0; }
    li a { min-height: 2.75rem; }
  }
  @media (max-width: 600px) {
    .footer-inner { width: calc(100% - 2.5rem); }
    .footer-bottom { align-items: flex-start; flex-direction: column; }
  }
</style>
