---
// Homepage TUS Reference Proof & Subject-by-Subject Breakdown
// Separates Doğrudan, Dolaylı, and Konu Kapsamı transparently; links every subject to /referanslar/.
import refSummary from '../data/generated/references-summary.json';

const views = [
  {
    key: 'all',
    label: 'Son 6 TUS (1.195 Soru)',
    stats: refSummary.overall,
    subjects: refSummary.bySubject,
    note: '2024/1–2026/2 arası tüm 6 sınavın toplam ölçümü (güncel katalog fbd7d94).',
  },
  ...refSummary.byExam.map((ex) => ({
    key: ex.sinav,
    label: `${ex.sinav} TUS (${ex.soru})`,
    stats: ex,
    subjects: ex.bySubject,
    note:
      ex.sinav === '2026/2'
        ? `Güncel katalog: ${ex.destek}/${ex.soru} (%${String(ex.destekOran).replace('.', ',')}). Sınavdan 2 gün önceki git a78ae1f sürümünde doğrulanan: ${refSummary.preExam2026_2.preExamEvet}/${ex.soru} (%${((refSummary.preExam2026_2.preExamEvet / Math.max(1, ex.soru)) * 100).toFixed(1).replace('.', ',')}).`
        : `${ex.sinav} sınavı · Güncel katalog ile ${ex.destek}/${ex.soru} çözüm desteği, ${ex.konuKapsami}/${ex.soru} konu kapsamı.`,
  })),
];
---
<section id="referans-ozet" class="scroll-mt-24 py-16 sm:py-20 bg-surface border-y border-line" aria-labelledby="ref-showcase-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
      <div class="max-w-2xl">
        <div class="section-num">Şeffaf Referans Sistemi · Ders Ders Kanıt</div>
        <h2 id="ref-showcase-heading" class="display text-section tracking-tightest mt-2 text-ink">
          Hangi sınavda, hangi derste, kaç soruyu çözdürdük?
        </h2>
        <p class="text-inkMuted mt-3 leading-relaxed">
          Rakipler gibi konu adı geçen her kartı "referans" saymıyoruz. <strong>Doğrudan</strong> çözdüren kartı, tek köprü isteyen
          <strong>Dolaylı</strong> karttan ve yalnızca <strong>Konu Kapsamı</strong>ndan ayırıp açıkça gösteriyoruz.
        </p>
      </div>
      <a
        href="/referanslar/"
        class="inline-flex items-center justify-center gap-2 shrink-0 min-h-[2.75rem] px-5 rounded-full bg-teal text-white text-sm font-semibold hover:bg-tealDark transition"
      >
        <span>Tüm 1.195 Soruyu İncele →</span>
      </a>
    </div>

    <div class="mt-8 rounded-3xl border border-line bg-white p-5 sm:p-8" data-ref-tabs>
      <!-- Exam switcher tabs -->
      <div class="tablist-scroll border-b border-line" role="tablist" aria-label="TUS dönemi seçin">
        {views.map((v, i) => (
          <button
            type="button"
            role="tab"
            id={`reftab-${v.key}`}
            data-reftab-key={v.key}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? '0' : '-1'}
            class="tab-btn"
          >
            {v.label}
          </button>
        ))}
      </div>

      {views.map((v, i) => (
        <div
          role="tabpanel"
          id={`refpanel-${v.key}`}
          data-refpanel-key={v.key}
          aria-labelledby={`reftab-${v.key}`}
          hidden={i === 0 ? undefined : 'until-found'}
        >
          <div class="tabpanel-inner">
            <!-- Summary strip for selected exam -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
              <div class="rounded-2xl bg-tint p-4">
                <div class="text-xs font-semibold text-teal">Çözüm Desteği (Doğrudan + Dolaylı)</div>
                <div class="display text-2xl text-ink mt-1 tabular-nums">
                  {v.stats.destek.toLocaleString('tr-TR')} / {v.stats.soru.toLocaleString('tr-TR')} <span class="text-base text-teal">(%{String(v.stats.destekOran).replace('.', ',')})</span>
                </div>
              </div>
              <div class="rounded-2xl bg-surfaceSoft border border-lineLight p-4">
                <div class="text-xs font-semibold text-inkMuted">Doğrudan Çözdüren</div>
                <div class="display text-2xl text-gradeGood mt-1 tabular-nums">{v.stats.dogrudan.toLocaleString('tr-TR')}</div>
              </div>
              <div class="rounded-2xl bg-surfaceSoft border border-lineLight p-4">
                <div class="text-xs font-semibold text-inkMuted">Dolaylı (Tek Adım Köprü)</div>
                <div class="display text-2xl text-warm mt-1 tabular-nums">{v.stats.dolayli.toLocaleString('tr-TR')}</div>
              </div>
              <div class="rounded-2xl bg-surfaceSoft border border-lineLight p-4">
                <div class="text-xs font-semibold text-inkMuted">Konu Kapsamı (Kitap Ölçüsü)</div>
                <div class="display text-2xl text-ink mt-1 tabular-nums">
                  %{String(v.stats.konuKapsamiOran).replace('.', ',')} <span class="text-sm font-normal text-inkMuted">({v.stats.konuKapsami.toLocaleString('tr-TR')})</span>
                </div>
              </div>
            </div>

            <p class="text-xs text-inkMuted mb-5">{v.note}</p>

            <!-- 11 subjects grid -->
            <div class="grid md:grid-cols-2 gap-x-8 gap-y-3.5">
              {v.subjects.map((s) => {
                const directPct = (s.dogrudan / Math.max(1, s.soru)) * 100;
                const indirectPct = (s.dolayli / Math.max(1, s.soru)) * 100;
                const topicOnlyPct = (s.konu / Math.max(1, s.soru)) * 100;
                const href = v.key === 'all'
                  ? `/referanslar/?ders=${encodeURIComponent(s.ders)}`
                  : `/referanslar/?sinav=${encodeURIComponent(v.key)}&ders=${encodeURIComponent(s.ders)}`;
                return (
                  <a href={href} class="group block rounded-xl p-2.5 -mx-2.5 hover:bg-surfaceSoft transition">
                    <div class="flex items-baseline justify-between gap-2 text-sm">
                      <span class="font-semibold text-ink group-hover:text-teal transition">{s.ders}</span>
                      <span class="text-xs tabular-nums text-inkMuted shrink-0">
                        <strong class="text-teal">%{String(s.destekOran).replace('.', ',')}</strong> ({s.destek}/{s.soru}) · Konu %{String(s.konuKapsamiOran).replace('.', ',')}
                      </span>
                    </div>
                    <div class="mt-1.5 h-2.5 w-full rounded-full bg-surface overflow-hidden flex" aria-hidden="true">
                      <div style={`width:${directPct.toFixed(1)}%`} class="bg-teal h-full"></div>
                      <div style={`width:${indirectPct.toFixed(1)}%`} class="bg-tealGraphic/65 h-full"></div>
                      <div style={`width:${topicOnlyPct.toFixed(1)}%`} class="bg-line h-full"></div>
                    </div>
                    <div class="mt-1 flex items-center justify-between text-[11px] text-inkMuted tabular-nums">
                      <span>Doğrudan {s.dogrudan} · Dolaylı {s.dolayli} · Yalnız konu {s.konu}</span>
                      <span class="text-teal font-semibold opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition">İncele →</span>
                    </div>
                  </a>
                );
              })}
            </div>

            <!-- Legend + Honest methodology footnote -->
            <div class="mt-6 pt-4 border-t border-line flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-inkMuted">
              <div class="flex flex-wrap items-center gap-4">
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-2.5 rounded-sm bg-teal inline-block"></span> Doğrudan</span>
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-2.5 rounded-sm bg-tealGraphic/65 inline-block"></span> Dolaylı</span>
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-2.5 rounded-sm bg-line inline-block"></span> Yalnız Konu</span>
              </div>
              <span>
                Yöntem notu: Yapay zekâ destekli ön değerlendirme (2026/2 hakem + git <code>a78ae1f</code> sınav öncesi kontrolü); bağımsız hekim editör onay süreci devam etmektedir.
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ref-tabs]').forEach((root) => {
    if (root.dataset.rtReady) return;
    root.dataset.rtReady = '1';
    const tablist = root.querySelector<HTMLElement>('[role="tablist"]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-reftab-key]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-refpanel-key]')];

    function scrollTabIntoView(btn: HTMLElement) {
      if (!tablist || tablist.scrollWidth <= tablist.clientWidth) return;
      const listRect = tablist.getBoundingClientRect();
      const btnRect = btn.getBoundingClientRect();
      const pad = 24;
      let delta = 0;
      if (btnRect.left < listRect.left + pad) delta = btnRect.left - (listRect.left + pad);
      else if (btnRect.right > listRect.right - pad) delta = btnRect.right - (listRect.right - pad);
      if (delta !== 0) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        tablist.scrollTo({
          left: Math.max(0, tablist.scrollLeft + delta),
          behavior: reduce ? 'auto' : 'smooth',
        });
      }
    }

    function activate(key: string, focus = false) {
      tabs.forEach((btn) => {
        const on = btn.dataset.reftabKey === key;
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        btn.tabIndex = on ? 0 : -1;
        if (on) {
          scrollTabIntoView(btn);
          if (focus) btn.focus({ preventScroll: true });
        }
      });
      panels.forEach((p) => {
        if (p.dataset.refpanelKey === key) p.removeAttribute('hidden');
        else (p as any).hidden = 'until-found';
      });
    }

    tabs.forEach((btn, idx) => {
      btn.addEventListener('click', () => btn.dataset.reftabKey && activate(btn.dataset.reftabKey));
      btn.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next === -1) return;
        e.preventDefault();
        const key = tabs[next].dataset.reftabKey;
        if (key) activate(key, true);
      });
    });

    root.addEventListener('beforematch', (e) => {
      const panel = (e.target as Element | null)?.closest<HTMLElement>('[data-refpanel-key]');
      if (panel?.dataset.refpanelKey) activate(panel.dataset.refpanelKey);
    });
  });
</script>
