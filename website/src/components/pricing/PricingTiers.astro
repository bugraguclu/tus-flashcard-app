---
import { SITE, PRICING_MODE } from '../../config';
import offer from '../../data/offer.json';
---
<section id="secenekler" class="py-10 sm:py-14 bg-white" aria-label="Erişim seçenekleri">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
    <ul role="list" class="grid lg:grid-cols-3 gap-6 items-stretch">
      {offer.tiers.map((tier) => (
        <li class={`rounded-2xl p-6 sm:p-8 flex flex-col bg-white ${tier.highlight ? 'border-2 border-teal' : 'border border-line'}`}>
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="display text-xl text-ink">{tier.name}</h2>
            <span class={`text-xs font-semibold ${tier.highlight ? 'text-teal' : 'text-inkMuted'}`}>{tier.badge}</span>
          </div>
          <p class="mt-4 flex flex-wrap items-baseline gap-x-2.5">
            <span class="display text-4xl text-ink tabular-nums">{tier.price}</span>
            <span class="text-sm text-inkMuted">{tier.period}</span>
          </p>
          <p class="text-sm text-inkMuted mt-3 leading-relaxed">{tier.summary}</p>
          <ul role="list" class="mt-5 space-y-2 flex-1">
            {tier.features.map((feat) => (
              <li class="flex items-start gap-2.5 text-sm text-ink">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0e7469" stroke-width="2.2" class="shrink-0 mt-1" aria-hidden="true"><path d="M5 13l4 4L19 7" /></svg>
                <span>{feat}</span>
              </li>
            ))}
          </ul>
          <a
            href={SITE.webAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={`mt-6 inline-flex items-center justify-center w-full min-h-[3rem] rounded-full text-sm font-semibold transition ${tier.highlight ? 'bg-teal text-white hover:bg-tealDark' : 'border border-line bg-surfaceSoft text-ink hover:border-teal hover:text-teal'}`}
          >
            {tier.ctaLabel}<span class="sr-only"> (yeni sekmede açılır)</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-6 space-y-1.5 text-sm text-inkMuted leading-relaxed max-w-3xl" data-pricing-mode={PRICING_MODE}>
      <p>{offer.transparencyNote}</p>
      <p>
        <strong class="text-ink">{offer.clubProgram.kicker}:</strong> {offer.clubProgram.text}{' '}
        <a href="/destek/" class="text-teal underline underline-offset-2 hover:text-tealDark">Destek sayfasından başvurabilirsin</a>.
      </p>
    </div>
  </div>
</section>
