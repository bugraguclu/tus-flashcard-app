---
import { SITE, PRICING_MODE } from '../../config';
import offer from '../../data/offer.json';
---
<section id="secenekler" class="py-10 sm:py-14 bg-white" aria-label="Erişim seçenekleri">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-6">
    <ul role="list" class="tiers grid lg:grid-cols-3 gap-6 items-stretch" data-tiers>
      {offer.tiers.map((tier, index) => (
        <li class="tier rounded-2xl p-6 sm:p-8 flex flex-col" style={`--n:${index}`} data-tier={tier.id} data-selected={tier.highlight ? '' : undefined}>
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="display text-xl text-ink">{tier.name}</h2>
            <span class="tier-badge text-xs font-semibold">{tier.badge}</span>
          </div>
          <p class="mt-4 flex flex-wrap items-baseline gap-x-2.5">
            <span class="tier-price display text-4xl tabular-nums">{tier.price}</span>
            <span class="text-sm text-inkMuted">{tier.period}</span>
          </p>
          <p class="text-sm text-inkMuted mt-3 leading-relaxed">{tier.summary}</p>
          <ul role="list" class="mt-5 space-y-2 flex-1">
            {tier.features.map((feat, i) => (
              <li class="flex items-start gap-2.5 text-sm text-ink">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0e7469" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="tier-check shrink-0 mt-1" style={`--i:${i}`} aria-hidden="true"><path pathLength="1" d="M5 13l4 4L19 7" /></svg>
                <span>{feat}</span>
              </li>
            ))}
          </ul>
          <a
            href={SITE.webAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="tier-cta mt-6 inline-flex items-center justify-center w-full min-h-[3rem] rounded-full text-sm font-semibold"
          >
            {tier.ctaLabel}<span class="sr-only"> (yeni sekmede açılır)</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-6 space-y-1.5 text-sm text-inkMuted leading-relaxed max-w-3xl" data-pricing-mode={PRICING_MODE}>
      <p>{offer.transparencyNote}</p>
      <p>
        <strong class="text-ink">{offer.clubProgram.kicker}:</strong> {offer.clubProgram.text}{' '}
        <a href="/destek/" class="text-teal underline underline-offset-2 hover:text-tealDark">Destek sayfasından başvurabilirsin</a>.
      </p>
    </div>
  </div>
</section>

<style>
  /* The chosen card steps forward: it grows, lifts and takes the teal frame and the filled
     button, while the other two step back. Hover, keyboard focus or a tap chooses a card. */
  .tier {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    background: #fff;
    border: 1px solid #dde1e4;
    box-shadow: 0 1px 2px rgba(36, 41, 44, 0.04);
    cursor: default;
  }
  .tier[data-selected] {
    z-index: 1;
    border-color: #0e7469;
    box-shadow:
      0 0 0 1px #0e7469,
      0 28px 56px -24px rgba(14, 116, 105, 0.42),
      0 10px 24px -14px rgba(36, 41, 44, 0.2);
  }

  .tier-badge { color: #596166; }
  .tier-price { color: #24292c; }
  .tier[data-selected] .tier-badge,
  .tier[data-selected] .tier-price { color: #0e7469; }

  .tier-cta {
    border: 1px solid #dde1e4;
    background: #f8f9fa;
    color: #24292c;
  }
  .tier[data-selected] .tier-cta {
    border-color: #0e7469;
    background: #0e7469;
    color: #fff;
  }
  .tier[data-selected] .tier-cta:hover { background: #0b5e55; border-color: #0b5e55; }

  @media (min-width: 1024px) {
    .tier { scale: 0.97; }
    .tier[data-selected] { scale: 1.045; translate: 0 -6px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tier {
      transition:
        scale 0.45s var(--ease),
        translate 0.45s var(--ease),
        box-shadow 0.45s var(--ease),
        border-color 0.25s ease;
      animation: tier-in 0.6s var(--ease) calc(var(--n) * 80ms) backwards;
    }
    .tier-badge, .tier-price { transition: color 0.25s ease; }
    .tier-cta { transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease; }
    .tier[data-selected] .tier-check path {
      stroke-dasharray: 1;
      animation: tier-check 0.4s ease-out calc(120ms + var(--i) * 55ms) backwards;
    }
  }
  @keyframes tier-in {
    from { opacity: 0; translate: 0 20px; }
  }
  @keyframes tier-check {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('[data-tiers]');
  if (list) {
    const tiers = [...list.querySelectorAll<HTMLElement>('[data-tier]')];
    const select = (tier: HTMLElement) => {
      if (tier.hasAttribute('data-selected')) return;
      for (const other of tiers) other.toggleAttribute('data-selected', other === tier);
    };
    for (const tier of tiers) {
      tier.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') select(tier);
      });
      tier.addEventListener('focusin', () => select(tier));
      tier.addEventListener('click', () => select(tier));
    }
  }
</script>
