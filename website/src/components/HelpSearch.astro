---
import type { WebsiteSearchEntry } from '../lib/websiteSearchIndex';

interface Props {
  entries: WebsiteSearchEntry[];
  guideCount: number;
}

const { entries, guideCount } = Astro.props;
---
<search id="help-search" class="mt-6 max-w-xl" data-entries={JSON.stringify(entries)}>
  <label for="help-filter" class="sr-only">Rehber veya araç ara</label>
  <div class="search-field help-search-field rounded-lg border border-line bg-white">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-teal shrink-0" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <input id="help-filter" type="search" autocomplete="off" enterkeyhint="search" maxlength="120" placeholder="Rehber veya araç ara"
      class="flex-1 min-w-0 py-3 text-base bg-transparent text-ink placeholder:text-inkMuted outline-none" />
    <button id="help-clear" type="button" aria-label="Aramayı temizle" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
  </div>
  <p id="help-count" role="status" class="mt-2 text-sm font-semibold text-teal">Tüm {guideCount} rehber listeleniyor</p>
  <ul id="help-results" aria-label="Arama sonuçları" hidden></ul>
  <p id="help-empty" hidden class="mt-3 text-sm text-inkMuted">
    Başka kelimelerle ara veya <a class="text-link" href="/destek/">destek sayfasından yaz</a>.
  </p>
</search>

<script>
  import { createGuideSearch, guideSearchWords } from '../lib/guideSearch';
  import type { WebsiteSearchEntry } from '../lib/websiteSearchIndex';

  const root = document.getElementById('help-search');
  const input = document.querySelector<HTMLInputElement>('#help-filter');
  const clear = document.querySelector<HTMLButtonElement>('#help-clear');
  const results = document.getElementById('help-results');
  const count = document.getElementById('help-count');
  const empty = document.getElementById('help-empty');

  if (root?.dataset.entries && input && clear && results && count && empty) {
    const find = createGuideSearch(JSON.parse(root.dataset.entries) as WebsiteSearchEntry[]);
    const browse = document.querySelectorAll<HTMLElement>('[data-help-browse]');
    const initialCount = count.textContent;
    const render = () => {
      const searching = guideSearchWords(input.value).length > 0;
      const hits = searching ? find(input.value) : [];
      count.textContent = searching
        ? hits.length ? `${hits.length} sonuç` : 'Sonuç bulunamadı'
        : initialCount;
      clear.hidden = input.value.length === 0;
      empty.hidden = !searching || hits.length > 0;
      results.hidden = hits.length === 0;
      browse.forEach((element) => { element.hidden = searching; });
      results.replaceChildren(...hits.map((item) => {
        const row = document.createElement('li');
        const link = document.createElement('a');
        const title = document.createElement('strong');
        link.href = item.url;
        title.textContent = item.title;
        link.append(title);
        if (item.sub !== item.title) {
          const detail = document.createElement('span');
          detail.textContent = item.sub;
          link.append(detail);
        }
        row.append(link);
        return row;
      }));
    };

    input.addEventListener('input', render);
    clear.addEventListener('click', () => {
      input.value = '';
      input.focus();
      render();
    });
    root.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.isComposing || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      const links = Array.from(results.querySelectorAll('a'));
      if (!links.length) return;
      if (event.target === input && (event.key === 'ArrowDown' || event.key === 'ArrowUp' || event.key === 'Enter')) {
        event.preventDefault();
        const stop = event.key === 'ArrowUp' ? links.at(-1) : links[0];
        stop?.focus();
        return;
      }

      const active = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (active === -1) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        input.focus();
      } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        const direction = event.key === 'ArrowDown' ? 1 : -1;
        links[(active + direction + links.length) % links.length].focus();
      }
    });
    window.addEventListener('pageshow', render);
    render();
  }
</script>

<style>
  .help-search-field { display: flex; align-items: center; gap: .75rem; padding-inline: 1rem; }
  #help-filter:focus-visible { outline: none; }
  #help-clear:not([hidden]) {
    display: grid; place-items: center; width: 2.75rem; min-height: 2.75rem;
    margin-inline-end: -.625rem; border-radius: .5rem; color: #596166;
  }
  #help-clear:hover { color: #0e7469; }
  #help-results { margin-top: .625rem; background: #fff; border: 1px solid #dde1e4; border-radius: .75rem; }
  #help-results :global(li + li) { border-top: 1px solid #e9ecee; }
  #help-results :global(a) {
    display: grid; align-content: center; min-height: 2.75rem; gap: .125rem; padding: .7rem 1rem;
    border-radius: .5rem; color: #1d332e;
  }
  #help-results :global(a:hover) { background: #f1f7f5; }
  #help-results :global(a:focus-visible) { outline-offset: -3px; background: #f1f7f5; }
  #help-results :global(strong) { font-size: .9375rem; font-weight: 650; }
  #help-results :global(span) { font-size: .8125rem; line-height: 1.45; color: #596166; }
</style>
