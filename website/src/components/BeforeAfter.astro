---
// Interactive Before/After slider — ported from belif BeforeAfter.astro, upgraded with AA colors,
// touch-pan-y mobile safety, keyboard range control, and WAI-ARIA tablist for multiple pairs.
import { markLatinTerms } from '../lib/richtext';

export interface BeforeAfterPair {
  before: string;
  after: string;
  beforeAlt: string;
  afterAlt: string;
  label: string;
  beforeBadge?: string;
  afterBadge?: string;
}

export interface BeforeAfterData {
  kicker?: string;
  heading: string;
  lead?: string;
  bullets?: string[];
  note?: string;
  pairs: BeforeAfterPair[];
}

interface Props {
  data: BeforeAfterData;
  id?: string;
}

const { data, id = 'once-sonra' } = Astro.props;
const uid = `ba-${id}`;
---
{data.pairs.length > 0 && (
  <section class="before-after-section scroll-mt-24" id={id} aria-labelledby={`${uid}-heading`}>
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left column: interactive slider -->
      <div class="lg:col-span-6 w-full max-w-[580px] mx-auto">
        {data.pairs.length > 1 && (
          <div class="flex flex-wrap items-center justify-center gap-2 mb-4" role="tablist" aria-label="Önce ve sonra örneği seçin">
            {data.pairs.map((p, idx) => (
              <button
                type="button"
                role="tab"
                id={`${uid}-tab-${idx}`}
                aria-selected={idx === 0 ? 'true' : 'false'}
                tabindex={idx === 0 ? '0' : '-1'}
                data-ba-tab={idx}
                class={`ba-tab-btn px-4 py-2 min-h-[2.75rem] rounded-full text-xs font-semibold transition cursor-pointer ${
                  idx === 0
                    ? 'bg-teal text-white'
                    : 'bg-surface text-ink hover:bg-tint'
                }`}
              >
                {p.label}
              </button>
            ))}
          </div>
        )}

        <div
          id={uid}
          class="ba-wrapper relative aspect-[3/2] rounded-3xl overflow-hidden shadow-sm border border-line bg-surface select-none cursor-ew-resize touch-pan-y group"
          style="--pos: 50%;"
          data-ba-root
        >
          {data.pairs.map((pair, idx) => (
            <div
              id={`${uid}-pair-${idx}`}
              role="tabpanel"
              aria-labelledby={data.pairs.length > 1 ? `${uid}-tab-${idx}` : undefined}
              aria-hidden={idx === 0 ? 'false' : 'true'}
              class={`ba-pair-container absolute inset-0 w-full h-full transition-opacity duration-300 ${
                idx === 0 ? 'opacity-100 pointer-events-auto z-10' : 'opacity-0 pointer-events-none z-0'
              }`}
              data-pair-idx={idx}
            >
              <div class="absolute inset-0 w-full h-full">
                <img
                  src={pair.after}
                  alt={pair.afterAlt}
                  width="600"
                  height="400"
                  loading="lazy"
                  class="w-full h-full object-cover pointer-events-none select-none"
                />
              </div>

              <div
                class="ba-before-layer absolute inset-0 w-full h-full pointer-events-none select-none"
                style="clip-path: inset(0 calc(100% - var(--pos)) 0 0);"
              >
                <img
                  src={pair.before}
                  alt={pair.beforeAlt}
                  width="600"
                  height="400"
                  loading="lazy"
                  class="w-full h-full object-cover pointer-events-none select-none"
                />
              </div>
            </div>
          ))}

          <!-- Vertical divider + handle -->
          <div class="ba-divider absolute top-0 bottom-0 pointer-events-none z-20" style="left: var(--pos);">
            <div class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-[2px] bg-white shadow-[0_0_8px_rgba(0,0,0,0.45)]"></div>
            <div class="ba-handle absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2 w-9 h-9 rounded-full bg-white shadow-md flex items-center justify-center text-teal border border-line group-hover:scale-105 transition-transform duration-150">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="8 17 3 12 8 7" />
                <polyline points="16 7 21 12 16 17" />
              </svg>
            </div>
          </div>

          <span class="ba-label-before absolute top-4 left-4 z-20 pointer-events-none text-[11px] font-bold tracking-wider text-ink bg-white/95 px-3 py-1 rounded-full shadow-sm border border-line uppercase">
            ÖNCE
          </span>
          <span class="ba-label-after absolute top-4 right-4 z-20 pointer-events-none text-[11px] font-bold tracking-wider text-white bg-teal px-3 py-1 rounded-full shadow-sm uppercase">
            SONRA
          </span>

          <input
            type="range"
            min="0"
            max="100"
            value="50"
            class="sr-only ba-range-input"
            aria-label="Önce ve sonra karşılaştırma çubuğu (sol ve sağ ok tuşlarıyla kaydırın)"
          />
        </div>
        <p class="mt-2.5 text-center text-xs text-inkMuted">
          Karşılaştırmak için görseli sola/sağa sürükleyin veya odaklayıp ok tuşlarını kullanın.
        </p>
      </div>

      <!-- Right column: explanation -->
      <div class="lg:col-span-6">
        {data.kicker && <div class="section-num mb-2" set:html={markLatinTerms(data.kicker)}></div>}
        <h2 id={`${uid}-heading`} class="display text-section tracking-tightest text-ink">{data.heading}</h2>
        {data.lead && <p class="text-inkMuted mt-4 leading-relaxed text-base">{data.lead}</p>}

        {data.bullets && data.bullets.length > 0 && (
          <ul class="mt-6 space-y-3">
            {data.bullets.map((item) => (
              <li class="flex items-start gap-3 text-sm sm:text-base text-ink">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#14998a" stroke-width="2.2" class="shrink-0 mt-0.5" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M9 12l2 2 4-4" />
                </svg>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        )}

        {data.note && (
          <p class="text-xs text-inkMuted mt-6 pt-4 border-t border-line leading-relaxed">{data.note}</p>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .ba-tab-btn[aria-selected="true"] {
    position: relative;
    outline: 2px solid transparent;
  }

  /* Clear keyboard focus indicator on slider handle when visually-hidden range input has focus */
  .ba-wrapper:focus-within {
    border-color: #0e7469;
  }
  .ba-wrapper:focus-within .ba-handle {
    outline: 3px solid #0e7469;
    outline-offset: 3px;
    box-shadow: 0 0 0 6px rgba(14, 116, 105, 0.2);
  }
  @supports selector(:has(*)) {
    .ba-wrapper:focus-within {
      border-color: #dde1e4;
    }
    .ba-wrapper:focus-within .ba-handle {
      outline: none;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    }
    .ba-wrapper:has(.ba-range-input:focus-visible) {
      border-color: #0e7469;
    }
    .ba-wrapper:has(.ba-range-input:focus-visible) .ba-handle {
      outline: 3px solid #0e7469;
      outline-offset: 3px;
      box-shadow: 0 0 0 6px rgba(14, 116, 105, 0.22);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba-root]').forEach((wrapper) => {
    if (wrapper.dataset.baReady) return;
    wrapper.dataset.baReady = '1';

    const labelBefore = wrapper.querySelector<HTMLElement>('.ba-label-before');
    const labelAfter = wrapper.querySelector<HTMLElement>('.ba-label-after');
    const range = wrapper.querySelector<HTMLInputElement>('.ba-range-input');

    let pos = 50;
    let dragging = false;
    let touchStart: { x: number; y: number } | null = null;
    let rect: DOMRect | null = null;

    const updateRect = () => { rect = wrapper.getBoundingClientRect(); };

    const render = (val: number) => {
      pos = Math.max(0, Math.min(100, val));
      wrapper.style.setProperty('--pos', `${pos}%`);
      if (range) range.value = String(Math.round(pos));
      if (labelBefore) labelBefore.style.opacity = pos < 16 ? '0' : '1';
      if (labelAfter) labelAfter.style.opacity = pos > 84 ? '0' : '1';
    };

    const pctFromX = (clientX: number) => {
      if (!rect || !rect.width) updateRect();
      return Math.max(0, Math.min(100, ((clientX - rect!.left) / rect!.width) * 100));
    };

    wrapper.addEventListener('pointerdown', (e) => {
      updateRect();
      if (e.pointerType === 'touch') {
        touchStart = { x: e.clientX, y: e.clientY };
        return;
      }
      dragging = true;
      try { wrapper.setPointerCapture(e.pointerId); } catch {}
      render(pctFromX(e.clientX));
    });

    wrapper.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' && !dragging) {
        if (!touchStart) return;
        const dx = Math.abs(e.clientX - touchStart.x);
        const dy = Math.abs(e.clientY - touchStart.y);
        if (dx < 6 || dx <= dy) return;
        dragging = true;
        try { wrapper.setPointerCapture(e.pointerId); } catch {}
      }
      if (!dragging) return;
      render(pctFromX(e.clientX));
    });

    const end = (e: PointerEvent) => {
      const wasTap = e.pointerType === 'touch' && touchStart && !dragging;
      dragging = false;
      touchStart = null;
      try { wrapper.releasePointerCapture(e.pointerId); } catch {}
      if (wasTap) render(pctFromX(e.clientX));
    };

    wrapper.addEventListener('pointerup', end);
    wrapper.addEventListener('pointercancel', () => { dragging = false; touchStart = null; });

    range?.addEventListener('input', () => render(Number(range.value)));
    window.addEventListener('resize', updateRect, { passive: true });

    const section = wrapper.closest('.before-after-section');
    if (section) {
      const tabs = [...section.querySelectorAll<HTMLButtonElement>('[data-ba-tab]')];
      const pairs = [...wrapper.querySelectorAll<HTMLElement>('.ba-pair-container')];

      const activate = (idx: number, focus = false) => {
        tabs.forEach((t, i) => {
          const active = i === idx;
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          t.tabIndex = active ? 0 : -1;
          t.classList.toggle('bg-teal', active);
          t.classList.toggle('text-white', active);
          t.classList.toggle('bg-surface', !active);
          t.classList.toggle('text-ink', !active);
          if (active && focus) t.focus({ preventScroll: true });
        });
        pairs.forEach((p, i) => {
          const active = i === idx;
          p.setAttribute('aria-hidden', active ? 'false' : 'true');
          p.classList.toggle('opacity-100', active);
          p.classList.toggle('pointer-events-auto', active);
          p.classList.toggle('z-10', active);
          p.classList.toggle('opacity-0', !active);
          p.classList.toggle('pointer-events-none', !active);
          p.classList.toggle('z-0', !active);
        });
        render(50);
      };

      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => activate(idx));
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') { e.preventDefault(); activate((idx + 1) % tabs.length, true); }
          else if (e.key === 'ArrowLeft') { e.preventDefault(); activate((idx - 1 + tabs.length) % tabs.length, true); }
          else if (e.key === 'Home') { e.preventDefault(); activate(0, true); }
          else if (e.key === 'End') { e.preventDefault(); activate(tabs.length - 1, true); }
        });
      });
    }
  });
</script>
