---
import {
  PLANNER_COURSES,
  PLANNER_EXAMS,
  PLANNER_LIMITS,
  formatDurationTr,
  formatTrInt,
  type PlannerResult,
} from '../../lib/studyPlanner';

interface Props {
  initial: PlannerResult;
  totalCatalogCards: number;
  temelCards: number;
  klinikCards: number;
}

const { initial, totalCatalogCards, temelCards, klinikCards } = Astro.props;

const defaultDaysStyle = `--attr-min:${PLANNER_LIMITS.minDays};--attr-max:${PLANNER_LIMITS.maxDays};--control-value:${initial.input.days}`;
const defaultPaceStyle = `--attr-min:${PLANNER_LIMITS.minPace};--attr-max:${PLANNER_LIMITS.maxPace};--control-value:${initial.input.newPerDay}`;
const defaultBudgetStyle = `--attr-min:${PLANNER_LIMITS.minBudgetMin};--attr-max:${PLANNER_LIMITS.maxBudgetMin};--control-value:${initial.input.maxMinutes}`;
---
<form
  class="lg:col-span-5 space-y-5 rounded-2xl border border-line bg-white p-4 sm:p-6"
  aria-labelledby="planner-studio-heading"
  data-planner-form
  novalidate
>
  <!-- 1. Planning Mode -->
  <fieldset class="space-y-2">
    <legend class="text-sm font-semibold text-ink">1. Planlama Yöntemi</legend>
    <div class="grid grid-cols-2 gap-2 items-stretch">
      <div>
        <input
          type="radio"
          id="mode-exam"
          name="plan-mode"
          value="exam"
          class="visually-hidden"
          checked={initial.input.mode === 'exam'}
        />
        <label for="mode-exam" class="seg-radio-label w-full h-full">Sınava göre hesapla</label>
      </div>
      <div>
        <input
          type="radio"
          id="mode-time"
          name="plan-mode"
          value="time"
          class="visually-hidden"
          checked={initial.input.mode === 'time'}
        />
        <label for="mode-time" class="seg-radio-label w-full h-full">Günlük süreme göre</label>
      </div>
    </div>
  </fieldset>

  <!-- 2. Target Exam / Horizon -->
  <div class="space-y-2.5 pt-4 border-t border-lineLight">
    <div class="flex items-baseline justify-between gap-2">
      <label for="plan-days" class="text-sm font-semibold text-ink">
        2. Sınava Kalan Süre
      </label>
      <span class="display text-lg text-teal tabular-nums" data-days-val>{initial.input.days} gün</span>
    </div>

    <div class="flex flex-wrap gap-2" role="group" aria-label="Hızlı sınav ve süre seçimi">
      {PLANNER_EXAMS.map((exam) => (
        <button
          type="button"
          data-exam-quick
          data-exam-iso={exam.examDateIso}
          aria-pressed="false"
          class="inline-flex items-center gap-1.5 min-h-[2.75rem] px-3 rounded-xl border border-line bg-surfaceSoft text-xs font-semibold text-ink hover:border-tealGraphic hover:text-teal transition cursor-pointer"
        >
          <span>{exam.shortName}</span>
          <span
            class="text-[11px] font-bold text-teal tabular-nums"
            data-exam-days-badge={exam.id}
            hidden
          ></span>
        </button>
      ))}
      <button
        type="button"
        data-exam-quick
        data-days-fixed="180"
        aria-pressed="true"
        class="inline-flex items-center min-h-[2.75rem] px-3 rounded-xl border border-line bg-surfaceSoft text-xs font-semibold text-ink hover:border-tealGraphic hover:text-teal transition cursor-pointer"
      >
        180 gün
      </button>
      <button
        type="button"
        data-exam-quick
        data-days-fixed="365"
        aria-pressed="false"
        class="inline-flex items-center min-h-[2.75rem] px-3 rounded-xl border border-line bg-surfaceSoft text-xs font-semibold text-ink hover:border-tealGraphic hover:text-teal transition cursor-pointer"
      >
        365 gün
      </button>
    </div>

    <input
      id="plan-days"
      name="days"
      type="range"
      min={PLANNER_LIMITS.minDays}
      max={PLANNER_LIMITS.maxDays}
      step="1"
      value={initial.input.days}
      aria-valuetext={`${initial.input.days} gün`}
      class="planner-range"
      style={defaultDaysStyle}
    />
    <div class="flex justify-between text-[11px] text-inkMuted tabular-nums -mt-1">
      <span>{PLANNER_LIMITS.minDays} gün</span>
      <span>155 gün</span>
      <span>280 gün</span>
      <span>{PLANNER_LIMITS.maxDays} gün</span>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-1">
      <label for="plan-exam-date" class="text-xs font-semibold text-inkMuted">
        Özel hedef tarih:
      </label>
      <input
        id="plan-exam-date"
        name="examDate"
        type="date"
        aria-describedby="plan-exam-date-hint"
        class="planner-input rounded-xl border border-line bg-surfaceSoft px-3 text-ink font-semibold tabular-nums sm:w-48"
      />
    </div>
    <p id="plan-exam-date-hint" class="text-xs text-inkMuted tabular-nums" data-exam-date-hint>
      Süre: {initial.input.days} gün
    </p>
  </div>

  <!-- 3. Study Scope & Course Picker -->
  <fieldset class="space-y-2.5 pt-4 border-t border-lineLight">
    <legend class="text-sm font-semibold text-ink">3. Çalışma Kapsamı</legend>
    <div class="grid grid-cols-2 gap-2 items-stretch">
      <div>
        <input type="radio" id="scope-all" name="plan-scope" value="all" class="visually-hidden" checked />
        <label for="scope-all" class="seg-radio-label w-full h-full flex-col py-2">
          <span>Tüm Paket</span>
          <span class="seg-radio-sub tabular-nums">{formatTrInt(totalCatalogCards)} kart</span>
        </label>
      </div>
      <div>
        <input type="radio" id="scope-temel" name="plan-scope" value="temel" class="visually-hidden" />
        <label for="scope-temel" class="seg-radio-label w-full h-full flex-col py-2">
          <span>Temel Bilimler</span>
          <span class="seg-radio-sub tabular-nums">{formatTrInt(temelCards)} kart</span>
        </label>
      </div>
      <div>
        <input type="radio" id="scope-klinik" name="plan-scope" value="klinik" class="visually-hidden" />
        <label for="scope-klinik" class="seg-radio-label w-full h-full flex-col py-2">
          <span>Klinik Bilimler</span>
          <span class="seg-radio-sub tabular-nums">{formatTrInt(klinikCards)} kart</span>
        </label>
      </div>
      <div>
        <input type="radio" id="scope-custom" name="plan-scope" value="custom" class="visually-hidden" />
        <label for="scope-custom" class="seg-radio-label w-full h-full flex-col py-2">
          <span>Ders Seç</span>
          <span class="seg-radio-sub">12 dersten seç</span>
        </label>
      </div>
    </div>

    <!-- Collapsible 12-course checklist (visible when scope === 'custom') -->
    <div data-course-picker hidden class="mt-3 rounded-xl border border-line bg-surfaceSoft p-3 space-y-2.5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <span class="text-xs font-semibold text-ink">Hangi dersleri çalışacaksın?</span>
        <div class="flex gap-1.5">
          <button type="button" data-courses-all class="min-h-[2.75rem] px-2.5 rounded-lg border border-line bg-white text-xs font-semibold text-teal hover:bg-tint cursor-pointer">
            Tümü
          </button>
          <button type="button" data-courses-temel class="min-h-[2.75rem] px-2.5 rounded-lg border border-line bg-white text-xs font-semibold text-ink hover:border-tealGraphic cursor-pointer">
            Temel
          </button>
          <button type="button" data-courses-klinik class="min-h-[2.75rem] px-2.5 rounded-lg border border-line bg-white text-xs font-semibold text-ink hover:border-tealGraphic cursor-pointer">
            Klinik
          </button>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
        {PLANNER_COURSES.map((course) => (
          <label class="course-check-label">
            <span class="inline-flex items-center gap-1.5 min-w-0">
              <input
                type="checkbox"
                value={course.id}
                data-course-check
                data-course-group={course.group}
                checked
                class="w-4 h-4 shrink-0 accent-[#0e7469] rounded cursor-pointer"
              />
              <span class="truncate font-semibold">{course.name}</span>
            </span>
            <span class="text-xs text-inkMuted tabular-nums shrink-0">{formatTrInt(course.cards)}</span>
          </label>
        ))}
      </div>
    </div>
  </fieldset>

  <!-- 4a. Daily New Cards Pace (Exam mode) -->
  <div class="space-y-2 pt-4 border-t border-lineLight" data-pace-block>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <label for="plan-pace" class="text-sm font-semibold text-ink">
        4. Günlük Yeni Kart Hızı
      </label>
      <span class="display text-lg text-teal tabular-nums" data-pace-val>
        {initial.input.newPerDay} yeni / gün
      </span>
    </div>
    <input
      id="plan-pace"
      name="newPerDay"
      type="range"
      min={PLANNER_LIMITS.minPace}
      max={PLANNER_LIMITS.maxPace}
      step="1"
      value={initial.input.newPerDay}
      aria-valuetext={`Günde ${initial.input.newPerDay} yeni kart`}
      class="planner-range"
      style={defaultPaceStyle}
    />
    <div class="flex items-center justify-between gap-2 text-[11px] text-inkMuted tabular-nums -mt-1">
      <span>{PLANNER_LIMITS.minPace} yeni</span>
      <span>55 yeni</span>
      <span>110 yeni</span>
      <span>{PLANNER_LIMITS.maxPace} yeni</span>
    </div>
    <div class="pt-1">
      <button
        type="button"
        data-rec-pace-btn
        data-rec-pace-value={String(initial.recommendedPace)}
        hidden={initial.recommendedPace === initial.input.newPerDay}
        class="inline-flex items-center min-h-[2.75rem] px-3.5 rounded-lg bg-tint text-xs font-bold text-teal hover:bg-teal hover:text-white transition cursor-pointer"
      >
        Önerilen: {initial.recommendedPace} yeni/gün
      </button>
    </div>
  </div>

  <!-- 4b. Daily Time Budget (Time-Budget mode) -->
  <div class="space-y-2 pt-4 border-t border-lineLight" data-budget-block hidden>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <label for="plan-budget" class="text-sm font-semibold text-ink">
        4. Günlük Kart Süre Bütçen
      </label>
      <span class="display text-lg text-teal tabular-nums" data-budget-val>
        {formatDurationTr(initial.input.maxMinutes)} / gün
      </span>
    </div>
    <input
      id="plan-budget"
      name="maxMinutes"
      type="range"
      min={PLANNER_LIMITS.minBudgetMin}
      max={PLANNER_LIMITS.maxBudgetMin}
      step="10"
      value={initial.input.maxMinutes}
      aria-valuetext={`Günde ${formatDurationTr(initial.input.maxMinutes)}`}
      class="planner-range"
      style={defaultBudgetStyle}
    />
    <div class="flex justify-between text-[11px] text-inkMuted tabular-nums -mt-1">
      <span>30 dk</span>
      <span>1 sa 40 dk</span>
      <span>2 sa 50 dk</span>
      <span>4 sa</span>
    </div>
    <p class="text-xs text-inkMuted leading-relaxed">
      <span lang="en">FSRS-6</span> motoru ortalama günlük süreni bu bütçenin altında tutan en yüksek yeni kart hızını bulur.
    </p>
  </div>

  <!-- 5–7. Weekly Cadence, Buffer Days & Target Retention -->
  <div class="space-y-4 pt-4 border-t border-lineLight">
    <fieldset class="space-y-2">
      <legend class="text-sm font-semibold text-ink">
        5. Haftalık Yeni Kart Düzeni
      </legend>
      <div class="grid grid-cols-3 gap-2 items-stretch">
        {[
          { v: 7, l: '7 gün', sub: 'Her gün' },
          { v: 6, l: '6 gün', sub: '1 mola' },
          { v: 5, l: '5 gün', sub: '2 mola' },
        ].map((opt) => (
          <div>
            <input
              type="radio"
              id={`week-${opt.v}`}
              name="plan-week"
              value={String(opt.v)}
              class="visually-hidden"
              checked={initial.input.studyDaysPerWeek === opt.v}
            />
            <label for={`week-${opt.v}`} class="seg-radio-label w-full h-full flex-col py-2 px-2">
              <span class="whitespace-nowrap">{opt.l}</span>
              <span class="seg-radio-sub whitespace-nowrap">{opt.sub}</span>
            </label>
          </div>
        ))}
      </div>
      <p class="text-xs text-inkMuted">
        Nöbet veya mola günlerinde yeni kart açılmaz; yalnız vadesi gelen tekrarlar çalışılır.
      </p>
    </fieldset>

    <fieldset class="space-y-2">
      <legend class="text-sm font-semibold text-ink">
        6. Sınav Öncesi Yalnız Tekrar Tamponu
      </legend>
      <div class="grid grid-cols-4 gap-2 items-stretch">
        {[
          { v: 0, l: 'Yok' },
          { v: 14, l: '14 gün' },
          { v: 21, l: '21 gün' },
          { v: 30, l: '30 gün' },
        ].map((opt) => (
          <div>
            <input
              type="radio"
              id={`buf-${opt.v}`}
              name="plan-buffer"
              value={String(opt.v)}
              class="visually-hidden"
              checked={initial.input.bufferDays === opt.v}
            />
            <label for={`buf-${opt.v}`} class="seg-radio-label w-full h-full px-1.5 whitespace-nowrap tabular-nums">
              {opt.l}
            </label>
          </div>
        ))}
      </div>
    </fieldset>

    <fieldset class="space-y-2">
      <legend class="text-sm font-semibold text-ink">
        7. <span lang="en">FSRS-6</span> Hedef Hatırlama Oranı
      </legend>
      <div class="grid grid-cols-3 gap-2 items-stretch">
        {[
          { v: 85, l: '%85', sub: 'Hafif' },
          { v: 90, l: '%90', sub: 'Önerilen' },
          { v: 93, l: '%93', sub: 'Yoğun' },
        ].map((opt) => (
          <div>
            <input
              type="radio"
              id={`ret-${opt.v}`}
              name="plan-retention"
              value={String(opt.v)}
              class="visually-hidden"
              checked={initial.input.retention === opt.v}
            />
            <label for={`ret-${opt.v}`} class="seg-radio-label w-full h-full flex-col py-2 px-2 tabular-nums">
              <span>{opt.l}</span>
              <span class="seg-radio-sub whitespace-nowrap">{opt.sub}</span>
            </label>
          </div>
        ))}
      </div>
    </fieldset>
  </div>

  <!-- Optional Advanced: Already completed cards -->
  <details class="planner-details pt-3 border-t border-lineLight">
    <summary class="cursor-pointer list-none flex items-center justify-between gap-2 min-h-[2.75rem] text-xs font-bold text-teal hover:text-tealDark select-none">
      <span>İleri ayar: Şu ana kadar bitirdiğin kartlar</span>
      <svg class="details-chevron shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 9 6 6 6-6" />
      </svg>
    </summary>
    <div class="pt-2 pb-1 space-y-2">
      <label for="plan-completed" class="block text-xs font-semibold text-ink">
        Daha önce gördüğün kart sayısı
      </label>
      <input
        id="plan-completed"
        name="completedCards"
        type="number"
        min="0"
        max={totalCatalogCards - 1}
        step="50"
        value={initial.input.completedCards}
        inputmode="numeric"
        aria-describedby="plan-completed-hint"
        class="planner-input w-full rounded-xl border border-line bg-surfaceSoft px-3.5 font-bold text-ink tabular-nums"
      />
      <p id="plan-completed-hint" class="text-xs text-inkMuted tabular-nums" data-completed-hint>
        Kalan: {formatTrInt(initial.target.remainingCards)} / {formatTrInt(initial.target.totalCards)} kart
      </p>
    </div>
  </details>
</form>
