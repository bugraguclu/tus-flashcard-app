---
import { ACCESS, SITE, SOCIAL, SHOW_PRICING_PROMO, PRICING_MODE } from '../../config';
import catalog from '../../data/generated/catalog.json';
import { num } from '../../lib/format';

const showLaunch = SHOW_PRICING_PROMO && PRICING_MODE !== 'free-beta';
const instagram = SOCIAL.find((social) => social.icon === 'instagram');
const guides = [
  { title: 'İlk kartınla başla', text: 'Hazır paketi aç, dersini seç ve ilk tekrarını yap.', href: '/yardim/hizli-baslangic/' },
  { title: 'Kartını görselle anlat', text: 'Kişisel kartına not ve görsel ekle, görseli düzenle.', href: '/yardim/kart-ekleme/' },
  { title: 'Kısayolları öğren', text: 'Klavye ve dokunma kontrollerini alışkanlığına göre ayarla.', href: '/yardim/kisayollar/' },
];
---
<section id="fiyatlandirma" class="scroll-mt-24 py-14 sm:py-20 bg-white border-b border-line" aria-labelledby="pricing-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 grid lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-7 reveal">
      <p class="kicker">Ücretsiz deneme ve erişim</p>
      <h2 id="pricing-heading" class="display text-section tracking-tightest text-ink mt-3">Ücretsiz dene, kartların sana uyuyor mu gör.</h2>
      <p class="text-inkMuted mt-3 leading-relaxed">{ACCESS.betaDescription}</p>
      <p class="text-inkMuted mt-2 leading-relaxed">
        iPhone için geliştirilen uygulamayı tarayıcıda keşfet. Kendi destelerini dosyayla taşıyabilirsin; otomatik cihaz eşitlemesi henüz yok.
      </p>
      <a href="/images/iphone-calisma.jpg" class="mt-3 inline-flex items-center min-h-[2.75rem] text-sm font-semibold text-teal underline underline-offset-4 hover:text-tealDark">iPhone çalışma ekranını gör →</a>
    </div>
    <div class="lg:col-span-5 reveal rounded-2xl border border-line bg-surfaceSoft p-6" style="--d: 60ms">
      <h3 class="text-sm font-bold uppercase tracking-wider text-inkMuted">Güncel beta</h3>
      <p class="display text-4xl text-teal mt-2">Ücretsiz</p>
      <p class="text-sm text-ink mt-2 leading-relaxed">{num(catalog.totals.cards)} kartlık hazır TUS koleksiyonu, kişisel desteler ve çalışma araçları.</p>
      <a href={SITE.webAppUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex w-full items-center justify-center min-h-[3rem] rounded-full bg-teal text-white text-sm font-semibold hover:bg-tealDark transition">
        Ücretsiz dene<span class="sr-only"> (yeni sekmede açılır)</span>
      </a>
      {showLaunch && (
        <p class="mt-4 text-xs text-inkMuted leading-relaxed">{ACCESS.plannedLaunchDescription} Günlük sınırın işleyişi ve satın alma koşulları ücretli erişim başlamadan önce açıklanacak.</p>
      )}
    </div>
  </div>
</section>

<section id="kullanim" class="scroll-mt-24 py-12 sm:py-16 bg-surfaceSoft border-b border-line" aria-labelledby="usage-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 reveal">
      <div>
        <p class="kicker">Uygulama kullanımı</p>
        <h2 id="usage-heading" class="display text-section tracking-tightest text-ink mt-3">Uygulamayı keşfet</h2>
      </div>
      <a href="/yardim/" class="inline-flex items-center min-h-[2.75rem] text-sm font-semibold text-teal underline underline-offset-4 hover:text-tealDark">Tüm rehberler →</a>
    </div>
    <ul role="list" class="mt-6 grid sm:grid-cols-3 gap-4">
      {guides.map((g, i) => (
        <li class="reveal" style={`--d: ${i * 60}ms`}>
          <a href={g.href} class="lift block h-full rounded-2xl border border-line bg-white p-5">
            <h3 class="font-semibold text-ink">{g.title}</h3>
            <p class="text-sm text-inkMuted mt-1.5 leading-relaxed">{g.text}</p>
          </a>
        </li>
      ))}
    </ul>
    {instagram && (
      <p class="mt-5 text-sm text-inkMuted">
        Kullanım ipuçları ve kart paylaşımları için Instagram’da
        <a href={instagram.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark">{instagram.handle}</a>.
      </p>
    )}
  </div>
</section>
