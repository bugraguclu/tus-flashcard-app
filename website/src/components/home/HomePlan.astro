---
import catalog from '../../data/generated/catalog.json';
import {
  DEFAULT_PLANNER_INPUT,
  PLANNER_PRESETS,
  formatDurationTr,
  runPlanner,
} from '../../lib/studyPlanner';
import { num } from '../../lib/format';

const cards = num(catalog.totals.cards);
const mezunPreset = PLANNER_PRESETS.find((preset) => preset.id === 'mezun');
if (!mezunPreset) throw new Error('Missing mezun preset in PLANNER_PRESETS');
const mezunSim = runPlanner({ ...DEFAULT_PLANNER_INPUT, ...mezunPreset.patch });

const paceSentence = `Günde ${mezunSim.activePace} yeni kartla ilk turu ${mezunSim.target.finishDay ?? mezunSim.input.days}. günde bitirirsin; bu, günde ortalama ~${formatDurationTr(mezunSim.target.avgMinutes)} demek`;
const tools = [
  { title: 'Çalışma planı', text: 'Sınav tarihini gir; günde kaç yeni kart ve kaç dakika tekrar çıkacağını gör.', href: '/calisma-plani/' },
  { title: 'TUS çalışma rehberi', text: '2027 takvimi, dört aday profili ve 11 branş için ayrı öneriler.', href: '/tus-calisma-rehberi/' },
  { title: 'Puan hesapla', text: 'Netlerini gir; Temel ve Klinik puanını, gerekiyorsa %5 kesintiyle gör.', href: '/puan-hesapla/' },
] as const;
---
<section id="calisma-plani" class="scroll-mt-24 py-14 sm:py-20 bg-white border-b border-line" aria-labelledby="plan-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-6 grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    <div class="lg:col-span-5">
      <h2 id="plan-heading" class="display text-section tracking-tightest text-ink">Sınava kalan güne göre planla</h2>
      <p class="text-inkMuted mt-3 leading-relaxed">
        Bir örnek: mezunsun ve {cards} kartın hepsini çalışacaksın. {paceSentence}. Kendi sınav tarihini ve çalışma günlerini gir, sana göre hesaplayalım.
      </p>
    </div>
    <ul role="list" class="lg:col-span-7 plan-links">
      {tools.map((tool) => (
        <li>
          <a href={tool.href} class="plan-link">
            <span>
              <strong class="display text-base text-ink">{tool.title}</strong>
              <span class="block text-sm text-inkMuted mt-0.5">{tool.text}</span>
            </span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .plan-links { border-top: 1px solid #dde1e4; }
  .plan-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-block-size: 4.5rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid #dde1e4;
    color: #596166;
  }
  .plan-link:focus-visible { outline: 2px solid #0e7469; outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) {
    .plan-link:hover { color: #0e7469; }
    .plan-link:hover strong { color: #0e7469; }
  }
</style>
