---
import AppScreenshot from '../AppScreenshot.astro';
import catalog from '../../data/generated/catalog.json';
import { SITE } from '../../config';
import { num } from '../../lib/format';

const cards = num(catalog.totals.cards);
const trust = ['Beta ücretsiz, kart bilgisi istemiyoruz', 'Hesap açmadan başlarsın', 'İnternet yokken de çalışır'];
---
<section class="home-product-hero border-b border-line" aria-labelledby="hero-title">
  <div class="hero-layout max-w-content mx-auto px-5 sm:px-6 lg:px-10">
    <div class="hero-copy-group min-w-0">
      <div>
        <p class="kicker">TUS için aralıklı tekrar</p>
        <h1 id="hero-title" class="hero-title display tracking-tightest text-ink mt-4">
          {cards} TUS kartı. <em>Unutmadan önce tekrar</em>
        </h1>
        <p data-speakable class="mt-5 text-base sm:text-lg text-inkMuted leading-relaxed max-w-xl">
          Bugün hangi kartı tekrar edeceğini sen düşünme. TusAnkiM cevaplarına bakar,
          <span lang="en" class="whitespace-nowrap">FSRS-6</span> ile hesaplar. Kartların son 6 TUS’taki karşılığını da soru soru gösteriyoruz.
        </p>

        <div class="mt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a
            href={SITE.webAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="button-primary home-cta"
          >
            Ücretsiz başla<span class="sr-only"> (yeni sekmede açılır)</span>
          </a>
          <a
            href="#demo-bolumu"
            class="button-secondary home-cta"
          >
            Kartları burada dene
          </a>
        </div>
      </div>

      <ul role="list" class="hero-perks mt-6 grid gap-1 text-sm text-inkMuted">
        {trust.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <figure class="hero-product">
      <div class="hero-product-stage">
        <div class="hero-device hero-device-decks">
          <AppScreenshot screen="decks" loading="eager" />
        </div>
        <div class="hero-device hero-device-answer">
          <AppScreenshot screen="answer" loading="eager" fetchpriority="high" />
        </div>
      </div>
      <figcaption>Ekranlar web uygulamasından; içindekiler örnek kartlar.</figcaption>
    </figure>
  </div>
</section>
