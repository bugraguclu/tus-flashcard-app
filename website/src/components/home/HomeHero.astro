---
import AppScreenshot from '../AppScreenshot.astro';
import catalog from '../../data/generated/catalog.json';
import { SITE } from '../../config';
import { num } from '../../lib/format';

const cards = num(catalog.totals.cards);
const trust = ['Güncel beta ücretsiz, kart bilgisi gerekmez', 'Hesap açmadan çalışır', 'İnternet olmadan da çalışır'];
---
<section class="home-product-hero border-b border-line" aria-labelledby="hero-title">
  <div class="hero-layout max-w-content mx-auto px-5 sm:px-6 lg:px-10">
    <div class="hero-copy-group min-w-0">
      <div>
        <p class="kicker">TUS için aralıklı tekrar</p>
        <h1 id="hero-title" class="hero-title display tracking-tightest text-ink mt-4">
          {cards} TUS kartıyla <em>planlı tekrar.</em>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-inkMuted leading-relaxed max-w-xl">
          Çıkmış sınavlardan süzülen kartları <span lang="en" class="whitespace-nowrap">FSRS-6</span> ile çalış.
          Bugün hangi kartları tekrar edeceğini TusAnkiM hesaplar.
        </p>

        <div class="mt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a
            href={SITE.webAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center min-h-[3.25rem] px-7 rounded-full bg-teal text-white text-[0.9375rem] font-semibold hover:bg-tealDark transition"
          >
            Ücretsiz başla<span class="sr-only"> (yeni sekmede açılır)</span>
          </a>
          <a
            href="#demo-bolumu"
            class="inline-flex items-center justify-center min-h-[3.25rem] px-7 rounded-full border border-line bg-white text-ink text-[0.9375rem] font-semibold hover:border-tealGraphic hover:text-teal transition"
          >
            Kartları burada dene
          </a>
        </div>
      </div>

      <ul role="list" class="hero-perks mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-inkMuted">
        {trust.map((item) => (
          <li class="inline-flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#14998a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7" /></svg>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <figure class="hero-product">
      <div class="hero-product-stage">
        <div class="hero-device hero-device-decks">
          <AppScreenshot screen="decks" loading="eager" />
        </div>
        <div class="hero-device hero-device-answer">
          <AppScreenshot screen="answer" loading="eager" fetchpriority="high" />
        </div>
      </div>
      <figcaption>TusAnkiM web uygulamasından, örnek koleksiyonla.</figcaption>
    </figure>
  </div>
</section>
