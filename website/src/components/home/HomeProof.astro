---
import catalog from '../../data/generated/catalog.json';
import ref from '../../data/generated/references-summary.json';
import { num, pct, share } from '../../lib/format';

const t = catalog.totals;
const o = ref.overall;
const pre = ref.preExam2026_2;
const konuYalniz = o.konuKapsami - o.destek;
---
<section id="ekosistem" class="scroll-mt-24 bg-white border-b border-line" aria-labelledby="proof-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-10 sm:py-14">
    <h2 id="proof-heading" class="sr-only">TusAnkiM doğrulanmış rakamlarla</h2>

    <dl class="kpi-grid">
      <div class="kpi reveal">
        <dt>Hazır kart</dt>
        <dd class="kpi-value">{num(t.cards)}</dd>
        <dd class="kpi-note">{num(t.notes)} not · {t.courses} ders (11 TUS branşı + Deneme ve Soru) · {t.topicSubdecks} alt deste</dd>
        <dd class="mt-auto pt-1">
          <div class="segbar grow" role="img" aria-label={`Temel Bilimler ${num(t.temelCards)}, Klinik Bilimler ${num(t.klinikCards)}, Deneme ve Soru ${num(t.karmaCards)} kart`}>
            <span class="seg-temel" style={`flex: ${t.temelCards} 0 0%`}></span>
            <span class="seg-klinik" style={`flex: ${t.klinikCards} 0 0%`}></span>
            <span class="seg-karma" style={`flex: ${t.karmaCards} 0 0%`}></span>
          </div>
          <p class="legend mt-2" aria-hidden="true">
            <span><i class="seg-temel"></i>Temel</span>
            <span><i class="seg-klinik"></i>Klinik</span>
            <span><i class="seg-karma"></i>Karma</span>
          </p>
        </dd>
      </div>

      <div class="kpi reveal" style="--d: 60ms">
        <dt>Son 6 TUS çözüm desteği</dt>
        <dd class="kpi-value">{o.destek} / {num(o.soru)}</dd>
        <dd class="kpi-note">{pct(o.destekOran)} · {o.dogrudan} doğrudan, {o.dolayli} dolaylı</dd>
        <dd class="mt-auto pt-1">
          <div class="segbar grow" role="img" aria-label={`${o.dogrudan} doğrudan, ${o.dolayli} dolaylı, ${konuYalniz} yalnız konu, ${o.yok} karşılıksız soru`}>
            <span class="seg-direct" style={`flex: ${o.dogrudan} 0 0%`}></span>
            <span class="seg-indirect" style={`flex: ${o.dolayli} 0 0%`}></span>
            <span class="seg-topic" style={`flex: ${konuYalniz} 0 0%`}></span>
            <span class="seg-none" style={`flex: ${o.yok} 0 0%`}></span>
          </div>
          <p class="legend mt-2" aria-hidden="true">
            <span><i class="seg-direct"></i>Doğrudan</span>
            <span><i class="seg-indirect"></i>Dolaylı</span>
            <span><i class="seg-topic"></i>Yalnız konu</span>
          </p>
        </dd>
      </div>

      <div class="kpi reveal" style="--d: 120ms">
        <dt>Konu kapsamı</dt>
        <dd class="kpi-value">{pct(o.konuKapsamiOran)}</dd>
        <dd class="kpi-note">{num(o.konuKapsami)} / {num(o.soru)} sorunun konusu destede var (çözüm desteğinden ayrı sayılır)</dd>
        <dd class="mt-auto pt-1">
          <div class="meter grow" role="img" aria-label={`Konu kapsamı ${pct(o.konuKapsamiOran)}`}>
            <span style={`width: ${share(o.konuKapsami, o.soru)}`}></span>
          </div>
        </dd>
      </div>

      <div class="kpi reveal" style="--d: 180ms">
        <dt>2026/2 sınav öncesi kanıt</dt>
        <dd class="kpi-value">{pre.preExamEvet}/200</dd>
        <dd class="kpi-note">Sınavdan 2 gün önceki sürüm <code>{pre.commit}</code> · güncel {pre.supportedCurrent}/200 · {pre.topicCoverage}/200 konu</dd>
        <dd class="mt-auto pt-1">
          <div class="meter grow" role="img" aria-label={`Sınav öncesi sürümde 200 sorunun ${pre.preExamEvet} tanesine çözüm desteği`}>
            <span style={`width: ${share(pre.preExamEvet, 200)}`}></span>
          </div>
        </dd>
      </div>
    </dl>

    <p class="mt-4 text-xs text-inkMuted leading-relaxed max-w-3xl">
      Kaynak: son 6 TUS (2024/1–2026/2) ve <code>{ref.katalogCommit}</code> kataloğu. Sınıflandırma yapay zekâ destekli ön değerlendirmedir; bağımsız hekim editör kontrolü sürmektedir.
      <a href="/referanslar/" class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark">Yöntemi ve 1.195 kaydı incele</a>
    </p>
  </div>
</section>

<section id="kisaca" class="scroll-mt-24 bg-surfaceSoft border-b border-line" aria-labelledby="kisaca-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-12 sm:py-16 grid lg:grid-cols-12 gap-8 lg:gap-12">
    <div class="lg:col-span-5 reveal">
      <p class="kicker">Kısaca</p>
      <h2 id="kisaca-heading" class="display text-section tracking-tightest text-ink mt-3">TusAnkiM nedir?</h2>
      <p data-speakable class="mt-4 text-inkMuted leading-relaxed">
        TusAnkiM, TUS'a (Tıpta Uzmanlık Sınavı) hazırlanan hekim ve tıp öğrencileri için Türkçe aralıklı tekrar uygulamasıdır.
        {num(t.cards)} kartlık hazır BKA TUS paketini <span lang="en">FSRS-6</span> algoritmasıyla zamanlar; kartlar, tekrar geçmişi ve yedekler cihazda kalır.
        Kart kalitesini son 6 TUS'un {num(o.soru)} sorusuyla açık veriyle ölçer.
      </p>
    </div>
    <dl class="lg:col-span-7 grid sm:grid-cols-2 gap-px rounded-2xl overflow-hidden border border-line bg-line reveal" style="--d: 80ms">
      <div class="bg-white p-5">
        <dt class="text-xs font-bold uppercase tracking-wider text-inkMuted">Kimin için</dt>
        <dd class="mt-1.5 text-sm text-ink leading-relaxed">Stajyer ve intörn tıp öğrencileri, TUS'a hazırlanan pratisyen hekimler.</dd>
      </div>
      <div class="bg-white p-5">
        <dt class="text-xs font-bold uppercase tracking-wider text-inkMuted">Nerede çalışır</dt>
        <dd class="mt-1.5 text-sm text-ink leading-relaxed">iPhone için geliştiriliyor; bugün web tarayıcıda (Mac, Windows, iPad, Android) ücretsiz beta olarak çalışır, çevrimdışı da açılır.</dd>
      </div>
      <div class="bg-white p-5">
        <dt class="text-xs font-bold uppercase tracking-wider text-inkMuted">İçerik</dt>
        <dd class="mt-1.5 text-sm text-ink leading-relaxed">{num(t.cards)} kart, {t.courses} ders, {t.topicSubdecks} konu alt destesi; kendi destelerini de ekleyebilirsin.</dd>
      </div>
      <div class="bg-white p-5">
        <dt class="text-xs font-bold uppercase tracking-wider text-inkMuted">Araçlar</dt>
        <dd class="mt-1.5 text-sm text-ink leading-relaxed">Kronometre, Çalışma Takvimi, Çalışma Planlama ve TUS puan hesaplayıcı.</dd>
      </div>
      <div class="bg-white p-5">
        <dt class="text-xs font-bold uppercase tracking-wider text-inkMuted">Anki uyumu</dt>
        <dd class="mt-1.5 text-sm text-ink leading-relaxed">Kişisel <code>.apkg</code> / <code>.colpkg</code> desteleri medya ve tekrar geçmişiyle içe ve dışa aktarılır.</dd>
      </div>
      <div class="bg-white p-5">
        <dt class="text-xs font-bold uppercase tracking-wider text-inkMuted">Kim hazırlıyor</dt>
        <dd class="mt-1.5 text-sm text-ink leading-relaxed">TusAnkiM ekibi; Anki veya Ankitects ile bağlantısı olmayan bağımsız bir projedir.</dd>
      </div>
    </dl>
  </div>
</section>
