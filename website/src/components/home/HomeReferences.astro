---
import ref from '../../data/generated/references-summary.json';
import { num, pct } from '../../lib/format';

const o = ref.overall;
const pre = ref.preExam2026_2;
const exam2026_2 = ref.byExam.find((e) => e.sinav === '2026/2');
const branches = ref.bySubject
  .map((s) => ({ name: s.ders, summary: s, konuYalniz: s.konuKapsami - s.destek }))
  .sort((a, b) => b.summary.destekOran - a.summary.destekOran);
---
<section id="referans-ozet" class="scroll-mt-24 py-14 sm:py-20 bg-white border-b border-line" aria-labelledby="ref-summary-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div class="max-w-2xl reveal">
        <p class="kicker">Açık veri</p>
        <h2 id="ref-summary-heading" class="display text-section tracking-tightest text-ink mt-3">
          Çıkmış TUS referans özeti
        </h2>
        <p class="text-inkMuted mt-3 leading-relaxed">
          Soruyu doğrudan çözdüren kartları, tek köprü isteyen dolaylı kartlardan ve yalnızca konu kapsamından ayrı tutuyoruz.
          Eksik kaldığımız dersleri de aynı tabloda gösteriyoruz.
        </p>
      </div>
      <a
        href="/referanslar/"
        class="inline-flex items-center min-h-[2.75rem] shrink-0 text-sm font-semibold text-teal underline underline-offset-4 hover:text-tealDark"
      >
        1.195 soruyu incele →
      </a>
    </div>

    <div
      class="overflow-x-auto rounded-2xl border border-line bg-white"
      tabindex="0"
      role="region"
      aria-label="TUS referans özeti tablosu"
    >
      <table class="w-full text-left border-collapse text-sm">
        <caption class="sr-only">Son 6 TUS ve 2026/2 Ağustos TUS referans dağılımı</caption>
        <thead>
          <tr class="border-b border-line bg-surfaceSoft text-xs font-semibold text-inkMuted">
            <th scope="col" class="py-3.5 px-5">Kapsam</th>
            <th scope="col" class="py-3.5 px-5 tabular-nums">Doğrudan</th>
            <th scope="col" class="py-3.5 px-5 tabular-nums">Dolaylı</th>
            <th scope="col" class="py-3.5 px-5 tabular-nums">Çözüm Desteği</th>
            <th scope="col" class="py-3.5 px-5 tabular-nums">Konu Kapsamı</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-lineLight tabular-nums">
          <tr>
            <th scope="row" class="py-3.5 px-5 font-semibold text-ink whitespace-nowrap">
              Son 6 TUS (2024/1–2026/2 · 1.195 soru)
            </th>
            <td class="py-3.5 px-5 text-gradeGood font-semibold">{o.dogrudan}</td>
            <td class="py-3.5 px-5 text-warm font-semibold">{o.dolayli}</td>
            <td class="py-3.5 px-5 text-ink font-semibold">{o.destek} / 1.195 ({pct(o.destekOran)})</td>
            <td class="py-3.5 px-5 text-inkMuted">{num(o.konuKapsami)} / 1.195 ({pct(o.konuKapsamiOran)})</td>
          </tr>
          {exam2026_2 && (
            <tr>
              <th scope="row" class="py-3.5 px-5 font-semibold text-ink whitespace-nowrap">
                2026/2 Ağustos (güncel katalog · 200 soru)
              </th>
              <td class="py-3.5 px-5 text-gradeGood font-semibold">{exam2026_2.dogrudan}</td>
              <td class="py-3.5 px-5 text-warm font-semibold">{exam2026_2.dolayli}</td>
              <td class="py-3.5 px-5 text-ink font-semibold">{exam2026_2.destek} / 200 ({pct(exam2026_2.destekOran)})</td>
              <td class="py-3.5 px-5 text-inkMuted">{exam2026_2.konuKapsami} / 200 ({pct(exam2026_2.konuKapsamiOran)})</td>
            </tr>
          )}
          <tr>
            <th scope="row" class="py-3.5 px-5 font-semibold text-ink whitespace-nowrap">
              2026/2 Ağustos (sınav öncesi <code>{pre.commit}</code>)
            </th>
            <td class="py-3.5 px-5 text-inkMuted" colspan="2">Sınavdan 2 gün önce ({pre.date})</td>
            <td class="py-3.5 px-5 text-ink font-semibold">{pre.preExamEvet} / 200 ({pct((pre.preExamEvet / 200) * 100)})</td>
            <td class="py-3.5 px-5 text-inkMuted">{pre.preExamKismen + pre.preExamHayir} soru sınav sonrası eklendi</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-12 grid lg:grid-cols-12 gap-8">
      <div class="lg:col-span-4 reveal">
        <h3 class="display text-subsection tracking-tightest text-ink">Ders ders çözüm desteği</h3>
        <p class="text-inkMuted mt-3 leading-relaxed text-sm">
          Her satır o dersin son 6 TUS'taki sorularını gösterir. Derse tıklayınca güçlü alanları, öncelikli boşlukları ve sınav bazlı tabloyu görürsün.
        </p>
        <p class="legend mt-5">
          <span><i class="seg-direct"></i>Doğrudan</span>
          <span><i class="seg-indirect"></i>Dolaylı</span>
          <span><i class="seg-topic"></i>Yalnız konu</span>
          <span><i class="seg-none"></i>Karşılıksız</span>
        </p>
      </div>

      <ul role="list" class="lg:col-span-8 border-t border-lineLight">
        {branches.map((b) => (
          <li>
            <div class="branch-row">
              <span class="branch-name text-sm font-semibold">{b.name}</span>
              <span
                class="segbar grow"
                role="img"
                aria-label={`${b.summary.soru} sorunun ${b.summary.dogrudan} doğrudan, ${b.summary.dolayli} dolaylı, ${b.konuYalniz} yalnız konu`}
              >
                <span class="seg-direct" style={`flex: ${b.summary.dogrudan} 0 0%`}></span>
                <span class="seg-indirect" style={`flex: ${b.summary.dolayli} 0 0%`}></span>
                <span class="seg-topic" style={`flex: ${b.konuYalniz} 0 0%`}></span>
                <span class="seg-none" style={`flex: ${b.summary.yok} 0 0%`}></span>
              </span>
              <span class="text-right text-sm font-bold tabular-nums text-ink">{pct(b.summary.destekOran)}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-6 text-xs text-inkMuted leading-relaxed max-w-3xl">
      Sınıflandırma 26 Ekim 2026 kataloğu (<code>{ref.katalogCommit}</code>) üzerinde yapay zekâ destekli ön değerlendirme ile hazırlanmıştır;
      bağımsız hekim editör kontrolü sürmektedir. Katalog 12 ders (FHE dâhil 11 branş + karma Deneme ve Soru) içerir; çıkmış soru referansları ise
      11 resmî ÖSYM TUS branşı üzerinden raporlanır. Güncel katalogda 2026/2 için {pre.supportedCurrent}/200 çözüm desteği vardır.
      Yalnız konu ilişkili kartlar çözüm desteğine katılmaz; ÖSYM soru metni yayımlanmaz.
    </p>
  </div>
</section>
