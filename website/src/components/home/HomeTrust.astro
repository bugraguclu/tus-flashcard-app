---
import faqs from '../../data/faqs.json';
import founder from '../../data/founder.json';
import { SITE } from '../../config';
import { answerHtml } from '../../lib/richtext';

const teaserFaqs = [faqs.items[1], faqs.items[4], faqs.items[5], faqs.items[16], faqs.items[14]].filter(Boolean);
---
<section id="sss" class="scroll-mt-24 py-14 sm:py-20 bg-white" aria-labelledby="home-faq-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 grid lg:grid-cols-12 gap-10 lg:gap-14">
    <aside id="neden-tusankim" class="scroll-mt-24 lg:col-span-5 reveal" aria-labelledby="founder-heading">
      <div class="rounded-2xl border border-line bg-surfaceSoft p-6 sm:p-7 lg:sticky lg:top-28">
        <p class="kicker">{founder.kicker}</p>
        <h2 id="founder-heading" class="display text-subsection tracking-tightest text-ink mt-3">{founder.letterTitle}</h2>
        <blockquote class="mt-4 text-[0.9375rem] text-ink leading-relaxed">
          <p>“{founder.quote}”</p>
        </blockquote>
        <p class="mt-4 text-sm text-inkMuted leading-relaxed">{founder.letterParagraphs[0]}</p>
        <ul role="list" class="mt-5 pt-4 border-t border-line space-y-2 text-sm">
          {founder.editorialPillars.slice(0, 3).map((p) => (
            <li><strong class="text-ink">{p.title}:</strong> <span class="text-inkMuted">{p.body}</span></li>
          ))}
        </ul>
        <a href="/kurucu/" class="mt-3 inline-flex items-center min-h-[2.75rem] text-sm font-semibold text-teal underline underline-offset-4 hover:text-tealDark">
          Hazırlama yaklaşımımızı oku →
        </a>
      </div>
    </aside>

    <div class="lg:col-span-7">
      <div class="flex items-end justify-between gap-4 mb-4 reveal">
        <h2 id="home-faq-heading" class="display text-section tracking-tightest text-ink">Sıkça sorulan sorular</h2>
        <a
          href="/sss/"
          class="shrink-0 inline-flex items-center min-h-[2.75rem] py-2 text-sm font-semibold text-teal hover:text-tealDark underline underline-offset-4 whitespace-nowrap"
        >
          Tümü ({faqs.items.length}) →
        </a>
      </div>
      <div class="faq">
        {teaserFaqs.map((f) => (
          <details>
            <summary><span>{f.q}</span></summary>
            <div class="faq-answer" set:html={answerHtml(f.a)}></div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="cta-band text-white" aria-labelledby="final-cta-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-14 sm:py-20 grid lg:grid-cols-12 gap-8 items-center">
    <div class="lg:col-span-8 reveal">
      <h2 id="final-cta-heading" class="display text-section tracking-tightest">Bugün 20 kartla başla.</h2>
      <p class="mt-3 text-white/90 leading-relaxed max-w-2xl">
        Web uygulamasını aç, BKA TUS paketinden bir ders seç ve ilk tekrarını yap. Hesap açman gerekmez; kartların ve ilerlemen cihazında kalır.
      </p>
    </div>
    <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 reveal" style="--d: 80ms">
      <a
        href={SITE.webAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center min-h-[3.25rem] px-7 rounded-full bg-white text-teal text-[0.9375rem] font-semibold hover:bg-tint transition"
      >
        Ücretsiz Başla ↗<span class="sr-only"> (yeni sekmede açılır)</span>
      </a>
      <a
        href="/yardim/hizli-baslangic/"
        class="inline-flex items-center justify-center min-h-[3.25rem] px-7 rounded-full border border-white/60 text-white text-[0.9375rem] font-semibold hover:bg-white/10 transition"
      >
        Hızlı başlangıç rehberi
      </a>
    </div>
  </div>
</section>
