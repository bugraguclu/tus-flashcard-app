---
interface Props {
  name: 'refresh' | 'chevron-down' | 'chevron-right' | 'back' | 'undo' | 'flame' | 'check' | 'cards' | 'timer' | 'add' | 'stats' | 'settings' | 'close' | 'search' | 'menu' | 'folder' | 'deck' | 'calendar' | 'info';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
---
{name === 'refresh' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.81"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class={className}
  >
    <path d="M19.5 12A8 8 0 1 0 16.09 18.55M21.75 9.75 19.5 12l-2.25-2.25" />
  </svg>
)}
{name === 'chevron-down' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.98"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class={className}
  >
    <path d="m6 9.25 6 6 6-6" />
  </svg>
)}
{name === 'chevron-right' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.98"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class={className}
  >
    <path d="m9.25 6 6 6-6 6" />
  </svg>
)}
{name === 'back' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class={className}
  >
    <path d="M15.5 4.75 8.25 12l7.25 7.25" />
  </svg>
)}
{name === 'undo' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.81"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class={className}
  >
    <path d="M8.75 13.25 4.5 9l4.25-4.25M4.5 9h10.25a5 5 0 0 1 0 10H10" />
  </svg>
)}
{name === 'flame' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
    class={className}
  >
    <path d="M12 21.25C8.6 21.25 5.75 18.6 5.75 15c0-2.4 1-4.4 2.25-5.9.6 1.5 1.6 2.3 2.6 2.5-.6-3.4.4-6.6 2.4-8.85 3.4 2.65 5.25 6.85 5.25 12 0 3.75-2.85 6.5-6.25 6.5Z" />
  </svg>
)}
{name === 'check' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class={className}
  >
    <path d="M4.75 12.75 9.5 17.5 19.25 7" />
  </svg>
)}

{['cards', 'timer', 'add', 'stats', 'settings', 'close', 'search', 'menu', 'folder', 'deck', 'calendar', 'info'].includes(name) && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class={className}>
    {name === 'cards' && <><path d="M6.85 17.53A2.5 2.5 0 0 1 5.69 16.02L3.43 7.57A2.5 2.5 0 0 1 5.19 4.5L10.75 3.02A2.5 2.5 0 0 1 13.81 4.78L13.83 4.85" /><rect x="9.25" y="7.25" width="10.75" height="13.75" rx="2.5" /></>}
    {name === 'timer' && <><circle cx="12" cy="13.5" r="7.75" /><path d="M9.75 2.75h4.5M12 2.75v3M18.1 6.65l1.4-1.4M12 13.5V9.5" /></>}
    {name === 'add' && <path d="M12 5v14M5 12h14" />}
    {name === 'stats' && <><rect x="3.5" y="12" width="3.6" height="8.5" rx="1.2" /><rect x="10.2" y="4.5" width="3.6" height="16" rx="1.2" /><rect x="16.9" y="8.75" width="3.6" height="11.75" rx="1.2" /></>}
    {name === 'settings' && <><path d="m10 3-.6 2.1-1.8 1L5.5 5.7l-2 3.5L5 10.8v2.4l-1.5 1.6 2 3.5 2.1-.4 1.8 1L10 21h4l.6-2.1 1.8-1 2.1.4 2-3.5-1.5-1.6v-2.4l1.5-1.6-2-3.5-2.1.4-1.8-1L14 3Z" /><circle cx="12" cy="12" r="3" /></>}
    {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
    {name === 'search' && <><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></>}
    {name === 'menu' && <path d="M4 6h16M4 12h16M4 18h16" />}
    {name === 'folder' && <path d="M3.5 7.25A2.25 2.25 0 0 1 5.75 5h3.6l2 2.25h6.9a2.25 2.25 0 0 1 2.25 2.25v8.25A2.25 2.25 0 0 1 18.25 20H5.75a2.25 2.25 0 0 1-2.25-2.25Z" />}
    {name === 'deck' && <><rect x="3" y="10.25" width="18" height="10.25" rx="2.5" /><path d="M4.75 10.25V8.75a1.5 1.5 0 0 1 1.5-1.5h11.5a1.5 1.5 0 0 1 1.5 1.5v1.5M6.5 7.25V5.75a1.5 1.5 0 0 1 1.5-1.5h8a1.5 1.5 0 0 1 1.5 1.5v1.5" /></>}
    {name === 'calendar' && <><rect x="3.5" y="5" width="17" height="16" rx="2.5" /><path d="M3.5 10h17M8 3v4m8-4v4M8 14h1m6 0h1m-8 4h1m6 0h1" /></>}
    {name === 'info' && <><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7h.01" /></>}
  </svg>
)}
