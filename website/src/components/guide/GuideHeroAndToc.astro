---
import catalog from '../../data/generated/catalog.json';
import refSummary from '../../data/generated/references-summary.json';
import { GUIDE_META, GUIDE_TOC } from '../../data/studyGuide';
import {
  DEFAULT_PLANNER_INPUT,
  PLANNER_PRESETS,
  formatDurationTr,
  runPlanner,
} from '../../lib/studyPlanner';
import { num, pct } from '../../lib/format';

const totalCards = num(catalog.totals.cards);
const mezunPreset = PLANNER_PRESETS.find((preset) => preset.id === 'mezun');
if (!mezunPreset) throw new Error('Missing mezun preset in PLANNER_PRESETS');
const mezunSim = runPlanner({ ...DEFAULT_PLANNER_INPUT, ...mezunPreset.patch });
const retentionPct = mezunSim.input.retention;
---
<section class="page-intro bg-surface border-b border-line py-10 sm:py-14">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
    <nav aria-label="Sayfa konumu" class="flex flex-wrap items-center gap-y-1 text-sm text-inkMuted mb-3">
      <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="text-ink font-semibold">TUS Çalışma Rehberi</span>
    </nav>

    <p class="guide-kicker">{GUIDE_META.kicker}</p>
    <h1 id="guide-title" class="display text-page-title tracking-tightest text-ink mt-3 max-w-4xl">
      {GUIDE_META.h1}
    </h1>
    <p data-speakable class="text-inkMuted mt-4 max-w-3xl text-base sm:text-lg leading-relaxed">
      {GUIDE_META.lead}
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/calisma-plani/" class="button-primary">Kişisel FSRS-6 planını kur →</a>
      <a href="/puan-hesapla/" class="button-secondary">TUS puanını ve hedef netini hesapla</a>
      <a href="#kartlari-dene" class="button-secondary">Kartları tablette dene</a>
    </div>
  </div>
</section>

<!-- Sticky Scrollspy Table of Contents -->
<div class="guide-toc-bar">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
    <nav aria-label="Rehber bölümleri" class="guide-toc-list" data-guide-toc>
      {GUIDE_TOC.map((item) => (
        <a href={`#${item.id}`} class="guide-toc-link">{item.label}</a>
      ))}
    </nav>
  </div>
</div>

<!-- Direct-answer GEO summary block -->
<section id="hizli-ozet" tabindex="-1" class="guide-section bg-white border-b border-line py-10 sm:py-14" aria-labelledby="tldr-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 grid lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-5">
      <p class="guide-kicker">Hızlı özet</p>
      <h2 id="tldr-heading" class="display text-section tracking-tightest text-ink mt-3">
        TUS’a nasıl çalışılır?
      </h2>
      <p data-speakable class="mt-3 text-inkMuted leading-relaxed">
        TUS, 11 tıp branşını aynı gün iki oturumda ve toplam <strong>200 soruyla</strong> (100 Temel + 100 Klinik) ölçer.
        4 yanlış 1 doğruyu götürür; Klinik puanının <strong>%40’ı Temel Bilimlerden</strong> gelir.
        Bilginin kalması için kart tekrarını <strong>FSRS-6 (%{retentionPct} hedef hatırlama)</strong> ile günde 60–125 dakikada tut.
        Her gün 2–4+ saati de konu okumaya, çıkmış soruya ve deneme analizine ayır.
      </p>
    </div>

    <dl class="lg:col-span-7 grid sm:grid-cols-2 gap-px rounded-2xl overflow-hidden border border-line bg-line">
      <div class="bg-white p-5">
        <dt class="text-sm font-semibold text-inkMuted">Sınav yapısı, süre ve ağırlıklar</dt>
        <dd class="mt-1.5 text-sm text-ink leading-relaxed">
          200 soru (100 Temel · 135 dk + 100 Klinik · 135 dk) · Klinik Puanı <strong>%40 T + %60 K</strong> · Temel Puanı <strong>%60 T + %40 K</strong> · 45 baraj ve %5 kesinti kuralı.
        </dd>
      </div>
      <div class="bg-white p-5">
        <dt class="text-sm font-semibold text-inkMuted">Önerilen tempo</dt>
        <dd class="mt-1.5 text-sm text-ink leading-relaxed">
          {totalCards} kartta günde <strong>{mezunSim.activePace} yeni kart</strong> ile ilk tur <strong>{mezunSim.target.finishDay ?? mezunSim.input.days}. günde</strong> biter; {mezunSim.input.days} günde ortalama {num(mezunSim.target.avgCards)} kart (~{formatDurationTr(mezunSim.target.avgMinutes)}/gün).
        </dd>
      </div>
      <div class="bg-white p-5">
        <dt class="text-sm font-semibold text-inkMuted">Son 6 TUS referans verisi</dt>
        <dd class="mt-1.5 text-sm text-ink leading-relaxed">
          {num(refSummary.overall.soru)} soruda <strong>{refSummary.overall.destek} çözüm desteği ({pct(refSummary.overall.destekOran)})</strong>
          ({refSummary.overall.dogrudan} doğrudan + {refSummary.overall.dolayli} dolaylı) ve <strong>{num(refSummary.overall.konuKapsami)} ({pct(refSummary.overall.konuKapsamiOran)}) konu kapsamı</strong>.
        </dd>
      </div>
      <div class="bg-white p-5">
        <dt class="text-sm font-semibold text-inkMuted">Son 30 gün kuralı</dt>
        <dd class="mt-1.5 text-sm text-ink leading-relaxed">
          İlk turu sınavdan <strong>14–30 gün önce</strong> bitir. Son haftalarda yeni kart açma; deneme yanlışlarına ve olgun kartların tekrarına odaklan.
        </dd>
      </div>
    </dl>
  </div>
</section>
