---
import catalog from '../../data/generated/catalog.json';
import {
  DEFAULT_PLANNER_INPUT,
  MEGA_DECK_CARDS,
  PLANNER_PRESETS,
  encodePlannerQuery,
  formatDurationTr,
  runPlanner,
} from '../../lib/studyPlanner';
import { num, pct } from '../../lib/format';

const totalCardsLabel = num(catalog.totals.cards);
const megaCards = MEGA_DECK_CARDS;
const megaCardsLabel = num(megaCards);
const retention = DEFAULT_PLANNER_INPUT.retention;

const presetCards = PLANNER_PRESETS.map((preset) => {
  const input = { ...DEFAULT_PLANNER_INPUT, ...preset.patch };
  const sim = runPlanner(input);
  const plannerUrl = `/calisma-plani/?${encodePlannerQuery(input)}#calisma-plani`;
  return { preset, sim, plannerUrl };
});

// Unified with /calisma-plani/: full BKA package vs 27,341 mega deck via runPlanner (FSRS-6 kernel).
const H = 180;
const P = 60;
const sim180_60 = runPlanner({
  ...DEFAULT_PLANNER_INPUT,
  days: H,
  newPerDay: P,
  studyDaysPerWeek: 7,
  bufferDays: 0,
});
const sim270_60 = runPlanner({
  ...DEFAULT_PLANNER_INPUT,
  days: 270,
  newPerDay: 60,
  studyDaysPerWeek: 7,
  bufferDays: 0,
});
const sim270_80 = runPlanner({
  ...DEFAULT_PLANNER_INPUT,
  days: 270,
  newPerDay: 80,
  studyDaysPerWeek: 7,
  bufferDays: 0,
});
const sim365_80 = runPlanner({
  ...DEFAULT_PLANNER_INPUT,
  days: 365,
  newPerDay: 80,
  studyDaysPerWeek: 7,
  bufferDays: 0,
});

const mine = sim180_60.target;
const mega = sim180_60.mega;

const sampleDaySet = new Set<number>([1, H]);
for (let d = 10; d < H; d += 10) sampleDaySet.add(d);
if (mine.peakDay >= 1 && mine.peakDay <= H) sampleDaySet.add(mine.peakDay);
if (mine.finishDay) {
  sampleDaySet.add(mine.finishDay);
  if (mine.finishDay + 1 <= H) sampleDaySet.add(mine.finishDay + 1);
}
const sampledSeries = [...sampleDaySet]
  .sort((a, b) => a - b)
  .map((day) => sim180_60.series[day - 1]);

const W = 600;
const HT = 220;
const pad = { l: 44, r: 16, t: 14, b: 30 };
const maxY =
  Math.ceil(
    Math.max(
      ...sampledSeries.map((p) => p.totalCards),
      ...sampledSeries.map((p) => p.megaTotalCards),
    ) / 100,
  ) * 100;
const x = (d: number) => pad.l + ((d - 1) / (H - 1)) * (W - pad.l - pad.r);
const y = (v: number) => pad.t + (1 - v / maxY) * (HT - pad.t - pad.b);
const minePath = sampledSeries
  .map((p, i) => `${i ? 'L' : 'M'}${x(p.day).toFixed(1)} ${y(p.totalCards).toFixed(1)}`)
  .join(' ');
const megaPath = sampledSeries
  .map((p, i) => `${i ? 'L' : 'M'}${x(p.day).toFixed(1)} ${y(p.megaTotalCards).toFixed(1)}`)
  .join(' ');
const yTicks = [0, maxY / 2, maxY];
const xTicks = [1, 60, 120, 180];
---
<section id="tempo-ve-profiller" tabindex="-1" class="guide-section py-14 sm:py-20 bg-surfaceSoft border-b border-line" aria-labelledby="tempo-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-6">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 id="tempo-heading" class="display text-section tracking-tightest text-ink">
          Sınava kaç gün var? Temponu ona göre seç
        </h2>
        <p class="text-inkMuted mt-3 leading-relaxed">
          Aşağıdaki sayıları elle yazmadık. {num(catalog.totals.cards)} kartın tamamını TusAnkiM’in
          <span lang="en">FSRS-6</span> simülatöründen (%{retention} hedef hatırlama) geçirdik. Her profil hazırlığı ikiye böler:
          <strong>1. faz (yeni kart + tekrar)</strong> ve sınavdan önceki <strong>2. faz (yalnız tekrar + deneme)</strong>.
        </p>
      </div>
      <a href="/calisma-plani/" class="button-primary shrink-0 self-start lg:self-auto">
        Kendi sınav tarihinle planla →
      </a>
    </div>

    <!-- 4 Candidate Stage Cards (migrated from HomePlan.astro and synced with PLANNER_PRESETS) -->
    <ol role="list" class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-8">
      {presetCards.map(({ preset, sim, plannerUrl }, i) => (
        <li class="guide-reveal border-t border-line pt-5 flex flex-col" style={`--d: ${i * 50}ms`}>
          <p class="text-sm font-semibold text-inkMuted">{preset.title}</p>
          <h3 class="display text-lg text-ink mt-1.5">{preset.horizonLabel}</h3>
          <p class="mt-4 flex items-baseline gap-1.5">
            <span class="display text-4xl text-teal tabular-nums">{sim.activePace}</span>
            <span class="text-sm text-inkMuted">yeni kart / gün</span>
          </p>
          <ul role="list" class="mt-3 space-y-1 text-sm text-ink tabular-nums">
            <li>İlk tur <strong>{sim.target.finishDay ?? sim.input.days}. günde</strong> biter</li>
            <li>Ortalama <strong>{num(sim.target.avgCards)}</strong> kart/gün (<strong>~{formatDurationTr(sim.target.avgMinutes)}</strong>)</li>
            <li>Haftada <strong>{sim.input.studyDaysPerWeek} gün</strong> · son <strong>{sim.target.reviewOnlyTailDays} gün</strong> tampon</li>
          </ul>
          <p class="mt-4 text-sm text-inkMuted leading-relaxed flex-1">{preset.tip}</p>
          <div class="mt-4 pt-3 border-t border-lineLight">
            <a href={plannerUrl} class="inline-flex items-center min-h-[2.75rem] text-sm font-semibold text-teal hover:text-tealDark underline underline-offset-4">
              Bu profili planlayıcıda aç →
            </a>
          </div>
        </li>
      ))}
    </ol>

    <!-- Horizon comparison table (synced directly with PLANNER_PRESETS / runPlanner) -->
    <div class="mt-12 space-y-4">
      <h3 id="ufuk-tablo-baslik" class="display text-subsection tracking-tightest text-ink">
        Hazırlık süresine göre günlük kart sayısı ve süre
      </h3>
      <div class="guide-table-wrap" tabindex="0" role="region" aria-labelledby="ufuk-tablo-baslik">
        <table class="guide-table">
          <caption class="sr-only">4 aday profili için 120, 180, 270 ve 365 günlük TUS hazırlığında FSRS-6 (%{retention}) ile günlük kart sayısı, en yoğun günün süresi ve tampon gün karşılaştırması</caption>
          <thead>
            <tr>
              <th scope="col">Aday profili ve süre</th>
              <th scope="col">Günlük yeni kart ve düzen</th>
              <th scope="col">İlk tur bitişi</th>
              <th scope="col">Günlük ortalama</th>
              <th scope="col">En yoğun gün</th>
              <th scope="col">Sınav öncesi tampon</th>
            </tr>
          </thead>
          <tbody class="tabular-nums">
            {presetCards.map(({ preset, sim }) => (
              <tr>
                <th scope="row">{preset.title} ({preset.horizonLabel})</th>
                <td data-col="Günlük yeni kart ve düzen">
                  {sim.activePace} yeni / gün · haftada {sim.input.studyDaysPerWeek} gün
                </td>
                <td data-col="İlk tur bitişi">{sim.target.finishDay ?? sim.input.days}. gün</td>
                <td data-col="Günlük ortalama">
                  {num(sim.target.avgCards)} kart (~{formatDurationTr(sim.target.avgMinutes)})
                </td>
                <td data-col="En yoğun gün">
                  ~{formatDurationTr(sim.target.peakMinutes)} ({num(sim.target.peakCards)} kart)
                </td>
                <td data-col="Sınav öncesi tampon">Son {sim.target.reviewOnlyTailDays} gün yalnız tekrar</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Moved from HomePlan.astro: Bitirilebilir deste vs Mega deste SVG chart & comparison -->
    <div id="mega-deste-kiyasi" tabindex="-1" class="guide-subanchor mt-14 pt-12 border-t border-line grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-5">
        <h3 class="display text-subsection tracking-tightest text-ink">
          Bitirilebilir deste, bitmeyen desteden önce gelir
        </h3>
        <p class="text-inkMuted mt-3 leading-relaxed">
          Günde {P} yeni kartla {H} gün çalıştığını düşün. İlk aylarda iki destede de günlük kart sayısı birbirine yakındır.
          Fark sınav sabahı ortaya çıkar: destenin ne kadarını bitirdin, kartlar konu ve deneme zamanını yedi mi?
        </p>
        <dl class="mt-6 space-y-4">
          <div>
            <dt class="flex justify-between text-sm">
              <span class="font-semibold text-ink">TusAnkiM · {totalCardsLabel} kart</span>
              <span class="tabular-nums font-bold text-teal">{pct(mine.memorizedPct)}</span>
            </dt>
            <dd class="mt-1.5">
              <div class="guide-meter" role="img" aria-label={`${H}. günde ${totalCardsLabel} kartın ${pct(mine.memorizedPct)} kadarı hafızada`}>
                <span style={`width: ${mine.memorizedPct}%`}></span>
              </div>
              <p class="mt-1 text-xs text-inkMuted">İlk tur {mine.finishDay ?? H}. günde biter; kalan günler yalnız tekrara ve denemeye kalır.</p>
            </dd>
          </div>
          <div>
            <dt class="flex justify-between text-sm">
              <span class="font-semibold text-ink">Mega deste · {megaCardsLabel} kart</span>
              <span class="tabular-nums font-bold text-warm">{pct(mega.memorizedPct)}</span>
            </dt>
            <dd class="mt-1.5">
              <div class="guide-meter guide-meter-warm" role="img" aria-label={`${H}. günde ${megaCardsLabel} kartın ${pct(mega.memorizedPct)} kadarı hafızada`}>
                <span style={`width: ${mega.memorizedPct}%`}></span>
              </div>
              <p class="mt-1 text-xs text-inkMuted">{H} günde ilk tur bitmez; son güne kadar yeni kart açmaya devam edersin.</p>
            </dd>
          </div>
        </dl>
      </div>

      <figure class="lg:col-span-7 border-t border-line pt-5">
        <figcaption class="flex flex-wrap items-center justify-between gap-2 text-sm">
          <span class="font-semibold text-ink">Günlük kart sayısı (yeni + tekrar · {H} gün, {P} yeni/gün)</span>
          <span class="guide-legend">
            <span><i style="background:#0e7469"></i>TusAnkiM ({totalCardsLabel})</span>
            <span><i style="background:#d9661a"></i>Mega deste ({megaCardsLabel})</span>
          </span>
        </figcaption>
        <svg
          class="guide-chart mt-3 w-full h-auto"
          viewBox={`0 0 ${W} ${HT}`}
          role="img"
          aria-label={`${H} gün boyunca günlük kart sayısı. İki deste ${mine.finishDay ?? H}. güne kadar benzer seyreder; sonra TusAnkiM yalnız tekrara iner, mega deste yeni kart eklemeye devam eder.`}
        >
          {yTicks.map((v) => (
            <g>
              <line x1={pad.l} x2={W - pad.r} y1={y(v)} y2={y(v)} stroke="#dde1e4" stroke-dasharray={v === 0 ? '0' : '3 4'} />
              <text x={pad.l - 8} y={y(v) + 4} text-anchor="end" font-size="11" fill="#596166">{num(v)}</text>
            </g>
          ))}
          {xTicks.map((d) => (
            <text x={x(d)} y={HT - 8} text-anchor={d === 1 ? 'start' : d === H ? 'end' : 'middle'} font-size="11" fill="#596166">{d}. gün</text>
          ))}
          <line x1={x(mine.finishDay ?? H)} x2={x(mine.finishDay ?? H)} y1={pad.t} y2={HT - pad.b} stroke="#14998a" stroke-dasharray="2 4" />
          <text x={x(mine.finishDay ?? H) - 6} y={pad.t + 10} text-anchor="end" font-size="11" font-weight="700" fill="#0e7469">İlk tur biter ({mine.finishDay ?? H}. gün)</text>
          <path class="guide-chart-line" d={megaPath} stroke="#d9661a" style="--len: 900" />
          <path class="guide-chart-line" d={minePath} stroke="#0e7469" style="--len: 900" />
        </svg>
        <p class="mt-2 text-xs text-inkMuted">
          Kaynak: TusAnkiM <span lang="en">FSRS-6</span> simülatörü (%{retention} hedef hatırlama).
          Günlük sınırları <a href="/yardim/deste-secenekleri/" class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark">deste seçenekleri rehberinde</a>,
          kendi eğrini <a href="/calisma-plani/" class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark">Çalışma Planı aracında</a> görebilirsin.
        </p>
      </figure>
    </div>

    <!-- Compact Mega Deck numeric proof table -->
    <div class="mt-8">
      <div class="guide-table-wrap" tabindex="0" role="region" aria-label={`${totalCardsLabel} kartlık BKA TUS paketi ile ${megaCardsLabel} kartlık mega destenin 270 ve 365 günlük karşılaştırması`}>
        <table class="guide-table">
          <caption class="sr-only">270 ve 365 günlük planlarda {totalCardsLabel} kartlık BKA TUS paketi ile {megaCardsLabel} kartlık mega destenin günlük kart ve süre karşılaştırması</caption>
          <thead>
            <tr>
              <th scope="col">Deste</th>
              <th scope="col">Günlük yeni kart</th>
              <th scope="col">İlk tur (270 ve 365 gün)</th>
              <th scope="col">270. günde</th>
              <th scope="col">270 günde en yoğun gün</th>
            </tr>
          </thead>
          <tbody class="tabular-nums">
            <tr>
              <th scope="row">BKA TUS paketi ({totalCardsLabel} kart)</th>
              <td data-col="Günlük yeni kart">60 yeni / gün</td>
              <td data-col="İlk tur (270 ve 365 gün)" class="font-semibold text-gradeGood">{sim270_60.target.finishDay}. günde biter (270. günde {pct(sim270_60.target.memorizedPct)} hafızada)</td>
              <td data-col="270. günde">{num(sim270_60.target.endDayCards)} kart · ~{formatDurationTr(sim270_60.target.endDayMinutes)}/gün</td>
              <td data-col="270 günde en yoğun gün">~{formatDurationTr(sim270_60.target.peakMinutes)} ({num(sim270_60.target.peakCards)} kart)</td>
            </tr>
            <tr>
              <th scope="row">Mega deste ({megaCardsLabel} kart)</th>
              <td data-col="Günlük yeni kart">60 yeni / gün</td>
              <td data-col="İlk tur (270 ve 365 gün)" class="font-semibold text-gradeAgain">270 ve 365 günde bitmez (270. günde {pct(sim270_60.mega.memorizedPct)} hafızada)</td>
              <td data-col="270. günde">{num(sim270_60.mega.endDayCards)} kart · ~{formatDurationTr(sim270_60.mega.endDayMinutes)}/gün</td>
              <td data-col="270 günde en yoğun gün">~{formatDurationTr(sim270_60.mega.peakMinutes)} ({num(sim270_60.mega.peakCards)} kart)</td>
            </tr>
            <tr>
              <th scope="row">Mega deste ({megaCardsLabel} kart)</th>
              <td data-col="Günlük yeni kart">80 yeni / gün</td>
              <td data-col="İlk tur (270 ve 365 gün)">270 günde bitmez; 365 günlük planda {sim365_80.mega.finishDay}. günde biter</td>
              <td data-col="270. günde">{num(sim270_80.mega.endDayCards)} kart · ~{formatDurationTr(sim270_80.mega.endDayMinutes)}/gün</td>
              <td data-col="270 günde en yoğun gün">~{formatDurationTr(sim270_80.mega.peakMinutes)} (365 günlük planda en yoğun gün: ~{formatDurationTr(sim365_80.mega.peakMinutes)})</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
