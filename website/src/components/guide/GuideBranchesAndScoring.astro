---
import catalog from '../../data/generated/catalog.json';
import refSummary from '../../data/generated/references-summary.json';
import { BRANCH_STUDY_NOTES } from '../../data/studyGuide';
import { num, pct } from '../../lib/format';

const courseById = new Map(catalog.courses.map((c) => [c.id, c]));
const refBySubject = new Map(refSummary.bySubject.map((s) => [s.ders, s]));
const karmaCourse = catalog.courses.find((c) => c.id === 'bka-deneme-ve-soru');

const branchRows = BRANCH_STUDY_NOTES.map((note) => {
  const course = courseById.get(note.catalogId)!;
  const ref = refBySubject.get(note.ders)!;
  return {
    ...note,
    cards: course.cards,
    subdecks: course.topicSubdecks,
    soru: ref.soru,
    dogrudan: ref.dogrudan,
    dolayli: ref.dolayli,
    destek: ref.destek,
    destekOran: ref.destekOran,
    konuKapsamiOran: ref.konuKapsamiOran,
    refHref: `/referanslar/?ders=${encodeURIComponent(note.ders)}`,
  };
});

const destekPct = (ders: string) => pct(refBySubject.get(ders)!.destekOran);

const scoreBenchmarks = [
  { target: '55,0 puan', noPenaltyNet: '~95 net (~47–48 / oturum)', penaltyRaw: '~57,9 ham puan', penaltyNet: '~105 net' },
  { target: '60,0 puan', noPenaltyNet: '~113 net (~56–57 / oturum)', penaltyRaw: '~63,2 ham puan', penaltyNet: '~124 net' },
  { target: '65,0 puan', noPenaltyNet: '~130 net (~65 / oturum)', penaltyRaw: '~68,4 ham puan', penaltyNet: '~143 net' },
  { target: '70,0 puan', noPenaltyNet: '~148 net (~74 / oturum)', penaltyRaw: '~73,7 ham puan', penaltyNet: '~161 net' },
  { target: '75,0 puan', noPenaltyNet: '~166 net (~83 / oturum)', penaltyRaw: '~78,9 ham puan', penaltyNet: '~180 net' },
];
---
<section id="brans-stratejisi" tabindex="-1" class="guide-section py-14 sm:py-20 bg-surfaceSoft border-b border-line" aria-labelledby="branches-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 space-y-8">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
      <div class="max-w-3xl">
        <p class="guide-kicker">TUS Kaç Soru? · 11 ÖSYM Branşı</p>
        <h2 id="branches-heading" class="display text-section tracking-tightest text-ink mt-3">
          11 TUS branşında soru dağılımı, kart hacmi ve çalışma odağı
        </h2>
        <p class="text-inkMuted mt-3 leading-relaxed">
          TUS iki oturumda <strong>100 Temel Bilimler (6 ders) + 100 Klinik Bilimler (5 ders)</strong> olmak üzere toplam 200 sorudan oluşur.
          Aşağıdaki tablo her dersin sınav soru aralığını, BKA TUS çekirdek kart sayısını, son 6 TUS’taki (2024/1–2026/2 · 1.195 soru)
          çözüm desteğini ve ders bazlı çalışma odağını tek yerde gösterir.
        </p>
      </div>
      <a href="/referanslar/" class="text-link shrink-0">1.195 soruyu tek tek incele →</a>
    </div>

    <div class="guide-table-wrap" tabindex="0" role="region" aria-labelledby="branches-heading">
      <table class="guide-table">
        <caption class="sr-only">11 ÖSYM TUS branşında oturum soru sayısı, BKA kart hacmi, son 6 TUS çözüm desteği, konu kapsamı ve çalışma stratejisi</caption>
        <thead>
          <tr>
            <th scope="col">Branş (Grup)</th>
            <th scope="col">Sınav Sorusu</th>
            <th scope="col">BKA Kart / Alt Deste</th>
            <th scope="col">Çözüm Desteği (Son 6 TUS)</th>
            <th scope="col">Konu Kapsamı</th>
            <th scope="col">Çalışma Odağı</th>
          </tr>
        </thead>
        <tbody>
          {branchRows.map((b) => (
            <tr>
              <th scope="row">
                <a href={b.refHref} class="inline-flex items-center min-h-[2.75rem] -my-1.5 text-ink hover:text-teal underline decoration-line hover:decoration-teal underline-offset-4">
                  {b.ders}
                </a>
                <span class="block text-xs font-normal text-inkMuted mt-0.5">{b.group} · {b.priorityTag}</span>
              </th>
              <td data-col="Sınav Sorusu" class="tabular-nums whitespace-nowrap">{b.examQuestionsLabel}</td>
              <td data-col="BKA Kart / Alt Deste" class="tabular-nums whitespace-nowrap">
                {num(b.cards)} kart · {b.subdecks} alt deste
              </td>
              <td data-col="Çözüm Desteği (Son 6 TUS)" class="tabular-nums whitespace-nowrap">
                <strong class="text-ink">{pct(b.destekOran)}</strong>
                <span class="block text-xs text-inkMuted">{b.dogrudan} doğrudan + {b.dolayli} dolaylı / {b.soru}</span>
              </td>
              <td data-col="Konu Kapsamı" class="tabular-nums whitespace-nowrap">{pct(b.konuKapsamiOran)}</td>
              <td data-col="Çalışma Odağı" class="guide-col-focus text-inkMuted leading-relaxed">{b.focus}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="rounded-2xl border border-line bg-white p-5 sm:p-6 grid lg:grid-cols-12 gap-6 items-start">
      <div class="lg:col-span-7 space-y-2">
        <h3 class="display text-lg text-ink">Bu tablo çalışma planına nasıl çevrilir?</h3>
        <p class="text-sm text-inkMuted leading-relaxed">
          Son 6 TUS referans dağılımında <strong>Farmakoloji ({destekPct('Farmakoloji')})</strong>, <strong>Biyokimya ({destekPct('Biyokimya')})</strong>,
          <strong>Mikrobiyoloji ({destekPct('Mikrobiyoloji')})</strong> ve <strong>Pediatri ({destekPct('Pediatri')})</strong> çekirdek kartlarla en yüksek doğrudan/dolaylı çözüm
          desteğini verir; bu dersleri erken tura almak net tabanını hızlı sağlamlaştırır.
          <strong>Anatomi ({destekPct('Anatomi')})</strong>, <strong>Küçük Stajlar ({destekPct('Küçük Stajlar')})</strong> ve <strong>Genel Cerrahi ({destekPct('Genel Cerrahi')})</strong> ise
          kart tekrarına ek olarak görsel atlas, klinik algoritma ve çıkmış vaka soruları gerektirir.
        </p>
      </div>
      <div class="lg:col-span-5 text-xs text-inkMuted leading-relaxed space-y-2 lg:border-l lg:border-lineLight lg:pl-6">
        <p>
          <strong class="text-ink">Şeffaflık notu:</strong> Katalog 12 ders içerir (11 ÖSYM branşı + {karmaCourse ? `${num(karmaCourse.cards)} kartlık karma Deneme ve Soru` : 'karma Deneme ve Soru'});
          referans oranları 11 resmî TUS branşı üzerinden, <code>{refSummary.katalogCommit}</code> sürümünde yapay zekâ destekli ön değerlendirmeyle
          hesaplanmıştır. Bağımsız hekim editör kontrolü sürmektedir.
        </p>
        <p>
          <strong>2026/2 TUS ayrımı:</strong> Sınavdan 2 gün önceki sürümde (<code>{refSummary.preExam2026_2.commit}</code>)
          <strong>{refSummary.preExam2026_2.preExamEvet}/200</strong>, güncel katalogda <strong>{refSummary.preExam2026_2.supportedCurrent}/200</strong> çözüm desteği ve
          <strong>{refSummary.preExam2026_2.topicCoverage}/200</strong> konu kapsamı bulunur.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Puan hesaplama, ağırlıklar, baraj, YDS ve %5 kesinti -->
<section id="puan-ve-mevzuat" tabindex="-1" class="guide-section py-14 sm:py-20 bg-white border-b border-line" aria-labelledby="scoring-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 space-y-8">
    <div class="grid lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 space-y-4">
        <p class="guide-kicker">Puan Ağırlıkları &amp; Güncel Mevzuat</p>
        <h2 id="scoring-heading" class="display text-section tracking-tightest text-ink">
          TUS puanı nasıl hesaplanır? Süre, baraj, yabancı dil ve %5 kesinti
        </h2>
        <p class="text-inkMuted leading-relaxed">
          Her oturum <strong>100 soru ve 135 dakika</strong> sürer (Temel 135 dk + Klinik 135 dk = toplam 270 dk);
          <strong>4 yanlış 1 doğruyu götürür</strong> ve standart puanlar o dönemin Türkiye ortalaması ile
          standart sapması üzerinden ÖSYM tarafından hesaplanır. Resmî ağırlıklar çalışma önceliğini doğrudan belirler:
        </p>

        <dl class="grid sm:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-line bg-surfaceSoft p-5">
            <dt class="text-xs font-bold uppercase tracking-wider text-teal">Klinik Tıp Puanı (K)</dt>
            <dd class="display text-2xl text-ink mt-1.5">%50 Temel + %50 Klinik</dd>
            <dd class="text-xs text-inkMuted mt-1.5 leading-relaxed">
              Dahiliye, Pediatri, Cerrahi, Dermatoloji, Radyoloji gibi tüm klinik uzmanlıklar için Temel Bilimler puanın tam yarısıdır.
            </dd>
          </div>
          <div class="rounded-2xl border border-line bg-surfaceSoft p-5">
            <dt class="text-xs font-bold uppercase tracking-wider text-teal">Temel Tıp Puanı (T)</dt>
            <dd class="display text-2xl text-ink mt-1.5">%70 Temel + %30 Klinik</dd>
            <dd class="text-xs text-inkMuted mt-1.5 leading-relaxed">
              Tıbbi Biyokimya, Mikrobiyoloji, Patoloji, Farmakoloji, Anatomi ve Fizyoloji hedeflerinde Temel netleri ana ağırlığı taşır.
            </dd>
          </div>
        </dl>

        <ul class="space-y-2 text-sm text-inkMuted leading-relaxed list-disc pl-5">
          <li><strong class="text-ink">45,000 puan barajı:</strong> Tercih yapabilmek için ilgili puan türünde (T veya K) en az 45 puan almak gerekir.</li>
          <li><strong class="text-ink">Yabancı dil şartı (erken hallet):</strong> Son 5 yıl içinde geçerli YDS, e-YDS veya TIPDİL sınavlarından en az <strong>50 puan</strong> (veya ÖSYM eşdeğerliği) aranır; geçerliliği dolan veya sona bırakılan dil puanı yüksek TUS puanıyla yerleşmeyi engelleyebilir.</li>
          <li><strong class="text-ink">%5 puan kesintisi (× 0,95):</strong> Uzmanlık eğitimine devam ederken sınava girenler, istifa edenler veya yerleşip süresi içinde başlamayanlar için takip eden ilk sınavda mesleki bilgi puanından %5 düşülür.</li>
        </ul>
      </div>

      <div class="lg:col-span-5 rounded-2xl border border-line bg-surfaceSoft p-5 sm:p-6 space-y-4">
        <h3 class="display text-lg text-ink">%5 kesinti hedef neti nasıl değiştirir?</h3>
        <p class="text-sm text-inkMuted leading-relaxed">
          Aşağıdaki satırlar son dönem dağılımlarına dayanan yaklaşık ±1,5 puanlık planlama rehberidir; resmî yerleştirme belgesi yerine geçmez.
          Kendi doğru/yanlışlarınla anlık denemek için hesaplayıcıyı açabilirsin.
        </p>
        <div class="guide-table-wrap" tabindex="0" role="region" aria-label="Hedef TUS Klinik puanına göre kesintisiz ve %5 kesintili yaklaşık net tablosu">
          <table class="guide-table guide-table-compact">
            <caption class="sr-only">Hedef TUS Klinik puanı için kesintisiz ve %5 kesintili yaklaşık toplam net karşılaştırması</caption>
            <thead>
              <tr>
                <th scope="col">Hedef K Puanı</th>
                <th scope="col">Kesintisiz Net</th>
                <th scope="col">%5 Kesintiyle Gereken</th>
              </tr>
            </thead>
            <tbody class="tabular-nums">
              {scoreBenchmarks.map((row) => (
                <tr>
                  <th scope="row">{row.target}</th>
                  <td data-col="Kesintisiz Net">{row.noPenaltyNet}</td>
                  <td data-col="%5 Kesintiyle Gereken">{row.penaltyRaw} ({row.penaltyNet})</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <a href="/puan-hesapla/" class="button-primary w-full">
          TUS Puan &amp; Hedef Net Hesaplayıcıyı Aç →
        </a>
      </div>
    </div>
  </div>
</section>
