---
import { SITE } from '../config';
import { NAV_GROUPS, NAV_LINK_IDS, page, link } from '../data/pages';
import SiteSearch from './SiteSearch.astro';
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (path: string) => currentPath === path || currentPath.startsWith(path + '/');
const groups = NAV_GROUPS.map((group) => {
  const items = group.items.map((item) => ({ ...page(item.id), hint: item.hint })).filter((p) => p.published);
  return { ...group, items, active: items.some((item) => isCurrent(item.path)) };
});
const links = NAV_LINK_IDS.map(page);
---
<header class="site-header">
  <div class="site-container header-inner">
    <a href="/" class="brand" aria-label="TusAnkiM — Ana sayfa">
      <img src="/images/app-mark.png" alt="" width="36" height="36" />
      <span>TusAnkiM</span>
    </a>
    <nav aria-label="Ana menü" class="desktop-nav">
      <ul role="list" class="nav-list">
        {groups.map((group) => (
          <li class="nav-group" data-nav-group>
            <button
              type="button"
              class="nav-trigger"
              aria-expanded="false"
              aria-controls={`nav-panel-${group.id}`}
              data-active={group.active ? '' : undefined}
            >
              {group.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div id={`nav-panel-${group.id}`} class="nav-panel" hidden>
              <ul role="list">
                {group.items.map((item) => (
                  <li>
                    <a href={link(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                      <strong>{item.navLabel}</strong>
                      <span>{item.hint}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
        {links.map((item) => (
          <li><a href={link(item.path)} class="nav-trigger" aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.navLabel}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <button id="site-search-open" type="button" aria-label="Sitede ara" aria-haspopup="dialog" aria-controls="site-search" aria-keyshortcuts="Control+K Meta+K" hidden>
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 4 4" /></svg>
      </button>
      <a href={SITE.webAppUrl} target="_blank" rel="noopener noreferrer" class="button-primary">Ücretsiz dene</a>
      <button id="mobile-nav-open" type="button" aria-label="Menüyü aç" aria-haspopup="dialog" aria-controls="mobile-nav-dialog">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
</header>
<dialog id="mobile-nav-dialog" closedby="any" aria-labelledby="mobile-nav-title" class="mobile-drawer">
  <div class="drawer-heading">
    <h2 id="mobile-nav-title">TusAnkiM</h2>
    <button id="mobile-nav-close" type="button" aria-label="Menüyü kapat">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
  </div>
  <nav aria-label="Mobil menü">
    <a href="/" class="drawer-link" aria-current={currentPath === '/' ? 'page' : undefined}>Ana sayfa</a>
    {groups.map((group) => (
      <details class="drawer-group" open={group.active}>
        <summary>{group.label}</summary>
        <ul role="list">
          {group.items.map((item) => (
            <li><a href={link(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.navLabel}</a></li>
          ))}
        </ul>
      </details>
    ))}
    {links.map((item) => <a href={link(item.path)} class="drawer-link" aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.navLabel}</a>)}
  </nav>
  <a href={SITE.webAppUrl} target="_blank" rel="noopener noreferrer" class="button-primary drawer-action">Uygulamayı dene</a>
</dialog>
<SiteSearch />
<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: #fff; border-bottom: 1px solid #e9ecee; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: clamp(.75rem, 2vw, 2rem); height: var(--site-header-height); }
  .brand { display: inline-flex; align-items: center; gap: .625rem; min-height: 2.75rem; font-size: 1.125rem; font-weight: 600; letter-spacing: -.035em; }
  .brand img { width: 2.25rem; height: 2.25rem; object-fit: contain; }
  .desktop-nav { margin-left: auto; }
  .nav-list { display: flex; align-items: center; gap: clamp(.25rem, 1vw, .75rem); }
  .nav-group { position: relative; }
  .nav-trigger {
    display: inline-flex; align-items: center; gap: .3rem; width: auto; height: auto; min-height: 2.75rem;
    padding-inline: .625rem; border-radius: .5rem; font-size: .875rem; color: #596166; white-space: nowrap;
  }
  .nav-trigger svg { transition: rotate 150ms cubic-bezier(.23, 1, .32, 1); }
  .nav-trigger[aria-expanded="true"] svg { rotate: 180deg; }
  .nav-trigger[aria-expanded="true"], .nav-trigger[data-active], .nav-trigger[aria-current="page"] { color: #0e7469; }
  .nav-trigger[data-active], .nav-trigger[aria-current="page"] { font-weight: 600; }
  .nav-trigger:focus-visible, .nav-panel a:focus-visible { outline: 2px solid #0e7469; outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) {
    .nav-trigger:hover { color: #0e7469; background: #f3f8f7; }
  }
  .nav-panel {
    position: absolute; top: calc(100% + .375rem); left: 50%; translate: -50% 0; z-index: 50;
    width: 20rem; padding: .5rem; background: #fff; border: 1px solid #dde1e4; border-radius: .875rem;
    box-shadow: 0 1rem 2.5rem #16332e1f; transform-origin: top center;
  }
  .nav-panel a { display: grid; gap: .125rem; padding: .625rem .75rem; border-radius: .5rem; min-height: 2.75rem; }
  .nav-panel strong { font-size: .9375rem; font-weight: 600; color: #24292c; }
  .nav-panel span { font-size: .8125rem; color: #596166; line-height: 1.4; }
  .nav-panel a[aria-current="page"] { background: #eaf5f2; }
  .nav-panel a[aria-current="page"] strong { color: #0e7469; }
  @media (hover: hover) and (pointer: fine) {
    .nav-panel a:hover { background: #f3f8f7; }
    .nav-panel a:hover strong { color: #0e7469; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-panel:not([hidden]) { animation: nav-panel-enter 180ms cubic-bezier(.23, 1, .32, 1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-trigger svg { transition: none; }
    .nav-panel:not([hidden]) { animation: nav-panel-fade 150ms ease-out; }
  }
  @keyframes nav-panel-enter { from { opacity: 0; scale: .95; } }
  @keyframes nav-panel-fade { from { opacity: 0; } }
  .header-actions { display: flex; align-items: center; gap: .5rem; }
  .header-actions .button-primary { white-space: nowrap; }
  .header-actions button, .drawer-heading button { display: grid; place-items: center; flex: 0 0 2.75rem; width: 2.75rem; height: 2.75rem; border-radius: .5rem; }
  #mobile-nav-open { display: none; }
  #site-search-open { color: #344344; }
  #site-search-open:focus-visible { background: #eaf5f2; color: #0e7469; }
  @media (hover: hover) and (pointer: fine) {
    #site-search-open:hover { background: #eaf5f2; color: #0e7469; }
  }
  .mobile-drawer { margin: 0 0 0 auto; padding: 1.25rem; width: min(22rem, 90vw); height: 100%; max-height: none; background: #fff; color: #24292c; border-left: 1px solid #dde1e4; overflow-y: auto; }
  .mobile-drawer :focus-visible,
  #mobile-nav-open:focus-visible {
    outline: 2px solid #0e7469;
    outline-offset: 2px;
    box-shadow: 0 0 0 4px #fff;
  }
  @media (prefers-reduced-motion: no-preference) {
    #mobile-nav-open, #mobile-nav-close, #site-search-open {
      transition: scale 150ms cubic-bezier(.23, 1, .32, 1);
    }
    #mobile-nav-open:active, #mobile-nav-close:active, #site-search-open:active { scale: .97; }
    .mobile-drawer[open] { animation: drawer-enter 200ms cubic-bezier(.23, 1, .32, 1); }
    .mobile-drawer[open]::backdrop { animation: drawer-backdrop-enter 200ms cubic-bezier(.23, 1, .32, 1); }

    @supports (overlay: auto) and (transition-behavior: allow-discrete) {
      .mobile-drawer {
        opacity: 0;
        translate: 1rem 0;
        transition: opacity 160ms, translate 160ms, display 160ms allow-discrete, overlay 160ms allow-discrete;
        transition-timing-function: cubic-bezier(.23, 1, .32, 1);
      }
      .mobile-drawer[open] { animation: none; opacity: 1; translate: 0; transition-duration: 200ms; }
      .mobile-drawer::backdrop { opacity: 0; transition: opacity 160ms, display 160ms allow-discrete, overlay 160ms allow-discrete; }
      .mobile-drawer[open]::backdrop { animation: none; opacity: 1; transition-duration: 200ms; }
      @starting-style {
        .mobile-drawer[open] { opacity: 0; translate: 1rem 0; }
        .mobile-drawer[open]::backdrop { opacity: 0; }
      }
    }
  }
  @keyframes drawer-enter { from { opacity: 0; translate: 1rem 0; } }
  @keyframes drawer-backdrop-enter { from { opacity: 0; } }
  .drawer-heading { display: flex; align-items: center; justify-content: space-between; padding-bottom: 1rem; border-bottom: 1px solid #dde1e4; }
  .drawer-heading h2 { font-weight: 600; font-size: 1.125rem; letter-spacing: -.03em; }
  .mobile-drawer nav { padding-block: .5rem 2rem; }
  .drawer-link, .drawer-group summary { display: flex; align-items: center; min-height: 3.5rem; border-bottom: 1px solid #e9ecee; font-size: 1rem; }
  .drawer-group summary { justify-content: space-between; cursor: pointer; list-style: none; font-weight: 500; }
  .drawer-group summary::-webkit-details-marker { display: none; }
  .drawer-group summary::after {
    content: ""; width: .5rem; height: .5rem; margin-right: .375rem;
    border-right: 2px solid #596166; border-bottom: 2px solid #596166; rotate: 45deg; translate: 0 -.125rem;
  }
  .drawer-group[open] summary::after { rotate: 225deg; translate: 0 .125rem; }
  .drawer-group ul { padding-block: .25rem .5rem; border-bottom: 1px solid #e9ecee; }
  .drawer-group li a { display: flex; align-items: center; min-height: 2.75rem; padding-left: .875rem; font-size: .9375rem; color: #3b4246; }
  .mobile-drawer [aria-current="page"] { color: #0e7469; font-weight: 600; }
  .drawer-action { width: 100%; }
  @media (max-width: 860px) {
    .header-inner { gap: .5rem; }
    .header-actions { gap: .25rem; }
    .desktop-nav { display: none; }
    #mobile-nav-open { display: grid; margin-right: -.5rem; }
    .brand { gap: .375rem; font-size: 1rem; }
    .brand img { width: 1.875rem; height: 1.875rem; }
    .header-actions .button-primary { padding-inline: .875rem; font-size: .875rem; }
  }
  @media (max-width: 359px) {
    .brand img { display: none; }
    .header-actions .button-primary { padding-inline: .625rem; }
  }
</style>
<script>
  // Desktop menu groups: a click opens one panel, Escape, a click elsewhere or
  // moving focus out of the group closes it.
  const groups = [...document.querySelectorAll<HTMLElement>('[data-nav-group]')];
  const parts = groups.map((group) => ({
    group,
    trigger: group.querySelector<HTMLButtonElement>('button')!,
    panel: group.querySelector<HTMLElement>('.nav-panel')!,
  }));
  const setOpen = (part: (typeof parts)[number], open: boolean) => {
    part.trigger.setAttribute('aria-expanded', String(open));
    part.panel.hidden = !open;
  };
  const closeAll = (except?: (typeof parts)[number]) => parts.forEach((part) => { if (part !== except) setOpen(part, false); });
  parts.forEach((part) => {
    part.trigger.addEventListener('click', () => {
      const open = part.trigger.getAttribute('aria-expanded') !== 'true';
      closeAll(part);
      setOpen(part, open);
    });
    part.group.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || part.panel.hidden) return;
      setOpen(part, false);
      part.trigger.focus();
    });
    part.group.addEventListener('focusout', (event) => {
      if (!part.group.contains(event.relatedTarget as Node | null)) setOpen(part, false);
    });
  });
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('[data-nav-group]')) closeAll();
  });

  const navOpen = document.getElementById('mobile-nav-open') as HTMLButtonElement;
  const navClose = document.getElementById('mobile-nav-close') as HTMLButtonElement;
  const navDialog = document.getElementById('mobile-nav-dialog') as HTMLDialogElement;
  navOpen.addEventListener('click', () => { if (!navDialog.open) navDialog.showModal(); });
  navClose.addEventListener('click', () => navDialog.close());
  navDialog.addEventListener('close', () => {
    if (navDialog.open || !navOpen.getClientRects().length) return;
    const active = document.activeElement;
    if (active === document.body || navDialog.contains(active)) navOpen.focus({ preventScroll: true });
  });
  navDialog.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) navDialog.close();
  });
  // Light-dismiss fallback for iOS versions without closedby support.
  if (!('closedBy' in HTMLDialogElement.prototype)) {
    let pressedOutside = false;
    const outside = (event: PointerEvent) => {
      const rect = navDialog.getBoundingClientRect();
      return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
    };
    navDialog.addEventListener('pointerdown', (event) => { pressedOutside = outside(event); });
    navDialog.addEventListener('pointerup', (event) => { if (pressedOutside && outside(event)) navDialog.close(); });
  }
  matchMedia('(min-width: 861px)').addEventListener('change', (event) => {
    if (event.matches && navDialog.open) navDialog.close();
    if (!event.matches) closeAll();
  });
</script>
