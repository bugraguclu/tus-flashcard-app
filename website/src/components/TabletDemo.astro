---
// The app's deck list and study screen in a tablet frame. The deck tree is drawn here; the cards
// load from /data/demo-decks.json so the home page HTML stays inside its budget.
import demoDecks from '../data/generated/demo-decks.json';
import IpadFrame from './demo/IpadFrame.astro';
import DemoDeckList, { type DeckNode, type DemoDeckCard } from './demo/DemoDeckList.astro';
import DemoControls from './demo/DemoControls.astro';
import DemoStudyScreen from './demo/DemoStudyScreen.astro';

const decks = demoDecks.decks as DeckNode[];
const cards = demoDecks.cards as DemoDeckCard[];
---
<div id="demo" data-demo-simulator data-decks-url="/data/demo-decks.json" aria-busy="true">
  <IpadFrame>
    <DemoDeckList decks={decks} cards={cards} />
    <DemoStudyScreen />
    <DemoControls prefix="tablet-demo" />
  </IpadFrame>
  <p class="mt-3 text-sm text-inkMuted">
    <button type="button" data-demo-retry hidden class="text-link">Kartlar yüklenemedi. Yeniden yükle</button>
  </p>
  <p class="mt-3 text-sm text-inkMuted">{cards.length} katalogdan uyarlanmış örnek · Yanıtlar saklanmaz; aralık etiketleri örnektir. Tıbbi içerik için bağımsız hekim editör onayı tamamlanmamıştır.</p>
  <p data-demo-live aria-live="polite" class="sr-only"></p>
</div>



<script>
  import { initDemoSimulators } from '../scripts/demoSimulator';
  initDemoSimulators();
</script>
