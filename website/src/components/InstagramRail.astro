---
import instagram from '../data/instagram.json';
import { SOCIAL } from '../config';
import Scroller from './Scroller.astro';

const igAccount = SOCIAL.find((s) => s.icon === 'instagram');
---
<section class="py-16 sm:py-20 bg-white" aria-labelledby="ig-rail-heading">
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div class="max-w-2xl">
        <div class="section-num"><span lang="en">Instagram</span> &amp; Uygulama Kullanımı</div>
        <h2 id="ig-rail-heading" class="display text-section tracking-tightest mt-2 text-ink">
          {instagram.heading}
        </h2>
        <p class="text-inkMuted mt-2 leading-relaxed">{instagram.lead}</p>
      </div>
      {igAccount && (
        <a
          href={igAccount.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 shrink-0 min-h-[2.75rem] px-4 rounded-full border border-line bg-surfaceSoft text-xs font-semibold text-ink hover:border-tealGraphic hover:text-teal transition"
        >
          <span>{igAccount.handle} Takip Et ↗</span>
        </a>
      )}
    </div>

    <div class="relative" data-scroller>
      <div class="flex items-center justify-end gap-2 mb-3">
        <button
          type="button"
          data-scroller-prev
          aria-label="Önceki ipuçları"
          hidden
          class="w-11 h-11 rounded-full border border-line bg-white text-ink hover:border-tealGraphic hover:text-teal grid place-items-center transition cursor-pointer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
        <button
          type="button"
          data-scroller-next
          aria-label="Sonraki ipuçları"
          hidden
          class="w-11 h-11 rounded-full border border-line bg-white text-ink hover:border-tealGraphic hover:text-teal grid place-items-center transition cursor-pointer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </div>

      <div
        data-scroller-track
        data-drag-scroll
        class="flex gap-4 sm:gap-5 pb-3 scroll-pl-1"
      >
        {instagram.posts.map((post) => (
          <article class="shrink-0 w-[275px] sm:w-[320px] snap-start rounded-2xl border border-line bg-white overflow-hidden lift flex flex-col">
            <div class="aspect-[4/3] bg-surfaceSoft border-b border-lineLight overflow-hidden">
              <img
                src={post.image}
                alt={post.title}
                width="400"
                height="300"
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-5 flex flex-col flex-1">
              <span class="inline-block self-start rounded-full bg-tint px-2.5 py-0.5 text-[11px] font-bold text-teal">
                {post.tag}
              </span>
              <h3 class="display text-base text-ink mt-2.5 leading-snug">{post.title}</h3>
              <p class="text-xs text-inkMuted mt-2 leading-relaxed flex-1">{post.caption}</p>
              <a
                href={post.helpHref}
                class="inline-flex items-center gap-1 mt-3 min-h-[2.75rem] py-2 text-xs font-semibold text-teal hover:text-tealDark underline underline-offset-2"
              >
                Adım adım rehber →
              </a>
            </div>
          </article>
        ))}
      </div>

      <div data-scroller-bar data-thumb-max="104" hidden class="mt-2">
        <div data-scroller-thumb></div>
      </div>
    </div>
  </div>
</section>
<Scroller />
