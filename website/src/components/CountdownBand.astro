---
import examsData from '../data/exams.json';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<section
  class={`border-y border-line bg-white ${compact ? 'py-8' : 'py-10 sm:py-12'}`}
  aria-labelledby="tus-countdown-heading"
  data-countdown-root
  data-exams={JSON.stringify(examsData.exams)}
>
  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <div class="max-w-xl">
        <div class="flex flex-wrap items-center gap-2">
          <span class="section-num">2027 TUS Sınav Geri Sayımı</span>
          <span
            data-cd-badge
            class="inline-flex items-center rounded-full bg-tint px-2.5 py-0.5 text-[11px] font-bold text-teal"
          >
            Sınav Öncesi Hazırlık
          </span>
        </div>
        <h2 id="tus-countdown-heading" class="display text-subsection tracking-tightest mt-2 text-ink" data-cd-title>
          2027-TUS 1. Dönem'e kaç gün kaldı?
        </h2>
        <p class="text-sm text-inkMuted mt-1.5" data-cd-sub>
          Başvuru: 2–10 Şubat 2027 · Sınav: 27 Mart 2027 · Sonuç: 22 Nisan 2027
        </p>
      </div>

      <!-- Exam selector pills + live clock -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <div class="inline-flex rounded-full border border-line bg-surface p-1" role="group" aria-label="Hedef TUS dönemi">
          {examsData.exams.map((ex, idx) => (
            <button
              type="button"
              data-cd-tab={ex.id}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              class={`px-3.5 py-1.5 min-h-[2.75rem] rounded-full text-xs font-semibold transition whitespace-nowrap cursor-pointer ${
                idx === 0 ? 'bg-white text-teal shadow-sm' : 'text-inkMuted hover:text-ink'
              }`}
            >
              {ex.shortName}
            </button>
          ))}
        </div>

        <div class="flex items-center gap-2.5" data-cd-numbers>
          <div class="min-w-[4.5rem] rounded-2xl border border-line bg-surfaceSoft px-3 py-2 text-center">
            <div class="display text-2xl text-teal tabular-nums" data-cd-days>—</div>
            <div class="text-[11px] font-semibold text-inkMuted">Gün</div>
          </div>
          <div class="min-w-[4rem] rounded-2xl border border-line bg-surfaceSoft px-3 py-2 text-center">
            <div class="display text-2xl text-ink tabular-nums" data-cd-hours>—</div>
            <div class="text-[11px] font-semibold text-inkMuted">Saat</div>
          </div>
          <div class="min-w-[4rem] rounded-2xl border border-line bg-surfaceSoft px-3 py-2 text-center">
            <div class="display text-2xl text-ink tabular-nums" data-cd-mins>—</div>
            <div class="text-[11px] font-semibold text-inkMuted">Dakika</div>
          </div>
        </div>
      </div>
    </div>

    <p class="sr-only" aria-live="polite" data-cd-announce></p>

    <div class="mt-4 pt-3 border-t border-lineLight flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-inkMuted">
      <span data-cd-pace>
        9.575 kartı sınavdan önce bitirmek için günlük ideal yeni kart temposunu aşağıdaki FSRS-6 hesaplayıcıyla planlayın.
      </span>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 shrink-0">
        <a href="/#calisma-dozu" class="inline-flex items-center min-h-[2.75rem] py-2 font-semibold text-teal hover:text-tealDark underline underline-offset-2">
          Günlük Dozu Hesapla →
        </a>
        <a href="/puan-hesapla/" class="inline-flex items-center min-h-[2.75rem] py-2 font-semibold text-teal hover:text-tealDark underline underline-offset-2">
          TUS Puan Hesaplayıcı →
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-countdown-root]').forEach((root) => {
    if (root.dataset.cdReady) return;
    root.dataset.cdReady = '1';

    type Exam = {
      id: string;
      name: string;
      shortName: string;
      examDate: string;
      examDateLabel: string;
      applicationLabel: string;
      resultDate: string;
      resultLabel: string;
      preferenceWindowDays: number;
    };

    const exams: Exam[] = JSON.parse(root.dataset.exams || '[]');
    if (!exams.length) return;

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-cd-tab]')];
    const badgeEl = root.querySelector<HTMLElement>('[data-cd-badge]');
    const titleEl = root.querySelector<HTMLElement>('[data-cd-title]');
    const subEl = root.querySelector<HTMLElement>('[data-cd-sub]');
    const paceEl = root.querySelector<HTMLElement>('[data-cd-pace]');
    const daysEl = root.querySelector<HTMLElement>('[data-cd-days]');
    const hoursEl = root.querySelector<HTMLElement>('[data-cd-hours]');
    const minsEl = root.querySelector<HTMLElement>('[data-cd-mins]');
    const announceEl = root.querySelector<HTMLElement>('[data-cd-announce]');

    // Pick first upcoming (or active preference window) exam by default
    const nowInit = Date.now();
    let activeId =
      exams.find((e) => new Date(e.examDate).getTime() + e.preferenceWindowDays * 864e5 > nowInit)?.id ||
      exams[exams.length - 1].id;

    function selectExam(id: string, { focus = false, announce = false } = {}) {
      activeId = id;
      tabs.forEach((btn) => {
        const on = btn.dataset.cdTab === id;
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        btn.classList.toggle('bg-white', on);
        btn.classList.toggle('text-teal', on);
        btn.classList.toggle('shadow-sm', on);
        btn.classList.toggle('text-inkMuted', !on);
        if (on && focus) btn.focus({ preventScroll: true });
      });
      paint();
      if (announce && announceEl && titleEl) {
        announceEl.textContent = titleEl.textContent || '';
      }
    }

    function paint() {
      const ex = exams.find((e) => e.id === activeId) || exams[0];
      const now = Date.now();
      const target = new Date(ex.examDate).getTime();
      const resultTs = new Date(ex.resultDate).getTime();
      const diffMs = target - now;
      const dayMs = 86_400_000;

      if (subEl) {
        subEl.textContent = `Başvuru: ${ex.applicationLabel} · Sınav: ${ex.examDateLabel} · Sonuç: ${ex.resultLabel}`;
      }

      if (diffMs > dayMs * 0.25) {
        // Pre-exam countdown state
        const days = Math.floor(diffMs / dayMs);
        const hours = Math.floor((diffMs % dayMs) / 3_600_000);
        const mins = Math.floor((diffMs % 3_600_000) / 60_000);
        if (badgeEl) {
          badgeEl.textContent = 'Sınav Öncesi Hazırlık';
          badgeEl.className = 'inline-flex items-center rounded-full bg-tint px-2.5 py-0.5 text-[11px] font-bold text-teal';
        }
        if (titleEl) titleEl.textContent = `${ex.name} sınavına ${days} gün kaldı`;
        if (daysEl) daysEl.textContent = String(days);
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minsEl) minsEl.textContent = String(mins).padStart(2, '0');
        if (paceEl) {
          const studyDays = Math.max(30, days - 30);
          const recNew = Math.min(140, Math.max(20, Math.ceil(9575 / studyDays / 10) * 10));
          paceEl.textContent = `Son 30 günü sadece tekrar ve denemelere bırakmak için 9.575 kartta önerilen tempo: günde ~${recNew} yeni kart.`;
        }
      } else if (diffMs >= -dayMs) {
        // Exam day state
        if (badgeEl) {
          badgeEl.textContent = 'Sınav Günü';
          badgeEl.className = 'inline-flex items-center rounded-full bg-warmTint px-2.5 py-0.5 text-[11px] font-bold text-warm';
        }
        if (titleEl) titleEl.textContent = `${ex.name} bugün — tüm adaylara başarılar!`;
        if (daysEl) daysEl.textContent = '0';
        if (hoursEl) hoursEl.textContent = '00';
        if (minsEl) minsEl.textContent = '00';
        if (paceEl) {
          paceEl.textContent = 'Sınav sonrası puan ve hedef net hesabınızı Puan Hesaplayıcı sayfasından hemen yapabilirsiniz.';
        }
      } else {
        // Post-exam & preference period state
        const toResult = Math.max(0, Math.ceil((resultTs - now) / dayMs));
        if (badgeEl) {
          badgeEl.textContent = 'Sınav Sonrası & Tercih Dönemi';
          badgeEl.className = 'inline-flex items-center rounded-full bg-warmTint px-2.5 py-0.5 text-[11px] font-bold text-warm';
        }
        if (titleEl) {
          titleEl.textContent = toResult > 0
            ? `${ex.name} tamamlandı — sonuçlara ${toResult} gün`
            : `${ex.name} sonuç ve tercih dönemi`;
        }
        if (daysEl) daysEl.textContent = String(toResult);
        if (hoursEl) hoursEl.textContent = '00';
        if (minsEl) minsEl.textContent = '00';
        if (paceEl) {
          paceEl.textContent = 'Netlerinize göre tahmini TUS puanınızı hesaplayın ve güncel referans analizlerimizi inceleyin.';
        }
      }
    }

    tabs.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.cdTab) selectExam(btn.dataset.cdTab, { announce: true });
      });
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const next = (idx + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
          const id = tabs[next].dataset.cdTab;
          if (id) selectExam(id, { focus: true, announce: true });
        }
      });
    });

    selectExam(activeId);
    window.setInterval(paint, 60_000);
  });
</script>
