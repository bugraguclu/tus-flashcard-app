---
import { SHOW_SPONSORS } from '../config';
import sponsors from '../data/sponsors.json';

interface SponsorItem {
  name: string;
  role?: string;
  logo?: string;
  url?: string;
}

const items = (sponsors.items ?? []) as SponsorItem[];
---
{SHOW_SPONSORS && items.length > 0 && (
  <section class="border-y border-line bg-surfaceSoft" aria-labelledby="sponsors-heading">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-12">
      <div class="text-center max-w-xl mx-auto">
        <div class="section-num">{sponsors.kicker}</div>
        <h2 id="sponsors-heading" class="display text-subsection tracking-tightest mt-2 text-ink">
          {sponsors.heading}
        </h2>
        <p class="text-sm text-inkMuted mt-2">{sponsors.lead}</p>
      </div>
      <ul class="mt-8 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 items-center">
        {items.map((item) => (
          <li class="rounded-2xl border border-line bg-white p-4 text-center">
            {item.url ? (
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="block font-semibold text-sm text-ink hover:text-teal">
                {item.name}
                {item.role && <span class="block text-xs font-normal text-inkMuted mt-1">{item.role}</span>}
              </a>
            ) : (
              <div class="font-semibold text-sm text-ink">
                {item.name}
                {item.role && <span class="block text-xs font-normal text-inkMuted mt-1">{item.role}</span>}
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
