---
import DemoControls from './demo/DemoControls.astro';
import IpadFrame from './demo/IpadFrame.astro';
import DemoIcons from './demo/DemoIcons.astro';
import DemoDeckList from './demo/DemoDeckList.astro';
import demoCards from '../data/generated/demo-cards.json';
import { INITIAL_FSRS_INTERVALS } from '../lib/demoFsrs';
const first = demoCards[0];
---
<section id="demo" class="demo" aria-labelledby="demo-heading" data-live-demo data-demo-page="decks" data-card-count={demoCards.length} data-cards-url="/data/demo-cards.json">
  <h2 id="demo-heading" class="sr-only">Örnek desteler ve kart çalışma</h2>
  <IpadFrame>
  <div class="demo-app-shell">
  <div class="demo-reviewer">
  <DemoDeckList decks={[]} cards={[]} />
  <div data-demo-screen="study" hidden class="demo-study-view">
  <div class="demo-toolbar">
    <button type="button" data-demo-back class="demo-menu-button" aria-label="Destelere dön"><DemoIcons name="back" /></button>
    <button type="button" data-demo-menu disabled class="demo-menu-button" aria-label="Uygulama menüsünü aç" aria-haspopup="dialog"><DemoIcons name="menu" /></button>
    <button type="button" data-demo-scope disabled class="demo-home-scope" aria-label="Deste seç" aria-haspopup="dialog">
      <span data-demo-deck-title>TUS Kartları</span>
      <span class="demo-home-counts" aria-label="Yeni, öğrenme ve tekrar kartları">
        <span data-demo-new-count class="is-current">{demoCards.length}</span><span data-demo-learn-count>0</span><span>0</span>
        <DemoIcons name="chevron-down" size={20} />
      </span>
    </button>
    <button type="button" data-home-undo disabled class="demo-home-undo" aria-label="Son değerlendirmeyi geri al"><DemoIcons name="undo" /></button>
  </div>
  <div class="demo-card-scroll" data-demo-scroll>
  <div class="demo-context"><span data-demo-course>{first.ders}</span><DemoIcons name="chevron-right" size={15} /><span>Örnek kart</span></div>
  <div class="demo-paper">
    <p class="demo-instruction">Boşluğu tahmin et, cevabı aç.</p>
    <div data-demo-body class="demo-question" tabindex="0" aria-label="Örnek çalışma kartı" aria-keyshortcuts="Space Enter ArrowLeft ArrowRight">
      {first.parts.map((part) => part.type === 'cloze' && part.index === (first.activeCloze ?? 1)
        ? <span class="demo-cloze">[…]</span>
        : <span>{part.type === 'cloze' ? part.answer : part.value}</span>)}
    </div>
    <p data-demo-extra hidden class="demo-extra"></p>
  </div>
  </div>
    <div class="demo-answer">
      <div data-demo-reveal-wrap>
        <button type="button" data-demo-reveal disabled class="button-primary">Cevabı göster</button>
      </div>
      <div data-demo-grades hidden>
        <p class="demo-instruction">Ne kadar kolay hatırladın?</p>
        <div class="demo-grades">
          {[
            ['again', 'Tekrar'], ['hard', 'Zor'], ['good', 'İyi'], ['easy', 'Kolay'],
          ].map(([value, label]) => <button type="button" data-demo-grade={value}><span data-demo-interval={value} class="demo-grade-interval">{INITIAL_FSRS_INTERVALS[value as keyof typeof INITIAL_FSRS_INTERVALS]}</span><span>{label}</span></button>)}
        </div>
      </div>
    </div>
  </div>
  <DemoControls prefix="home-demo" />
  </div>
  </div>
  </IpadFrame>
  <p class="demo-footnote">11 kart örneği · Güncel katalogdan uyarlanmıştır. İlgili bilgi, ön değerlendirmede sınav öncesi <code>a78ae1f</code> sürümünde de var olarak işaretlenmiştir. Bu denemedeki yanıtlar saklanmaz. Süreler varsayılan FSRS-6 başlangıç örneğidir; kişisel FSRS hesabı yapılmaz.</p>
  <p data-demo-status role="status" class="demo-footnote">Kartlar yükleniyor…</p>
  <button type="button" data-demo-retry hidden class="text-link">Yeniden yükle</button>
  <noscript><p class="demo-footnote">Kartları denemek için JavaScript’i açabilir veya referans kayıtlarını inceleyebilirsin.</p></noscript>
  <p data-demo-live aria-live="polite" class="sr-only"></p>
</section>



<script>
  import { initLiveCardDemos } from '../scripts/liveCardDemo';
  initLiveCardDemos();
</script>
