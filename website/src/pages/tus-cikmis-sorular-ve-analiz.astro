---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config';
import { getBranches } from '../data/branches';
import refSummary from '../data/generated/references-summary.json';
import { breadcrumbList } from '../lib/schema';
import { effectiveDate, formatTrDate, pageSources } from '../lib/lastmod';

const origin = new URL(Astro.site!).origin;
const modDate = effectiveDate(pageSources('cikmis-sorular'));
const modLabel = formatTrDate(modDate);
const branches = getBranches();

const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'TUS Çıkmış Sorular ve Analiz', path: '/tus-cikmis-sorular-ve-analiz' },
]);

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': origin + '/tus-cikmis-sorular-ve-analiz/#dataset',
  name: 'Son 6 TUS (2024/1–2026/2) Soru Dağılımı ve BKA Referans Analizi',
  description:
    'Son 6 TUS dönemindeki 1.195 sorunun 11 ÖSYM TUS branşı ve sınav dönemine göre soru dağılımı, çözüm desteği (%43,6) ve konu kapsamı (%92,7) analizi. Telifli ÖSYM soru metni yayımlanmaz.',
  url: origin + '/tus-cikmis-sorular-ve-analiz/',
  inLanguage: 'tr-TR',
  isAccessibleForFree: true,
  dateModified: modDate,
  creator: { '@id': origin + '/#organization' },
  publisher: { '@id': origin + '/#organization' },
};

const fmtInt = (n: number) => n.toLocaleString('tr-TR');
const fmtDec1 = (n: number) => n.toFixed(1).replace('.', ',');
const pre = refSummary.preExam2026_2;
---
<Layout
  title="TUS Çıkmış Sorular Dağılımı ve Referans Analizi | TusAnkiM"
  description="Son 6 TUS (2024/1–2026/2, 1.195 soru) ÖSYM soru dağılımı ve BKA referans analizi: %43,6 çözüm desteği, %92,7 konu kapsamı ve 11 branş tablosu."
  modifiedTime={modDate}
  schema={[crumbs, datasetSchema]}
>
  <section class="bg-surfaceSoft border-b border-line py-10 sm:py-14">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <nav aria-label="Sayfa konumu" class="mb-3">
        <ol class="flex flex-wrap items-center gap-y-1 text-xs text-inkMuted">
          <li class="inline-flex items-center">
            <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
          </li>
          <li class="inline-flex items-center">
            <span aria-hidden="true" class="mx-2">/</span>
            <a href="/tus-cikmis-sorular-ve-analiz/" aria-current="page" class="inline-flex items-center min-h-[2.75rem] py-2 text-ink font-semibold">
              TUS Çıkmış Sorular ve Analiz
            </a>
          </li>
        </ol>
      </nav>

      <h1 class="display text-page-title tracking-tightest text-ink max-w-3xl">
        TUS Çıkmış Sorular Dağılımı ve Son 6 Sınav Referans Analizi
      </h1>
      <p class="text-inkMuted mt-3 max-w-3xl leading-relaxed">
        <strong>2024/1–2026/2</strong> dönemlerindeki son 6 TUS’ta (toplam <strong>1.195 soru</strong>) 11 ÖSYM branşının soru dağılımı ve
        9.575 kartlık BKA TUS kataloğunun (<code>{refSummary.katalogCommit}</code>) şeffaf çözüm desteği ile konu kapsamı ayrımı.
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-inkMuted">
        <span>
          Son güncelleme: <time datetime={modDate} class="font-semibold text-ink">{modLabel}</time>
        </span>
        <span>
          Hazırlayan:{' '}
          <a href="/hakkimizda/" class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark">
            TusAnkiM
          </a>
        </span>
      </div>
    </div>
  </section>

  <!-- Copyright & Methodology Boundary Banner -->
  <section class="bg-white border-b border-line py-6" aria-labelledby="copyright-heading">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <div class="rounded-2xl border-l-4 border-teal bg-tint p-5 text-xs sm:text-sm text-ink leading-relaxed">
        <h2 id="copyright-heading" class="display text-base text-ink mb-1">Telif Hakkı ve Şeffaflık Sınırı</h2>
        <p>
          Bu sayfada ve TusAnkiM’in açık veri dosyalarında <strong>telifli ÖSYM soru kökü veya şık metni yayımlanmaz</strong>.
          Yalnızca sınav/soru dağılımı, kendi cümlemizle ölçülen bilgi özeti ve kart eşleşmeleri paylaşılır; resmî kitapçıklara doğrudan{' '}
          <a
            href="https://www.osym.gov.tr/TR,15070/tus-cikmis-sorular.html"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark"
          >
            ÖSYM TUS Çıkmış Sorular Arşivi ↗
          </a>{' '}
          üzerinden ulaşabilirsin.
        </p>
      </div>
    </div>
  </section>

  <!-- Key Summary Strip -->
  <section class="bg-white border-b border-line py-8" aria-labelledby="summary-metrics-heading">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <h2 id="summary-metrics-heading" class="sr-only">Son 6 TUS referans özeti</h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-2xl border border-line bg-surfaceSoft p-5">
          <div class="text-xs font-semibold text-inkMuted">İncelenen Çıkmış Soru</div>
          <div class="display text-2xl sm:text-3xl text-ink mt-1 tabular-nums">{fmtInt(refSummary.overall.soru)}</div>
          <p class="text-xs text-inkMuted mt-1">Son 6 TUS (2024/1–2026/2)</p>
        </div>
        <div class="rounded-2xl border border-line bg-surfaceSoft p-5">
          <div class="text-xs font-semibold text-inkMuted">Çözüm Desteği</div>
          <div class="display text-2xl sm:text-3xl text-teal mt-1 tabular-nums">%{fmtDec1(refSummary.overall.destekOran)}</div>
          <p class="text-xs text-inkMuted mt-1 tabular-nums">
            {refSummary.overall.destek}/1.195 ({refSummary.overall.dogrudan} Doğrudan + {refSummary.overall.dolayli} Dolaylı)
          </p>
        </div>
        <div class="rounded-2xl border border-line bg-surfaceSoft p-5">
          <div class="text-xs font-semibold text-inkMuted">Konu Kapsamı</div>
          <div class="display text-2xl sm:text-3xl text-ink mt-1 tabular-nums">%{fmtDec1(refSummary.overall.konuKapsamiOran)}</div>
          <p class="text-xs text-inkMuted mt-1 tabular-nums">
            {fmtInt(refSummary.overall.konuKapsami)}/1.195 ({refSummary.overall.konu} yalnız konu · {refSummary.overall.yok} yok)
          </p>
        </div>
        <div class="rounded-2xl border border-line bg-surfaceSoft p-5">
          <div class="text-xs font-semibold text-inkMuted">2026/2 Sınav Öncesi (a78ae1f)</div>
          <div class="display text-2xl sm:text-3xl text-teal mt-1 tabular-nums">{pre.preExamEvet} / 200</div>
          <p class="text-xs text-inkMuted mt-1 tabular-nums">
            %38,0 sınav öncesi · güncel {pre.supportedCurrent}/200 (%41,0)
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Tables -->
  <section class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-12 space-y-14">
    <!-- Table 1: 11 ÖSYM Branches -->
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="max-w-2xl">
          <h2 class="display text-section tracking-tightest text-ink">
            11 ÖSYM TUS Branşına Göre Soru Dağılımı ve Referans Oranları
          </h2>
          <p class="text-sm text-inkMuted mt-2 leading-relaxed">
            Katalogda 12 ders (11 branş + karma <em>Deneme ve Soru</em>) bulunur; çıkmış soru dağılımı ve referans denetimi
            11 resmî ÖSYM TUS branşı üzerinden raporlanır (katalogdaki FHE = Fizyoloji-Histoloji-Embriyoloji).
          </p>
        </div>
        <a
          href="/referanslar/"
          class="inline-flex items-center min-h-[2.75rem] text-sm font-semibold text-teal underline underline-offset-4 hover:text-tealDark shrink-0"
        >
          1.195 soruyu tek tek ara →
        </a>
      </div>

      <div
        class="overflow-x-auto rounded-2xl border border-line bg-white"
        tabindex="0"
        role="region"
        aria-labelledby="branches-dist-caption"
      >
        <table class="w-full text-left border-collapse text-sm">
          <caption id="branches-dist-caption" class="sr-only">
            11 ÖSYM TUS branşına göre son 6 TUS soru dağılımı, çözüm desteği, konu kapsamı ve katalog kart sayısı tablosu
          </caption>
          <thead>
            <tr class="border-b border-line bg-surfaceSoft text-xs font-semibold text-inkMuted">
              <th scope="col" class="py-3.5 px-4">ÖSYM TUS Branşı</th>
              <th scope="col" class="py-3.5 px-4">Bölüm</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">6 Sınav Soru</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Sınav / Ort.</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Doğrudan + Dolaylı</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Çözüm Desteği</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Konu Kapsamı</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Katalog Kartı</th>
              <th scope="col" class="py-3.5 px-4">Detay</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-lineLight tabular-nums">
            {branches.map((b) => {
              const avgPerExam = b.summary.soru / 6;
              return (
                <tr>
                  <th scope="row" class="py-3 px-4 font-semibold text-ink">
                    <a href={`/referanslar/${b.slug}/`} class="text-ink hover:text-teal underline decoration-line underline-offset-2">
                      {b.name}
                    </a>
                  </th>
                  <td class="py-3 px-4 text-xs text-inkMuted">{b.group}</td>
                  <td class="py-3 px-4 font-semibold text-ink">{b.summary.soru}</td>
                  <td class="py-3 px-4 text-inkMuted">~{fmtDec1(avgPerExam)}</td>
                  <td class="py-3 px-4 text-inkMuted">
                    {b.summary.dogrudan} + {b.summary.dolayli} = <strong class="text-ink">{b.summary.destek}</strong>
                  </td>
                  <td class="py-3 px-4 font-semibold text-teal">%{fmtDec1(b.summary.destekOran)}</td>
                  <td class="py-3 px-4 text-ink">%{fmtDec1(b.summary.konuKapsamiOran)}</td>
                  <td class="py-3 px-4 text-inkMuted">{fmtInt(b.catalogCourse.cards)}</td>
                  <td class="py-3 px-4 whitespace-nowrap">
                    <a
                      href={`/referanslar/${b.slug}/`}
                      class="inline-flex items-center min-h-[2.75rem] text-xs font-semibold text-teal underline hover:text-tealDark"
                    >
                      Branş analizi →
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Table 2: By Exam (2024/1–2026/2) -->
    <div class="pt-8 border-t border-line space-y-4">
      <h2 class="display text-section tracking-tightest text-ink">
        Sınavlara Göre Çıkmış Soru Dağılımı (2024/1 – 2026/2)
      </h2>
      <p class="text-sm text-inkMuted max-w-3xl leading-relaxed">
        Her TUS oturumunda 100 Temel + 100 Klinik olmak üzere 200 soru sorulur (iptal edilen sorular nedeniyle 2024/1 ve 2025/2’de 198,
        2024/2’de 199 soru değerlendirilmiştir).
      </p>

      <div
        class="overflow-x-auto rounded-2xl border border-line bg-white"
        tabindex="0"
        role="region"
        aria-labelledby="exams-dist-caption"
      >
        <table class="w-full text-left border-collapse text-sm">
          <caption id="exams-dist-caption" class="sr-only">
            2024/1 ile 2026/2 arası son 6 TUS sınavının soru, doğrudan, dolaylı, çözüm desteği ve konu kapsamı tablosu
          </caption>
          <thead>
            <tr class="border-b border-line bg-surfaceSoft text-xs font-semibold text-inkMuted">
              <th scope="col" class="py-3.5 px-4">Sınav Dönemi</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Soru</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Doğrudan</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Dolaylı</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Çözüm Desteği</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Çözüm %</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Yalnız Konu</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Konu Kapsamı</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Kapsam %</th>
              <th scope="col" class="py-3.5 px-4 tabular-nums">Yok</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-lineLight tabular-nums">
            {refSummary.byExam.map((ex) => (
              <tr>
                <th scope="row" class="py-3 px-4 font-semibold text-ink">{ex.sinav} TUS</th>
                <td class="py-3 px-4 text-ink">{ex.soru}</td>
                <td class="py-3 px-4 text-gradeGood font-semibold">{ex.dogrudan}</td>
                <td class="py-3 px-4 text-warm font-semibold">{ex.dolayli}</td>
                <td class="py-3 px-4 font-semibold text-ink">{ex.destek}</td>
                <td class="py-3 px-4 font-semibold text-teal">%{fmtDec1(ex.destekOran)}</td>
                <td class="py-3 px-4 text-inkMuted">{ex.konu}</td>
                <td class="py-3 px-4 text-ink">{ex.konuKapsami}</td>
                <td class="py-3 px-4 text-ink font-semibold">%{fmtDec1(ex.konuKapsamiOran)}</td>
                <td class="py-3 px-4 text-inkMuted">{ex.yok}</td>
              </tr>
            ))}
            <tr class="bg-surfaceSoft font-semibold">
              <th scope="row" class="py-3.5 px-4 text-ink">Toplam (6 TUS)</th>
              <td class="py-3.5 px-4 text-ink">{fmtInt(refSummary.overall.soru)}</td>
              <td class="py-3.5 px-4 text-gradeGood">{refSummary.overall.dogrudan}</td>
              <td class="py-3.5 px-4 text-warm">{refSummary.overall.dolayli}</td>
              <td class="py-3.5 px-4 text-ink">{refSummary.overall.destek}</td>
              <td class="py-3.5 px-4 text-teal">%{fmtDec1(refSummary.overall.destekOran)}</td>
              <td class="py-3.5 px-4 text-inkMuted">{refSummary.overall.konu}</td>
              <td class="py-3.5 px-4 text-ink">{fmtInt(refSummary.overall.konuKapsami)}</td>
              <td class="py-3.5 px-4 text-ink">%{fmtDec1(refSummary.overall.konuKapsamiOran)}</td>
              <td class="py-3.5 px-4 text-inkMuted">{refSummary.overall.yok}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 2026/2 Pre-Exam Git Commit Proof -->
    <div class="pt-8 border-t border-line space-y-4">
      <h2 class="display text-section tracking-tightest text-ink">
        2026/2 Ağustos TUS: Sınav Öncesi (<code>{pre.commit}</code>) vs Güncel Katalog Ayrımı
      </h2>
      <p class="text-sm text-inkMuted max-w-3xl leading-relaxed">
        Sınav sonrası kart ekleyip geriye dönük yüksek referans gösterme yanılgısını engellemek için 23 Ağustos 2026 sınavından
        2 gün önceki <code>git {pre.commit}</code> ({pre.date}) sürümü dondurulmuştur. Güncel <strong>{pre.supportedCurrent}/200 (%41,0)</strong>
        çözüm desteğinin <strong>{pre.preExamEvet}/200 (%38,0)</strong> kadarı sınav öncesinde de destedeydi; kalan 6 soru ({pre.preExamKismen} kısmen,
        {pre.preExamHayir} sınav sonrası eklendi) aşağıda şeffaf biçimde ayrılmıştır:
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
        {pre.postExamEdited.map((item) => (
          <div class="rounded-xl border border-line bg-surfaceSoft p-4 space-y-1.5 text-xs">
            <div class="flex items-center justify-between gap-2 font-semibold">
              <span class="text-ink">{item.qid} · {item.ders}</span>
              <span class="text-teal">{item.rozet === 'DOGRUDAN' ? 'Doğrudan' : 'Dolaylı'}</span>
            </div>
            <p class="text-inkMuted leading-relaxed">{item.olculenBilgi}</p>
            <p class="text-[11px] text-inkMuted">
              Sınav öncesi sürümde: <strong class="text-ink">{item.sinavOncesiSurumde === 'kismen' ? 'kısmen' : 'hayır'}</strong>
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Cross-links & Official Source -->
    <div class="rounded-2xl border border-line bg-surfaceSoft p-6 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
      <div class="max-w-2xl space-y-1.5">
        <h2 class="display text-lg text-ink">Analizi Aktif Çalışmaya Bağla</h2>
        <p class="text-sm text-inkMuted leading-relaxed">
          Çıkmış sorulardan süzülen 11 canlı kartı hemen deneyebilir, netlerini puana çevirebilir veya 2025–2026 ÖSYM taban puanlarını inceleyebilirsin.
        </p>
        <p class="text-xs text-inkMuted">
          {SITE.disclaimer} Sınıflandırma yapay zekâ destekli ön değerlendirmedir; bağımsız hekim editör kontrolü sürmektedir.
        </p>
      </div>
      <div class="flex flex-wrap gap-2.5 shrink-0">
        <a href="/referanslar/" class="inline-flex items-center min-h-[2.75rem] px-4 rounded-full bg-teal text-white text-xs font-semibold hover:bg-tealDark transition">
          1.195 Referans Kataloğu →
        </a>
        <a href="/tus-spot-bilgiler/" class="inline-flex items-center min-h-[2.75rem] px-4 rounded-full border border-line bg-white text-xs font-semibold text-ink hover:border-tealGraphic hover:text-teal transition">
          TUS Spot Bilgiler →
        </a>
        <a href="/puan-hesapla/" class="inline-flex items-center min-h-[2.75rem] px-4 rounded-full border border-line bg-white text-xs font-semibold text-ink hover:border-tealGraphic hover:text-teal transition">
          TUS Puan Hesapla →
        </a>
        <a href="/tus-taban-puanlari-ve-kontenjan/" class="inline-flex items-center min-h-[2.75rem] px-4 rounded-full border border-line bg-white text-xs font-semibold text-ink hover:border-tealGraphic hover:text-teal transition">
          Taban Puanları →
        </a>
      </div>
    </div>
  </section>
</Layout>
