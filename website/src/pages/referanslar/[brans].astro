---
import Layout from '../../layouts/Layout.astro';
import { getBranches, type BranchInfo } from '../../data/branches';
import catalog from '../../data/generated/catalog.json';
import refSummary from '../../data/generated/references-summary.json';
import { breadcrumbList } from '../../lib/schema';
import { effectiveDate, formatTrDate } from '../../lib/lastmod';

export function getStaticPaths() {
  const all = getBranches();
  return all.map((branch) => ({
    params: { brans: branch.slug },
    props: { branch, all },
  }));
}

interface Props {
  branch: BranchInfo;
  all: BranchInfo[];
}

const { branch, all } = Astro.props;
const origin = new URL(Astro.site!).origin;
const pagePath = `/referanslar/${branch.slug}`;
const modDate = effectiveDate([
  'website/src/pages/referanslar/[brans].astro',
  'website/src/data/branches.ts',
  'website/src/data/generated/references-summary.json',
]);
const modLabel = formatTrDate(modDate);

const fmtPct = (v: number) => `%${v.toFixed(1).replace('.', ',')}`;
const fmtNum = (n: number) => n.toLocaleString('tr-TR');

const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'TUS Referansları', path: '/referanslar' },
  { name: branch.name, path: pagePath },
]);

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${branch.name}: son 6 TUS çıkmış soru referans analizi`,
  description: branch.seoDescription,
  inLanguage: 'tr-TR',
  temporalCoverage: '2024/2026',
  keywords: `${branch.name}, TUS soru dağılımı, TUS çıkmış sorular, BKA TUS`,
  url: origin + pagePath + '/',
  dateModified: modDate,
  creator: { '@id': origin + '/#organization' },
  publisher: { '@id': origin + '/#organization' },
};

const siblings = all.filter((b) => b.slug !== branch.slug);
---
<Layout
  title={branch.seoTitle}
  description={branch.seoDescription}
  modifiedTime={modDate}
  schema={[crumbs, datasetSchema]}
>
  <section class="bg-surface border-b border-line py-10 sm:py-14">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <nav aria-label="Sayfa konumu" class="mb-3">
        <ol class="flex flex-wrap items-center gap-y-1 text-xs text-inkMuted">
          <li class="inline-flex items-center">
            <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
          </li>
          <li class="inline-flex items-center">
            <span aria-hidden="true" class="mx-2">/</span>
            <a href="/referanslar/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">TUS Referansları</a>
          </li>
          <li class="inline-flex items-center">
            <span aria-hidden="true" class="mx-2">/</span>
            <a href={pagePath + '/'} aria-current="page" class="inline-flex items-center min-h-[2.75rem] py-2 text-ink font-semibold">
              {branch.name}
            </a>
          </li>
        </ol>
      </nav>

      <p class="text-xs font-semibold text-teal">
        {branch.group} · 11 TUS branşından biri
      </p>
      <h1 class="display text-page-title tracking-tightest text-ink mt-2 max-w-3xl">
        {branch.name} TUS çıkmış sorularını kartlar ne kadar karşılıyor?
      </h1>
      <p class="text-inkMuted mt-3 max-w-3xl leading-relaxed">
        Son 6 TUS’ta ({refSummary.sinavlar[refSummary.sinavlar.length - 1]}–{refSummary.sinavlar[0]}){' '}
        <strong class="text-ink">{branch.summary.soru} {branch.name}</strong> sorusu çıktı. Her birini BKA TUS kartlarıyla
        (<code>{refSummary.katalogCommit}</code> sürümü) karşılaştırdık. Kaç soruda kartın çözüme götürdüğünü, kaç soruda yalnızca konunun geçtiğini aşağıda görürsün. Sınıflandırma yapay zekâ destekli bir ön değerlendirme; bağımsız hekim editör onayı henüz tamamlanmadı. ÖSYM’nin telif hakkı nedeniyle soru metni ve şık yayımlamıyoruz.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-inkMuted">
        <span>
          Son güncelleme: <time datetime={modDate} class="font-semibold text-ink">{modLabel}</time>
        </span>
        <span>
          Hazırlayan:{' '}
          <a href="/hakkimizda/" class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark">
            TusAnkiM
          </a>
        </span>
      </div>

      <div class="mt-7 grid grid-cols-2 lg:grid-cols-4 gap-3.5">
        <div class="rounded-2xl border border-line bg-white p-4">
          <div class="text-xs font-semibold text-inkMuted">Çözüm desteği (6 sınav)</div>
          <div class="display text-2xl text-teal mt-1 tabular-nums">
            {branch.summary.destek} / {branch.summary.soru}{' '}
            <span class="text-base">({fmtPct(branch.summary.destekOran)})</span>
          </div>
          <div class="text-xs text-inkMuted mt-0.5">
            {branch.summary.dogrudan} Doğrudan + {branch.summary.dolayli} Dolaylı
          </div>
        </div>
        <div class="rounded-2xl border border-line bg-white p-4">
          <div class="text-xs font-semibold text-inkMuted">Konu Kapsamı</div>
          <div class="display text-2xl text-ink mt-1 tabular-nums">
            {branch.summary.konuKapsami} / {branch.summary.soru}{' '}
            <span class="text-base text-teal">({fmtPct(branch.summary.konuKapsamiOran)})</span>
          </div>
          <div class="text-xs text-inkMuted mt-0.5">
            {branch.summary.konu} yalnız konu · {branch.summary.yok} kart yok
          </div>
        </div>
        <div class="rounded-2xl border border-line bg-white p-4">
          <div class="text-xs font-semibold text-inkMuted">Destedeki kart sayısı</div>
          <div class="display text-2xl text-ink mt-1 tabular-nums">
            {fmtNum(branch.catalogCourse.cards)} kart
          </div>
          <div class="text-xs text-inkMuted mt-0.5">
            {fmtNum(branch.catalogCourse.notes)} not · {branch.catalogCourse.topicSubdecks} konu alt destesi
          </div>
        </div>
        <div class="rounded-2xl border border-line bg-white p-4">
          <div class="text-xs font-semibold text-inkMuted">Destenin adı</div>
          <div class="display text-2xl text-ink mt-1">
            {branch.catalogCourseName}
          </div>
          <div class="text-xs text-inkMuted mt-0.5">
            12 dersten biri ({branch.group})
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-12 space-y-12">
    <!-- 6-exam table -->
    <div>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-5">
        <div>
          <h2 class="display text-section tracking-tightest text-ink">
            Sınavlara göre {branch.name} sonuçları
          </h2>
          <p class="text-sm text-inkMuted mt-1">
            Çözüm desteği, Doğrudan ve Dolaylı soruların toplamıdır. Konu Kapsamı ayrı sayılır.
          </p>
        </div>
        <a
          href={`/referanslar/?ders=${encodeURIComponent(branch.name)}`}
          class="inline-flex items-center min-h-[2.75rem] text-sm font-semibold text-teal underline underline-offset-4 hover:text-tealDark shrink-0"
        >
          {branch.summary.soru} sorunun hepsini gör →
        </a>
      </div>

      <div
        class="overflow-x-auto rounded-2xl border border-line bg-white"
        tabindex="0"
        role="region"
        aria-labelledby="branch-exam-caption"
      >
        <table class="w-full text-left border-collapse text-sm">
          <caption id="branch-exam-caption" class="sr-only">
            {branch.name} için 2024/1–2026/2 arasındaki 6 TUS’un sonuç tablosu
          </caption>
          <thead>
            <tr class="border-b border-line bg-surfaceSoft text-xs font-semibold text-inkMuted">
              <th scope="col" class="py-3.5 px-4 sm:px-5">Sınav</th>
              <th scope="col" class="py-3.5 px-4 sm:px-5 tabular-nums">Soru</th>
              <th scope="col" class="py-3.5 px-4 sm:px-5 tabular-nums">Doğrudan</th>
              <th scope="col" class="py-3.5 px-4 sm:px-5 tabular-nums">Dolaylı</th>
              <th scope="col" class="py-3.5 px-4 sm:px-5 tabular-nums">Çözüm desteği</th>
              <th scope="col" class="py-3.5 px-4 sm:px-5 tabular-nums">Konu Kapsamı</th>
              <th scope="col" class="py-3.5 px-4 sm:px-5 tabular-nums">Kart yok</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-lineLight tabular-nums">
            {branch.exams.map((ex) => (
              <tr>
                <th scope="row" class="py-3 px-4 sm:px-5 font-semibold text-ink whitespace-nowrap">
                  {ex.sinav} TUS
                </th>
                <td class="py-3 px-4 sm:px-5 text-ink">{ex.soru}</td>
                <td class="py-3 px-4 sm:px-5 text-gradeGood font-semibold">{ex.dogrudan}</td>
                <td class="py-3 px-4 sm:px-5 text-warm font-semibold">{ex.dolayli}</td>
                <td class="py-3 px-4 sm:px-5 text-ink font-semibold">
                  {ex.destek} ({fmtPct(ex.destekOran)})
                </td>
                <td class="py-3 px-4 sm:px-5 text-inkMuted">
                  {ex.konuKapsami} ({fmtPct(ex.konuKapsamiOran)})
                </td>
                <td class="py-3 px-4 sm:px-5 text-inkMuted">{ex.yok}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-inkMuted leading-relaxed">
        Tablo kartların güncel sürümüne göredir. 2026/2 TUS’un tamamında sınavdan 2 gün önceki sürüm (<code>{refSummary.preExam2026_2.commit}</code>, {refSummary.preExam2026_2.date})
        {refSummary.preExam2026_2.preExamEvet}/200, güncel sürüm {refSummary.preExam2026_2.supportedCurrent}/200 soruda çözüm desteği veriyor. Sınavdan sonra güncellediğimiz kayıtları ayrıca işaretliyoruz.
        Ayrıntı: <a href="/referanslar/" class="text-teal underline underline-offset-2 hover:text-tealDark">TUS Referansları</a> ·{' '}
        <a href="/tus-cikmis-sorular-ve-analiz/" class="text-teal underline underline-offset-2 hover:text-tealDark">Çıkmış sorular analizi</a>.
      </p>
    </div>

    <!-- Question distribution & current scope intent -->
    <div class="rounded-2xl border border-line bg-white p-6 sm:p-8 space-y-6">
      <div>
        <h2 class="display text-section tracking-tightest text-ink">
          TUS’ta kaç {branch.name} sorusu çıkıyor, kartlar kaçını karşılıyor?
        </h2>
        <p class="text-sm text-inkMuted mt-1 leading-relaxed max-w-3xl">
          Önce sınavdaki soru sayısı, sonra konusu kartlarda geçen ama kartla çözülmeyen sorular.
        </p>
      </div>

      <div class="grid lg:grid-cols-12 gap-6">
        <div class="lg:col-span-5 rounded-2xl border border-line bg-surfaceSoft p-5 space-y-3">
          <h3 class="display text-base text-ink">Sınavdaki soru sayısı</h3>
          <p class="text-sm text-ink leading-relaxed">
            {branch.name}, {branch.examAllocation.sessionTotal} soruluk {branch.group} testinde{' '}
            <strong class="text-teal tabular-nums">{branch.examAllocation.standardQuestions} soru</strong> tutuyor.{' '}
            {branch.examAllocation.observedRange === String(branch.examAllocation.standardQuestions)
              ? 'Son 6 sınavda bu sayı hiç değişmedi;'
              : `Son 6 sınavda sayı ${branch.examAllocation.observedRange} arasında değişti;`}
            {' '}toplam <strong class="tabular-nums">{branch.summary.soru} soru</strong> çıktı.
          </p>
          <p class="text-xs text-inkMuted leading-relaxed">
            {branch.examAllocation.sessionShareNote}. Klinik puanı %40 Temel + %60 Klinik, Temel puanı %60 Temel + %40 Klinik ağırlıkla hesaplanır.
          </p>
          <div class="pt-1">
            <a
              href="/puan-hesapla/"
              class="inline-flex items-center min-h-[2.75rem] text-sm font-semibold text-teal underline underline-offset-4 hover:text-tealDark"
            >
              {branch.name} netinle TUS puanını hesapla →
            </a>
          </div>
        </div>

        <div class="lg:col-span-7 rounded-2xl border border-line bg-surfaceSoft p-5 space-y-3">
          <h3 class="display text-base text-ink">Konusu var ama kartla çözülmeyen sorular</h3>
          <p class="text-sm text-ink leading-relaxed">
            {branch.name} sorularında çözüm desteği{' '}
            <strong class="tabular-nums">{branch.summary.destek}/{branch.summary.soru} ({fmtPct(branch.summary.destekOran)})</strong>.{' '}
            <strong class="tabular-nums">{branch.summary.konu} soruda</strong> ise konu kartlarda geçiyor ama soruyu çözdüren bilgi eksik. Bunlara <em>yalnız konu</em> diyoruz ve çözüm desteğine saymıyoruz. Çözüm desteği ile yalnız konunun toplamı Konu Kapsamı’dır:{' '}
            <strong class="tabular-nums">{branch.summary.konuKapsami}/{branch.summary.soru} · {fmtPct(branch.summary.konuKapsamiOran)}</strong>.
          </p>
          <p class="text-sm text-ink leading-relaxed">
            Karşılaştırmak istersen {fmtNum(catalog.totals.cards)} kartın tamamında son 6 TUS için çözüm desteği{' '}
            <strong class="tabular-nums">{refSummary.overall.destek}/{fmtNum(refSummary.overall.soru)} ({fmtPct(refSummary.overall.destekOran)})</strong>, Konu Kapsamı{' '}
            <strong class="tabular-nums">{fmtNum(refSummary.overall.konuKapsami)}/{fmtNum(refSummary.overall.soru)} ({fmtPct(refSummary.overall.konuKapsamiOran)})</strong>.
          </p>
          <p class="text-xs text-inkMuted leading-relaxed">
            {branch.group === 'Temel Bilimler'
              ? 'Yalnız konu sorularında mekanizma ya da anatomik/laboratuvar sınırı kartta geçer ama soruyu ayırt ettiren adım eksiktir. O adımı soru çözerek ve karşılaştırma kartlarıyla tamamlaman gerekir.'
              : 'Yalnız konu sorularında hastalığın temel bilgisi destede vardır ama vakadaki karar adımı (ilk tetkik, birinci basamak tedavi ya da kontrendikasyon) eksiktir. O adımı soru çözerek tamamlaman gerekir.'}
          </p>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-1 pt-1 text-xs">
            <a href="/referanslar/" class="inline-flex items-center min-h-[2.75rem] font-semibold text-teal underline underline-offset-4 hover:text-tealDark">
              11 branşın 1.195 sorusunu gör →
            </a>
            <a href="/rehber/tusta-kac-kart-calisilmali/" class="inline-flex items-center min-h-[2.75rem] font-semibold text-teal underline underline-offset-4 hover:text-tealDark">
              9.575 kart ve günlük tempo rehberi →
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Strengths, gaps & catalog subdecks -->
    <div class="grid lg:grid-cols-12 gap-6">
      <div class="lg:col-span-7 rounded-2xl border border-line bg-surfaceSoft p-6 space-y-5">
        <h2 class="display text-lg text-ink">Kartların iyi olduğu ve eksik kaldığı konular</h2>
        <div>
          <h3 class="text-sm font-semibold text-gradeGood">İyi karşılanan konular</h3>
          <p class="text-sm text-ink mt-1.5 leading-relaxed">{branch.strongAreas}</p>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-warm">Eksik kalan konular</h3>
          <p class="text-sm text-inkMuted mt-1.5 leading-relaxed">{branch.priorityGaps}</p>
        </div>
        <div class="pt-4 border-t border-line text-xs text-inkMuted leading-relaxed">
          <strong class="text-ink">Neden 12 ders ama 11 branş?</strong> BKA TUS’ta{' '}
          <strong>{catalog.totals.courses} ders</strong> var. 11’i TUS branşlarının destesi, biri de karma soru tekrarı için 806 kartlık{' '}
          <strong>Deneme ve Soru</strong> destesi.{' '}
          {branch.catalogCourseName === 'FHE'
            ? 'Bu branşın destesinin adı kısaca FHE.'
            : 'Fizyoloji-Histoloji-Embriyoloji destesinin adı FHE.'}
          {' '}Soru karşılaştırmasını yalnızca <strong>11 TUS branşı</strong> için yaptık.
        </div>
      </div>

      <div class="lg:col-span-5 rounded-2xl border border-line bg-white p-6">
        <h2 class="display text-lg text-ink">En çok kartı olan konular ({branch.catalogCourseName})</h2>
        <p class="text-xs text-inkMuted mt-1">
          {branch.catalogCourse.topicSubdecks} konu alt destesinden en kalabalık {branch.catalogCourse.topTopics.length} tanesi:
        </p>
        <ul class="mt-4 divide-y divide-lineLight text-sm">
          {branch.catalogCourse.topTopics.map((topic) => (
            <li class="py-2.5 flex items-center justify-between gap-3">
              <span class="text-ink">{topic.name}</span>
              <span class="font-semibold text-teal tabular-nums shrink-0">{fmtNum(topic.cards)} kart</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Sample verified cards -->
    <div>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-5">
        <div>
          <h2 class="display text-section tracking-tightest text-ink">
            Örnek {branch.name} kayıtları
          </h2>
          <p class="text-sm text-inkMuted mt-1">
            Her kayıtta sorunun ölçtüğü bilgi ve o bilgiyi veren kartın özeti var. Soru metni yok.
          </p>
        </div>
        <a
          href="/tus-cikmis-sorular-ve-analiz/"
          class="inline-flex items-center min-h-[2.75rem] text-sm font-semibold text-teal underline underline-offset-4 hover:text-tealDark shrink-0"
        >
          Çıkmış soru analizi
        </a>
      </div>

      <div class="space-y-3">
        {branch.samples.map((r) => (
          <article class="rounded-2xl border border-line bg-white p-4 sm:p-5">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                <span class="font-bold text-ink tabular-nums">
                  {r.sinav} · {r.qid.split('-')[1]}
                </span>
                <span
                  class={`font-semibold ${
                    r.rozet === 'DOGRUDAN' ? 'text-gradeGood' : 'text-gradeHard'
                  }`}
                >
                  {r.rozet === 'DOGRUDAN' ? 'Doğrudan' : 'Dolaylı'}
                </span>
                {r.sinavOncesiSurumde === 'evet' && (
                  <span class="text-inkMuted">· Sınavdan önce de vardı (a78ae1f)</span>
                )}
              </div>
              {r.cardId && <span class="font-mono text-inkMuted">{r.cardId}</span>}
            </div>
            <p class="mt-2.5 text-sm font-semibold text-ink">{r.olculenBilgi}</p>
            {r.eksikAdim && (
              <p class="mt-2 text-xs text-warm">
                <strong class="font-bold">Eksik adım:</strong> {r.eksikAdim}
              </p>
            )}
            {r.kartOzet && (
              <p class="mt-2 rounded-xl bg-surfaceSoft px-3.5 py-2.5 text-xs sm:text-sm text-inkMuted leading-relaxed border border-lineLight">
                <strong class="text-ink font-semibold">Kart özeti:</strong> {r.kartOzet}
              </p>
            )}
          </article>
        ))}
      </div>
    </div>

    <!-- Authority & Sibling branches -->
    <div class="pt-8 border-t border-line grid lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8">
        <h2 class="display text-lg text-ink">Diğer 10 TUS branşı (çözüm desteği)</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {siblings.map((sib) => (
            <li>
              <a
                href={`/referanslar/${sib.slug}/`}
                class="inline-flex items-center min-h-[2.75rem] px-3.5 rounded-lg border border-line bg-white text-xs font-semibold text-ink hover:border-tealGraphic hover:text-teal transition"
              >
                {sib.name} ({fmtPct(sib.summary.destekOran)})
              </a>
            </li>
          ))}
        </ul>
      </div>

      <aside class="lg:col-span-4 rounded-2xl border border-line bg-surfaceSoft p-5 text-xs text-inkMuted leading-relaxed">
        <h2 class="display text-sm text-ink">Bu veriler ne için?</h2>
        <p class="mt-2">
          Veriler yalnızca TUS hazırlığı içindir; klinik kararın ya da resmî ÖSYM kılavuzunun yerini tutmaz. Sınıflandırma ön değerlendirmedir, hekim editör onayı henüz tamamlanmadı.
        </p>
        <p class="mt-2">
          Son güncelleme: <time datetime={modDate} class="font-semibold text-ink">{modLabel}</time> ·{' '}
          <a href="/hakkimizda/" class="text-teal underline hover:text-tealDark">TusAnkiM</a>
        </p>
      </aside>
    </div>
  </section>
</Layout>
