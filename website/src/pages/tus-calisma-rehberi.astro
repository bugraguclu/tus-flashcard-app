---
import Layout from '../layouts/Layout.astro';
import GuideHeroAndToc from '../components/guide/GuideHeroAndToc.astro';
import GuideTempoAndMegaDeck from '../components/guide/GuideTempoAndMegaDeck.astro';
import GuideExamCalendar from '../components/guide/GuideExamCalendar.astro';
import GuideBranchesAndScoring from '../components/guide/GuideBranchesAndScoring.astro';
import GuideFsrsAndWorkflow from '../components/guide/GuideFsrsAndWorkflow.astro';
import GuideTryCards from '../components/guide/GuideTryCards.astro';
import GuideStruggles from '../components/guide/GuideStruggles.astro';
import GuideFaqAndSources from '../components/guide/GuideFaqAndSources.astro';
import '../styles/guide.css';

import { GUIDE_FAQS, GUIDE_META, WORKFLOW_STEPS } from '../data/studyGuide';
import { breadcrumbList } from '../lib/schema';
import { publicationDates, pageSources } from '../lib/lastmod';

const origin = new URL(Astro.site!).origin;
const pageUrl = origin + '/tus-calisma-rehberi/';
const dates = publicationDates('website/src/pages/tus-calisma-rehberi.astro', pageSources('calisma-rehberi'));

const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'TUS Çalışma Rehberi', path: '/tus-calisma-rehberi' },
]);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': pageUrl + '#article',
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  isPartOf: { '@id': origin + '/#website' },
  url: pageUrl,
  headline: GUIDE_META.h1,
  description: GUIDE_META.description,
  articleSection: 'TUS Çalışma Rehberi',
  inLanguage: 'tr-TR',
  author: { '@id': origin + '/#organization' },
  publisher: { '@id': origin + '/#organization' },
  image: {
    '@type': 'ImageObject',
    url: origin + '/images/og/tus-calisma-rehberi.png',
    width: 1200,
    height: 630,
  },
  about: [
    { '@type': 'Thing', name: 'Tıpta Uzmanlık Eğitimi Giriş Sınavı (TUS)' },
    { '@type': 'Thing', name: 'Aralıklı tekrar (FSRS-6)' },
    { '@type': 'Thing', name: 'TUS çalışma planı ve 11 branş stratejisi' },
  ],
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['#guide-title', '[data-speakable]'],
  },
  ...dates,
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'TUS çalışma planı nasıl kurulur ve sürdürülür?',
  description:
    '4 adımlı TUS çalışma yöntemi: sınav tarihine göre günlük kart sayını belirle, her gün önce tekrarları bitir, çalışmanı Kronometre ile kaydet ve deneme yanlışlarını karta çevir.',
  inLanguage: 'tr-TR',
  step: WORKFLOW_STEPS.map((s, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: s.name,
    text: `${s.summary} ${s.detail}`,
    url: origin + s.href,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: GUIDE_FAQS.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---
<Layout
  title={GUIDE_META.title}
  description={GUIDE_META.description}
  ogType="article"
  publishedTime={dates.datePublished}
  modifiedTime={dates.dateModified}
  schema={[crumbs, articleSchema, howToSchema, faqSchema]}
>
  <GuideHeroAndToc />
  <GuideTempoAndMegaDeck />
  <GuideExamCalendar />
  <GuideBranchesAndScoring />
  <GuideFsrsAndWorkflow />
  <GuideTryCards />
  <GuideStruggles />
  <GuideFaqAndSources datePublished={dates.datePublished} dateModified={dates.dateModified} />
</Layout>

<script>
  // 1. Scrollspy aria-current sync (native CSS scroll-target-group + deterministic fallback)
  const tocNav = document.querySelector<HTMLElement>('[data-guide-toc]');
  if (tocNav) {
    const links = Array.from(tocNav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const sections = links
      .map((a) => document.getElementById(a.getAttribute('href')!.slice(1)))
      .filter((el): el is HTMLElement => Boolean(el));
    const tocBar = tocNav.closest<HTMLElement>('.guide-toc-bar');

    const centerTocPill = (active: HTMLAnchorElement | null) => {
      if (!active || tocNav.scrollWidth <= tocNav.clientWidth) return;
      const navRect = tocNav.getBoundingClientRect();
      const linkRect = active.getBoundingClientRect();
      const delta = linkRect.left - navRect.left - (navRect.width - linkRect.width) / 2;
      const maxScroll = tocNav.scrollWidth - tocNav.clientWidth;
      tocNav.scrollLeft = Math.max(0, Math.min(maxScroll, tocNav.scrollLeft + delta));
    };

    const stickyBottom = () => Math.round(tocBar?.getBoundingClientRect().bottom ?? 140);

    const resolveActiveId = () => {
      if (!sections.length) return '';
      const atBottom =
        window.scrollY > 0 &&
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 24;
      if (atBottom) return sections[sections.length - 1].id;
      const cutoff = stickyBottom() + 36;
      let current = sections[0].id;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= cutoff) current = section.id;
        else break;
      }
      return current;
    };

    const supportsNative = typeof CSS !== 'undefined' && CSS.supports('scroll-target-group: auto');
    if (supportsNative) {
      let outerRaf = 0;
      let innerRaf = 0;
      const syncNative = () => {
        outerRaf = 0;
        innerRaf = 0;
        const nativeActive = tocNav.querySelector<HTMLAnchorElement>('a:target-current');
        const fallbackId = nativeActive ? null : resolveActiveId();
        const active =
          nativeActive ??
          links.find((l) => l.getAttribute('href') === `#${fallbackId}`) ??
          links[0] ??
          null;
        links.forEach((link) => {
          if (link === active) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
        centerTocPill(active);
      };
      // Blink updates :target-current after the scroll frame's rAF callbacks run;
      // deferring across two animation frames guarantees we read the fresh marker.
      const scheduleSync = () => {
        if (outerRaf) cancelAnimationFrame(outerRaf);
        if (innerRaf) cancelAnimationFrame(innerRaf);
        outerRaf = requestAnimationFrame(() => {
          outerRaf = 0;
          innerRaf = requestAnimationFrame(syncNative);
        });
      };
      syncNative();
      document.addEventListener('scrollend', scheduleSync, { passive: true });
      window.addEventListener('scroll', scheduleSync, { passive: true });
      window.addEventListener('hashchange', scheduleSync);
    } else if (sections.length) {
      let rafId = 0;
      const setActive = (id: string) => {
        let active: HTMLAnchorElement | null = null;
        links.forEach((link) => {
          const match = link.getAttribute('href') === `#${id}`;
          link.classList.toggle('target-current', match);
          if (match) {
            link.setAttribute('aria-current', 'true');
            active = link;
          } else {
            link.removeAttribute('aria-current');
          }
        });
        centerTocPill(active);
      };
      const syncFallback = () => {
        rafId = 0;
        setActive(resolveActiveId());
      };
      const scheduleFallback = () => {
        if (!rafId) rafId = requestAnimationFrame(syncFallback);
      };

      const initialHash = window.location.hash.slice(1);
      if (initialHash && sections.some((s) => s.id === initialHash)) {
        setActive(initialHash);
      } else {
        setActive(resolveActiveId());
      }

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(scheduleFallback, {
          rootMargin: '-15% 0px -65% 0px',
          threshold: 0,
        });
        sections.forEach((section) => io.observe(section));
      }
      window.addEventListener('scroll', scheduleFallback, { passive: true });
      window.addEventListener('hashchange', () => {
        const hashId = window.location.hash.slice(1);
        if (hashId && sections.some((s) => s.id === hashId)) setActive(hashId);
        scheduleFallback();
      });
    }
  }

  // 2. Accordion Expand/Collapse All (Invoker Commands + click fallback for older browsers)
  const faqList = document.getElementById('guide-faq-list');
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-faq-toggle-all]');
  if (faqList && toggleBtn) {
    const items = () => Array.from(faqList.querySelectorAll<HTMLDetailsElement>(':scope > details'));
    const syncButton = () => {
      const allOpen = items().length > 0 && items().every((d) => d.open);
      toggleBtn.setAttribute('aria-expanded', String(allOpen));
    };
    const toggleAll = () => {
      const expand = toggleBtn.getAttribute('aria-expanded') !== 'true';
      items().forEach((d) => { d.open = expand; });
      syncButton();
    };

    if (Object.hasOwn(HTMLButtonElement.prototype, 'commandForElement')) {
      faqList.addEventListener('command', (event: Event) => {
        if ((event as Event & { command?: string }).command !== '--toggle-all') return;
        toggleAll();
      });
    } else {
      toggleBtn.addEventListener('click', toggleAll);
    }

    faqList.addEventListener(
      'toggle',
      (event) => {
        if ((event.target as Element)?.matches('#guide-faq-list > details')) syncButton();
      },
      { capture: true },
    );
  }
</script>
