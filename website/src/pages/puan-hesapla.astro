---
import Layout from '../layouts/Layout.astro';
import exams from '../data/exams.json';
import { breadcrumbList } from '../lib/schema';
import { effectiveDate, formatTrDate, pageSources, publicationDates } from '../lib/lastmod';

const origin = new URL(Astro.site!).origin;
const modDate = effectiveDate(pageSources('puan'));
const modLabel = formatTrDate(modDate);

const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'TUS Puan Hesaplayıcı', path: '/puan-hesapla' },
]);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': origin + '/puan-hesapla/#webapp',
  name: 'TusAnkiM TUS Puan ve Hedef Net Hesaplayıcı',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  inLanguage: 'tr-TR',
  url: origin + '/puan-hesapla/',
  ...publicationDates('website/src/pages/puan-hesapla.astro', pageSources('puan')),
  author: { '@id': origin + '/#organization' },
  provider: { '@id': origin + '/#organization' },
  publisher: { '@id': origin + '/#organization' },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'TRY',
  },
  featureList: [
    'Klinik (%40/%60) ve Temel (%60/%40) ağırlıklı tahmini TUS puan hesabı',
    '11 ÖSYM TUS branşı için ders ders (100 Temel + 100 Klinik) net girişi',
    'Güncel %5 puan kesintisi, 45 barajı ve tahmini sıralama bandı öngörüsü',
    'Hedef TUS puanı için gereken net hesabı ve 45/60/65/70 puan referans tablosu',
  ],
};

const TEMEL_BRANCH_INPUTS = [
  { id: 'anatomi', name: 'Anatomi', max: 13, defD: 8, defY: 3 },
  { id: 'fhe', name: 'FHE (Fizyoloji-Histoloji-Embriyoloji)', max: 15, defD: 10, defY: 3 },
  { id: 'biyokimya', name: 'Biyokimya', max: 18, defD: 12, defY: 3 },
  { id: 'mikrobiyoloji', name: 'Mikrobiyoloji', max: 18, defD: 12, defY: 4 },
  { id: 'patoloji', name: 'Patoloji', max: 18, defD: 11, defY: 4 },
  { id: 'farmakoloji', name: 'Farmakoloji', max: 18, defD: 12, defY: 3 },
] as const;

const KLINIK_BRANCH_INPUTS = [
  { id: 'dahiliye', name: 'Dahiliye', max: 24, defD: 16, defY: 4 },
  { id: 'pediatri', name: 'Pediatri', max: 25, defD: 17, defY: 5 },
  { id: 'genel-cerrahi', name: 'Genel Cerrahi', max: 20, defD: 14, defY: 4 },
  { id: 'kadin-dogum', name: 'Kadın Doğum', max: 10, defD: 7, defY: 2 },
  { id: 'kucuk-stajlar', name: 'Küçük Stajlar', max: 21, defD: 14, defY: 3 },
] as const;

const SCORE_REFERENCE_ROWS = [
  {
    band: '45,0 (baraj)',
    totalNet: '~59 net (~29,5 / oturum)',
    kesintiTarget: '~47,4 ham puan (~68 net)',
    rankBand: 'Tercih alt sınırı (~26.000+)',
    sampleBranches: 'Genel Kontenjan baraj eşiği (İç Hast., Pediatri, Acil Tıp taban sınırları 45,02–45,12)',
  },
  {
    band: '60,0',
    totalNet: '~113 net (~56,5 / oturum)',
    kesintiTarget: '~63,2 ham puan (~124 net)',
    rankBand: '~3.200 – 7.500 bandı',
    sampleBranches: 'Radyoloji (59,72 min) · KBB (56,91 min) · Göz (55,27 min) · Dermatoloji (54,74 min)',
  },
  {
    band: '65,0',
    totalNet: '~130 net (~65,0 / oturum)',
    kesintiTarget: '~68,4 ham puan (~143 net)',
    rankBand: '~1.100 – 3.200 bandı',
    sampleBranches: 'Plastik, Rekonstrüktif ve Estetik Cerrahi (64,82 min) · Üst dilim klinik programlar',
  },
  {
    band: '70,0',
    totalNet: '~148 net (~74,0 / oturum)',
    kesintiTarget: '~73,7 ham puan (~161 net)',
    rankBand: '~300 – 1.100 bandı',
    sampleBranches: 'Radyasyon Onkolojisi (66,19–73,96) · Tıbbi Biyokimya (66,05–73,94) üst sıraları',
  },
] as const;

const OSYM_2026_2_BRANCH_ROWS = [
  { branch: 'Radyasyon Onkolojisi', quota: '70 / 70', occupancy: '%100,0', min: '66,19', max: '73,96' },
  { branch: 'Tıbbi Biyokimya', quota: '56 / 56', occupancy: '%100,0', min: '66,05', max: '73,94' },
  { branch: 'Plastik, Rekonstrüktif ve Estetik Cerrahi', quota: '98 / 98', occupancy: '%100,0', min: '64,82', max: '85,00' },
  { branch: 'Radyoloji', quota: '326 / 324', occupancy: '%99,4', min: '59,72', max: '79,65' },
  { branch: 'Kulak Burun Boğaz Hastalıkları', quota: '225 / 225', occupancy: '%100,0', min: '56,91', max: '80,25' },
  { branch: 'Göz Hastalıkları', quota: '267 / 267', occupancy: '%100,0', min: '55,27', max: '84,53' },
  { branch: 'Deri ve Zührevi Hastalıkları', quota: '212 / 212', occupancy: '%100,0', min: '54,74', max: '84,44' },
  { branch: 'İç Hastalıkları', quota: '620 / 557', occupancy: '%89,8', min: '45,04', max: '82,37' },
  { branch: 'Kadın Hastalıkları ve Doğum', quota: '468 / 381', occupancy: '%81,4', min: '45,19', max: '74,34' },
  { branch: 'Genel Cerrahi', quota: '413 / 323', occupancy: '%78,2', min: '45,12', max: '77,44' },
  { branch: 'Çocuk Sağlığı ve Hastalıkları', quota: '827 / 602', occupancy: '%72,8', min: '45,02', max: '79,55' },
  { branch: 'Aile Hekimliği', quota: '864 / 837', occupancy: '%96,9', min: '45,10', max: '73,85' },
  { branch: 'Acil Tıp', quota: '533 / 433', occupancy: '%81,2', min: '45,12', max: '65,12' },
] as const;
---
<Layout
  title="TUS puan hesaplama: ders neti ve sıralama | TusAnkiM"
  description="TUS puan hesaplama aracı: Temel ve Klinik netini gir, tahmini puanını ve sıralama bandını gör. %5 kesinti, 45 barajı ve hedef puan için gereken net de var."
  modifiedTime={modDate}
  schema={[crumbs, pageSchema]}
>
  <section class="bg-surfaceSoft border-b border-line py-10 sm:py-14">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <nav aria-label="Sayfa konumu" class="flex flex-wrap items-center gap-y-1 text-xs text-inkMuted mb-3">
        <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-ink font-semibold">TUS Puan Hesaplayıcı</span>
      </nav>

      <h1 class="display text-page-title tracking-tightest text-ink max-w-3xl">
        TUS puan ve hedef net hesaplayıcı
      </h1>
      <p class="text-inkMuted mt-3 max-w-2xl leading-relaxed">
        Temel ve Klinik testlerdeki (100’er soru) doğru ve yanlış sayını gir, tahmini TUS puanını gör.
        Hedeflediğin puan için kaç net gerektiğini de hesaplar. Sonuç tahmindir; resmî puanı ÖSYM açıklar.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-inkMuted">
        <span>
          Son güncelleme: <time datetime={modDate} class="font-semibold text-ink">{modLabel}</time>
        </span>
        <span>
          Hazırlayan:{' '}
          <a href="/hakkimizda/" class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark">
            TusAnkiM
          </a>
        </span>
      </div>
    </div>
  </section>

  <!-- Main interactive calculator -->
  <section class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-12" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="sr-only">TUS puan hesaplama aracı</h2>

    <div class="grid lg:grid-cols-12 gap-8 items-start" data-tus-score-calc>
      <!-- Left: Forward Calculator -->
      <div class="lg:col-span-7 rounded-2xl border border-line bg-white p-6 sm:p-8">
        <h3 class="display text-subsection text-ink">Doğru ve yanlış sayılarını gir</h3>
        <p class="text-xs text-inkMuted mt-1">
          4 yanlış 1 doğruyu götürür. Her oturum 100 soru, toplam 200 soru.
        </p>

        <div class="mt-4 inline-flex flex-wrap gap-2 rounded-2xl border border-line bg-surfaceSoft p-1.5" role="group" aria-label="Giriş şekli">
          <button
            type="button"
            data-calc-mode="genel"
            aria-pressed="true"
            class="min-h-[2.75rem] px-4 rounded-xl text-xs sm:text-sm font-semibold transition bg-teal text-white cursor-pointer"
          >
            Toplam gir (Temel / Klinik)
          </button>
          <button
            type="button"
            data-calc-mode="ders"
            aria-pressed="false"
            class="min-h-[2.75rem] px-4 rounded-xl text-xs sm:text-sm font-semibold transition text-ink hover:bg-white cursor-pointer"
          >
            Ders ders gir (11 branş)
          </button>
        </div>

        <div data-panel-genel class="mt-6 grid sm:grid-cols-2 gap-6">
          <!-- Temel Bilimler -->
          <fieldset class="rounded-2xl border border-line bg-surfaceSoft p-4 space-y-3">
            <legend class="px-2 text-sm font-semibold text-teal">Temel Bilimler (100 soru)</legend>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="tt-dogru" class="block text-xs font-semibold text-ink mb-1">Doğru</label>
                <input
                  id="tt-dogru"
                  data-score-field="Temel · Doğru"
                  type="number"
                  min="0"
                  max="100"
                  value="65"
                  inputmode="numeric"
                  class="w-full min-h-[2.75rem] rounded-xl border border-line bg-white px-3 text-base font-bold text-ink tabular-nums"
                />
              </div>
              <div>
                <label for="tt-yanlis" class="block text-xs font-semibold text-ink mb-1">Yanlış</label>
                <input
                  id="tt-yanlis"
                  data-score-field="Temel · Yanlış"
                  type="number"
                  min="0"
                  max="100"
                  value="20"
                  inputmode="numeric"
                  class="w-full min-h-[2.75rem] rounded-xl border border-line bg-white px-3 text-base font-bold text-ink tabular-nums"
                />
              </div>
            </div>
            <div class="flex items-center justify-between text-xs pt-2 border-t border-lineLight">
              <span class="text-inkMuted">Boş: <strong data-tt-bos class="text-ink tabular-nums">15</strong></span>
              <span class="text-teal font-bold">Temel net: <span data-tt-net class="tabular-nums">60,00</span></span>
            </div>
          </fieldset>

          <!-- Klinik Bilimler -->
          <fieldset class="rounded-2xl border border-line bg-surfaceSoft p-4 space-y-3">
            <legend class="px-2 text-sm font-semibold text-teal">Klinik Bilimler (100 soru)</legend>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="kt-dogru" class="block text-xs font-semibold text-ink mb-1">Doğru</label>
                <input
                  id="kt-dogru"
                  data-score-field="Klinik · Doğru"
                  type="number"
                  min="0"
                  max="100"
                  value="68"
                  inputmode="numeric"
                  class="w-full min-h-[2.75rem] rounded-xl border border-line bg-white px-3 text-base font-bold text-ink tabular-nums"
                />
              </div>
              <div>
                <label for="kt-yanlis" class="block text-xs font-semibold text-ink mb-1">Yanlış</label>
                <input
                  id="kt-yanlis"
                  data-score-field="Klinik · Yanlış"
                  type="number"
                  min="0"
                  max="100"
                  value="18"
                  inputmode="numeric"
                  class="w-full min-h-[2.75rem] rounded-xl border border-line bg-white px-3 text-base font-bold text-ink tabular-nums"
                />
              </div>
            </div>
            <div class="flex items-center justify-between text-xs pt-2 border-t border-lineLight">
              <span class="text-inkMuted">Boş: <strong data-kt-bos class="text-ink tabular-nums">14</strong></span>
              <span class="text-teal font-bold">Klinik net: <span data-kt-net class="tabular-nums">63,50</span></span>
            </div>
          </fieldset>
        </div>

        <div data-panel-ders hidden class="mt-6 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-lineLight bg-surfaceSoft px-4 py-2.5 text-xs">
            <span class="text-inkMuted">
              Temel net: <strong data-ders-tt-net class="text-teal tabular-nums">60,00</strong> · Klinik net:{' '}
              <strong data-ders-kt-net class="text-teal tabular-nums">63,50</strong>
            </span>
            <span class="text-inkMuted">Toplam girişe kendiliğinden aktarılır</span>
          </div>

          <fieldset class="rounded-2xl border border-line bg-surfaceSoft p-4 space-y-3">
            <legend class="px-2 text-sm font-semibold text-teal">Temel Bilimler · 6 ders (100 soru)</legend>
            <div class="space-y-2.5">
              {TEMEL_BRANCH_INPUTS.map((b) => (
                <div class="grid grid-cols-12 gap-2 items-center rounded-xl border border-lineLight bg-white px-3 py-2">
                  <div class="col-span-12 sm:col-span-5">
                    <span class="block text-xs font-semibold text-ink">{b.name}</span>
                    <span class="block text-[11px] text-inkMuted tabular-nums">{b.max} soru · Net: <strong data-subj-net={b.id} class="text-teal">{(b.defD - b.defY / 4).toFixed(2).replace('.', ',')}</strong></span>
                  </div>
                  <div class="col-span-6 sm:col-span-3">
                    <label for={`subj-${b.id}-d`} class="block text-[11px] text-inkMuted mb-0.5">Doğru</label>
                    <input
                      id={`subj-${b.id}-d`}
                      type="number"
                      min="0"
                      max={b.max}
                      value={b.defD}
                      inputmode="numeric"
                      data-subj-group="temel"
                      data-subj-kind="d"
                      data-score-field={`${b.name} · Doğru`}
                      data-subj-id={b.id}
                      data-subj-name={b.name}
                      data-subj-max={b.max}
                      class="w-full min-h-[2.75rem] rounded-lg border border-line bg-surfaceSoft px-2.5 text-sm font-bold text-ink tabular-nums"
                    />
                  </div>
                  <div class="col-span-6 sm:col-span-4">
                    <label for={`subj-${b.id}-y`} class="block text-[11px] text-inkMuted mb-0.5">Yanlış</label>
                    <input
                      id={`subj-${b.id}-y`}
                      type="number"
                      min="0"
                      max={b.max}
                      value={b.defY}
                      inputmode="numeric"
                      data-subj-group="temel"
                      data-subj-kind="y"
                      data-score-field={`${b.name} · Yanlış`}
                      data-subj-id={b.id}
                      data-subj-name={b.name}
                      data-subj-max={b.max}
                      class="w-full min-h-[2.75rem] rounded-lg border border-line bg-surfaceSoft px-2.5 text-sm font-bold text-ink tabular-nums"
                    />
                  </div>
                </div>
              ))}
            </div>
          </fieldset>

          <fieldset class="rounded-2xl border border-line bg-surfaceSoft p-4 space-y-3">
            <legend class="px-2 text-sm font-semibold text-teal">Klinik Bilimler · 5 ders (100 soru)</legend>
            <p class="text-[11px] text-inkMuted leading-relaxed">
              Soru sayıları 2026/2 sınavına göredir. Klinik derslerde sayı sınavdan sınava 1 soru oynayabilir (Dahiliye 23–25, Pediatri 24–25, Genel Cerrahi 19–21, Küçük Stajlar 20–22).
            </p>
            <div class="space-y-2.5">
              {KLINIK_BRANCH_INPUTS.map((b) => (
                <div class="grid grid-cols-12 gap-2 items-center rounded-xl border border-lineLight bg-white px-3 py-2">
                  <div class="col-span-12 sm:col-span-5">
                    <span class="block text-xs font-semibold text-ink">{b.name}</span>
                    <span class="block text-[11px] text-inkMuted tabular-nums">{b.max} soru · Net: <strong data-subj-net={b.id} class="text-teal">{(b.defD - b.defY / 4).toFixed(2).replace('.', ',')}</strong></span>
                  </div>
                  <div class="col-span-6 sm:col-span-3">
                    <label for={`subj-${b.id}-d`} class="block text-[11px] text-inkMuted mb-0.5">Doğru</label>
                    <input
                      id={`subj-${b.id}-d`}
                      type="number"
                      min="0"
                      max={b.max}
                      value={b.defD}
                      inputmode="numeric"
                      data-subj-group="klinik"
                      data-subj-kind="d"
                      data-score-field={`${b.name} · Doğru`}
                      data-subj-id={b.id}
                      data-subj-name={b.name}
                      data-subj-max={b.max}
                      class="w-full min-h-[2.75rem] rounded-lg border border-line bg-surfaceSoft px-2.5 text-sm font-bold text-ink tabular-nums"
                    />
                  </div>
                  <div class="col-span-6 sm:col-span-4">
                    <label for={`subj-${b.id}-y`} class="block text-[11px] text-inkMuted mb-0.5">Yanlış</label>
                    <input
                      id={`subj-${b.id}-y`}
                      type="number"
                      min="0"
                      max={b.max}
                      value={b.defY}
                      inputmode="numeric"
                      data-subj-group="klinik"
                      data-subj-kind="y"
                      data-score-field={`${b.name} · Yanlış`}
                      data-subj-id={b.id}
                      data-subj-name={b.name}
                      data-subj-max={b.max}
                      class="w-full min-h-[2.75rem] rounded-lg border border-line bg-surfaceSoft px-2.5 text-sm font-bold text-ink tabular-nums"
                    />
                  </div>
                </div>
              ))}
            </div>
          </fieldset>
        </div>

        <div class="mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 rounded-2xl border border-line bg-surfaceSoft px-4 py-1.5">
          <div class="flex items-center gap-3">
            <input
              id="puan-kesinti"
              type="checkbox"
              aria-describedby="puan-kesinti-status"
              class="w-5 h-5 shrink-0 accent-[#0e7469] rounded cursor-pointer"
            />
            <label for="puan-kesinti" class="inline-flex flex-wrap items-center min-h-[2.75rem] py-1.5 text-xs sm:text-sm font-semibold text-ink cursor-pointer select-none">
              %5 puan kesintisini uygula&nbsp;<span class="font-normal text-inkMuted">(uzmanlık eğitimindeysen, istifa ettiysen ya da yerleşip başlamadıysan)</span>
            </label>
          </div>
          <span id="puan-kesinti-status" data-kesinti-status class="text-xs text-inkMuted shrink-0">
            Kesinti uygulanmıyor
          </span>
        </div>

        <button type="button" data-score-results-button hidden class="score-results-button mt-4 min-h-[2.75rem] rounded-lg border border-line px-4 text-sm font-bold text-teal">
          Sonucu gör
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m-5-5 5 5 5-5" /></svg>
        </button>

        <p data-score-warn role="alert" tabindex="-1" hidden class="score-warn mt-4 rounded-xl bg-gradeAgainBg px-4 py-2.5 text-xs font-semibold text-gradeAgain"></p>

        <!-- Result cards -->
        <h4 id="score-results-heading" tabindex="-1" class="score-results-heading display text-lg text-ink mt-6">Puan sonucu</h4>
        <div class="mt-3 space-y-3.5" aria-live="polite">
          <div class="grid sm:grid-cols-3 gap-3.5">
            <div class="rounded-2xl bg-tint p-4">
              <div class="text-xs font-semibold text-teal">Tahmini Klinik (K) puanı</div>
              <div class="display text-3xl text-ink mt-1 tabular-nums" data-out-k>63,3</div>
              <div class="text-[11px] text-inkMuted mt-0.5" data-out-k-range>Aralık: 61,8 – 64,8</div>
            </div>
            <div class="rounded-2xl bg-surfaceSoft border border-line p-4">
              <div class="text-xs font-semibold text-inkMuted">Tahmini Temel (T) puanı</div>
              <div class="display text-3xl text-ink mt-1 tabular-nums" data-out-t>62,9</div>
              <div class="text-[11px] text-inkMuted mt-0.5" data-out-t-range>Aralık: 61,4 – 64,4</div>
            </div>
            <div class="rounded-2xl bg-surfaceSoft border border-line p-4">
              <div class="text-xs font-semibold text-inkMuted">Toplam net</div>
              <div class="display text-3xl text-teal mt-1 tabular-nums" data-out-totnet>123,50</div>
              <div class="text-[11px] text-inkMuted mt-0.5" data-out-baraj>K ve T 45 barajının üstünde</div>
            </div>
          </div>

          <div class="rounded-2xl bg-surfaceSoft border border-line p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <div class="text-xs font-semibold text-inkMuted">Tahmini sıralama bandı (Klinik puana göre)</div>
              <div class="display text-xl text-ink mt-0.5 tabular-nums" data-out-rank>~3.200 – 7.500 bandı</div>
            </div>
            <div class="text-xs text-inkMuted sm:text-right" data-out-rank-note>
              Orta-üst dilim · 2026/2 ilk yerleşen: 7.625 / 8.637 kontenjan
            </div>
          </div>
        </div>

        <div class="score-keyboard" data-score-keyboard hidden>
          <span class="text-sm font-semibold text-inkMuted" data-score-current-field></span>
          <button type="button" data-score-next-field class="min-h-[2.75rem] shrink-0 rounded-lg bg-teal px-3 text-sm font-bold text-white hover:bg-tealDark">Sonraki alan</button>
        </div>

        <div class="mt-5 space-y-2 text-xs text-inkMuted leading-relaxed border-t border-lineLight pt-4">
          <p>
            Resmî TUS puanını ÖSYM, her sınavın Türkiye ortalamasına ve standart sapmasına göre hesaplar.
