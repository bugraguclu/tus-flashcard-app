---
import Layout from '../layouts/Layout.astro';
import { breadcrumbList } from '../lib/schema';
import { publicationDates, pageSources } from '../lib/lastmod';

const origin = new URL(Astro.site!).origin;
const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'TUS Puan Hesaplayıcı', path: '/puan-hesapla' },
]);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'TusAnkiM TUS Puan ve Hedef Net Hesaplayıcı',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  inLanguage: 'tr-TR',
  url: origin + '/puan-hesapla/',
  author: { '@id': origin + '/#organization' },
  publisher: { '@id': origin + '/#organization' },
  isAccessibleForFree: true,
  ...publicationDates('website/src/pages/puan-hesapla.astro', pageSources('puan')),
};
---
<Layout
  title="TUS Puan Hesaplayıcı | TusAnkiM"
  description="Temel ve Klinik doğru/yanlış sayılarıyla netlerini ve tahmini TUS puanını hesapla; hedef puanın için gereken yaklaşık neti gör."
  schema={[crumbs, pageSchema]}
>
  <section class="page-intro bg-surface border-b border-line py-10 sm:py-14">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-6">
      <nav aria-label="Sayfa konumu" class="flex flex-wrap items-center gap-y-1 text-sm text-inkMuted mb-3">
        <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-ink font-semibold">TUS Puan Hesaplayıcı</span>
      </nav>

      <div class="section-num">Çalışma araçları</div>
      <h1 class="display text-page-title tracking-tightest text-ink mt-2 max-w-3xl">
        TUS puan hesaplayıcı
      </h1>
      <p class="text-inkMuted mt-3 max-w-2xl leading-relaxed">
        Temel (100 soru) ve Klinik (100 soru) doğru-yanlış sayılarınızdan netlerinizi ve tahmini TUS puanlarınızı anında hesaplayın;
        veya hedeflediğiniz puana ulaşmak için kaç net gerektiğini görün.
      </p>
    </div>
  </section>

  <!-- Main interactive calculator -->
  <section class="max-w-content mx-auto px-5 sm:px-6 lg:px-6 py-12" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="sr-only">İnteraktif TUS Puan Hesaplama Aracı</h2>

    <div class="grid lg:grid-cols-12 gap-8 items-start" data-tus-score-calc>
      <!-- Left: Forward Calculator -->
      <div class="lg:col-span-7 border-b border-line bg-white pb-8">
        <div class="section-num">Tahmini puan</div>
        <h3 class="display text-subsection text-ink mt-1">Doğru ve yanlış sayılarını gir</h3>
        <p class="text-sm text-inkMuted mt-1">
          ÖSYM kuralı: 4 yanlış 1 doğruyu götürür. Her oturum 100 sorudur (Toplam 200 soru).
        </p>

        <div class="mt-6 grid sm:grid-cols-2 gap-6">
          <!-- Temel Bilimler -->
          <fieldset class="rounded-xl border border-line bg-surfaceSoft p-4 space-y-3">
            <legend class="px-2 text-sm font-bold uppercase tracking-wider text-teal">Temel Bilimler (100 Soru)</legend>
            <div class="grid grid-cols-2 gap-3">
              <div class="score-field">
                <label for="tt-dogru" class="block text-sm font-semibold text-ink mb-1">Doğru</label>
                <input
                  id="tt-dogru"
                  type="number"
                  min="0"
                  max="100"
                  value="65"
                  inputmode="numeric"
                  enterkeyhint="next"
                  data-score-field="Temel · Doğru"
                  class="w-full min-h-[2.75rem] rounded-xl border border-line bg-white px-3 text-base font-bold text-ink tabular-nums"
                />
              </div>
              <div class="score-field">
                <label for="tt-yanlis" class="block text-sm font-semibold text-ink mb-1">Yanlış</label>
                <input
                  id="tt-yanlis"
                  type="number"
                  min="0"
                  max="100"
                  value="20"
                  inputmode="numeric"
                  enterkeyhint="next"
                  data-score-field="Temel · Yanlış"
                  class="w-full min-h-[2.75rem] rounded-xl border border-line bg-white px-3 text-base font-bold text-ink tabular-nums"
                />
              </div>
            </div>
            <div class="flex items-center justify-between text-sm pt-2 border-t border-lineLight">
              <span class="text-inkMuted">Boş: <strong data-tt-bos class="text-ink tabular-nums">15</strong></span>
              <span class="text-teal font-bold">Temel Net: <span data-tt-net class="tabular-nums">60,00</span></span>
            </div>
          </fieldset>

          <!-- Klinik Bilimler -->
          <fieldset class="rounded-xl border border-line bg-surfaceSoft p-4 space-y-3">
            <legend class="px-2 text-sm font-bold uppercase tracking-wider text-teal">Klinik Bilimler (100 Soru)</legend>
            <div class="grid grid-cols-2 gap-3">
              <div class="score-field">
                <label for="kt-dogru" class="block text-sm font-semibold text-ink mb-1">Doğru</label>
                <input
                  id="kt-dogru"
                  type="number"
                  min="0"
                  max="100"
                  value="68"
                  inputmode="numeric"
                  enterkeyhint="next"
                  data-score-field="Klinik · Doğru"
                  class="w-full min-h-[2.75rem] rounded-xl border border-line bg-white px-3 text-base font-bold text-ink tabular-nums"
                />
              </div>
              <div class="score-field">
                <label for="kt-yanlis" class="block text-sm font-semibold text-ink mb-1">Yanlış</label>
                <input
                  id="kt-yanlis"
                  type="number"
                  min="0"
                  max="100"
                  value="18"
                  inputmode="numeric"
                  enterkeyhint="done"
                  data-score-field="Klinik · Yanlış"
                  class="w-full min-h-[2.75rem] rounded-xl border border-line bg-white px-3 text-base font-bold text-ink tabular-nums"
                />
              </div>
            </div>
            <div class="flex items-center justify-between text-sm pt-2 border-t border-lineLight">
              <span class="text-inkMuted">Boş: <strong data-kt-bos class="text-ink tabular-nums">14</strong></span>
              <span class="text-teal font-bold">Klinik Net: <span data-kt-net class="tabular-nums">63,50</span></span>
            </div>
          </fieldset>
        </div>

        <div class="mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 rounded-xl border border-line bg-surfaceSoft px-4 py-1.5">
          <div class="flex items-center gap-3">
            <input
              id="puan-kesinti"
              type="checkbox"
              aria-describedby="puan-kesinti-status"
              class="w-5 h-5 shrink-0 accent-[#0e7469] rounded cursor-pointer"
            />
            <label for="puan-kesinti" class="inline-flex flex-wrap items-center min-h-[2.75rem] py-1.5 text-sm sm:text-sm font-semibold text-ink cursor-pointer select-none">
              %5 Puan Kesintisi Uygula&nbsp;<span class="font-normal text-inkMuted">(uzmanlığa devam / istifa / başlamama)</span>
            </label>
          </div>
          <span id="puan-kesinti-status" data-kesinti-status class="text-sm font-medium text-inkMuted shrink-0">
            Kesinti uygulanmıyor
          </span>
        </div>

        <button type="button" data-score-results-button hidden class="score-results-button mt-4 min-h-[2.75rem] rounded-lg border border-line px-4 text-sm font-bold text-teal">
          Sonucu gör
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m-5-5 5 5 5-5" /></svg>
        </button>

        <p data-score-warn role="alert" tabindex="-1" hidden class="score-warn mt-4 rounded-xl bg-gradeAgainBg px-4 py-2.5 text-sm font-semibold text-gradeAgain"></p>

        <section class="mt-6" aria-labelledby="score-results-heading">
          <h4 id="score-results-heading" tabindex="-1" class="score-results-heading display text-lg text-ink">Puan sonucu</h4>
          <div class="mt-3 grid sm:grid-cols-3 gap-3.5" aria-live="polite">
            <div class="rounded-xl bg-tint p-4">
              <div class="text-sm font-semibold text-teal">Tahmini Klinik (K) Puanı</div>
              <div class="display text-3xl text-ink mt-1 tabular-nums" data-out-k>63,1</div>
              <div class="text-xs text-inkMuted mt-0.5" data-out-k-range>Aralık: 61,6 – 64,6</div>
            </div>
            <div class="rounded-xl bg-surfaceSoft border border-line p-4">
              <div class="text-sm font-semibold text-inkMuted">Tahmini Temel (T) Puanı</div>
              <div class="display text-3xl text-ink mt-1 tabular-nums" data-out-t>62,7</div>
              <div class="text-xs text-inkMuted mt-0.5" data-out-t-range>Aralık: 61,2 – 64,2</div>
            </div>
            <div class="rounded-xl bg-surfaceSoft border border-line p-4">
              <div class="text-sm font-semibold text-inkMuted">Toplam Net</div>
              <div class="display text-3xl text-teal mt-1 tabular-nums" data-out-totnet>123,50</div>
              <div class="text-xs text-inkMuted mt-0.5" data-out-baraj>K ve T 45 barajı üzerinde</div>
            </div>
          </div>
        </section>

        <div class="score-keyboard" data-score-keyboard hidden>
          <span class="text-sm font-semibold text-inkMuted" data-score-current-field></span>
          <button type="button" data-score-next-field class="min-h-[2.75rem] shrink-0 rounded-lg bg-teal px-3 text-sm font-bold text-white hover:bg-tealDark">Sonraki alan</button>
        </div>

        <p class="mt-5 text-sm text-inkMuted leading-relaxed border-t border-lineLight pt-4">
          <strong>Şeffaflık notu:</strong> Resmî TUS puanları her dönemin Türkiye ortalaması ve standart sapmasına göre ÖSYM tarafından hesaplanır.
          Buradaki sonuçlar son dönem TUS dağılım katsayılarına (Temel puanı: %70 Temel + %30 Klinik; Klinik puanı: %50 Temel + %50 Klinik ağırlık) dayanan <em>yaklaşık ±1,5 puan</em> öngörüsüdür; resmî yerleştirme belgesi yerine geçmez.
        </p>
      </div>

      <!-- Right: Reverse Target Net Planner -->
      <div class="lg:col-span-5 rounded-xl border border-line bg-surfaceSoft p-5 sm:p-6 space-y-5">
        <div class="section-num">Hedef net</div>
        <h3 class="display text-subsection text-ink">Hedef puanın için kaç net gerekir?</h3>

        <div>
          <div class="flex items-baseline justify-between">
            <label for="target-score" class="text-sm font-semibold text-ink">Hedef TUS Klinik Puanı</label>
            <span class="display text-2xl text-teal tabular-nums" data-target-val>65,0</span>
          </div>
          <input
            id="target-score"
            type="range"
            min="45"
            max="80"
            step="0.5"
            value="65"
            class="mt-1 w-full min-h-[2.75rem] py-3 accent-[#0e7469] rounded-lg cursor-pointer"
          />
          <div class="flex justify-between text-xs text-inkMuted tabular-nums">
            <span>45 (Baraj)</span>
            <span>60</span>
            <span>70</span>
            <span>80</span>
          </div>
        </div>

        <div class="rounded-xl border border-line bg-white p-5 space-y-3" aria-live="polite">
          <div class="flex items-center justify-between text-sm">
            <span class="text-inkMuted">Gereken yaklaşık toplam net</span>
            <strong class="display text-lg text-teal tabular-nums" data-req-total>~130 net</strong>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-inkMuted">Oturum başına ortalama (Temel / Klinik)</span>
            <strong class="font-bold text-ink tabular-nums" data-req-each>~65 / 100</strong>
          </div>
          <div class="pt-3 border-t border-lineLight text-sm text-inkMuted leading-relaxed" data-req-tip>Hedef net, bu sayfadaki tahmini puan modeline göre hesaplanır. Resmî sonuç, sınav döneminin ortalama ve standart sapmasına bağlıdır.</div>
        </div>

        <a
          href="/yardim/fsrs/"
          class="inline-flex items-center justify-center w-full min-h-[2.75rem] rounded-lg bg-teal text-white text-sm font-bold hover:bg-tealDark transition"
        >
          Aralıklı tekrar rehberini oku
        </a>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-line max-w-3xl">
      <h2 class="display text-lg text-ink">%5 Puan Kesintisi Kuralı</h2>
      <p class="text-sm text-inkMuted mt-2 leading-relaxed">Kesinti kapsamındaysan hesaplayıcıdaki seçeneği açabilirsin. Koşulları ve tercih işlemlerini sınava girdiğin dönemin resmî ÖSYM kılavuzundan kontrol et.</p>
      <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1">
        <a href="/tus-calisma-rehberi/#puan-ve-mevzuat" class="text-link">Puan ağırlıkları, baraj ve %5 kesinti rehberi →</a>
        <a href="/tus-calisma-rehberi/#brans-stratejisi" class="text-link">11 branş çalışma stratejisi →</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .score-field input {
    transition: box-shadow 150ms ease-out;
  }

  .score-field:focus-within label { color: #0e7469; }

  .score-field input:focus {
    outline: 2px solid #0e7469;
    outline-offset: 2px;
    box-shadow: 0 0 0 6px #e4f4f1;
  }

  .score-results-heading {
    width: fit-content;
    scroll-margin-block-start: .5rem;
  }

  .score-results-heading:focus, .score-warn:focus {
    border-radius: .25rem;
    outline: 2px solid #0e7469;
    outline-offset: 4px;
  }

  .score-results-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
  }

  .score-results-button:hover { background: #e4f4f1; }

  .score-keyboard {
    position: fixed;
    z-index: 45;
    inset-inline: 0;
    top: var(--score-keyboard-bottom);
    transform: translateY(-100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding: .375rem max(1rem, env(safe-area-inset-right)) .375rem max(1rem, env(safe-area-inset-left));
    background: #fff;
    border-top: 1px solid #dde1e4;
    box-shadow: 0 -4px 16px #24292c12;
  }

  [data-tus-score-calc]:has(.score-keyboard:not([hidden])) .score-results-button,
  .score-results-button[hidden], .score-keyboard[hidden] { display: none; }
</style>

<script>
  import { enhanceScoreKeyboard } from '../lib/scoreKeyboard';

  document.querySelectorAll<HTMLElement>('[data-tus-score-calc]').forEach((root) => {
    const ttD = root.querySelector<HTMLInputElement>('#tt-dogru');
    const ttY = root.querySelector<HTMLInputElement>('#tt-yanlis');
    const ktD = root.querySelector<HTMLInputElement>('#kt-dogru');
    const ktY = root.querySelector<HTMLInputElement>('#kt-yanlis');
    const kesintiEl = root.querySelector<HTMLInputElement>('#puan-kesinti');
    const kesintiStatusEl = root.querySelector<HTMLElement>('[data-kesinti-status]');
    const targetRange = root.querySelector<HTMLInputElement>('#target-score');

    const ttBosEl = root.querySelector<HTMLElement>('[data-tt-bos]');
    const ttNetEl = root.querySelector<HTMLElement>('[data-tt-net]');
    const ktBosEl = root.querySelector<HTMLElement>('[data-kt-bos]');
    const ktNetEl = root.querySelector<HTMLElement>('[data-kt-net]');
    const warnEl = root.querySelector<HTMLElement>('[data-score-warn]');

    const outK = root.querySelector<HTMLElement>('[data-out-k]');
    const outKRange = root.querySelector<HTMLElement>('[data-out-k-range]');
    const outT = root.querySelector<HTMLElement>('[data-out-t]');
    const outTRange = root.querySelector<HTMLElement>('[data-out-t-range]');
    const outTot = root.querySelector<HTMLElement>('[data-out-totnet]');
    const outBaraj = root.querySelector<HTMLElement>('[data-out-baraj]');

    const targetValEl = root.querySelector<HTMLElement>('[data-target-val]');
    const reqTotalEl = root.querySelector<HTMLElement>('[data-req-total]');
    const reqEachEl = root.querySelector<HTMLElement>('[data-req-each]');
    const reqTipEl = root.querySelector<HTMLElement>('[data-req-tip]');

    const fmt = (n: number, d = 1) => n.toFixed(d).replace('.', ',');
    const clamp = (n: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, Number.isFinite(n) ? n : 0));

    // Recent ÖSYM TUS standardized-score linear approximation (mean ~45 net => ~50 pts, ~0.27-0.29 pts per weighted net)
    // T = 0.7 * Temel + 0.3 * Klinik for T-score orientation vs K = 0.5 * Temel + 0.5 * Klinik
    function estimateScores(tNet: number, kNet: number) {
      const kScore = clamp(28.5 + 0.28 * (tNet + kNet), 15, 86);
      const tScore = clamp(28.5 + 0.39 * tNet + 0.17 * kNet, 15, 86);
      return { kScore, tScore };
    }

    function updateForward() {
      const td = clamp(Number(ttD?.value), 0, 100);
      const ty = clamp(Number(ttY?.value), 0, 100);
      const kd = clamp(Number(ktD?.value), 0, 100);
      const ky = clamp(Number(ktY?.value), 0, 100);

      const badT = td + ty > 100;
      const badK = kd + ky > 100;
      if (warnEl) {
        if (badT || badK) {
          warnEl.textContent = 'Doğru + yanlış toplamı bir oturumda 100 soruyu geçemez. Lütfen değerleri düzeltin.';
          warnEl.hidden = false;
        } else {
          warnEl.hidden = true;
        }
      }

      const safeTy = Math.min(ty, 100 - td);
      const safeKy = Math.min(ky, 100 - kd);
      const tBos = 100 - td - safeTy;
      const kBos = 100 - kd - safeKy;
      const tNet = Math.max(0, td - safeTy / 4);
      const kNet = Math.max(0, kd - safeKy / 4);
      const totNet = tNet + kNet;
      const raw = estimateScores(tNet, kNet);
      const hasKesinti = Boolean(kesintiEl?.checked);
      const mult = hasKesinti ? 0.95 : 1;
      const kScore = raw.kScore * mult;
      const tScore = raw.tScore * mult;

      if (kesintiStatusEl) {
        if (hasKesinti) {
          kesintiStatusEl.textContent = `%5 kesinti aktif (×0,95 · ham K: ${fmt(raw.kScore, 1)})`;
          kesintiStatusEl.className = 'text-sm font-semibold text-warm shrink-0';
        } else {
          kesintiStatusEl.textContent = 'Kesinti uygulanmıyor';
          kesintiStatusEl.className = 'text-sm font-medium text-inkMuted shrink-0';
        }
      }

      const setIfChanged = (el: HTMLElement | null, val: string) => {
        if (el && el.textContent !== val) el.textContent = val;
      };

      setIfChanged(ttBosEl, String(tBos));
      setIfChanged(ttNetEl, fmt(tNet, 2));
      setIfChanged(ktBosEl, String(kBos));
      setIfChanged(ktNetEl, fmt(kNet, 2));
      setIfChanged(outK, fmt(kScore, 1));
      setIfChanged(outKRange, `Aralık: ${fmt(Math.max(0, kScore - 1.5), 1)} – ${fmt(Math.min(100, kScore + 1.5), 1)}`);
      setIfChanged(outT, fmt(tScore, 1));
      setIfChanged(outTRange, `Aralık: ${fmt(Math.max(0, tScore - 1.5), 1)} – ${fmt(Math.min(100, tScore + 1.5), 1)}`);
      setIfChanged(outTot, fmt(totNet, 2));
      const barajText =
        kScore >= 45 && tScore >= 45
          ? 'K ve T 45 barajı üzerinde'
          : kScore >= 45
            ? 'K 45 barajı üzerinde · T 45 altında'
            : tScore >= 45
              ? 'T 45 barajı üzerinde · K 45 altında'
              : 'K ve T 45 barajı altında';
      setIfChanged(outBaraj, barajText);
    }

    function updateReverse() {
      const target = clamp(Number(targetRange?.value), 45, 80);
      const hasKesinti = Boolean(kesintiEl?.checked);
      const reqTotal = Math.min(192, Math.max(55, Math.round((target - 28.5) / 0.28)));
      const reqEach = Math.round(reqTotal / 2);

      const setIfChanged = (el: HTMLElement | null, val: string) => {
        if (el && el.textContent !== val) el.textContent = val;
      };

      setIfChanged(targetValEl, fmt(target, 1));
      setIfChanged(reqTotalEl, `~${reqTotal} net`);
      setIfChanged(reqEachEl, `~${reqEach} / 100`);
      if (reqTipEl) {
        const baseTip = 'Hedef net, bu sayfadaki tahmini puan modeline göre hesaplanır. Resmî sonuç, sınav döneminin ortalama ve standart sapmasına bağlıdır.';
        if (hasKesinti) {
          const rawNeeded = target / 0.95;
          const reqKesintiTotal = Math.min(200, Math.max(55, Math.round((rawNeeded - 28.5) / 0.28)));
          const kesintiNote =
            rawNeeded > 86
              ? ` %5 kesinti etkinken ${fmt(target, 1)} net puan için ham puan hedefi (${fmt(rawNeeded, 1)}) üst sınav bandına dayanır.`
              : ` %5 kesinti aktifken bu hedefe ulaşmak için ham puanın ~${fmt(rawNeeded, 1)} (yaklaşık ~${reqKesintiTotal} toplam net) olması gerekir.`;
          setIfChanged(reqTipEl, baseTip + kesintiNote);
        } else {
          setIfChanged(reqTipEl, baseTip);
        }
      }
    }

    [ttD, ttY, ktD, ktY].forEach((el) => el?.addEventListener('input', updateForward));
    enhanceScoreKeyboard(root);
    kesintiEl?.addEventListener('change', () => {
      updateForward();
      updateReverse();
    });
    targetRange?.addEventListener('input', updateReverse);

    updateForward();
    updateReverse();
  });
</script>
