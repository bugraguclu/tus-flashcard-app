<script>
  import { enhanceScoreKeyboard } from '../lib/scoreKeyboard';

  document.querySelectorAll<HTMLElement>('[data-tus-score-calc]').forEach((root) => {
    const ttD = root.querySelector<HTMLInputElement>('#tt-dogru');
    const ttY = root.querySelector<HTMLInputElement>('#tt-yanlis');
    const ktD = root.querySelector<HTMLInputElement>('#kt-dogru');
    const ktY = root.querySelector<HTMLInputElement>('#kt-yanlis');
    const kesintiEl = root.querySelector<HTMLInputElement>('#puan-kesinti');
    const kesintiStatusEl = root.querySelector<HTMLElement>('[data-kesinti-status]');
    const targetRange = root.querySelector<HTMLInputElement>('#target-score');

    const ttBosEl = root.querySelector<HTMLElement>('[data-tt-bos]');
    const ttNetEl = root.querySelector<HTMLElement>('[data-tt-net]');
    const ktBosEl = root.querySelector<HTMLElement>('[data-kt-bos]');
    const ktNetEl = root.querySelector<HTMLElement>('[data-kt-net]');
    const warnEl = root.querySelector<HTMLElement>('[data-score-warn]');

    const outK = root.querySelector<HTMLElement>('[data-out-k]');
    const outKRange = root.querySelector<HTMLElement>('[data-out-k-range]');
    const outT = root.querySelector<HTMLElement>('[data-out-t]');
    const outTRange = root.querySelector<HTMLElement>('[data-out-t-range]');
    const outTot = root.querySelector<HTMLElement>('[data-out-totnet]');
    const outBaraj = root.querySelector<HTMLElement>('[data-out-baraj]');
    const outRank = root.querySelector<HTMLElement>('[data-out-rank]');
    const outRankNote = root.querySelector<HTMLElement>('[data-out-rank-note]');

    const modeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-calc-mode]')];
    const panelGenel = root.querySelector<HTMLElement>('[data-panel-genel]');
    const panelDers = root.querySelector<HTMLElement>('[data-panel-ders]');
    const subjInputs = [...root.querySelectorAll<HTMLInputElement>('[data-subj-id]')];
    const dersTtNetEl = root.querySelector<HTMLElement>('[data-ders-tt-net]');
    const dersKtNetEl = root.querySelector<HTMLElement>('[data-ders-kt-net]');

    const targetValEl = root.querySelector<HTMLElement>('[data-target-val]');
    const reqTotalEl = root.querySelector<HTMLElement>('[data-req-total]');
    const reqEachEl = root.querySelector<HTMLElement>('[data-req-each]');
    const reqTipEl = root.querySelector<HTMLElement>('[data-req-tip]');

    const fmt = (n: number, d = 1) => n.toFixed(d).replace('.', ',');
    const clamp = (n: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, Number.isFinite(n) ? n : 0));

    function estimateScores(tNet: number, kNet: number) {
      // ÖSYM kılavuzu (4.2): K = 0,4 Temel + 0,6 Klinik; T = 0,6 Temel + 0,4 Klinik.
      // 0.56 puan/net eğimi tahmindir; iki testin dağılımını eşit sayar.
      const kScore = clamp(28.5 + 0.56 * (0.4 * tNet + 0.6 * kNet), 15, 85);
      const tScore = clamp(28.5 + 0.56 * (0.6 * tNet + 0.4 * kNet), 15, 85);
      return { kScore, tScore };
    }

    function estimateRankBand(kScore: number): { band: string; note: string } {
      if (kScore < 45) {
        return {
          band: '45 barajı altı (yerleştirme dışı)',
          note: '45,000 puan altında tercih hakkı oluşmaz · ~26.000+ sıra ölçeği',
        };
      }
      if (kScore < 55) {
        return {
          band: '~16.000 – 26.000+ bandı',
          note: 'Baraj üstü başlangıç dilimi · 2026/2 ilk yerleşen: 7.625 / 8.637 kontenjan',
        };
      }
      if (kScore < 60) {
        return {
          band: '~7.500 – 16.000 bandı',
          note: 'Orta dilim · 2026/2 ilk yerleşen: 7.625 / 8.637 kontenjan',
        };
      }
      if (kScore < 65) {
        return {
          band: '~3.200 – 7.500 bandı',
          note: 'Orta-üst dilim · 2026/2 ilk yerleşen: 7.625 / 8.637 kontenjan',
        };
      }
      if (kScore < 70) {
        return {
          band: '~1.100 – 3.200 bandı',
          note: 'Üst dilim · 2026/2 ilk yerleşen: 7.625 / 8.637 kontenjan',
        };
      }
      if (kScore < 75) {
        return {
          band: '~300 – 1.100 bandı',
          note: 'Yüksek rekabet dilimi · 2026/2 ilk yerleşen: 7.625 / 8.637 kontenjan',
        };
      }
      return {
        band: 'İlk ~300 bandı',
        note: 'En üst yüzde dilimi · 2026/2 ilk yerleşen: 7.625 / 8.637 kontenjan',
      };
    }

    let subjectOverflowWarn = '';

    function syncFromSubjects() {
      const byId = new Map<string, { group: string; name: string; max: number; d: number; y: number }>();
      for (const inp of subjInputs) {
        const id = inp.dataset.subjId || '';
        const group = inp.dataset.subjGroup || '';
        const kind = inp.dataset.subjKind || '';
        const name = inp.dataset.subjName || id;
        const maxQ = Number(inp.dataset.subjMax || 25);
        const cur = byId.get(id) ?? { group, name, max: maxQ, d: 0, y: 0 };
        const val = clamp(Number(inp.value), 0, maxQ);
        if (kind === 'd') cur.d = val;
        else cur.y = val;
        byId.set(id, cur);
      }

      let tdSum = 0;
      let tySum = 0;
      let kdSum = 0;
      let kySum = 0;
      const badNames: string[] = [];

      for (const [id, entry] of byId.entries()) {
        if (entry.d + entry.y > entry.max) {
          badNames.push(`${entry.name} (${entry.max} soru)`);
        }
        const safeY = Math.min(entry.y, entry.max - entry.d);
        const sNet = Math.max(0, entry.d - safeY / 4);
        const netEl = root.querySelector<HTMLElement>(`[data-subj-net="${id}"]`);
        if (netEl) netEl.textContent = fmt(sNet, 2);

        if (entry.group === 'temel') {
          tdSum += entry.d;
          tySum += safeY;
        } else {
          kdSum += entry.d;
          kySum += safeY;
        }
      }

      subjectOverflowWarn = badNames.length
        ? `${badNames[0]} için doğru ve yanlış toplamı soru sayısını geçemez. Değerleri düzelt.`
        : '';

      if (ttD) ttD.value = String(tdSum);
      if (ttY) ttY.value = String(tySum);
      if (ktD) ktD.value = String(kdSum);
      if (ktY) ktY.value = String(kySum);
      if (dersTtNetEl) dersTtNetEl.textContent = fmt(Math.max(0, tdSum - tySum / 4), 2);
      if (dersKtNetEl) dersKtNetEl.textContent = fmt(Math.max(0, kdSum - kySum / 4), 2);
      updateForward();
    }

    function setMode(mode: 'genel' | 'ders') {
      const isDers = mode === 'ders';
      if (panelGenel) panelGenel.hidden = isDers;
      if (panelDers) panelDers.hidden = !isDers;
      for (const btn of modeButtons) {
        const active = btn.dataset.calcMode === mode;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.className = active
          ? 'min-h-[2.75rem] px-4 rounded-xl text-xs sm:text-sm font-semibold transition bg-teal text-white cursor-pointer'
          : 'min-h-[2.75rem] px-4 rounded-xl text-xs sm:text-sm font-semibold transition text-ink hover:bg-white cursor-pointer';
      }
      if (isDers) {
        syncFromSubjects();
      } else {
        subjectOverflowWarn = '';
        updateForward();
      }
    }

    function updateForward() {
      const td = clamp(Number(ttD?.value), 0, 100);
      const ty = clamp(Number(ttY?.value), 0, 100);
      const kd = clamp(Number(ktD?.value), 0, 100);
      const ky = clamp(Number(ktY?.value), 0, 100);

      const badT = td + ty > 100;
      const badK = kd + ky > 100;
      if (warnEl) {
        if (subjectOverflowWarn) {
          warnEl.textContent = subjectOverflowWarn;
          warnEl.hidden = false;
        } else if (badT || badK) {
          warnEl.textContent = 'Doğru ve yanlış toplamı bir oturumda 100 soruyu geçemez. Değerleri düzelt.';
          warnEl.hidden = false;
        } else {
          warnEl.hidden = true;
        }
      }

      const safeTy = Math.min(ty, 100 - td);
      const safeKy = Math.min(ky, 100 - kd);
      const tBos = 100 - td - safeTy;
      const kBos = 100 - kd - safeKy;
      const tNet = Math.max(0, td - safeTy / 4);
      const kNet = Math.max(0, kd - safeKy / 4);
      const totNet = tNet + kNet;
      const raw = estimateScores(tNet, kNet);
      const hasKesinti = Boolean(kesintiEl?.checked);
      const mult = hasKesinti ? 0.95 : 1;
      const kScore = raw.kScore * mult;
      const tScore = raw.tScore * mult;
      const rankInfo = estimateRankBand(kScore);

      if (kesintiStatusEl) {
        if (hasKesinti) {
          kesintiStatusEl.textContent = `%5 kesinti uygulanıyor (×0,95 · kesinti öncesi K: ${fmt(raw.kScore, 1)})`;
          kesintiStatusEl.className = 'text-xs font-semibold text-warm shrink-0';
        } else {
          kesintiStatusEl.textContent = 'Kesinti uygulanmıyor';
          kesintiStatusEl.className = 'text-xs text-inkMuted shrink-0';
        }
      }

      const setIfChanged = (el: HTMLElement | null, val: string) => {
        if (el && el.textContent !== val) el.textContent = val;
      };

      setIfChanged(ttBosEl, String(tBos));
      setIfChanged(ttNetEl, fmt(tNet, 2));
      setIfChanged(ktBosEl, String(kBos));
      setIfChanged(ktNetEl, fmt(kNet, 2));
      setIfChanged(outK, fmt(kScore, 1));
      setIfChanged(outKRange, `Aralık: ${fmt(Math.max(0, kScore - 1.5), 1)} – ${fmt(Math.min(100, kScore + 1.5), 1)}`);
      setIfChanged(outT, fmt(tScore, 1));
      setIfChanged(outTRange, `Aralık: ${fmt(Math.max(0, tScore - 1.5), 1)} – ${fmt(Math.min(100, tScore + 1.5), 1)}`);
      setIfChanged(outTot, fmt(totNet, 2));
      setIfChanged(outRank, rankInfo.band);
      setIfChanged(outRankNote, rankInfo.note);
      const barajText =
        kScore >= 45 && tScore >= 45
          ? 'K ve T 45 barajının üstünde'
          : kScore >= 45
            ? 'K 45 barajının üstünde · T altında'
            : tScore >= 45
              ? 'T 45 barajının üstünde · K altında'
              : 'K ve T 45 barajının altında';
      setIfChanged(outBaraj, barajText);
    }

    function updateReverse() {
      const target = clamp(Number(targetRange?.value), 45, 80);
      const hasKesinti = Boolean(kesintiEl?.checked);
      const reqTotal = Math.min(192, Math.max(55, Math.round((target - 28.5) / 0.28)));
      const reqEach = Math.round(reqTotal / 2);

      const setIfChanged = (el: HTMLElement | null, val: string) => {
        if (el && el.textContent !== val) el.textContent = val;
      };

      setIfChanged(targetValEl, fmt(target, 1));
      setIfChanged(reqTotalEl, `~${reqTotal} net`);
      setIfChanged(reqEachEl, `~${reqEach} / 100`);
      if (reqTipEl) {
        let baseTip = '';
        if (target >= 70) {
          baseTip =
            '70 ve üstü puan isteyen branşlar için hem temel bilimlere hâkim olman hem de klinik ayrımları hatasız hatırlaman gerekir. Günde 60–80 yeni kart ve deneme analizi bu hedefe uygun.';
        } else if (target >= 60) {
          baseTip =
            'Düzenli FSRS-6 tekrarıyla günde 60 yeni kart çalışırsan 9.575 kartı 160 günde bitirir, son ayları denemelerdeki eksiklerine ayırırsın.';
        } else {
          baseTip =
            '45–60 puan için en çok soru getiren temel ve klinik kartlardan başla. Günde 40 yeni kart yaklaşık 60 dakika tutar.';
        }
        if (hasKesinti) {
          const rawNeeded = target / 0.95;
          const reqKesintiTotal = Math.min(200, Math.max(55, Math.round((rawNeeded - 28.5) / 0.28)));
          const kesintiNote =
            rawNeeded > 86
              ? ` %5 kesintiyle ${fmt(target, 1)} puan için kesinti öncesi ${fmt(rawNeeded, 1)} puan gerekir; bu, sınavın en üst puanlarına denk gelir.`
              : ` %5 kesintiyle bu hedef için kesinti öncesi puanının ~${fmt(rawNeeded, 1)} olması gerekir (yaklaşık ${reqKesintiTotal} toplam net).`;
          setIfChanged(reqTipEl, baseTip + kesintiNote);
        } else {
          setIfChanged(reqTipEl, baseTip);
        }
      }
    }

    [ttD, ttY, ktD, ktY].forEach((el) => el?.addEventListener('input', () => {
      subjectOverflowWarn = '';
      updateForward();
    }));
    subjInputs.forEach((el) => el.addEventListener('input', syncFromSubjects));
    modeButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        setMode(btn.dataset.calcMode === 'ders' ? 'ders' : 'genel');
      }),
    );
    kesintiEl?.addEventListener('change', () => {
      updateForward();
      updateReverse();
    });
    targetRange?.addEventListener('input', updateReverse);

    updateForward();
    updateReverse();
    enhanceScoreKeyboard(root);
  });
</script>
