---
import Layout from '../layouts/Layout.astro';
import CountdownBand from '../components/CountdownBand.astro';
import LiveCardDemo from '../components/LiveCardDemo.astro';
import ReferenceShowcase from '../components/ReferenceShowcase.astro';
import FsrsDoseCalculator from '../components/FsrsDoseCalculator.astro';
import StoryBands, { type StoryBand } from '../components/StoryBands.astro';
import BeforeAfter, { type BeforeAfterData } from '../components/BeforeAfter.astro';
import InstagramRail from '../components/InstagramRail.astro';
import SponsorsBand from '../components/SponsorsBand.astro';
import FaqTabs from '../components/FaqTabs.astro';

import catalog from '../data/generated/catalog.json';
import refSummary from '../data/generated/references-summary.json';
import offer from '../data/offer.json';
import founder from '../data/founder.json';
import { SITE, WHATSAPP, SHOW_PRICING_PROMO, PRICING_MODE } from '../config';
import { dateModified, pageSources } from '../lib/lastmod';

const origin = new URL(Astro.site!).origin;

type OfferTier = {
  id: string;
  name: string;
  badge: string;
  price: string;
  oldPrice?: string;
  period: string;
  highlight: boolean;
  summary: string;
  features: string[];
  ctaLabel: string;
  ctaHref: string;
  external: boolean;
};

const activeOffer: {
  badge: string;
  headline: string;
  subheadline: string;
  tiers: OfferTier[];
  note: string;
  heroBullet: string;
  heroSecondaryCta: string;
  comparisonCostCell: string;
  schemaOfferDescription: string;
} = PRICING_MODE === 'free-beta'
  ? {
      badge: offer.freeBeta.badge,
      headline: offer.freeBeta.headline,
      subheadline: offer.freeBeta.subheadline,
      tiers: offer.freeBeta.tiers,
      note: offer.freeBeta.transparencyNote,
      heroBullet: offer.freeBeta.heroBullet,
      heroSecondaryCta: 'Ücretsiz Beta’yı Aç (9.575 Kart)',
      comparisonCostCell: 'Açık beta: ücretsiz · Lansman ₺50/ay',
      schemaOfferDescription: offer.freeBeta.schemaOfferDescription,
    }
  : {
      badge: offer.badge,
      headline: offer.headline,
      subheadline: offer.subheadline,
      tiers: offer.tiers,
      note: offer.betaTransparencyNote,
      heroBullet: 'Lansmana özel ayda ₺50 tam erişim',
      heroSecondaryCta: 'Ücretsiz Başla (Günde 200 Kart)',
      comparisonCostCell: 'Günde 200 kart ücretsiz · Lansman ₺50/ay',
      schemaOfferDescription: 'Günde 200 karta kadar ücretsiz; lansmana özel sınırsız tam erişim ayda ₺50.',
    };

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': origin + '/#webpage',
    url: origin + '/',
    name: 'TusAnkiM — TUS Aralıklı Tekrar, 9.575 Kart ve Referans Kanıtı',
    description: SITE.description,
    inLanguage: 'tr-TR',
    isPartOf: { '@id': origin + '/#website' },
    about: { '@id': origin + '/#brand' },
    ...dateModified(pageSources('home')),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'TusAnkiM',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'iOS, Web',
    inLanguage: 'tr-TR',
    description: SITE.description,
    url: origin + '/',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'TRY',
      description: activeOffer.schemaOfferDescription,
    },
  },
];

const storyBands: StoryBand[] = [
  {
    img: '/images/band-fsrs.svg',
    imgAlt: 'FSRS-6 aralıklı tekrar unutma eğrisi ile pasif okumanın karşılaştırma grafiği',
    kicker: 'Aralıklı Tekrar · FSRS-6 Motoru',
    heading: 'Pasif okuma 72 saatte uçar; FSRS-6 tam unutacağın gün hatırlatır',
    text: 'Aynı konu kitabını baştan sona üç kez okumak zaman kaybettirir. TusAnkiM’in yerleşik FSRS-6 algoritması her kartta hafıza kararlılığını ve zorluğunu ayrı ölçer; bildiğin kartları haftalar sonrasına atar, zorlandığın ayrımları tam unutma eşiğinde önüne getirir.',
    bullets: [
      'Aynı %90 hatırlama hedefine klasik tekrarlara göre %20–30 daha az kartla ulaşın.',
      'Kendi çalışma geçmişinizden FSRS parametre optimizasyonu ve kolay günler (Easy Days) desteği.',
      'Yazı tahtası, klavye kısayolları ve tek dokunuşla geri alma ile kesintisiz odak.',
    ],
    ctaLabel: 'FSRS-6 nasıl çalışır? Kılavuzu oku',
    ctaHref: '/yardim/fsrs/',
  },
  {
    img: '/images/band-kronometre.svg',
    imgAlt: 'TusAnkiM Kronometre, haftalık çalışma takvimi ve detaylı çalışma planı ekranı',
    kicker: 'TUS Çalışma Merkezi · Kronometre & Plan',
    heading: 'Kronometre, Çalışma Takvimi ve Çalışma Planı tek uygulamada',
    text: 'Sadece kart çalışmak yetmez; konu tekrarı, deneme süresi ve günlük çalışma disiplini bir bütün olmalı. Kronometre oturumlarınız kart tekrarlarınızla aynı Çalışma Takviminde birleşir.',
    bullets: [
      'Blok hatırlatmaları ve mola takibiyle kesintisiz çalışma serisi.',
      'Sınav tarihinize göre haftalık ve ders bazlı Detaylı Çalışma Planlama sihirbazı.',
      'Çalışma Analiziniz ekranıyla gerçek hızınızı ve en verimli saatlerinizi görün.',
    ],
    ctaLabel: 'Kronometre ve Takvim rehberi',
    ctaHref: '/yardim/kronometre/',
    flip: true,
  },
  {
    img: '/images/band-anki-compat.svg',
    imgAlt: 'Anki .apkg ve .colpkg uyumluluğu ve iPhone ile Web platform desteği',
    kicker: 'Bütün Platformlarda Çalış · Anki Uyumu',
    heading: 'Bir kere başla, Anki uyumlu (.apkg / .colpkg) motorla her yerde çalış',
    text: 'Kendi oluşturduğun destelere asla kilit vurulmaz. iPhone uygulamasında çevrimdışı çalış, Mac, Windows, iPad veya Android tarayıcıda Web üzerinden devam et; elindeki Anki destelerini medyası ve geçmişiyle içeri al.',
    bullets: [
      'iPhone uygulaması ve Web tarayıcı (Mac, Windows, iPad, Android tarayıcı) bugün aktif.',
      'Kişisel destelerde .apkg, .colpkg ve CSV/TSV tam içe/dışa aktarım uyumu.',
      'Otomatik Bulut Eşitleme, yerel Android uygulaması ve TUS Tercih Simülasyonu yol haritamızda (Yakında).',
    ],
    ctaLabel: 'Anki ile birlikte kullanma rehberi',
    ctaHref: '/yardim/anki-ile-kullanma/',
    note: 'TusAnkiM bağımsız bir projedir; Anki veya Ankitects ile bağlantılı değildir.',
  },
];

const beforeAfterData: BeforeAfterData = {
  kicker: 'Fotoğraf Düzenleyici & Görsel Gizleme',
  heading: 'Ders notunu çek, kırp, saniyeler içinde karta dönüştür',
  lead: 'Kendi aldığın ders notlarını veya anatomi şemalarını karta çevirmek için ek uygulamaya gerek yok. Dahili Fotoğraf Düzenleyici ve Görsel Gizleme (Image Occlusion) ile temiz, akılda kalıcı kartlar üret.',
  bullets: [
    'Perspektif kırpma ve Belge Filtresi ile gölgeli kitap sayfalarını yüksek kontrastlı karta çevirin.',
    'Görsel Gizleme (Image Occlusion) ile tek bir şemadan saniyeler içinde birden çok aktif hatırlama kartı çıkarın.',
    'Görselleriniz cihazınızda yerel saklanır; hiçbir sunucuya yüklenmez.',
  ],
  note: 'Instagram hesabımızda (@tusankim) bu iş akışlarının 30 saniyelik pratik kullanım videolarını düzenli olarak paylaşıyoruz.',
  pairs: [
    {
      label: 'Fotoğraf & Belge Filtresi',
      before: '/images/ba-photo-before.svg',
      after: '/images/ba-photo-after.svg',
      beforeAlt: 'Eğik ve gölgeli ham ders kitabı fotoğrafı',
      afterAlt: 'TusAnkiM Belge Filtresi ile kırpılmış ve netleştirilmiş kart görseli',
    },
    {
      label: 'Görsel Gizleme (Occlusion)',
      before: '/images/ba-occ-before.svg',
      after: '/images/ba-occ-after.svg',
      beforeAlt: 'Tüm etiketleri açık pasif brakiyal pleksus şeması',
      afterAlt: 'TusAnkiM Görsel Gizleme ile aktif hatırlama kutularına dönüştürülmüş şema',
    },
  ],
};
---
<Layout
  title="TusAnkiM — Sadece 9.575 Kartla TUS'a Hazırlan | FSRS-6 & Referans Kanıtı"
  description={SITE.description}
  schema={homeSchema}
  preloadImage="/images/hero-tusankim.svg"
>
  <!-- 1 · HERO -->
  <section class="hero-bg border-b border-line">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-12 sm:py-16 lg:py-20">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-6">
          <div class="inline-flex flex-wrap items-center gap-x-1.5 sm:gap-x-2 gap-y-1 rounded-2xl sm:rounded-full border border-line bg-white px-3 sm:px-3.5 py-1.5 text-[11px] sm:text-xs font-semibold text-teal shadow-xs">
            <span class="w-2 h-2 rounded-full bg-tealGraphic" aria-hidden="true"></span>
            <span>9.575 Doğrulanmış Kart</span>
            <span aria-hidden="true" class="text-inkMuted">·</span>
            <span>Son 6 TUS Kanıtlı</span>
            <span aria-hidden="true" class="text-inkMuted">·</span>
            <span lang="en">FSRS-6</span>
          </div>

          <h1 class="display text-hero-title tracking-tightest text-ink mt-5">
            Sadece 9.575 kartla hayaline ulaş — <span class="text-teal">biz yanındayız.</span>
          </h1>

          <p class="mt-5 text-base sm:text-lg text-inkMuted leading-relaxed max-w-xl">
            TUS kazanan hekim bakış açısıyla hazırlanıp sürekli güncellenen kartlar, <span lang="en">Anki</span> uyumlu
            (<code>.apkg</code> / <code>.colpkg</code>) <span lang="en">FSRS-6</span> aralıklı tekrar motoru, Kronometre ve
            şeffaf TUS referans kanıtları tek sakin uygulamada.
          </p>

          <div class="mt-7 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <a
              href="#demo"
              class="inline-flex items-center justify-center min-h-[3.125rem] px-6 rounded-full bg-teal text-white text-sm font-bold hover:bg-tealDark transition"
            >
              Gerçek TUS Kartlarını Dene ↓
            </a>
            <a
              href={SITE.webAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center min-h-[3.125rem] px-6 rounded-full border border-line bg-white text-ink text-sm font-bold hover:border-tealGraphic hover:text-teal transition"
            >
              {activeOffer.heroSecondaryCta} ↗
            </a>
          </div>

          <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium text-inkMuted">
            <li class="inline-flex items-center gap-1.5">
              <span class="text-teal font-bold" aria-hidden="true">•</span>
              {activeOffer.heroBullet}
            </li>
            <li class="inline-flex items-center gap-1.5">
              <span class="text-teal font-bold" aria-hidden="true">•</span>
              7 gün koşulsuz iade garantisi
            </li>
            <li class="inline-flex items-center gap-1.5">
              <span class="text-teal font-bold" aria-hidden="true">•</span>
              iPhone &amp; Web tarayıcıda aktif
            </li>
          </ul>
        </div>

        <div class="lg:col-span-6">
          <div class="rounded-3xl overflow-hidden border border-line bg-white shadow-md">
            <img
              src="/images/hero-tusankim.svg"
              alt="TusAnkiM iPhone çalışma ekranı, Web deste görünümü, 2026/2 TUS doğrudan referans kartı ve Kronometre özeti"
              width="640"
              height="520"
              fetchpriority="high"
              class="block w-full h-auto"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · TRUST STAT ROW (ported from belif .stat-row) -->
  <section class="bg-white border-b border-line" aria-labelledby="trust-stats-heading">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-10">
      <h2 id="trust-stats-heading" class="sr-only">TusAnkiM doğrulanmış rakamlarla</h2>
      <ul role="list" class="stat-row grid grid-cols-2 lg:grid-cols-4">
        <li class="stat">
          <div class="stat-n display">{catalog.totals.cards.toLocaleString('tr-TR')}</div>
          <div class="stat-l">
            Odaklı TUS kartı · {catalog.totals.courses} ders, {catalog.totals.topicSubdecks} konu alt destesi
          </div>
        </li>
        <li class="stat">
          <div class="stat-n display">{refSummary.overall.destek} / 1.195</div>
          <div class="stat-l">
            Son 6 TUS çözüm desteği (%{String(refSummary.overall.destekOran).replace('.', ',')} · {refSummary.overall.dogrudan} Doğrudan + {refSummary.overall.dolayli} Dolaylı)
          </div>
        </li>
        <li class="stat">
          <div class="stat-n display">%{String(refSummary.overall.konuKapsamiOran).replace('.', ',')}</div>
          <div class="stat-l">
            Son 6 TUS konu kapsamı ({refSummary.overall.konuKapsami.toLocaleString('tr-TR')} / 1.195 soru · 2026/2'de %96,0)
          </div>
        </li>
        <li class="stat">
          <div class="stat-n display">{refSummary.preExam2026_2.preExamEvet} / 200</div>
          <div class="stat-l">
            2026/2 TUS sınav öncesi sürümde (<code>a78ae1f</code>) kanıtlı çözüm desteği
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- 3 · 2027 TUS COUNTDOWN -->
  <CountdownBand />

  <!-- 4 · LIVE INTERACTIVE CARD DEMO (Trust #1 — real pre-exam DOGRUDAN cards) -->
  <LiveCardDemo />

  <!-- 5 · REFERENCE PROOF BY EXAM & SUBJECT -->
  <ReferenceShowcase />

  <!-- 6 · FSRS-6 STUDY DOSE CALCULATOR -->
  <FsrsDoseCalculator />

  <!-- 7 · TUS ECOSYSTEM HUB (All TUS prep + preference needs in one place) -->
  <section class="py-16 sm:py-20 bg-surface border-y border-line" aria-labelledby="ecosystem-heading">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <div class="max-w-2xl">
        <div class="section-num">TUS Hazırlık &amp; Tercih Ekosistemi</div>
        <h2 id="ecosystem-heading" class="display text-section tracking-tightest mt-2 text-ink">
          TUS hazırlık ve tercih sürecindeki tüm ihtiyaçların tek yerde
        </h2>
        <p class="text-inkMuted mt-3 leading-relaxed">
          Kart çalışmasından net hesabına, Kronometre takibinden çıkmış soru referansına kadar dağınık araçları tek sade sistemde topladık.
        </p>
      </div>

      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        <a href="#demo" class="rounded-2xl border border-line bg-white p-6 lift block">
          <span class="inline-block rounded-full bg-tint px-2.5 py-0.5 text-[11px] font-bold text-teal">Aktif</span>
          <h3 class="display text-lg text-ink mt-3">9.575 Kart &amp; <span lang="en">FSRS-6</span></h3>
          <p class="text-sm text-inkMuted mt-2 leading-relaxed">
            12 ders, 106 konu alt destesi, boşluk doldurma (<span lang="en">Cloze</span>), görsel gizleme ve bilimsel unutma eğrisi optimizasyonu.
          </p>
        </a>

        <a href="/referanslar/" class="rounded-2xl border border-line bg-white p-6 lift block">
          <span class="inline-block rounded-full bg-tint px-2.5 py-0.5 text-[11px] font-bold text-teal">Aktif</span>
          <h3 class="display text-lg text-ink mt-3">Çıkmış TUS Referans Sistemi</h3>
          <p class="text-sm text-inkMuted mt-2 leading-relaxed">
            Son 6 TUS'un 1.195 sorusunda ders ders Doğrudan, Dolaylı ve Konu kapsamı kanıtlarını filtreleyip inceleyin.
          </p>
        </a>

        <a href="/puan-hesapla/" class="rounded-2xl border border-line bg-white p-6 lift block">
          <span class="inline-block rounded-full bg-tint px-2.5 py-0.5 text-[11px] font-bold text-teal">Aktif</span>
          <h3 class="display text-lg text-ink mt-3">TUS Puan &amp; Hedef Net Hesapla</h3>
          <p class="text-sm text-inkMuted mt-2 leading-relaxed">
            Temel ve Klinik netlerinizle tahmini TUS puanınızı görün veya hedef puan için gereken neti tersine hesaplayın.
          </p>
        </a>

        <a href="/yardim/kronometre/" class="rounded-2xl border border-line bg-white p-6 lift block">
          <span class="inline-block rounded-full bg-warmTint px-2.5 py-0.5 text-[11px] font-bold text-warm">Aktif</span>
          <h3 class="display text-lg text-ink mt-3">Kronometre, Takvim &amp; Planlama</h3>
          <p class="text-sm text-inkMuted mt-2 leading-relaxed">
            Ders sürelerinizi ölçün, blok hatırlatıcı kurun ve Çalışma Takviminde kart + konu çalışma sürenizi birleştirin.
          </p>
        </a>

        <a href="/yardim/" class="rounded-2xl border border-line bg-white p-6 lift block">
          <span class="inline-block rounded-full bg-tint px-2.5 py-0.5 text-[11px] font-bold text-teal">21 Rehber</span>
          <h3 class="display text-lg text-ink mt-3">Türkçe Kullanım Kılavuzu</h3>
          <p class="text-sm text-inkMuted mt-2 leading-relaxed">
            İlk kurulumdan <span lang="en">FSRS-6</span> ince ayarlarına, Anki aktarımından yedeklemeye kadar eksiksiz Türkçe dokümantasyon.
          </p>
        </a>

        <div class="rounded-2xl border border-dashed border-line bg-white/80 p-6">
          <span class="inline-block rounded-full bg-gradeHardBg px-2.5 py-0.5 text-[11px] font-bold text-gradeHard">Yakında</span>
          <h3 class="display text-lg text-ink mt-3">TUS Tercih Simülasyonu &amp; Bulut</h3>
          <p class="text-sm text-inkMuted mt-2 leading-relaxed">
            Taban puan karşılaştırma, kontenjan tercih simülasyonu, otomatik bulut eşitleme ve yerel Android uygulaması yol haritamızdadır.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 · STORY BANDS (FSRS-6, Kronometre, Cross-platform & Anki compat) -->
  <section class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-16 sm:py-20">
    <h2 class="sr-only">TusAnkiM temel özellikleri</h2>
    <StoryBands bands={storyBands} />
  </section>

  <!-- 9 · BEFORE / AFTER INTERACTIVE SLIDER (Photo Editor & Image Occlusion) -->
  <div class="border-y border-line bg-surfaceSoft py-16 sm:py-20">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <BeforeAfter data={beforeAfterData} id="editor-once-sonra" />
    </div>
  </div>

  <!-- 10 · FOUNDER & EDITORIAL VERIFICATION TEASER -->
  <section class="py-16 sm:py-20 bg-white" aria-labelledby="founder-teaser-heading">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <div class="rounded-3xl border border-line bg-surfaceSoft p-6 sm:p-10 lg:p-12">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-7">
            <div class="section-num">{founder.kicker}</div>
            <h2 id="founder-teaser-heading" class="display text-section tracking-tightest mt-2 text-ink">
              {founder.letterTitle}
            </h2>
            <blockquote class="mt-5 border-l-4 border-teal pl-4 sm:pl-5 text-base sm:text-lg text-ink leading-relaxed font-medium">
              “{founder.quote}”
            </blockquote>
            <ul class="mt-6 space-y-2 text-sm text-inkMuted">
              {founder.credentials.map((cred) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-teal font-bold" aria-hidden="true">•</span>
                  <span>{cred}</span>
                </li>
              ))}
            </ul>
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <a
                href="/kurucu/"
                class="inline-flex items-center justify-center min-h-[2.75rem] px-5 rounded-full bg-teal text-white text-sm font-semibold hover:bg-tealDark transition"
              >
                Kurucumuzun Yazısının Tamamını Oku →
              </a>
              <span class="text-xs font-semibold text-inkMuted">{founder.name} · {founder.role}</span>
            </div>
          </div>

          <div class="lg:col-span-5 grid sm:grid-cols-2 lg:grid-cols-1 gap-3.5">
            {founder.editorialPillars.map((p) => (
              <div class="rounded-2xl border border-line bg-white p-4">
                <h3 class="display text-sm text-ink">{p.title}</h3>
                <p class="text-xs text-inkMuted mt-1.5 leading-relaxed">{p.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 11 · PRICING, 10x VALUE, 7-DAY REFUND, CLUB PROGRAM & COMPETITOR COMPARISON -->
  {SHOW_PRICING_PROMO && (
    <section id="fiyatlandirma" class="scroll-mt-24 py-16 sm:py-20 bg-surface border-y border-line" aria-labelledby="pricing-heading">
      <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
        <div class="max-w-2xl">
          <div class="section-num">{activeOffer.badge}</div>
          <h2 id="pricing-heading" class="display text-section tracking-tightest mt-2 text-ink">
            {activeOffer.headline}
          </h2>
          <p class="text-inkMuted mt-3 leading-relaxed">{activeOffer.subheadline}</p>
        </div>

        <!-- Two clean cards -->
        <div class="mt-8 grid lg:grid-cols-2 gap-6 items-stretch">
          {activeOffer.tiers.map((tier) => (
            <div
              class={`rounded-3xl p-6 sm:p-8 flex flex-col ${
                tier.highlight
                  ? 'border-2 border-teal bg-white shadow-md'
                  : 'border border-line bg-white'
              }`}
            >
              <div class="flex items-center justify-between gap-3">
                <h3 class="display text-xl text-ink">{tier.name}</h3>
                <span
                  class={`rounded-full px-3 py-1 text-xs font-bold ${
                    tier.highlight ? 'bg-tint text-teal' : 'bg-surface text-inkMuted'
                  }`}
                >
                  {tier.badge}
                </span>
              </div>

              <div class="mt-5 flex items-baseline gap-2.5">
                <span class="display text-4xl sm:text-5xl text-ink tabular-nums">{tier.price}</span>
                {tier.oldPrice && (
                  <span class="text-lg text-inkMuted line-through tabular-nums">{tier.oldPrice}</span>
                )}
                <span class="text-sm text-inkMuted">{tier.period}</span>
              </div>

              <p class="text-sm text-inkMuted mt-3 leading-relaxed">{tier.summary}</p>

              <ul class="mt-6 space-y-2.5 flex-1">
                {tier.features.map((feat) => (
                  <li class="flex items-start gap-2.5 text-sm text-ink">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#14998a" stroke-width="2.2" class="shrink-0 mt-0.5" aria-hidden="true">
                      <circle cx="12" cy="12" r="9" />
                      <path d="M9 12l2 2 4-4" />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-7">
                <a
                  href={tier.ctaHref}
                  target={tier.external ? '_blank' : undefined}
                  rel={tier.external ? 'noopener noreferrer' : undefined}
                  class={`inline-flex items-center justify-center w-full min-h-[3rem] rounded-full text-sm font-bold transition ${
                    tier.highlight
                      ? 'bg-teal text-white hover:bg-tealDark'
                      : 'border border-line bg-surfaceSoft text-ink hover:border-tealGraphic hover:text-teal'
                  }`}
                >
                  {tier.ctaLabel} {tier.external ? '↗' : ''}
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- 7-day guarantee + Student clubs free program -->
        <div class="mt-6 grid md:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-line bg-white p-5 flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-tint text-teal grid place-items-center shrink-0" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <path d="M9 12l2 2 4-4" />
              </svg>
            </div>
            <div>
              <h3 class="display text-base text-ink">{offer.refundGuarantee.title}</h3>
              <p class="text-sm text-inkMuted mt-1 leading-relaxed">{offer.refundGuarantee.text}</p>
            </div>
          </div>

          <div class="rounded-2xl border border-line bg-white p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="section-num">{offer.clubProgram.kicker}</div>
              <h3 class="display text-base text-ink mt-1">{offer.clubProgram.title}</h3>
              <p class="text-xs text-inkMuted mt-1 leading-relaxed">{offer.clubProgram.text}</p>
            </div>
            <a
              href={WHATSAPP.clubApplicationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center shrink-0 min-h-[2.75rem] px-4 rounded-full border border-teal text-teal text-xs font-bold hover:bg-tint transition"
            >
              {offer.clubProgram.cta} ↗
            </a>
          </div>
        </div>

        <!-- Honest Beta / Platform Availability Transparency Note -->
        <p class="mt-5 text-xs text-inkMuted leading-relaxed" data-pricing-mode={PRICING_MODE}>
          {activeOffer.note}
        </p>

        <!-- Platform Status Strip -->
        <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
          {offer.platforms.map((pl) => (
            <div class="rounded-2xl border border-line bg-white p-4">
              <div class="flex items-center justify-between gap-2">
                <h3 class="display text-sm text-ink">{pl.name}</h3>
                <span
                  class={`rounded-full px-2.5 py-0.5 text-[11px] font-bold shrink-0 ${
                    pl.badgeType === 'live' ? 'bg-gradeGoodBg text-gradeGood' : 'bg-gradeHardBg text-gradeHard'
                  }`}
                >
                  {pl.status}
                </span>
              </div>
              <p class="text-xs text-inkMuted mt-2 leading-relaxed">{pl.detail}</p>
            </div>
          ))}
        </div>

        <!-- Objective Comparison Table -->
        <div class="mt-12 rounded-3xl border border-line bg-white overflow-hidden">
          <div class="p-6 pb-3">
            <div class="section-num">Nesnel Karşılaştırma</div>
            <h3 class="display text-subsection tracking-tightest mt-1 text-ink">
              TusAnkiM, AnkiMobile, paketler ve klasik kaynaklar yan yana
            </h3>
          </div>
          <div
            class="overflow-x-auto"
            tabindex="0"
            role="region"
            aria-label="TusAnkiM ve alternatif TUS çalışma seçenekleri karşılaştırma tablosu"
          >
            <table class="w-full text-left border-collapse text-sm">
              <caption class="sr-only">{offer.comparison.caption}</caption>
              <thead>
                <tr class="border-y border-line bg-surfaceSoft text-xs uppercase tracking-wider text-inkMuted">
                  <th scope="col" class="py-3.5 px-5 font-bold">Özellik</th>
                  <th scope="col" class="py-3.5 px-5 font-bold text-teal bg-tint/60">TusAnkiM</th>
                  <th scope="col" class="py-3.5 px-5 font-bold"><span lang="en">AnkiMobile</span></th>
                  <th scope="col" class="py-3.5 px-5 font-bold">Anki TUS Paketleri</th>
                  <th scope="col" class="py-3.5 px-5 font-bold">Dershane / Kitap</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-lineLight">
                {offer.comparison.rows.map((row) => (
                  <tr>
                    <th scope="row" class="py-3.5 px-5 font-semibold text-ink whitespace-nowrap">{row.feature}</th>
                    <td class="py-3.5 px-5 font-semibold text-teal bg-tint/35">
                      {row.feature === 'Erişilebilir maliyet' ? activeOffer.comparisonCostCell : row.tusankim}
                    </td>
                    <td class="py-3.5 px-5 text-inkMuted">{row.ankimobile}</td>
                    <td class="py-3.5 px-5 text-inkMuted">{row.ankipacks}</td>
                    <td class="py-3.5 px-5 text-inkMuted">{row.dershane}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="px-5 py-3.5 text-xs text-inkMuted bg-surfaceSoft border-t border-line">
            {offer.comparison.footnote}
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- 12 · INSTAGRAM USAGE SHOWCASE RAIL -->
  <InstagramRail />

  <!-- 13 · WHATSAPP 7/24 CHATBOT SUPPORT BAND -->
  <section class="py-12 sm:py-16 bg-tint/60 border-y border-line" aria-labelledby="wa-support-heading">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <div class="rounded-3xl border border-line bg-white p-6 sm:p-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="max-w-2xl">
          <div class="section-num"><span lang="en">WhatsApp</span> 7/24 Kesintisiz Destek</div>
          <h2 id="wa-support-heading" class="display text-subsection tracking-tightest mt-2 text-ink">
            Takıldığın her anda 7/24 <span lang="en">WhatsApp</span> destek hattı yanında
          </h2>
          <p class="text-sm sm:text-base text-inkMuted mt-2.5 leading-relaxed">
            Anki desteni nasıl içe aktaracağını, <span lang="en">FSRS-6</span> hedef oranını kaç seçmen gerektiğini veya günlük çalışma temposunu
            gecenin üçünde bile <span lang="en">WhatsApp</span> chatbot'umuza sorabilir; içerik veya teknik bildirimlerini ekibimize iletebilirsin.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href={WHATSAPP.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 min-h-[3rem] px-6 rounded-full bg-teal text-white text-sm font-bold hover:bg-tealDark transition"
          >
            <span>WhatsApp'tan Yaz (7/24) ↗</span>
          </a>
          <a
            href="/destek/"
            class="inline-flex items-center justify-center min-h-[3rem] px-5 rounded-full border border-line bg-surfaceSoft text-ink text-sm font-semibold hover:border-tealGraphic hover:text-teal transition"
          >
            Destek Sayfası
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 14 · SPONSORS (controlled by SHOW_SPONSORS in src/config.ts) -->
  <SponsorsBand />

  <!-- 15 · FAQ TEASER -->
  <section class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-10 py-16 sm:py-20" aria-labelledby="home-faq-heading">
    <div class="flex items-end justify-between gap-4 mb-6">
      <div>
        <div class="section-num">Sıkça Sorulan Sorular</div>
        <h2 id="home-faq-heading" class="display text-section tracking-tightest mt-2 text-ink">
          Merak ettiklerin
        </h2>
      </div>
      <a href="/sss/" class="shrink-0 inline-flex items-center min-h-[2.75rem] py-2 text-sm font-semibold text-teal hover:text-tealDark underline underline-offset-4">
        Tüm SSS →
      </a>
    </div>
    <FaqTabs idp="hpfaq" />
  </section>
</Layout>

