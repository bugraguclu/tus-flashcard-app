---
import Layout from '../layouts/Layout.astro';
import LiveCardDemo from '../components/LiveCardDemo.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeProof from '../components/home/HomeProof.astro';
import HomePlan from '../components/home/HomePlan.astro';
import HomeReferences from '../components/home/HomeReferences.astro';
import HomeTools from '../components/home/HomeTools.astro';
import HomeAccess from '../components/home/HomeAccess.astro';
import HomeTrust from '../components/home/HomeTrust.astro';
import '../styles/home.css';

import catalog from '../data/generated/catalog.json';
import { ACCESS, SITE, SHOW_PRICING_PROMO, PRICING_MODE } from '../config';
import { breadcrumbList } from '../lib/schema';
import { dateModified, pageSources } from '../lib/lastmod';

const origin = new URL(Astro.site!).origin;
const homeCrumbs = breadcrumbList(origin, [{ name: 'Ana Sayfa', path: '/' }]);
const beta = PRICING_MODE === 'free-beta';
const cards = catalog.totals.cards.toLocaleString('tr-TR');

const homeSchema = [
  homeCrumbs,
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': origin + '/#webpage',
    url: origin + '/',
    name: `TusAnkiM — ${cards} TUS Kartı, FSRS-6 ve Referans Kanıtı`,
    description: SITE.description,
    inLanguage: 'tr-TR',
    isPartOf: { '@id': origin + '/#website' },
    about: { '@id': origin + '/#brand' },
    mainEntity: { '@id': origin + '/#application' },
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: new URL('/images/og/home.png', Astro.site).href,
      width: 1200,
      height: 630,
    },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['#hero-title', '[data-speakable]'],
    },
    significantLink: [
      origin + '/referanslar/',
      origin + '/puan-hesapla/',
      origin + '/yardim/fsrs/',
      origin + '/yardim/anki-ile-kullanma/',
    ],
    ...dateModified(pageSources('home')),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': origin + '/#application',
    name: 'TusAnkiM',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'iOS, Web',
    inLanguage: 'tr-TR',
    description: SITE.description,
    url: origin + '/',
    screenshot: origin + '/images/iphone-calisma.jpg',
    softwareHelp: { '@type': 'WebPage', url: origin + '/yardim/' },
    isAccessibleForFree: true,
    audience: {
      '@type': 'EducationalAudience',
      educationalRole: 'student',
      audienceType: 'TUS adayları: tıp öğrencileri ve pratisyen hekimler',
    },
    publisher: { '@id': origin + '/#organization' },
    featureList: [
      `${cards} TUS kartı (${catalog.totals.courses} ders, ${catalog.totals.topicSubdecks} alt deste)`,
      'FSRS-6 aralıklı tekrar zamanlayıcısı ve parametre optimizasyonu',
      'Kayıpsız Anki (.apkg / .colpkg) içe ve dışa aktarma',
      'Kronometre, Çalışma Takvimi ve Çalışma Planlama',
      'Çevrimdışı yerel öncelikli SQLite depolama ve otomatik yedekleme',
    ],
    offers: {
      '@type': 'Offer', name: 'Güncel ücretsiz beta', price: 0, priceCurrency: 'TRY',
      url: SITE.webAppUrl,
      description: [ACCESS.betaDescription, ...(SHOW_PRICING_PROMO && !beta ? [ACCESS.plannedLaunchDescription] : [])].join(' '),
    },
  },
];

---
<Layout
  title={`TusAnkiM — ${cards} TUS Kartı, FSRS-6 ve Referans Kanıtı`}
  description={SITE.description}
  schema={homeSchema}
>
  <HomeHero />
  <HomeProof />
  <section id="demo-bolumu" class="home-demo scroll-mt-24 py-14 sm:py-20 bg-surfaceSoft border-b border-line" aria-labelledby="demo-section-heading">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="lg:col-span-5 reveal">
        <p class="kicker">Canlı deneme</p>
        <h2 id="demo-section-heading" class="display text-section tracking-tightest text-ink mt-3">Kartları burada dene.</h2>
        <p class="text-inkMuted mt-3 leading-relaxed">
          11 dersten gerçek kartlar. Boşluğu tahmin et, cevabı aç ve ne kadar kolay hatırladığını işaretle; uygulamadaki tekrar akışı aynen böyle işler.
        </p>
      </div>
      <div class="lg:col-span-7 min-w-0">
        <LiveCardDemo />
      </div>
    </div>
  </section>
  <HomePlan />
  <HomeReferences />
  <HomeTools />
  <HomeAccess />
  <HomeTrust />
</Layout>

<script>
  // Reveal sections once as they scroll into view. Content is visible without JS,
  // elements already on screen at load are left alone, and Reduce Motion skips it all.
  const targets = document.querySelectorAll<HTMLElement>('.reveal, .grow, .chart');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window && targets.length) {
    let first = true;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          if (!first) entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
        first = false;
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
