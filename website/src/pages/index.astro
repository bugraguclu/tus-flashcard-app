---
import Layout from '../layouts/Layout.astro';
import TabletDemo from '../components/TabletDemo.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeWhy from '../components/home/HomeWhy.astro';
import HomeEvidence from '../components/home/HomeEvidence.astro';
import HomePlan from '../components/home/HomePlan.astro';
import HomeClose from '../components/home/HomeClose.astro';
import '../styles/home.css';

import { appScreens } from '../data/appScreens';
import catalog from '../data/generated/catalog.json';
import { ACCESS, SITE, SHOW_PRICING_PROMO, PRICING_MODE } from '../config';
import { breadcrumbList } from '../lib/schema';
import { dateModified, pageSources } from '../lib/lastmod';

const origin = new URL(Astro.site!).origin;
const homeCrumbs = breadcrumbList(origin, [{ name: 'Ana Sayfa', path: '/' }]);
const beta = PRICING_MODE === 'free-beta';
const cards = catalog.totals.cards.toLocaleString('tr-TR');

const homeSchema = [
  homeCrumbs,
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': origin + '/#webpage',
    url: origin + '/',
    name: `TusAnkiM — ${cards} TUS Kartı ve FSRS-6 ile Aralıklı Tekrar`,
    description: SITE.description,
    inLanguage: 'tr-TR',
    isPartOf: { '@id': origin + '/#website' },
    about: { '@id': origin + '/#brand' },
    mainEntity: { '@id': origin + '/#application' },
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: new URL('/images/og/home.png', Astro.site).href,
      width: 1200,
      height: 630,
    },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['#hero-title', '[data-speakable]'],
    },
    significantLink: [
      origin + '/ozellikler/',
      origin + '/tus-calisma-rehberi/',
      origin + '/calisma-plani/',
      origin + '/referanslar/',
      origin + '/puan-hesapla/',
      origin + '/fiyatlar/',
      origin + '/yardim/',
    ],
    ...dateModified(pageSources('home')),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': origin + '/#application',
    name: 'TusAnkiM',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'iOS, Web',
    inLanguage: 'tr-TR',
    description: SITE.description,
    url: origin + '/',
    screenshot: origin + appScreens.question.src,
    softwareHelp: { '@type': 'WebPage', url: origin + '/yardim/' },
    isAccessibleForFree: true,
    audience: {
      '@type': 'EducationalAudience',
      educationalRole: 'student',
      audienceType: 'TUS adayları: tıp öğrencileri ve pratisyen hekimler',
    },
    publisher: { '@id': origin + '/#organization' },
    featureList: [
      `${cards} TUS kartı (${catalog.totals.courses} ders, ${catalog.totals.topicSubdecks} alt deste)`,
      'FSRS-6 aralıklı tekrar zamanlayıcısı ve parametre optimizasyonu',
      'Kayıpsız Anki (.apkg / .colpkg) içe ve dışa aktarma',
      'Kronometre, Çalışma Takvimi ve Çalışma Planlama',
      'Çevrimdışı çalışma, cihazda saklanan veriler ve otomatik yedekleme',
    ],
    offers: {
      '@type': 'Offer', name: 'Güncel ücretsiz beta', price: 0, priceCurrency: 'TRY',
      url: SITE.webAppUrl,
      description: [ACCESS.betaDescription, ...(SHOW_PRICING_PROMO && !beta ? [ACCESS.plannedLaunchDescription] : [])].join(' '),
    },
  },
];

---
<Layout
  title={`TusAnkiM — ${cards} TUS Kartı ve FSRS-6 ile Aralıklı Tekrar`}
  description={SITE.description}
  schema={homeSchema}
>
  <HomeHero />
  <section id="demo-bolumu" class="home-demo scroll-mt-24 py-14 sm:py-20 bg-surfaceSoft border-b border-line" aria-labelledby="demo-section-heading">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div class="max-w-2xl">
          <p class="kicker">Canlı deneme</p>
          <h2 id="demo-section-heading" class="display text-section tracking-tightest text-ink mt-3">Önce kartları gör, sonra karar ver</h2>
          <p class="text-inkMuted mt-3 leading-relaxed">
            Aşağıdakiler 11 dersten gerçek kartlar. Bir deste seç, cevabı aklından geçir, sonra aç. Ne kadar kolay hatırladığını işaretle; uygulamada her gün yapacağın şey bu.
          </p>
        </div>
        <a href="/kart-denemesi/" class="shrink-0 inline-flex items-center min-h-[2.75rem] text-sm font-semibold text-teal underline underline-offset-4 hover:text-tealDark">Tam ekranda dene →</a>
      </div>
      <div class="mt-8 min-w-0">
        <TabletDemo />
      </div>

    </div>
  </section>
  <HomeWhy />
  <HomeEvidence />
  <HomePlan />
  <HomeClose />
</Layout>

