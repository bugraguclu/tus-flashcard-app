---
import Layout from '../layouts/Layout.astro';
import refSummary from '../data/generated/references-summary.json';
import { breadcrumbList } from '../lib/schema';
import { dateModified, pageSources } from '../lib/lastmod';

const origin = new URL(Astro.site!).origin;
const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'TUS Referansları', path: '/referanslar' },
]);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'TusAnkiM Son 6 TUS Referans Analizi (2024/1–2026/2)',
  description:
    'Son 6 TUS’un (2024/1–2026/2) 1.195 sorusu için Doğrudan, Dolaylı ve Konu Kapsamı ayrı ayrı. Yapay zekâ destekli ön değerlendirme; bağımsız hekim editör onayı henüz tamamlanmadı.',
  inLanguage: 'tr-TR',
  url: origin + '/referanslar/',
  temporalCoverage: '2024/2026',
  creator: { '@id': origin + '/#organization' },
  publisher: { '@id': origin + '/#organization' },
  distribution: {
    '@type': 'DataDownload', encodingFormat: 'application/json',
    contentUrl: origin + '/data/references.json',
  },
  ...dateModified(pageSources('referanslar')),
};
---
<Layout
  title="TUS Referansları | TusAnkiM"
  description="TUS referansları: son 6 sınavın 1.195 sorusunu kartlarla karşılaştırdık. Doğrudan, Dolaylı ve Konu Kapsamı ayrı; 2026/2 için sınav öncesi sürüm de var."
  schema={[crumbs, pageSchema]}
>
  <section class="page-intro bg-surface border-b border-line py-10 sm:py-14">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-6">
      <nav aria-label="Sayfa konumu" class="flex flex-wrap items-center gap-y-1 text-sm text-inkMuted mb-3">
        <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-ink font-semibold">TUS Referansları</span>
      </nav>

      <div class="section-num">2024/1–2026/2 · Son 6 TUS</div>
      <h1 class="display text-page-title tracking-tightest text-ink mt-2 max-w-3xl">
        TUS referansları
      </h1>
      <p class="text-inkMuted mt-3 max-w-3xl leading-relaxed">
        Son 6 TUS’ta çıkan 1.195 soruyu kartlarımızla karşılaştırdık. Hangi soruda kartın çözüme götürdüğünü derse ve sınava göre arayabilirsin. <strong>Doğrudan</strong>, <strong>Dolaylı</strong> ve <strong>Konu Kapsamı</strong> ayrı sayılır. Soru metni ve şık yayımlamıyoruz.
      </p>

      <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1">
        <a href="/data/references.json" download class="text-link">Verinin tamamını indir (JSON)</a>
        <a href="/tus-calisma-rehberi/#brans-stratejisi" class="text-link">11 branş çalışma stratejisini oku →</a>
      </div>

      <!-- KPI summary row -->
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-6 border-t border-line pt-6">
        <div class="reference-stat">
          <div class="text-sm font-semibold text-inkMuted">Çözüm desteği · Son 6 TUS</div>
          <div class="display text-2xl text-teal mt-1 tabular-nums">
            {refSummary.overall.destek} / 1.195 <span class="text-base">(%{String(refSummary.overall.destekOran).replace('.', ',')})</span>
          </div>
          <div class="text-sm text-inkMuted mt-0.5">{refSummary.overall.dogrudan} Doğrudan + {refSummary.overall.dolayli} Dolaylı</div>
        </div>
        <div class="reference-stat">
          <div class="text-sm font-semibold text-inkMuted">Konu kapsamı</div>
          <div class="display text-2xl text-ink mt-1 tabular-nums">
            {refSummary.overall.konuKapsami.toLocaleString('tr-TR')} / 1.195 <span class="text-base text-teal">(%{String(refSummary.overall.konuKapsamiOran).replace('.', ',')})</span>
          </div>
          <div class="text-sm text-inkMuted mt-0.5">2026/2 TUS’ta 192/200 (%96,0)</div>
        </div>
        <div class="reference-stat">
          <div class="text-sm font-semibold text-inkMuted">2026/2, sınavdan önceki sürüm</div>
          <div class="display text-2xl text-gradeGood mt-1 tabular-nums">
            {refSummary.preExam2026_2.preExamEvet} / 200 <span class="text-base">(%38,0)</span>
          </div>
          <div class="text-sm text-inkMuted mt-0.5">Sürüm <code>{refSummary.preExam2026_2.commit}</code> · {refSummary.preExam2026_2.date}</div>
        </div>
        <div class="reference-stat">
          <div class="text-sm font-semibold text-inkMuted">2026/2, güncel sürüm</div>
          <div class="display text-2xl text-ink mt-1 tabular-nums">
            {refSummary.preExam2026_2.supportedCurrent} / 200 <span class="text-base text-teal">(%41,0)</span>
          </div>
          <div class="text-sm text-inkMuted mt-0.5">{refSummary.preExam2026_2.preExamKismen + refSummary.preExam2026_2.preExamHayir} soruda kart sınavdan sonra güncellendi</div>
        </div>
      </div>
      <p class="mt-6 text-sm text-inkMuted leading-relaxed">Bu sınıflandırma yapay zekâ destekli bir ön değerlendirme. Bağımsız hekim editör onayı henüz tamamlanmadı.</p>
    </div>
  </section>

  <section class="site-container reference-explorer" aria-labelledby="explorer-heading" data-ref-total={refSummary.overall.soru}>
    <h2 id="explorer-heading">Kayıtlarda ara</h2>
    <search class="ref-filters" aria-label="Referans filtreleri">
      <div class="ref-search">
        <label for="ref-q">Konu veya soru numarası</label>
        <input id="ref-q" type="search" autocomplete="off" placeholder="Örneğin S2 veya T005" />
      </div>
      <div class="ref-selects">
        <div>
          <label for="ref-sinav">Sınav</label>
          <select id="ref-sinav"><option value="">Tüm sınavlar</option>{refSummary.sinavlar.map((exam) => <option value={exam}>{exam} TUS</option>)}</select>
        </div>
        <div>
          <label for="ref-ders">Ders</label>
          <select id="ref-ders"><option value="">Tüm dersler</option>{refSummary.dersler.map((subject) => <option value={subject}>{subject}</option>)}</select>
        </div>
        <div>
          <label for="ref-rozet">Kart desteği</label>
          <select id="ref-rozet">
            <option value="">Hepsi</option>
            <option value="DESTEK">Çözüm desteği (Doğrudan + Dolaylı)</option>
            <option value="DOGRUDAN">Doğrudan ({refSummary.overall.dogrudan})</option>
            <option value="DOLAYLI">Dolaylı ({refSummary.overall.dolayli})</option>
            <option value="KONU">Yalnız konu (587)</option>
            <option value="YOK">Kart yok (87)</option>
          </select>
        </div>
      </div>
      <div class="ref-filter-bottom">
        <div class="ref-pre-filter"><input id="ref-pre" type="checkbox" /><label for="ref-pre">Yalnız 2026/2 sınavından önce destede olanlar</label></div>
        <button id="ref-reset" type="button" hidden class="text-link">Filtreleri temizle</button>
      </div>
    </search>

    <div class="ref-load-message" data-ref-load-message>
      <p id="ref-load-status" role="status">Örnek kayıtlar aşağıda. Tüm kayıtlar yükleniyor.</p>
      <button id="ref-retry" type="button" hidden class="button-secondary">Yeniden dene</button>
    </div>
    <noscript><p class="ref-no-script">Aşağıda 24 Doğrudan kayıt var; hepsi sınavdan önce de destedeydi. Bütün kayıtlarda aramak ve filtrelemek için JavaScript gerekir.</p></noscript>

    <div class="ref-results-heading"><h2>Referans kayıtları</h2><p id="ref-status" aria-live="polite">24 örnek kayıt</p></div>
    <div id="ref-list" aria-busy="false">
      {refSummary.featuredSamples.map((row) => (
        <article class="reference-row">
          <div class="ref-row-top"><p class="ref-row-meta">{row.sinav} · {row.qid.split('-')[1]} <span>{row.ders}</span></p><span class="ref-badge ref-badge-direct">Doğrudan</span></div>
          <h3>{row.olculenBilgi}</h3>
          {row.kartOzet && <p class="ref-row-summary"><strong>Kart özeti:</strong> {row.kartOzet}</p>}
          <div class="ref-row-footer"><p>Sınavdan önce destede vardı{row.cardId && <span> · {row.cardId}</span>}</p></div>
        </article>
      ))}
    </div>
    <div id="ref-empty" hidden class="ref-empty"><p>Bu filtrelerle eşleşen kayıt yok.</p><p>Aramayı kısalt ya da filtreleri temizle.</p></div>
    <button id="ref-more" type="button" hidden class="button-secondary ref-more">Daha fazla kayıt göster</button>

    <!-- Transparent disclosure: 6 post-exam edited 2026/2 notes + Methodology -->
    <div class="ref-methodology mt-14 pt-10 border-t border-line grid lg:grid-cols-2 gap-8">
      <div class="min-w-0">
        <div class="section-num">2026/2 TUS</div>
        <h2 class="display text-lg text-ink mt-2">
          Sınavdan sonra güncellediğimiz 6 kayıt
        </h2>
        <p class="text-sm text-inkMuted mt-2 leading-relaxed">
          23 Ağustos 2026 TUS’unda kartların güncel sürümü 82 soruda çözüm desteği veriyor. Ama aşağıdaki 6 sorunun bilgisi sınavdan 2 gün önceki sürümde (<code>git a78ae1f</code>, 21 Ağustos 2026)
          ya kısmen vardı ya da hiç yoktu, sonradan ekledik. Bu yüzden iki sayıyı ayrı veriyoruz. Sınavdan önceki sürümde çözüm desteği <strong>76/200 (%38,0)</strong>, güncel sürümde <strong>82/200 (%41,0)</strong>.
        </p>
        <ul class="mt-4 space-y-2 text-sm text-ink">
          {refSummary.preExam2026_2.postExamEdited.map((item) => (
            <li class="border-b border-lineLight py-3 flex flex-wrap items-start justify-between gap-3">
              <span>
                <strong>{item.qid}</strong> ({item.ders}): {item.olculenBilgi}
              </span>
              <span class="shrink-0 rounded-lg bg-gradeHardBg px-2 py-0.5 text-xs font-bold text-gradeHard">
                {item.sinavOncesiSurumde === 'kismen' ? 'Kısmen vardı' : 'Sonradan eklendi'}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="min-w-0">
        <div class="section-num">Yöntem</div>
        <h2 class="display text-lg text-ink mt-2">Doğrudan, Dolaylı ve yalnız konu ne demek?</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="font-bold text-gradeGood">Doğrudan (333 / 1.195)</dt>
            <dd class="text-inkMuted mt-0.5">Kart doğru şıkkı ya da onu zorunlu kılan bilgiyi açıkça verir veya diğer dört şıkkı eler.</dd>
          </div>
          <div>
            <dt class="font-bold text-warm">Dolaylı (188 / 1.195)</dt>
            <dd class="text-inkMuted mt-0.5">Kart doğru bilgiye götürür ama arada küçük bir adım kalır (bir terim ya da klinik bağlantı). Eksik adımı kaydın içinde yazıyoruz.</dd>
          </div>
          <div>
            <dt class="font-bold text-ink">Yalnız konu (587 / 1.195)</dt>
            <dd class="text-inkMuted mt-0.5">Konunun kartı var ama şıkları ayıran bilgi eksik. Bunları çözüm desteğine saymıyoruz; yalnızca ayrı tuttuğumuz Konu Kapsamı ölçüsüne (%92,7) girer.</dd>
          </div>
          <div>
            <dt class="font-bold text-ink">Kart yok (87 / 1.195)</dt>
            <dd class="text-inkMuted mt-0.5">Soruyla ilgili kart bulunamadı. Hiçbir orana girmez.</dd>
          </div>
        </dl>
        <p class="mt-4 pt-4 border-t border-line text-sm text-inkMuted leading-relaxed">
          Sınıflandırmayı kartların 26 Ekim 2026 sürümü (<code>{refSummary.katalogCommit}</code>) üzerinde yaptık. Yapay zekâ destekli bir ön değerlendirmedir; bağımsız hekim editör onayı henüz tamamlanmadı. 2024/1–2026/1 sonuçları kartların bugünkü hâlinin o soruları ne kadar karşıladığını gösterir, sınav günündeki hâlini değil.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  type RefRow = {
    qid: string; sinav: string; ders: string;
    rozet: 'DOGRUDAN' | 'DOLAYLI' | 'KONU' | 'YOK';
    olculenBilgi: string; eksikAdim: string; kartOzet: string;
    sinavOncesiSurumde: 'evet' | 'kismen' | 'hayir' | null; cardId: string | null;
  };
  type SearchRow = RefRow & { search: string };
  const root = document.querySelector<HTMLElement>('.reference-explorer');
  const exam = document.getElementById('ref-sinav') as HTMLSelectElement;
  const subject = document.getElementById('ref-ders') as HTMLSelectElement;
  const badge = document.getElementById('ref-rozet') as HTMLSelectElement;
  const query = document.getElementById('ref-q') as HTMLInputElement;
  const preExam = document.getElementById('ref-pre') as HTMLInputElement;
  const status = document.getElementById('ref-status')!;
  const reset = document.getElementById('ref-reset') as HTMLButtonElement;
  const list = document.getElementById('ref-list')!;
  const empty = document.getElementById('ref-empty')!;
  const more = document.getElementById('ref-more') as HTMLButtonElement;
  const retry = document.getElementById('ref-retry') as HTMLButtonElement;
  const loadStatus = document.getElementById('ref-load-status')!;
  const loadMessage = document.querySelector<HTMLElement>('[data-ref-load-message]')!;

  if (root) {
    const pageSize = 30;
    const expectedCount = Number(root.dataset.refTotal);
    const badges = {
      DOGRUDAN: { label: 'Doğrudan', className: 'ref-badge-direct' },
      DOLAYLI: { label: 'Dolaylı', className: 'ref-badge-indirect' },
      KONU: { label: 'Yalnız konu', className: 'ref-badge-topic' },
      YOK: { label: 'Kart yok', className: 'ref-badge-none' },
    };
    let allRows: SearchRow[] = [];
    let filtered: SearchRow[] = [];
    let visibleCount = pageSize;
    let ready = false;
    let loading = false;
    let failed = false;

    const normalize = (text: string) => text.toLocaleLowerCase('tr').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ı/g, 'i');
    const escape = (text: unknown) => String(text ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]!));
    const hasFilters = () => Boolean(exam.value || subject.value || badge.value || query.value.trim() || preExam.checked);

    function syncUrl() {
      const params = new URLSearchParams();
      if (exam.value) params.set('sinav', exam.value);
      if (subject.value) params.set('ders', subject.value);
      if (badge.value) params.set('rozet', badge.value);
      if (query.value.trim()) params.set('q', query.value.trim());
      if (preExam.checked) params.set('pre', '1');
      const suffix = params.toString();
      window.history.replaceState(null, '', window.location.pathname + (suffix ? `?${suffix}` : ''));
    }

    function renderRow(row: RefRow) {
      const meta = badges[row.rozet];
      const timing = row.sinavOncesiSurumde === 'evet' ? 'Sınavdan önce destede vardı'
        : row.sinavOncesiSurumde === 'kismen' ? 'Sınavdan sonra düzenlendi; önce kısmen vardı'
        : row.sinavOncesiSurumde === 'hayir' ? 'Sınavdan sonra eklendi' : '';
      return `<article class="reference-row">
        <div class="ref-row-top"><p class="ref-row-meta">${escape(row.sinav)} · ${escape(row.qid.split('-')[1])} <span>${escape(row.ders)}</span></p><span class="ref-badge ${meta.className}">${meta.label}</span></div>
        <h3>${escape(row.olculenBilgi)}</h3>
        ${row.eksikAdim ? `<p class="ref-row-bridge"><strong>Eksik adım:</strong> ${escape(row.eksikAdim)}</p>` : ''}
        ${row.kartOzet ? `<p class="ref-row-summary"><strong>Kart özeti:</strong> ${escape(row.kartOzet)}</p>` : ''}
        <div class="ref-row-footer"><p>${escape(timing)}${row.cardId ? `${timing ? ' · ' : ''}${escape(row.cardId)}` : ''}</p></div>
      </article>`;
    }

    function renderList() {
      const visible = filtered.slice(0, visibleCount);
      list.innerHTML = visible.map(renderRow).join('');
      empty.hidden = visible.length > 0;
      const remaining = filtered.length - visibleCount;
      more.hidden = remaining <= 0;
      more.textContent = `Daha fazla göster (${Math.min(pageSize, remaining)} kayıt)`;
      const support = filtered.filter((row) => row.rozet === 'DOGRUDAN' || row.rozet === 'DOLAYLI').length;
      status.textContent = `${filtered.length.toLocaleString('tr-TR')} kayıt · ${support.toLocaleString('tr-TR')} çözüm desteği`;
    }

    function applyFilters() {
      reset.hidden = !hasFilters();
      syncUrl();
      // Until the complete dataset arrives, keep the server-rendered sample list intact.
      if (!ready) {
        if (!loading && failed) loadStatus.textContent = hasFilters()
          ? 'Tam liste yüklenemedi. Filtrelerin korunuyor; aşağıda yalnızca 24 örnek kayıt var.'
          : 'Tam liste yüklenemedi. Aşağıda yalnızca 24 örnek kayıt var.';
        else loadStatus.textContent = hasFilters()
          ? 'Tüm kayıtlar yükleniyor. Filtrelerin yükleme tamamlandığında uygulanacak.'
          : 'Örnek kayıtlar aşağıda. Tüm kayıtlar yükleniyor.';
        return;
      }
      const tokens = normalize(query.value.trim()).split(/\s+/).filter(Boolean);
      filtered = allRows.filter((row) => {
        if (exam.value && row.sinav !== exam.value) return false;
        if (subject.value && row.ders !== subject.value) return false;
        if (badge.value === 'DESTEK' && row.rozet !== 'DOGRUDAN' && row.rozet !== 'DOLAYLI') return false;
        if (badge.value && badge.value !== 'DESTEK' && row.rozet !== badge.value) return false;
        if (preExam.checked && row.sinavOncesiSurumde !== 'evet') return false;
        return tokens.every((token) => row.search.includes(token));
      });
      visibleCount = pageSize;
      renderList();
    }

    function validRows(value: unknown): value is RefRow[] {
      if (!Array.isArray(value) || value.length !== expectedCount) return false;
      const ids = new Set<string>();
      return value.every((row) => {
        if (!row || typeof row !== 'object') return false;
        const strings = ['qid', 'sinav', 'ders', 'olculenBilgi', 'eksikAdim', 'kartOzet'];
        if (!strings.every((key) => typeof row[key] === 'string') || !Object.hasOwn(badges, row.rozet)) return false;
        if (!['evet', 'kismen', 'hayir', null].includes(row.sinavOncesiSurumde)) return false;
        if (row.cardId !== null && typeof row.cardId !== 'string') return false;
        if (!row.qid || ids.has(row.qid)) return false;
        ids.add(row.qid);
        return true;
      });
    }

    async function load() {
      if (loading) return;
      const restoreFocus = document.activeElement === retry;
      loading = true;
      failed = false;
      retry.disabled = true;
      retry.textContent = 'Yükleniyor…';
      loadMessage.hidden = false;
      list.setAttribute('aria-busy', 'true');
      applyFilters();
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 12000);
      try {
        const response = await fetch('/data/references.json', { signal: controller.signal });
        if (!response.ok) throw new Error('Reference request failed');
        const payload: unknown = await response.json();
        const rows = payload && typeof payload === 'object' && 'kayitlar' in payload ? payload.kayitlar : null;
        if (!validRows(rows)) throw new Error('Reference data is incomplete');
        allRows = rows.map((row) => ({ ...row, search: normalize(`${row.qid} ${row.sinav} ${row.ders} ${row.olculenBilgi} ${row.eksikAdim} ${row.kartOzet} ${row.cardId ?? ''}`) }));
        ready = true;
        applyFilters();
        loadMessage.hidden = true;
        retry.hidden = true;
        // The retry control disappears on success; keep keyboard focus on the result count.
        if (restoreFocus) {
          status.tabIndex = -1;
          status.focus({ preventScroll: true });
        }
      } catch {
        failed = true;
        loading = false;
        applyFilters();
        retry.hidden = false;
      } finally {
        window.clearTimeout(timeout);
        loading = false;
        retry.disabled = false;
        retry.textContent = 'Yeniden dene';
        list.setAttribute('aria-busy', 'false');
        if (failed && restoreFocus) retry.focus({ preventScroll: true });
      }
    }

    const params = new URLSearchParams(window.location.search);
    for (const [control, key] of [[exam, 'sinav'], [subject, 'ders'], [badge, 'rozet']] as const) {
      const value = params.get(key);
      if (value && [...control.options].some((option) => option.value === value)) control.value = value;
    }
    query.value = params.get('q') ?? '';
    preExam.checked = params.get('pre') === '1';
    [exam, subject, badge, preExam].forEach((control) => control.addEventListener('change', applyFilters));
    query.addEventListener('input', applyFilters);
    reset.addEventListener('click', () => {
      exam.value = subject.value = badge.value = query.value = '';
      preExam.checked = false;
      applyFilters();
      query.focus({ preventScroll: true });
    });
    more.addEventListener('click', () => { visibleCount += pageSize; renderList(); });
    retry.addEventListener('click', load);
    load();
  }
</script>

<style is:global>
  .reference-explorer { padding-block: 3rem 4rem; }
  .reference-explorer > h2, .ref-results-heading h2 { font-size: 1.25rem; font-weight: 600; letter-spacing: -.02em; }
  .ref-filters { margin-top: 1.25rem; padding: 1.5rem; background: #f8f9fa; border: 1px solid #dde1e4; border-radius: .75rem; }
  .ref-filters label { display: flex; align-items: center; min-height: 2rem; font-size: .875rem; font-weight: 500; }
  .ref-filters input[type="search"], .ref-filters select { width: 100%; min-height: 2.875rem; padding: .625rem .75rem; background-color: #fff; color: #24292c; border: 1px solid #dde1e4; border-radius: .5rem; font-size: 1rem; }
  .ref-selects { display: grid; grid-template-columns: .8fr 1fr 1.2fr; gap: 1rem; margin-top: 1rem; }
  .ref-selects > div { min-width: 0; }
  .ref-filter-bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem; margin-top: 1rem; }
