---
import Layout from '../layouts/Layout.astro';
import founder from '../data/founder.json';
import { breadcrumbList } from '../lib/schema';
import { dateModified, pageSources } from '../lib/lastmod';
const origin = new URL(Astro.site!).origin;
const crumbs = breadcrumbList(origin, [{ name: 'Ana Sayfa', path: '/' }, { name: 'Hakkımızda', path: '/hakkimizda' }]);
const pageSchema = {
  '@context': 'https://schema.org', '@type': 'AboutPage', url: origin + '/hakkimizda/',
  name: 'TusAnkiM hakkında', description: founder.quote, inLanguage: 'tr-TR', ...dateModified(pageSources('hakkimizda')),
};
---
<Layout title="Hakkımızda | TusAnkiM" description="TusAnkiM’i neden kurduk, 9.575 TUS kartını nasıl hazırlıyoruz ve kartları çıkmış sorularla nasıl karşılaştırıyoruz? Kısaca anlatıyoruz." schema={[crumbs, pageSchema]}>
  <article class="about-page">
    <p class="eyebrow">{founder.kicker}</p>
    <h1>{founder.letterTitle}</h1>
    <p class="about-intro">{founder.quote}</p>
    <div class="about-letter">{founder.letterParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
    <section class="about-principles" aria-labelledby="approach-heading">
      <h2 id="approach-heading">Kartlar ve referanslar</h2>
      <div class="principles-list">{founder.editorialPillars.map((pillar) => <div><h3>{pillar.title}</h3><p>{pillar.body}</p></div>)}</div>
    </section>
    <nav class="about-links" aria-label="TusAnkiM hakkında daha fazla bilgi">
      <a class="text-link" href="/referanslar/">Referansları incele</a>
      <a class="text-link" href="/destek/">Bize ulaş</a>
    </nav>
  </article>
</Layout>
<style>
  .about-page { width: min(720px, calc(100% - 2.5rem)); margin-inline: auto; padding-block: 4rem; }
  h1 { font-size: clamp(2rem, 1.4rem + 2vw, 2.875rem); line-height: 1.25; font-weight: 600; letter-spacing: -.035em; }
  .about-intro { font-size: 1.25rem; line-height: 1.7; margin-top: 1.5rem; color: #596166; }
  .about-letter { margin-top: 2.5rem; font-size: 1rem; line-height: 1.9; }
  .about-letter p + p { margin-top: 1.25rem; }
  .about-principles { border-top: 1px solid #dde1e4; padding-top: 2.5rem; margin-top: 3rem; }
  h2 { font-size: 1.5rem; font-weight: 600; letter-spacing: -.025em; }
  .principles-list { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2rem; }
  h3 { font-weight: 600; font-size: 1rem; }
  .principles-list p { color: #596166; line-height: 1.85; font-size: 1rem; margin-top: .5rem; }
  .about-links { border-top: 1px solid #dde1e4; margin-top: 3rem; padding-top: 1.5rem; display: flex; flex-wrap: wrap; gap: .5rem 2rem; }
  @media (max-width: 540px) { .about-page { padding-block: 2.5rem; } .principles-list { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
