---
import Layout from '../layouts/Layout.astro';
import founder from '../data/founder.json';
import { FOUNDER, SITE } from '../config';
import { breadcrumbList } from '../lib/schema';
import { effectiveDate, formatTrDate, pageSources } from '../lib/lastmod';

const origin = new URL(Astro.site!).origin;
const modDate = effectiveDate(pageSources('kurucu'));
const modLabel = formatTrDate(modDate);

const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Kurucumuz', path: '/kurucu' },
]);

const founderPerson = {
  '@type': 'Person',
  name: FOUNDER.name,
  jobTitle: FOUNDER.title,
  url: origin + '/kurucu/',
  address: {
    '@type': 'PostalAddress',
    addressLocality: FOUNDER.district,
    addressRegion: FOUNDER.city,
    addressCountry: 'TR',
  },
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: origin + '/kurucu/',
  name: 'Kurucumuz ve Editöryal Standart | TusAnkiM',
  description: founder.quote,
  inLanguage: 'tr-TR',
  dateModified: modDate,
  author: founderPerson,
  mainEntity: founderPerson,
  publisher: { '@id': origin + '/#organization' },
};
---
<Layout
  title="Kurucumuz ve Editöryal Standart | TusAnkiM"
  description="TusAnkiM kurucusu Uzm. Dr. Muhammet Kürşat Güçlü (İzmir Çiğli, KBB Uzman Doktoru): 9.575 kartlık bitirilebilir hacim, sınav öncesi sürüm kanıtı ve hekim editör kontrolü."
  ogImage="/images/og-kurucu.png"
  modifiedTime={modDate}
  schema={[crumbs, pageSchema]}
>
  <section class="bg-surfaceSoft border-b border-line py-10 sm:py-14">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-10">
      <nav aria-label="Sayfa konumu" class="flex flex-wrap items-center gap-y-1 text-xs text-inkMuted mb-3">
        <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-ink font-semibold">Kurucumuz</span>
      </nav>
      <p class="text-xs font-semibold text-teal">{founder.kicker}</p>
      <h1 class="display text-page-title tracking-tightest text-ink mt-1.5">
        {founder.letterTitle}
      </h1>
      <p class="text-inkMuted mt-3 leading-relaxed">
        <strong class="text-ink font-semibold">{founder.name}</strong> · {founder.role}
      </p>
      <p class="text-xs text-inkMuted mt-2">
        Son güncelleme: <time datetime={modDate}>{modLabel}</time>
      </p>
    </div>
  </section>

  <article class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-10 py-12">
    <div class="mb-8 rounded-2xl border border-line bg-surfaceSoft p-5">
      <h2 class="display text-base text-ink">Kurucu hekim kimliği ve yaklaşım</h2>
      <ul class="mt-3 space-y-2 text-sm text-inkMuted">
        {founder.credentials.map((cred) => (
          <li class="flex items-start gap-2.5">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-teal mt-2 shrink-0" aria-hidden="true"></span>
            <span>{cred}</span>
          </li>
        ))}
      </ul>
    </div>

    <blockquote class="border-l-4 border-teal pl-5 py-1 text-lg sm:text-xl text-ink leading-relaxed">
      “{founder.quote}”
    </blockquote>

    <div class="mt-8 space-y-5 text-base text-ink leading-relaxed">
      {founder.letterParagraphs.map((para) => (
        <p>{para}</p>
      ))}
    </div>

    {/* Editorial Standards: borderless/hairline layout */}
    <section class="mt-14 pt-10 border-t border-line" aria-labelledby="pillars-heading">
      <h2 id="pillars-heading" class="display text-section tracking-tightest text-ink">
        Kart doğrulama standartları
      </h2>
      <div class="mt-8 grid sm:grid-cols-2 gap-8">
        {founder.editorialPillars.map((pillar) => (
          <div>
            <h3 class="display text-base text-ink">{pillar.title}</h3>
            <div class="w-8 h-px bg-tealGraphic my-2.5" aria-hidden="true"></div>
            <p class="text-sm text-inkMuted leading-relaxed">{pillar.body}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="mt-12 pt-8 border-t border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <p class="text-sm text-inkMuted">
        İletişim ve kart bildirimi için <a href="/destek/" class="text-teal underline hover:text-tealDark">Destek sayfasını</a> veya{' '}
        <a href={SITE.githubIssuesUrl} target="_blank" rel="noopener noreferrer" class="text-teal underline hover:text-tealDark">destek kaydı formunu</a> kullanabilirsin.
      </p>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a
          href="/#demo"
          class="inline-flex items-center justify-center min-h-[2.75rem] px-5 rounded-full bg-teal text-white text-sm font-semibold hover:bg-tealDark transition"
        >
          Kartları Dene
        </a>
        <a
          href="/referanslar/"
          class="inline-flex items-center justify-center min-h-[2.75rem] px-5 rounded-full border border-line bg-white text-ink text-sm font-semibold hover:border-tealGraphic hover:text-teal transition"
        >
          Referanslar →
        </a>
      </div>
    </div>
  </article>
</Layout>
