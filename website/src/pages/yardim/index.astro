---
import Layout from '../../layouts/Layout.astro';
import HelpSearch from '../../components/HelpSearch.astro';
import { SITE } from '../../config';
import { HELP_INTROS } from '../../data/help-intros';
import { getHelpArticles, helpCategoryId } from '../../lib/helpDocs';
import { websiteGuideEntries, websitePageEntries } from '../../lib/websiteSearchIndex';
import { breadcrumbList, collectionPage } from '../../lib/schema';
import { newest, pageSources } from '../../lib/lastmod';

const articles = getHelpArticles();
const categories = [...new Set(articles.map((a) => a.category))];
const entries = [...websiteGuideEntries(articles), ...websitePageEntries(['calisma-rehberi', 'calisma-plani', 'puan', 'referanslar', 'sss', 'destek'])];

const origin = new URL(Astro.site!).origin;
const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Yardım Merkezi', path: '/yardim' },
]);

const colSchema = collectionPage(origin, {
  path: '/yardim',
  name: 'TusAnkiM Türkçe Yardım Merkezi ve Kullanım Kılavuzu',
  description: 'TUS kartlarıyla ücretsiz başlangıç, aralıklı tekrar ve çalışma takibi için adım adım Türkçe kullanım rehberleri.',
  items: articles.map((a) => ({ name: a.title, path: a.webPath })),
  dateModified: newest(pageSources('yardim')),
});
---
<Layout
  title="TUS Kartları ve Aralıklı Tekrar Rehberi | TusAnkiM"
  description="TusAnkiM ile ücretsiz başla: TUS kartlarını aç, aralıklı tekrar düzenini kur, çalışma süreni ve ilerlemeni takip et. Adım adım Türkçe kullanım rehberleri."
  schema={[crumbs, colSchema]}
>
  <section class="page-intro bg-white border-b border-line py-10 sm:py-14">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-6">
      <nav aria-label="Sayfa konumu" class="flex flex-wrap items-center gap-y-1 text-sm text-inkMuted mb-3">
        <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-ink font-semibold">Yardım Merkezi</span>
      </nav>
      <div class="section-num">Kullanım rehberleri</div>
      <h1 class="display text-page-title tracking-tightest text-ink mt-2 max-w-3xl">
        Yardım Merkezi
      </h1>
      <p class="text-inkMuted mt-3 max-w-2xl leading-relaxed">
        Kurulum, kart çalışması ve veri aktarımı için kısa adımlarla başla. Her rehberin ayrıntılarını ihtiyacın olduğunda aç.
      </p>

      <HelpSearch entries={entries} guideCount={articles.length} />

      <div class="mt-6" data-help-browse>
        <div class="flex flex-wrap gap-3">
          <a href={SITE.webAppUrl} target="_blank" rel="noopener noreferrer" class="button-primary">Ücretsiz dene</a>
          <a href="/sss/" class="button-secondary">Sık sorulanları incele</a>
        </div>
        <p class="text-sm text-inkMuted mt-3">Güncel beta ücretsiz. Ödeme veya kart bilgisi gerekmez.</p>
      </div>
    </div>
  </section>

  <section data-help-browse aria-labelledby="help-start-heading" class="max-w-content mx-auto px-5 sm:px-6 lg:px-6 pt-10">
    <h2 id="help-start-heading" class="display text-subsection tracking-tightest text-ink">Hızlı bağlantılar</h2>
    <div class="grid sm:grid-cols-3 gap-x-8 mt-4">
      <a href="/yardim/hizli-baslangic/" class="block border-b border-line py-4 hover:text-teal transition">
        <h3 class="display text-base text-ink">İlk kartını aç</h3>
        <p class="text-base text-inkMuted mt-2 leading-relaxed">Hazır paketi aç veya kendi kartını ekle.</p>
      </a>
      <a href="/yardim/fsrs/" class="block border-b border-line py-4 hover:text-teal transition">
        <h3 class="display text-base text-ink">Günlük tekrarını planla</h3>
        <p class="text-base text-inkMuted mt-2 leading-relaxed">Aralıklı tekrarın nasıl çalıştığını ve ayarlarını öğren.</p>
      </a>
      <a href="/yardim/kronometre/" class="block border-b border-line py-4 hover:text-teal transition">
        <h3 class="display text-base text-ink">Çalışma süreni kaydet</h3>
        <p class="text-base text-inkMuted mt-2 leading-relaxed">Çalışma süreni ölç, oturumlarını takvimde gör.</p>
      </a>
    </div>
    <p class="text-base text-inkMuted mt-5 leading-relaxed">
      TUS hazırlık stratejisi ve çalışma temposu için <a class="text-link" href="/tus-calisma-rehberi/">TUS Çalışma Rehberi’ni oku</a>.
      Kartları önce incelemek mi istiyorsun? <a class="text-link" href="/#demo-heading">Gerçek kartları dene</a> ve <a class="text-link" href="/referanslar/">açıklamalı referans kayıtlarına bak</a>.
    </p>
  </section>

  <section data-help-browse class="max-w-content mx-auto px-5 sm:px-6 lg:px-6 py-12 space-y-12">
    {categories.map((cat) => {
      const list = articles.filter((a) => a.category === cat);
      return (
        <div>
          <h2 id={helpCategoryId(cat)} class="display text-subsection tracking-tightest text-ink pb-3 border-b border-line">{cat}</h2>
          <div class="mt-2 grid sm:grid-cols-2 gap-x-10">
            {list.map((art) => (
              <a
                href={art.webPath}
                class="guide-link border-b border-lineLight py-5 block"
              >
                <div>
                  <h3 class="display text-base text-ink">{art.slug === 'sss' ? 'Sorun giderme' : art.title}</h3>
                  <p class="text-base text-inkMuted mt-2 leading-relaxed">{HELP_INTROS[art.slug].intro}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      );
    })}

  </section>

  <section aria-labelledby="help-support-heading" class="max-w-content mx-auto px-5 sm:px-6 lg:px-6 pb-12">
    <div class="border-t border-line pt-8">
      <h2 id="help-support-heading" class="display text-subsection text-ink">Destek ve iletişim</h2>
      <p class="text-base text-inkMuted mt-2 leading-relaxed">Kurulumda yardıma mı ihtiyacın var, bir kart için düzeltme mi önermek istiyorsun? Sorunu bize ilet.</p>
      <a href="/destek/" class="text-link inline-flex items-center min-h-[2.75rem] mt-2">Destek ve iletişim</a>
    </div>
  </section>
</Layout>
