---
import Layout from '../../layouts/Layout.astro';
import { FOUNDER } from '../../config';
import { getHelpAuthority } from '../../data/helpAuthority';
import { getHelpArticles, type HelpArticle } from '../../lib/helpDocs';
import { breadcrumbList } from '../../lib/schema';
import { effectiveDate, formatTrDate, helpArticleSources } from '../../lib/lastmod';

export function getStaticPaths() {
  const all = getHelpArticles();
  return all.map((article, idx) => ({
    params: { slug: article.slug },
    props: {
      article,
      prev: idx > 0 ? all[idx - 1] : null,
      next: idx < all.length - 1 ? all[idx + 1] : null,
      all,
    },
  }));
}

interface Props {
  article: HelpArticle;
  prev: HelpArticle | null;
  next: HelpArticle | null;
  all: HelpArticle[];
}

const { article, prev, next, all } = Astro.props;
const origin = new URL(Astro.site!).origin;
const modDate = effectiveDate(helpArticleSources(article.sourceRelPath));
const modLabel = formatTrDate(modDate);
const authority = getHelpAuthority(article.id);

const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Yardım Merkezi', path: '/yardim' },
  { name: article.title, path: article.webPath },
]);

const reviewerPerson = {
  '@type': 'Person',
  name: FOUNDER.name,
  jobTitle: FOUNDER.title,
  url: origin + '/kurucu/',
  address: {
    '@type': 'PostalAddress',
    addressLocality: FOUNDER.district,
    addressRegion: FOUNDER.city,
    addressCountry: 'TR',
  },
};

const docSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: article.title,
  description: article.summary,
  inLanguage: 'tr-TR',
  url: origin + article.webPath,
  dateModified: modDate,
  author: reviewerPerson,
  reviewedBy: reviewerPerson,
  citation: authority.sources.map((s) => s.url),
  publisher: { '@id': origin + '/#organization' },
};

const h2List = article.headings.filter((h) => h.depth === 2);
---
<Layout
  title={`${article.title} — Yardım Merkezi | TusAnkiM`}
  description={article.summary}
  ogImage="/images/og-yardim.png"
  ogType="article"
  modifiedTime={modDate}
  schema={[crumbs, docSchema]}
>
  <section class="bg-surface border-b border-line py-8 sm:py-12">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <nav aria-label="Sayfa konumu" class="flex flex-wrap items-center gap-y-1 text-xs text-inkMuted mb-2">
        <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <a href="/yardim/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Yardım Merkezi</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-ink font-semibold">{article.title}</span>
      </nav>
      <p class="text-xs font-semibold text-teal">{article.category} · Rehber {String(article.order).padStart(2, '0')} / {all.length}</p>
      <h1 class="display text-page-title tracking-tightest text-ink mt-2 max-w-3xl">{article.title}</h1>
      <p class="text-inkMuted mt-2.5 max-w-2xl leading-relaxed">{article.summary}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-inkMuted">
        <span>
          Son güncelleme: <time datetime={modDate} class="font-semibold text-ink">{modLabel}</time>
        </span>
        <span>
          İnceleyen:{' '}
          <a href="/kurucu/" class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark">
            {FOUNDER.signature}
          </a>
        </span>
      </div>
    </div>
  </section>

  <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-10">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <!-- Main prose -->
      <article class="lg:col-span-8 min-w-0">
        {h2List.length > 1 && (
          <nav aria-label="Sayfa içi başlıklar" class="lg:hidden mb-8 rounded-2xl border border-line bg-surfaceSoft p-4">
            <div class="text-xs font-bold uppercase tracking-wider text-teal mb-1">İçindekiler</div>
            <ul class="divide-y divide-lineLight text-sm">
              {h2List.map((h) => (
                <li>
                  <a href={`#${h.id}`} class="flex items-center min-h-[2.75rem] py-2 text-inkMuted hover:text-teal transition">{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <div class="help-prose" set:html={article.html}></div>

        {authority.terminologyNote && (
          <aside class="mt-8 rounded-2xl border border-teal/25 bg-tint p-5 text-sm text-ink leading-relaxed">
            <p>{authority.terminologyNote}</p>
            <p class="mt-2">
              Branş bazlı çıkmış soru dağılımı için <a href="/referanslar/" class="font-semibold text-teal underline hover:text-tealDark">11 TUS branşı referans cetvelini</a> inceleyebilirsin.
            </p>
          </aside>
        )}

        <section aria-labelledby="sources-heading" class="mt-10 rounded-2xl border border-line bg-surfaceSoft p-5 sm:p-6">
          <h2 id="sources-heading" class="display text-base text-ink">
            Doğrulanmış Kaynaklar &amp; Dış Referanslar
          </h2>
          <ul class="mt-3 space-y-1 text-sm">
            {authority.sources.map((src) => (
              <li>
                <a
                  href={src.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center min-h-[2.75rem] py-1.5 text-teal underline underline-offset-2 hover:text-tealDark"
                >
                  {src.label} ({src.publisher}) ↗
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-3 pt-3 border-t border-lineLight text-xs text-inkMuted leading-relaxed">
            Bu rehber eğitim ve teknik kullanım amaçlıdır; klinik karar desteği veya resmî ÖSYM kılavuzu yerine geçmez.{' '}
            <a href="/kurucu/" class="text-teal underline hover:text-tealDark">{FOUNDER.signature}</a> tarafından {modLabel} tarihinde gözden geçirilmiştir.
          </p>
        </section>

        <!-- Prev / Next pagination -->
        <nav aria-label="Önceki ve sonraki rehber" class="mt-12 pt-8 border-t border-line grid sm:grid-cols-2 gap-4">
          {prev ? (
            <a href={prev.webPath} class="rounded-2xl border border-line bg-surfaceSoft p-4 hover:border-tealGraphic transition">
              <div class="text-xs font-semibold text-inkMuted">← Önceki rehber</div>
              <div class="display text-sm text-ink mt-1">{prev.title}</div>
            </a>
          ) : <div></div>}

          {next && (
            <a href={next.webPath} class="rounded-2xl border border-line bg-surfaceSoft p-4 hover:border-tealGraphic transition sm:text-right">
              <div class="text-xs font-semibold text-inkMuted">Sonraki rehber →</div>
              <div class="display text-sm text-ink mt-1">{next.title}</div>
            </a>
          )}
        </nav>
      </article>

      <!-- Desktop sidebar TOC + All guides -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
        {h2List.length > 0 && (
          <nav aria-label="Bu sayfadaki başlıklar" class="hidden lg:block rounded-2xl border border-line bg-surfaceSoft p-5">
            <div class="text-xs font-semibold text-ink mb-3">Bu Sayfada</div>
            <ul class="space-y-2 text-xs">
              {h2List.map((h) => (
                <li>
                  <a href={`#${h.id}`} class="text-inkMuted hover:text-teal transition block leading-snug">{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <nav aria-label="Tüm yardım rehberleri" class="rounded-2xl border border-line bg-white p-5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-ink">Tüm Rehberler ({all.length})</span>
            <a href="/yardim/" class="inline-flex items-center min-h-[2.75rem] px-2 -mr-2 text-xs font-semibold text-teal hover:underline">Tümü</a>
          </div>
          <ul class="space-y-1 text-xs max-h-[45vh] overflow-y-auto pr-1">
            {all.map((item) => (
              <li>
                <a
                  href={item.webPath}
                  aria-current={item.slug === article.slug ? 'page' : undefined}
                  class={`flex items-center min-h-[2.75rem] lg:min-h-[2.25rem] rounded-lg px-2.5 py-2 lg:py-1.5 transition ${
                    item.slug === article.slug
                      ? 'bg-tint font-bold text-teal'
                      : 'text-inkMuted hover:bg-surfaceSoft hover:text-ink'
                  }`}
                >
                  {String(item.order).padStart(2, '0')}. {item.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    </div>
  </div>
</Layout>
