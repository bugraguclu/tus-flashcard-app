---
import AppScreenshot from '../../components/AppScreenshot.astro';
import Layout from '../../layouts/Layout.astro';
import { getHelpArticles, helpCategoryId, type HelpArticle } from '../../lib/helpDocs';
import { HELP_INTROS } from '../../data/help-intros';
import { readingSections, groupReading } from '../../lib/helpReading';
import { breadcrumbList } from '../../lib/schema';
import { publicationDates, helpSources } from '../../lib/lastmod';

export function getStaticPaths() {
  return getHelpArticles().map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
interface Props { article: HelpArticle }
const { article } = Astro.props;
const intro = HELP_INTROS[article.slug];
if (!intro) throw new Error(`Missing introduction: ${article.slug}`);
const reading = readingSections(article.html);
const groups = groupReading(reading.sections, intro.groups);
const related = intro.related.map((slug) => getHelpArticles().find((item) => item.slug === slug)!);
const origin = new URL(Astro.site!).origin;
const dates = publicationDates(article.sourceRelPath, helpSources(article.sourceRelPath));
const title = article.slug === 'sss' ? 'Sorun giderme' : article.title;
const quickStartTitle = article.slug === 'sozluk' ? 'Terim bulmak için' : article.slug === 'sss' ? 'Önce bunları dene' : 'Başlamak için';
const fullTitle = `${title} — Yardım Merkezi | TusAnkiM`;
const metaTitle = fullTitle.length <= 58 ? fullTitle : `${title} | TusAnkiM`;
const description = article.slug === 'temel-kavramlar'
  ? 'Aralıklı tekrar, not, kart, deste ve not türü kavramlarını öğren. Kart durumlarını ve cevap düğmelerini TusAnkiM örnekleriyle tanı.'
  : article.summary;
const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' }, { name: 'Yardım Merkezi', path: '/yardim' }, { name: title, path: article.webPath },
]);
const docSchema = {
  '@context': 'https://schema.org', '@type': 'TechArticle', headline: title, description,
  inLanguage: 'tr-TR', url: origin + article.webPath, ...dates,
  author: { '@id': origin + '/#organization' }, publisher: { '@id': origin + '/#organization' },
};
---
<Layout title={metaTitle} description={description} schema={[crumbs, docSchema]}>
  <article class="help-reading">
    <nav aria-label="Sayfa konumu" class="help-breadcrumb">
      <a href="/yardim/">← Yardım Merkezi</a><span aria-hidden="true">/</span><a class="help-category" href={`/yardim/#${helpCategoryId(article.category)}`}>{article.category}</a>
    </nav>
    <h1 class="display text-page-title tracking-tightest text-ink">{title}</h1>
    <p class="help-intro">{intro.intro}</p>
    {article.slug === 'sss' && <p class="help-product-faq">Fiyat, erişim ve ürün hakkında <a class="text-link" href="/sss/">sık sorulan sorulara bak</a>.</p>}

    <div class="help-section-bar">
      <details class="help-section-picker" data-help-section-picker>
        <summary class="help-section-toggle">
          <span>Bu rehberde</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <nav aria-label="Rehber bölümleri" class="help-section-panel">
          <ul>
            <li><a href="#quick-start-heading">{quickStartTitle}</a></li>
            {groups.map((group, index) => <li><a href={`#rehber-bolum-${index + 1}`}>{group.title}</a></li>)}
            <li><a href="#related-heading">İlgili rehberler</a></li>
          </ul>
        </nav>
      </details>
    </div>

    <section aria-labelledby="quick-start-heading" class="help-start">
      <h2 id="quick-start-heading" tabindex="-1">{quickStartTitle}</h2>
      <ol data-help-steps>{intro.steps.map((step) => <li>{step}</li>)}</ol>
      {intro.note && <p class="help-note">{intro.note}</p>}
    </section>

    {article.slug === 'calisma-ekrani' && (
      <details class="help-screenshot">
        <summary>Uygulamadan çalışma ekranını gör</summary>
        <figure>
          <AppScreenshot screen="question" />
        </figure>
      </details>
    )}

    <section aria-labelledby="help-details-heading" class="help-detail-list">
      <h2 id="help-details-heading">Ayrıntılı anlatım</h2>
      <p class="help-detail-hint">İhtiyacın olan konuyu aç.</p>
      {groups.map((group, index) => (
        <details data-help-detail>
          <summary id={`rehber-bolum-${index + 1}`}>{group.title}</summary>
          <div class="help-prose help-detail-body">
            {index === 0 && <div set:html={reading.lead}></div>}
            <div set:html={group.html}></div>
          </div>
        </details>
      ))}
    </section>

    <nav aria-labelledby="related-heading" class="help-related">
      <h2 id="related-heading" tabindex="-1">İlgili rehberler</h2>
      <ul>{related.map((item) => <li><a href={item.webPath}>{item.title}<span aria-hidden="true"> →</span></a></li>)}</ul>
      <a class="text-link" href="/yardim/">Tüm rehberler</a>
    </nav>
    <p class="help-contact">Sorunun çözülmediyse <a class="text-link" href="/destek/">destek sayfasından yazabilirsin</a>.</p>
  </article>
</Layout>

<script>
  const picker = document.querySelector<HTMLDetailsElement>('[data-help-section-picker]');
  const pickerToggle = picker?.querySelector('summary');
  let pendingPickerFocus: string | null = null;

  // Stable source anchors still open the right detail group, including links from the app.
  function revealHelpAnchor(moveFocus = false) {
    if (!window.location.hash) return;
    let id: string;
    try { id = decodeURIComponent(window.location.hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    if (!target) return;
    let parent = target.parentElement;
    while (parent) {
      if (parent instanceof HTMLDetailsElement) parent.open = true;
      parent = parent.parentElement;
    }
    // A fragment is an explicit reading destination; ordinary page loads keep scrollY at zero.
    requestAnimationFrame(() => {
      if (moveFocus) target.focus({ preventScroll: true });
      target.scrollIntoView({ block: 'start', behavior: 'instant' });
    });
  }

  window.addEventListener('hashchange', () => {
    revealHelpAnchor(pendingPickerFocus === window.location.hash);
    pendingPickerFocus = null;
  });
  picker?.addEventListener('keydown', (event) => {
    if (!picker.open) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      picker.open = false;
      pickerToggle?.focus({ preventScroll: true });
    } else if (event.key === 'Tab') {
      // Safari may focus the main region before a link tap. Only close on keyboard focus leaving.
      requestAnimationFrame(() => {
        if (!picker.contains(document.activeElement)) picker.open = false;
      });
    }
  });
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    if (picker?.open && !picker.contains(event.target)) picker.open = false;
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const link = event.target.closest<HTMLAnchorElement>('a[href]');
    if (!link || !link.hash || link.origin !== window.location.origin || link.pathname !== window.location.pathname) return;
    if (picker?.contains(link)) {
      picker.open = false;
      pendingPickerFocus = link.hash === window.location.hash ? null : link.hash;
      if (!pendingPickerFocus) revealHelpAnchor(true);
    } else if (link.hash === window.location.hash) {
      revealHelpAnchor();
    }
  });
  revealHelpAnchor();
</script>

<style>
  :global(html:has(.help-reading)) { scroll-padding-top: calc(var(--site-header-height, 4.75rem) + 4.25rem); }
  .help-reading { max-width: 48rem; margin-inline: auto; padding: 2rem 1.25rem 4rem; }
  .help-breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; color: #596166; font-size: .875rem; margin-bottom: 1.25rem; }
  .help-breadcrumb a { display: inline-flex; align-items: center; min-height: 2.75rem; color: #0e7469; }
  .help-category { text-decoration: underline; text-underline-offset: .2em; }
  .help-intro { color: #596166; font-size: 1.0625rem; line-height: 1.85; margin-top: 1rem; }
  .help-product-faq { margin-top: .75rem; line-height: 1.8; color: #596166; }
  .help-reading h2 { font-size: 1.25rem; font-weight: 600; letter-spacing: -.02em; line-height: 1.4; }
  .help-section-bar { position: sticky; z-index: 10; top: calc(var(--site-header-height, 4.75rem) + 1px); margin-top: 1.25rem; padding-block: .5rem; background: #fff; }
  .help-section-picker { position: relative; }
  .help-reading .help-section-toggle { display: flex; justify-content: space-between; align-items: center; gap: .75rem; min-height: 2.75rem; padding: .5rem .875rem; border: 1px solid #dde1e4; border-radius: .625rem; background: #f3f5f6; color: #0e7469; font-size: .875rem; font-weight: 600; list-style: none; }
  .help-section-toggle::-webkit-details-marker { display: none; }
  .help-section-picker[open] .help-section-toggle svg { rotate: 180deg; }
  .help-section-panel { position: absolute; inset-inline: 0; top: calc(100% + .375rem); max-block-size: min(24rem, 52dvh); overflow: auto; padding: .375rem; border: 1px solid #dde1e4; border-radius: .625rem; background: #fff; box-shadow: 0 8px 24px rgba(36, 41, 44, .1); }
  .help-section-panel a { display: flex; align-items: center; min-height: 2.75rem; padding: .5rem; border-radius: .375rem; color: #24292c; font-size: .875rem; }
  .help-section-panel a:hover, .help-section-panel a:focus-visible { background: #e4f4f1; color: #0e7469; }
  .help-section-panel a:focus-visible { outline-offset: -2px; }
  @media (prefers-reduced-motion: no-preference) {
    .help-section-toggle svg { transition: rotate 160ms cubic-bezier(.23, 1, .32, 1); }
    .help-section-picker[open] .help-section-panel { animation: help-sections-enter 160ms cubic-bezier(.23, 1, .32, 1) both; }
  }
  @keyframes help-sections-enter { from { opacity: 0; translate: 0 -.25rem; } }
  .help-start { margin-top: 1.5rem; }
  .help-start ol { list-style: decimal; padding-left: 1.5rem; margin-top: 1rem; line-height: 1.85; }
  .help-start li { padding-left: .35rem; margin-top: .65rem; }
  .help-start li::marker { color: #0e7469; font-weight: 600; }
  .help-note { border-left: 3px solid #0e7469; padding: .875rem 1rem; margin-top: 1.5rem; background: #f3f5f6; line-height: 1.8; color: #24292c; }
  .help-detail-list { margin-top: 2.75rem; }
  .help-detail-hint { color: #596166; margin: .5rem 0 1.25rem; }
  .help-detail-list details { border-bottom: 1px solid #dde1e4; }
  .help-detail-list details:first-of-type { border-top: 1px solid #dde1e4; }
  .help-reading summary { padding: 1rem .25rem; min-height: 3.5rem; cursor: pointer; font-weight: 500; line-height: 1.7; }
  .help-reading summary::marker { color: #0e7469; }
  .help-reading details[open] > summary { color: #0e7469; }
  .help-detail-body { padding: .25rem .25rem 1.75rem; overflow-wrap: anywhere; }
  .help-detail-body :global([id]) { scroll-margin-top: 0; }
  .help-detail-body :global(h3) { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #e9ecee; }
  .help-detail-body :global(h4) { font-weight: 600; margin-top: 1.5rem; font-size: 1rem; }
  .help-detail-body :global(h3:first-child) { margin-top: .75rem; }
  .help-related { border-top: 1px solid #dde1e4; padding-top: 2rem; margin-top: 2.75rem; }
  .help-related ul { margin-top: .75rem; margin-bottom: .75rem; }
  .help-related li a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: #0e7469; min-height: 2.75rem; padding-block: .5rem; }
  .help-related li a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .help-contact { font-size: .875rem; line-height: 1.8; color: #596166; margin-top: 2rem; }
  .help-screenshot { margin-top: 1.25rem; }
  .help-screenshot summary { color: #0e7469; font-weight: 400; }
  .help-screenshot figure { margin-top: 1rem; }
  .help-screenshot :global(img) { width: 16rem; max-width: 100%; height: auto; border: 1px solid #dde1e4; border-radius: .75rem; }
  @media (min-width: 640px) { .help-reading { padding: 3rem 1.5rem 5rem; } }
</style>
