---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config';
import { breadcrumbList } from '../lib/schema';

const origin = new URL(Astro.site!).origin;
const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Destek ve İletişim', path: '/destek' },
]);

const clubMailto = `mailto:${SITE.email}?subject=${encodeURIComponent('Tıp Kulübü / Eğitim Topluluğu Ücretsiz Hesap Başvurusu')}`;
---
<Layout
  title="Destek ve İletişim | TusAnkiM"
  description="TusAnkiM e-posta desteği, teknik kayıt bildirimi, kart düzeltme önerisi ve tıp fakültesi kulüp ücretsiz hesap başvurusu."
  ogImage="/images/og-destek.png"
  schema={[crumbs]}
>
  <section class="bg-surfaceSoft border-b border-line py-10 sm:py-14">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <nav aria-label="Sayfa konumu" class="flex flex-wrap items-center gap-y-1 text-xs text-inkMuted mb-3">
        <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-ink font-semibold">Destek</span>
      </nav>
      <h1 class="display text-page-title tracking-tightest text-ink max-w-2xl">
        Destek ve İletişim
      </h1>
      <p class="text-inkMuted mt-3 max-w-2xl leading-relaxed">
        Kurulum, Anki aktarımı, FSRS-6 ayarları, kart düzeltme bildirimi, 7 gün iade talebi veya ücretsiz kulüp hesabı başvurusu için bize ulaşabilirsin.
      </p>
    </div>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-12">
    <div class="grid md:grid-cols-3 gap-6">
      <!-- Email Support -->
      <div class="rounded-2xl border-2 border-teal bg-white p-6 flex flex-col justify-between">
        <div>
          <h2 class="display text-xl text-ink">E-posta Desteği</h2>
          <p class="text-sm text-inkMuted mt-2 leading-relaxed">
            Anki <code>.apkg</code> içe aktarma, FSRS-6 hedef ayarı, günlük çalışma düzeni ve iade/erişim soruların için doğrudan yazabilirsin.
          </p>
        </div>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-6 inline-flex items-center justify-center w-full min-h-[2.75rem] rounded-full bg-teal text-white text-sm font-semibold hover:bg-tealDark transition"
        >
          {SITE.email}
        </a>
      </div>

      <!-- Free account for medical clubs & student groups -->
      <div class="rounded-2xl border border-line bg-white p-6 flex flex-col justify-between">
        <div>
          <h2 class="display text-xl text-ink">Tıp Kulüpleri &amp; Eğitim Toplulukları</h2>
          <p class="text-sm text-inkMuted mt-2 leading-relaxed">
            Tıp fakültesi öğrenci topluluklarına, dönem temsilcilerine ve düzenli tıp eğitimi paylaşımı yapan kulüplere ücretsiz tam erişim tanımlıyoruz.
          </p>
        </div>
        <a
          href={clubMailto}
          class="mt-6 inline-flex items-center justify-center w-full min-h-[2.75rem] rounded-full border border-teal bg-white text-teal text-sm font-semibold hover:bg-tint transition"
        >
          Ücretsiz Hesap Başvurusu
        </a>
      </div>

      <!-- Technical / Card Error Report -->
      <div class="rounded-2xl border border-line bg-white p-6 flex flex-col justify-between">
        <div>
          <h2 class="display text-xl text-ink">Kart Hatası &amp; Teknik Kayıt</h2>
          <p class="text-sm text-inkMuted mt-2 leading-relaxed">
            Bir kartta güncel kılavuz farkı gördüğünde veya teknik sorun yaşadığında kayıt aç; lütfen kişisel sağlık verisi veya parola paylaşma.
          </p>
        </div>
        <div class="mt-6 space-y-2.5">
          <a
            href={SITE.githubIssuesUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-full min-h-[2.75rem] rounded-full border border-line bg-white text-ink text-sm font-semibold hover:border-tealGraphic hover:text-teal transition"
          >
            Destek Kaydı Oluştur ↗
          </a>
          <p class="text-center text-xs text-inkMuted">
            E-posta: <a href={`mailto:${SITE.email}`} class="text-teal underline">{SITE.email}</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Self-service help & social -->
    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <div class="rounded-2xl border border-line bg-white p-6">
        <h2 class="display text-lg text-ink">Yardım Merkezi &amp; SSS</h2>
        <ul class="mt-3 space-y-0.5 text-sm">
          <li><a href="/yardim/hizli-baslangic/" class="inline-flex items-center min-h-[2.75rem] py-1.5 text-teal underline hover:text-tealDark">Hızlı başlangıç: 5 dakikada ilk çalışma →</a></li>
          <li><a href="/yardim/anki-ile-kullanma/" class="inline-flex items-center min-h-[2.75rem] py-1.5 text-teal underline hover:text-tealDark">Anki destelerini (.apkg / .colpkg) aktarma →</a></li>
          <li><a href="/yardim/sss/" class="inline-flex items-center min-h-[2.75rem] py-1.5 text-teal underline hover:text-tealDark">Sık sorunların çözümleri (kart gelmiyor, yedekleme) →</a></li>
          <li><a href="/sss/" class="inline-flex items-center min-h-[2.75rem] py-1.5 text-teal underline hover:text-tealDark">Tüm Sıkça Sorulan Sorular →</a></li>
        </ul>
      </div>

      <div class="rounded-2xl border border-line bg-white p-6">
        <h2 class="display text-lg text-ink">Doğrulanabilir Kanallar &amp; Rehberler</h2>
        <p class="text-sm text-inkMuted mt-2 leading-relaxed">
          Resmî destek ve teknik bildirimler yalnızca aşağıdaki doğrulanabilir kanallar üzerinden yürütülür:
        </p>
        <ul class="mt-3 space-y-0.5 text-sm">
          <li>
            <a href={`mailto:${SITE.email}`} class="inline-flex items-center min-h-[2.75rem] py-1.5 text-teal underline hover:text-tealDark">
              E-posta: {SITE.email} →
            </a>
          </li>
          <li>
            <a href={SITE.githubIssuesUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-[2.75rem] py-1.5 text-teal underline hover:text-tealDark">
              GitHub Teknik Destek &amp; Hata Bildirimi ↗
            </a>
          </li>
          <li>
            <a href="/kurucu/" class="inline-flex items-center min-h-[2.75rem] py-1.5 text-teal underline hover:text-tealDark">
              Kurucu Hekim &amp; Editöryal Standart →
            </a>
          </li>
          <li>
            <a href="/rehber/" class="inline-flex items-center min-h-[2.75rem] py-1.5 text-teal underline hover:text-tealDark">
              TUS Çalışma Rehberleri →
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
