---
import Layout from '../../layouts/Layout.astro';
import {
  REHBER_ARTICLES,
  estimateReadingMinutes,
  type RehberArticle,
} from '../../data/rehber/index';
import { inlineHtml } from '../../lib/richtext';
import { breadcrumbList, faqPage } from '../../lib/schema';
import { formatTrDate } from '../../lib/lastmod';

export function getStaticPaths() {
  return REHBER_ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: RehberArticle;
}

const { article } = Astro.props;
const origin = new URL(Astro.site!).origin;
const pagePath = `/rehber/${article.slug}`;
// Each article carries its own dates, so editing one article does not re-date the other twenty.
const modDate = article.updated;

const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'TUS Yazıları', path: '/rehber' },
  { name: article.questionH1, path: pagePath },
]);

const authorOrg = { '@id': origin + '/#organization' };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.questionH1,
  description: article.seoDescription,
  articleSection: article.category,
  inLanguage: 'tr-TR',
  url: origin + pagePath + '/',
  image: `${origin}/images/og/rehber/${article.slug}.png`,
  datePublished: article.published,
  dateModified: modDate,
  author: authorOrg,
  citation: article.sources.map((s) => (s.url.startsWith('/') ? origin + s.url : s.url)),
  publisher: authorOrg,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['#hizli-cevap'],
  },
};

const schemas: Record<string, unknown>[] = [crumbs, articleSchema];
if (article.faq?.length) {
  schemas.push(
    faqPage(
      origin,
      pagePath,
      article.faq.map((item) => ({ question: item.q, answer: item.a })),
    ),
  );
}

const related = article.relatedLinks;
---
<Layout
  title={article.seoTitle}
  description={article.seoDescription}
  ogType="article"
  modifiedTime={modDate}
  schema={schemas}
>
  <section class="bg-surface border-b border-line py-8 sm:py-12">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-6">
      <nav aria-label="Sayfa konumu" class="mb-3">
        <ol class="flex flex-wrap items-center gap-y-1 text-xs text-inkMuted">
          <li class="inline-flex items-center">
            <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
          </li>
          <li class="inline-flex items-center">
            <span aria-hidden="true" class="mx-2">/</span>
            <a href="/rehber/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">TUS Yazıları</a>
          </li>
          <li class="inline-flex items-center">
            <span aria-hidden="true" class="mx-2">/</span>
            <span aria-current="page" class="inline-flex items-center min-h-[2.75rem] py-2 text-ink font-semibold">
              {article.category}
            </span>
          </li>
        </ol>
      </nav>

      <h1 class="display text-page-title tracking-tightest text-ink">
        {article.questionH1}
      </h1>
    </div>
  </section>

  <article class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-6 py-10 space-y-10">
    <!-- Part 2: Direct answer, marked for search and voice assistants -->
    <div id="hizli-cevap" class="border-t border-line pt-5">
      <p class="text-base sm:text-lg text-ink leading-relaxed font-semibold" set:html={inlineHtml(article.directAnswer)} />
    </div>

    <!-- Part 3: Neden böyle sanılıyor? -->
    <section class="help-prose" aria-labelledby="misconception-heading">
      <h2 id="misconception-heading">Neden böyle sanılıyor?</h2>
      {article.whyMisconceived.map((p) => (
        <p set:html={inlineHtml(p)} />
      ))}
    </section>

    <!-- Part 4: Doğrusu (+ HTML table) -->
    <section class="help-prose" aria-labelledby="truth-heading">
      <h2 id="truth-heading">Doğrusu</h2>
      {article.truthParagraphs.map((p) => (
        <p set:html={inlineHtml(p)} />
      ))}

      <p id="guide-table-caption" class="mt-6 text-sm text-inkMuted">{article.table.caption}</p>
      <div
        class="help-table-wrap border-y border-line mt-2"
        tabindex="0"
        role="region"
        aria-labelledby="guide-table-caption"
      >
        <table>
          <caption class="sr-only">{article.table.caption}</caption>
          <thead>
            <tr>
              {article.table.headers.map((h) => (
                <th scope="col">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {article.table.rows.map((row) => (
              <tr>
                {row.map((cell, idx) => (
                  idx === 0 ? <th scope="row" class="font-semibold text-ink">{cell}</th> : <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Part 5: Ne yapmalısın? -->
    <section class="help-prose" aria-labelledby="action-heading">
      <h2 id="action-heading">Ne yapmalısın?</h2>
      <ol>
        {article.actionSteps.map((step) => (
          <li set:html={inlineHtml(step)} />
        ))}
      </ol>
    </section>

    <!-- Part 5b: Sık sorulan sorular (native accordion + FAQPage JSON-LD) -->
    {article.faq && article.faq.length > 0 && (
      <section class="border-t border-line pt-5" aria-labelledby="article-faq-heading">
        <h2 id="article-faq-heading" class="display text-base text-ink">Sık sorulan sorular</h2>
        <div class="faq mt-2">
          {article.faq.map((item) => (
            <details>
              <summary><span>{item.q}</span></summary>
              <div class="faq-answer">
                <p set:html={inlineHtml(item.a)} />
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Part 6: Sınır uyarısı -->
    <section class="border-t border-line pt-5" aria-labelledby="boundary-heading">
      <h2 id="boundary-heading" class="display text-base text-ink">Sınır uyarısı</h2>
      <p class="mt-2 text-sm text-inkMuted leading-relaxed" set:html={inlineHtml(article.boundaryNote)} />
    </section>

    <!-- Part 7: Kaynaklar -->
    <section class="border-t border-line pt-5" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="display text-base text-ink">Kaynaklar</h2>
      <ul class="mt-3 space-y-1 text-sm">
        {article.sources.map((src) => {
          const external = /^https?:\/\//.test(src.url);
          return (
            <li>
              <a
                href={src.url}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center min-h-[2.75rem] py-1.5 text-teal underline underline-offset-2 hover:text-tealDark"
              >
                {src.label} ({src.publisher}){external ? ' ↗' : ''}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  </article>
</Layout>
