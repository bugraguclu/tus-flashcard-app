---
import Layout from '../../layouts/Layout.astro';
import { REHBER_ARTICLES, type RehberArticle } from '../../data/rehber/index';
import { inlineHtml } from '../../lib/richtext';
import { breadcrumbList } from '../../lib/schema';
import { effectiveDate, formatTrDate } from '../../lib/lastmod';

export function getStaticPaths() {
  return REHBER_ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: RehberArticle;
}

const { article } = Astro.props;
const origin = new URL(Astro.site!).origin;
const pagePath = `/rehber/${article.slug}`;
const modDate = effectiveDate([
  'website/src/pages/rehber/[slug].astro',
  'website/src/data/rehber/index.ts',
  'website/src/data/rehber/part1.ts',
  'website/src/data/rehber/part2.ts',
  'website/src/data/rehber/part3.ts',
]);
const modLabel = formatTrDate(modDate);

const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'TUS Yazıları', path: '/rehber' },
  { name: article.questionH1, path: pagePath },
]);

const authorOrg = { '@id': origin + '/#organization' };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.questionH1,
  description: article.seoDescription,
  inLanguage: 'tr-TR',
  url: origin + pagePath + '/',
  dateModified: modDate,
  author: authorOrg,
  citation: article.sources.map((s) => s.url),
  publisher: { '@id': origin + '/#organization' },
};
---
<Layout
  title={article.seoTitle}
  description={article.seoDescription}
  ogType="article"
  modifiedTime={modDate}
  schema={[crumbs, articleSchema]}
>
  <section class="bg-surface border-b border-line py-8 sm:py-12">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-10">
      <nav aria-label="Sayfa konumu" class="mb-3">
        <ol class="flex flex-wrap items-center gap-y-1 text-xs text-inkMuted">
          <li class="inline-flex items-center">
            <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
          </li>
          <li class="inline-flex items-center">
            <span aria-hidden="true" class="mx-2">/</span>
            <a href="/rehber/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">TUS Yazıları</a>
          </li>
          <li class="inline-flex items-center">
            <span aria-hidden="true" class="mx-2">/</span>
            <a href={pagePath + '/'} aria-current="page" class="inline-flex items-center min-h-[2.75rem] py-2 text-ink font-semibold">
              Yazı {String(article.order).padStart(2, '0')}
            </a>
          </li>
        </ol>
      </nav>

      <p class="text-xs font-semibold text-teal">
        TUS Çalışma Rehberi {String(article.order).padStart(2, '0')} / {REHBER_ARTICLES.length} · {article.tone}
      </p>
      <h1 class="display text-page-title tracking-tightest text-ink mt-2">
        {article.questionH1}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-inkMuted">
        <span>
          Son güncelleme: <time datetime={modDate} class="font-semibold text-ink">{modLabel}</time>
        </span>
        <span>
          Hazırlayan:{' '}
          <a href="/hakkimizda/" class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark">
            TusAnkiM
          </a>
        </span>
      </div>
    </div>
  </section>

  <article class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-10 py-10 space-y-10">
    <!-- Part 2: Direct <=50-word answer -->
    <div class="rounded-2xl border-l-4 border-teal bg-tint p-5 sm:p-6">
      <p class="text-base sm:text-lg text-ink leading-relaxed font-semibold">
        {article.directAnswer}
      </p>
    </div>

    <!-- Part 3: Neden böyle sanılıyor? -->
    <section class="help-prose" aria-labelledby="misconception-heading">
      <h2 id="misconception-heading">Neden böyle sanılıyor?</h2>
      {article.whyMisconceived.map((p) => (
        <p>{p}</p>
      ))}
    </section>

    <!-- Part 4: Doğrusu (+ HTML table) -->
    <section class="help-prose" aria-labelledby="truth-heading">
      <h2 id="truth-heading">Doğrusu</h2>
      {article.truthParagraphs.map((p) => (
        <p set:html={inlineHtml(p)} />
      ))}

      <div
        class="help-table-wrap rounded-2xl border border-line bg-white mt-6"
        tabindex="0"
        role="region"
        aria-labelledby="guide-table-caption"
      >
        <table>
          <caption id="guide-table-caption" class="sr-only">{article.table.caption}</caption>
          <thead>
            <tr>
              {article.table.headers.map((h) => (
                <th scope="col">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {article.table.rows.map((row) => (
              <tr>
                {row.map((cell, idx) => (
                  idx === 0 ? <th scope="row" class="font-semibold text-ink">{cell}</th> : <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Part 5: Ne yapabilirsiniz? -->
    <section class="help-prose" aria-labelledby="action-heading">
      <h2 id="action-heading">Ne yapabilirsiniz?</h2>
      <ol>
        {article.actionSteps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </section>

    <!-- Part 6: Sınır uyarısı -->
    <section class="rounded-2xl border border-line bg-surfaceSoft p-5 sm:p-6" aria-labelledby="boundary-heading">
      <h2 id="boundary-heading" class="display text-base text-ink">Sınır uyarısı</h2>
      <p class="mt-2 text-sm text-inkMuted leading-relaxed">{article.boundaryNote}</p>
    </section>

    <!-- Part 7: Kaynaklar -->
    <section class="rounded-2xl border border-line bg-white p-5 sm:p-6" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="display text-base text-ink">Kaynaklar</h2>
      <ul class="mt-3 space-y-1 text-sm">
        {article.sources.map((src) => (
          <li>
            <a
              href={src.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center min-h-[2.75rem] py-1.5 text-teal underline underline-offset-2 hover:text-tealDark"
            >
              {src.label} ({src.publisher}) ↗
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-3 pt-3 border-t border-lineLight text-xs text-inkMuted leading-relaxed">
        Hazırlayan: <a href="/hakkimizda/" class="font-semibold text-teal underline hover:text-tealDark">TusAnkiM</a> ·
        Son güncelleme: <time datetime={modDate} class="font-semibold text-ink">{modLabel}</time>
      </p>
    </section>

    <!-- Part 8: İlgili iç bağlantılar -->
    <nav aria-label="İlgili rehberler ve araçlar" class="pt-6 border-t border-line">
      <h2 class="display text-base text-ink">İlgili rehberler ve araçlar</h2>
      <ul class="mt-3 flex flex-wrap gap-2.5">
        {article.relatedLinks.map((lnk) => (
          <li>
            <a
              href={lnk.href}
              class="inline-flex items-center min-h-[2.75rem] px-4 rounded-full border border-line bg-surfaceSoft text-xs font-semibold text-ink hover:border-tealGraphic hover:text-teal transition"
            >
              {lnk.label} →
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </article>
</Layout>
