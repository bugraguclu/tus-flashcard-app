---
import Layout from '../../layouts/Layout.astro';
import { REHBER_ARTICLES } from '../../data/rehber/index';
import { breadcrumbList, collectionPage } from '../../lib/schema';
import { effectiveDate, formatTrDate } from '../../lib/lastmod';

const origin = new URL(Astro.site!).origin;
const modDate = effectiveDate([
  'website/src/pages/rehber/index.astro',
  'website/src/data/rehber/index.ts',
  'website/src/data/rehber/part1.ts',
  'website/src/data/rehber/part2.ts',
  'website/src/data/rehber/part3.ts',
]);
const modLabel = formatTrDate(modDate);

const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'TUS Yazıları', path: '/rehber' },
]);

const colSchema = collectionPage(origin, {
  path: '/rehber',
  name: 'TUS çalışma rehberleri: puan, takvim, FSRS-6 | TusAnkiM',
  description:
    'TUS puanının hesabı, 2027 TUS tarihleri, FSRS-6, kaç kart çalışılacağı ve Anki uyumlu çalışma üzerine kısa yazılar.',
  items: REHBER_ARTICLES.map((a) => ({ name: a.questionH1, path: `/rehber/${a.slug}` })),
  dateModified: modDate,
});
---
<Layout
  title="TUS çalışma rehberleri: puan, takvim, FSRS-6 | TusAnkiM"
  description="TUS çalışma rehberleri: doğru bilinen yanlışlar, 5. sınıf, intörn ve son 1 ay programı, 2027 takvimi, puan hesabı ve FSRS-6 üzerine 8 kısa, kaynaklı yazı."
  modifiedTime={modDate}
  schema={[crumbs, colSchema]}
>
  <section class="bg-white border-b border-line py-10 sm:py-14">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <nav aria-label="Sayfa konumu" class="mb-3">
        <ol class="flex flex-wrap items-center gap-y-1 text-xs text-inkMuted">
          <li class="inline-flex items-center">
            <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
          </li>
          <li class="inline-flex items-center">
            <span aria-hidden="true" class="mx-2">/</span>
            <a href="/rehber/" aria-current="page" class="inline-flex items-center min-h-[2.75rem] py-2 text-ink font-semibold">
              TUS Yazıları
            </a>
          </li>
        </ol>
      </nav>

      <h1 class="display text-page-title tracking-tightest text-ink max-w-3xl">
        TUS Yazıları
      </h1>
      <p class="text-inkMuted mt-3 max-w-2xl leading-relaxed">
        TUS puanı, 2027 sınav takvimi, FSRS-6, kaç kart çalışılacağı ve sık yapılan çalışma hataları üzerine {REHBER_ARTICLES.length} kısa yazı. Hepsi veriye ve resmî kaynaklara dayanır.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-inkMuted">
        <span>
          Son güncelleme: <time datetime={modDate} class="font-semibold text-ink">{modLabel}</time>
        </span>
        <span>
          Hazırlayan:{' '}
          <a href="/hakkimizda/" class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark">
            TusAnkiM
          </a>
        </span>
      </div>
    </div>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-12">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-8">
      {REHBER_ARTICLES.map((art) => (
        <a
          href={`/rehber/${art.slug}/`}
          class="border-t border-line pt-5 hover:border-tealGraphic transition flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 text-[11px] font-bold text-teal">
              <span>Yazı {String(art.order).padStart(2, '0')}</span>
            </div>
            <h2 class="display text-base text-ink mt-2 leading-snug">{art.questionH1}</h2>
            <p class="text-xs sm:text-sm text-inkMuted mt-2.5 leading-relaxed">{art.directAnswer}</p>
          </div>
          <span class="mt-5 inline-flex items-center text-xs font-semibold text-teal">
            Yazıyı oku →
          </span>
        </a>
      ))}
    </div>

    <aside class="mt-12 border-t border-line pt-5 text-sm text-inkMuted leading-relaxed">
      <h2 class="display text-base text-ink">Kılavuzlar, araçlar ve referanslar</h2>
      <p class="mt-2">
        Uygulamanın ekranlarını adım adım{' '}
        <a href="/yardim/" class="font-semibold text-teal underline hover:text-tealDark">21 Türkçe yardım rehberi</a>{' '}
        anlatır. Çıkmış soruların dağılımına{' '}
        <a href="/tus-cikmis-sorular-ve-analiz/" class="font-semibold text-teal underline hover:text-tealDark">TUS çıkmış sorular analizinden</a>{' '}
        ve <a href="/referanslar/" class="font-semibold text-teal underline hover:text-tealDark">11 ÖSYM TUS branşının referans cetvelinden</a>{' '}
        bakabilirsin. Diğer araçlar ve sayfalar:{' '}
        <a href="/tus-taban-puanlari-ve-kontenjan/" class="font-semibold text-teal underline hover:text-tealDark">TUS taban puanları</a>,{' '}
        <a href="/yardim/kronometre/" class="font-semibold text-teal underline hover:text-tealDark">TUS kronometresi ve çalışma takvimi</a>,{' '}
        <a href="/tus-spot-bilgiler/" class="font-semibold text-teal underline hover:text-tealDark">TUS spot bilgiler</a> ve{' '}
        <a href="/tus-icin-ankimobile-alternatifi/" class="font-semibold text-teal underline hover:text-tealDark">AnkiMobile alternatifi</a>.
      </p>
    </aside>
  </section>
</Layout>
