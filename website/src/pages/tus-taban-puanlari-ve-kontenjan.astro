<script>
  document.querySelectorAll<HTMLElement>('[data-osym-explorer]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';

    const periodBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-osym-period]')];
    const searchInput = root.querySelector<HTMLInputElement>('#osym-search');
    const sortSelect = root.querySelector<HTMLSelectElement>('#osym-sort');
    const tbody = root.querySelector<HTMLElement>('[data-osym-tbody]');
    const countEl = root.querySelector<HTMLElement>('[data-osym-count]');
    if (!tbody) return;
    const tableBody = tbody;

    const rows = [...tableBody.querySelectorAll<HTMLTableRowElement>('[data-osym-row]')];
    const emptyRow = tableBody.querySelector<HTMLTableRowElement>('[data-osym-empty]');
    let activePeriod = 'all';

    const normTr = (s: string) =>
      s
        .toLocaleLowerCase('tr-TR')
        .replace(/ç/g, 'c')
        .replace(/ğ/g, 'g')
        .replace(/ı/g, 'i')
        .replace(/ö/g, 'o')
        .replace(/ş/g, 's')
        .replace(/ü/g, 'u')
        .replace(/â/g, 'a');

    function applyFilterAndSort() {
      const tokens = normTr((searchInput?.value || '').trim()).split(/\s+/).filter(Boolean);
      const mode = sortSelect?.value || 'default';

      const sorted = [...rows].sort((a, b) => {
        if (mode === 'min-desc') return Number(b.dataset.min) - Number(a.dataset.min);
        if (mode === 'max-desc') return Number(b.dataset.max) - Number(a.dataset.max);
        if (mode === 'quota-desc') return Number(b.dataset.quota) - Number(a.dataset.quota);
        if (mode === 'fill-desc') return Number(b.dataset.fill) - Number(a.dataset.fill);
        if (mode === 'alpha') return (a.dataset.branch || '').localeCompare(b.dataset.branch || '', 'tr-TR');
        return Number(a.dataset.idx) - Number(b.dataset.idx);
      });

      let visible = 0;
      const frag = document.createDocumentFragment();
      for (const row of sorted) {
        const matchPeriod = activePeriod === 'all' || row.dataset.period === activePeriod;
        const hay = row.dataset.search || '';
        const matchQuery = tokens.every((t) => hay.includes(t));
        const show = matchPeriod && matchQuery;
        row.hidden = !show;
        if (show) visible++;
        frag.appendChild(row);
      }
      if (emptyRow) {
        emptyRow.hidden = visible > 0;
        frag.appendChild(emptyRow);
      }
      tableBody.appendChild(frag);

      if (countEl) {
        countEl.textContent = '';
        countEl.appendChild(document.createTextNode('Gösterilen kayıt: '));
        const strong = document.createElement('strong');
        strong.className = 'text-ink';
        strong.textContent = String(visible);
        countEl.appendChild(strong);
        countEl.appendChild(document.createTextNode(` / ${rows.length}`));
      }
    }

    periodBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activePeriod = btn.dataset.osymPeriod || 'all';
        periodBtns.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
          b.className = active
            ? 'min-h-[2.75rem] px-4 rounded-xl text-xs sm:text-sm font-semibold bg-teal text-white transition cursor-pointer'
            : 'min-h-[2.75rem] px-4 rounded-xl text-xs sm:text-sm font-semibold bg-white border border-line text-ink hover:border-tealGraphic transition cursor-pointer';
        });
        applyFilterAndSort();
      });
    });

    searchInput?.addEventListener('input', applyFilterAndSort);
    sortSelect?.addEventListener('change', applyFilterAndSort);
  });
</script>
