---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config';
import { breadcrumbList } from '../lib/schema';
import { effectiveDate, formatTrDate, pageSources } from '../lib/lastmod';

const origin = new URL(Astro.site!).origin;
const modDate = effectiveDate(pageSources('ankimobile-alternatifi'));
const modLabel = formatTrDate(modDate);

const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'TUS İçin AnkiMobile Alternatifi', path: '/tus-icin-ankimobile-alternatifi' },
]);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': origin + '/tus-icin-ankimobile-alternatifi/#article',
  headline: 'TUS için AnkiMobile alternatifi: iPhone ve webde karşılaştırma',
  description:
    'AnkiMobile Flashcards (₺1.299,99) ile bağımsız TusAnkiM’in karşılaştırması: .apkg ve .colpkg desteği, FSRS-6, Kronometre, fiyat seçenekleri ve TusAnkiM’de henüz olmayanlar.',
  url: origin + '/tus-icin-ankimobile-alternatifi/',
  inLanguage: 'tr-TR',
  dateModified: modDate,
  author: { '@id': origin + '/#organization' },
  publisher: { '@id': origin + '/#organization' },
};

const COMPARISON_ROWS = [
  {
    feature: 'iPhone’da fiyat',
    ankimobile: '₺1.299,99, tek seferlik (App Store Türkiye, 21 Kasım 2026)',
    tusankim: 'Beta ücretsiz ve reklamsız. Planlanan: ₺0 ücretsiz kullanım (ara ara reklam), 9.575 kartın tamamı ₺2.000, reklam kaldırma ₺50',
  },
  {
    feature: 'Seçili demo soruları',
    ankimobile: 'Boş gelir; hazır TUS sorusu veya destesi yok',
    tusankim: 'Üç seçenekte de açık',
  },
  {
    feature: 'Anki dosyaları (.apkg, .colpkg)',
    ankimobile: 'Resmî Anki biçimlerinin tamamını destekler',
    tusankim: 'Kendi .apkg, .colpkg ve CSV/TSV dosyalarını kayıpsız içe ve dışa aktarır',
  },
  {
    feature: 'Tekrar algoritması',
    ankimobile: 'FSRS ve SM-2',
    tusankim: 'FSRS-6 (%90 hedef hatırlama, 21 parametre) ve klasik zamanlayıcı',
  },
  {
    feature: 'Hazır TUS kartları',
    ankimobile: 'Topluluk destelerini kendin kurarsın; çıkmış TUS sorularıyla karşılaştırma yok',
    tusankim: '9.575 kart (12 ders, 106 alt deste). Son 6 TUS’ta %43,6 çözüm desteği, %92,7 konu kapsamı',
  },
  {
    feature: 'Kronometre ve çalışma takvimi',
    ankimobile: 'Yerleşik kronometre veya çalışma takvimi yok',
    tusankim: 'Kronometre, Çalışma Takvimi ve Çalışma Planlama uygulamanın içinde; internetsiz çalışır',
  },
  {
    feature: 'Otomatik eşitleme',
    ankimobile: 'AnkiWeb ile otomatik eşitler',
    tusankim: 'Henüz yok. Cihaz değiştirirken .colpkg dosyasını taşırsın',
  },
  {
    feature: 'Android ve bilgisayar',
    ankimobile: 'AnkiDroid (Android) ve Anki masaüstü ayrı uygulamalar',
    tusankim: 'iPhone uygulaması geliştiriliyor. Bugün tarayıcıda çalışır (iPhone Safari dahil): tusankim.vercel.app/uygulama. Android uygulaması henüz yok',
  },
] as const;
---
<Layout
  title="TUS için AnkiMobile alternatifi: iPhone ve web | TusAnkiM"
  description="TUS için AnkiMobile alternatifi arıyorsan TusAnkiM betada ücretsiz; .apkg ve .colpkg destelerini açar. AnkiMobile ile farkları ve eksiklerimizi yazdık."
  ogType="article"
  modifiedTime={modDate}
  schema={[crumbs, articleSchema]}
>
  <section class="bg-white border-b border-line py-10 sm:py-14">
    <div class="max-w-content mx-auto px-5 sm:px-6 lg:px-10">
      <nav aria-label="Sayfa konumu" class="mb-3">
        <ol class="flex flex-wrap items-center gap-y-1 text-xs text-inkMuted">
          <li class="inline-flex items-center">
            <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
          </li>
          <li class="inline-flex items-center">
            <span aria-hidden="true" class="mx-2">/</span>
            <a href="/tus-icin-ankimobile-alternatifi/" aria-current="page" class="inline-flex items-center min-h-[2.75rem] py-2 text-ink font-semibold">
              AnkiMobile Alternatifi
            </a>
          </li>
        </ol>
      </nav>

      <h1 class="display text-page-title tracking-tightest text-ink max-w-3xl">
        TUS için iPhone’da AnkiMobile alternatifi var mı?
      </h1>
      <p class="text-inkMuted mt-3 max-w-3xl leading-relaxed">
        Var. TusAnkiM iPhone’da Safari’den, bilgisayarda tarayıcıdan çalışır; Anki destelerini (<code>.apkg</code>, <code>.colpkg</code>) açar ve betada ücretsizdir.
        <strong>AnkiMobile Flashcards</strong> Türkiye App Store’da tek seferlik <strong>₺1.299,99</strong> (21 Kasım 2026’da baktık).
        Aşağıda ikisini yan yana koyduk; AnkiMobile’ın daha iyi seçim olduğu durumları da yazdık.
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-inkMuted">
        <span>
          Son güncelleme: <time datetime={modDate} class="font-semibold text-ink">{modLabel}</time>
        </span>
        <span>
          Hazırlayan:{' '}
          <a href="/hakkimizda/" class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark">
            TusAnkiM
          </a>
        </span>
      </div>
    </div>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-6 lg:px-10 py-12 space-y-12">
    <!-- Independence & Transparency Callout -->
    <div class="border-t border-line pt-5">
      <p class="text-sm sm:text-base text-ink leading-relaxed font-semibold">
        {SITE.disclaimer} Anki çok iyi bir yazılım; masaüstü sürümü açık kaynak ve arkasında büyük bir topluluk var. Bu sayfa hangi durumda AnkiMobile’ın,
        hangi durumda TusAnkiM’in sana daha uygun olduğunu artısıyla eksisiyle gösterir.
      </p>
    </div>

    <!-- Main Comparison Table -->
    <div class="space-y-4">
      <h2 class="display text-section tracking-tightest text-ink">
        AnkiMobile ile TusAnkiM arasındaki fark ne?
      </h2>
      <p class="text-sm text-inkMuted max-w-3xl leading-relaxed">
        İkisi de Anki’nin açık dosya biçimlerini (<code>.apkg</code>, <code>.colpkg</code>) okur. Fark fiyatta, hazır TUS kartlarında ve eşitlemede.
        Özellikleri ve fiyatları tabloda yan yana görürsün.
      </p>

      <div
        class="overflow-x-auto border-y border-line"
        tabindex="0"
        role="region"
        aria-labelledby="anki-comp-caption"
      >
        <table class="w-full text-left border-collapse text-sm">
          <caption id="anki-comp-caption" class="sr-only">
            AnkiMobile Flashcards ile TusAnkiM’in fiyat, Anki dosyası desteği, tekrar algoritması ve platform karşılaştırması
          </caption>
          <thead>
            <tr class="border-b border-line text-xs font-semibold text-inkMuted">
              <th scope="col" class="py-3.5 px-5">Ölçüt</th>
              <th scope="col" class="py-3.5 px-5">AnkiMobile Flashcards (resmî iOS uygulaması)</th>
              <th scope="col" class="py-3.5 px-5 text-teal">TusAnkiM (bağımsız, iPhone ve web)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-lineLight">
            {COMPARISON_ROWS.map((r) => (
              <tr>
                <th scope="row" class="py-3.5 px-5 font-semibold text-ink">{r.feature}</th>
                <td class="py-3.5 px-5 text-inkMuted">{r.ankimobile}</td>
                <td class="py-3.5 px-5 text-ink font-medium">{r.tusankim}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- 3-Segment Access Summary -->
    <div class="space-y-4 pt-6 border-t border-line">
      <h2 class="display text-section tracking-tightest text-ink">
        TusAnkiM ücretli mi?
      </h2>
      <p class="text-sm text-inkMuted leading-relaxed">Şu an ücretsiz. Güncel beta sürümünde ücretli seçenekler ve reklamlar henüz devrede değil; TUS paketi ücretsiz açılır. Abonelik yok; planlanan üç seçenek şöyle.</p>
      <div class="grid md:grid-cols-3 gap-x-10 gap-y-8">
        <div class="border-t border-line pt-5 space-y-2">
          <div class="text-xs font-bold text-teal">Seçenek 1 · ₺0</div>
          <h3 class="display text-lg text-ink">Ücretsiz kullanım</h3>
          <p class="text-sm text-inkMuted leading-relaxed">
            Kendi destelerinle çalışırsın, <code>.apkg</code>/<code>.colpkg</code> dosyalarını içe ve dışa aktarırsın. FSRS-6,
            Kronometre ve seçili demo soruları da açık. Ücretli seçenekler devreye girince ücretsiz kullanımda ara ara reklam çıkacak;
            sıklığını sonra belirleyeceğiz.
          </p>
        </div>
        <div class="border-t-2 border-ink pt-5 space-y-2">
          <div class="text-xs font-bold text-teal">Seçenek 2 · ₺2.000</div>
          <h3 class="display text-lg text-ink">Tüm kartlar</h3>
          <p class="text-sm text-inkMuted leading-relaxed">
            BKA TUS arşivinin tamamını açar: 12 ders ve 106 alt destede <strong>9.575 kart</strong> (7.721 not).
            Seçili demo soruları da açık. Arşiv 160 günde bitirilebilir.
          </p>
        </div>
        <div class="border-t border-line pt-5 space-y-2">
          <div class="text-xs font-bold text-teal">Seçenek 3 · ₺50</div>
          <h3 class="display text-lg text-ink">Reklamları kaldırma</h3>
          <p class="text-sm text-inkMuted leading-relaxed">
            Ücretsiz kullanımda ara ara çıkacak reklamları kaldırır; kendi <code>.apkg</code>/<code>.colpkg</code> destelerinle ve
            seçili demo sorularıyla kesintisiz çalışırsın.
          </p>
        </div>
      </div>
    </div>

    <!-- Android & Desktop Web Preview Bridge + Honest Limitations -->
    <div class="grid lg:grid-cols-2 gap-x-10 gap-y-8">
      <div class="border-t border-line pt-5 space-y-3">
        <h2 class="display text-lg text-ink">Android, Mac veya Windows’ta nasıl kullanırım?</h2>
        <p class="text-sm text-inkMuted leading-relaxed">
          Tarayıcıdan. TusAnkiM’in <strong>iPhone</strong> uygulaması geliştiriliyor; Android uygulaması henüz yok, üzerinde çalışıyoruz.
          Bugün Android telefonda, iPad’de, bilgisayarda ve iPhone Safari’de kurulum yapmadan{' '}
          <a
            href={SITE.webAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-teal underline underline-offset-2 hover:text-tealDark"
          >
            web uygulamasını (tusankim.vercel.app/uygulama) ↗
          </a>{' '}
          açabilirsin. <code>.apkg</code>/<code>.colpkg</code> destelerin tarayıcının deposunda, kendi cihazında durur. Seçili demo sorularını da orada denersin.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href={SITE.webAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center min-h-[2.75rem] px-5 rounded-lg bg-teal text-white text-xs sm:text-sm font-semibold hover:bg-tealDark transition"
          >
            Web uygulamasını aç ↗
          </a>
          <a
            href="/#demo"
            class="inline-flex items-center min-h-[2.75rem] px-5 rounded-lg border border-line bg-surfaceSoft text-xs sm:text-sm font-semibold text-ink hover:border-tealGraphic hover:text-teal transition"
          >
            11 demo kartı dene →
          </a>
        </div>
      </div>

      <div class="border-t border-line pt-5 space-y-3">
        <h2 class="display text-lg text-ink">AnkiMobile ne zaman daha iyi seçim?</h2>
        <ul class="space-y-2 text-sm text-inkMuted list-disc pl-5 leading-relaxed">
          <li>
            <strong class="text-ink">Cihazların AnkiWeb ile kendiliğinden eşitlensin istiyorsan.</strong> TusAnkiM’de otomatik eşitleme henüz yok;
            desteni cihazlar arasında <code>.colpkg</code> dosyasıyla taşırsın.
          </li>
          <li>
            <strong class="text-ink">Kartlarında özel JavaScript kullanıyorsan.</strong> TusAnkiM güvenlik için kart içindeki
            üçüncü taraf JavaScript’i çalıştırmaz. Anki’nin her özelliğini karşıladığımızı da söylemiyoruz.
          </li>
          <li>
            <strong class="text-ink">Hazır BKA TUS paketindeki ilerlemeni dışarı almak istiyorsan.</strong> Kendi destelerini her zaman kayıpsız dışa aktarırsın.
            Hazır BKA TUS paketindeki ilerleme ise <code>.apkg</code>/<code>.colpkg</code> olarak dışa aktarılamaz.
          </li>
        </ul>
      </div>
    </div>

    <!-- Sources & Related Links -->
    <div class="border-t border-line pt-5 space-y-3">
      <h2 class="display text-base text-ink">Kaynaklar ve ilgili rehberler</h2>
      <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
        <a
          href="https://docs.ankiweb.net/exporting.html#collection-colpkg"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center min-h-[2.75rem] py-1 text-teal underline underline-offset-2 hover:text-tealDark"
        >
          Anki Manual: .apkg ve .colpkg paket biçimleri ↗
        </a>
        <a
          href="https://dl.acm.org/doi/10.1145/3534678.3539081"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center min-h-[2.75rem] py-1 text-teal underline underline-offset-2 hover:text-tealDark"
        >
          ACM KDD ’22: FSRS aralıklı tekrar optimizasyonu ↗
        </a>
      </div>
      <nav aria-label="İlgili sayfalar" class="pt-3 border-t border-lineLight flex flex-wrap gap-x-5 gap-y-0">
        <a href="/yardim/anki-ile-kullanma/" class="text-link">
          Anki ile birlikte kullanma kılavuzu →
        </a>
        <a href="/rehber/tus-icin-anki-uyumlu-sistem/" class="text-link">
          TUS için Anki uyumlu sistem rehberi →
        </a>
        <a href="/yardim/kronometre/" class="text-link">
          TUS kronometresi ve çalışma takvimi →
        </a>
        <a href="/referanslar/" class="text-link">
          Son 6 TUS referans kanıtları →
        </a>
      </nav>
    </div>
  </section>
</Layout>
