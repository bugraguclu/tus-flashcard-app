---
import Layout from '../layouts/Layout.astro';
import FaqList from '../components/FaqList.astro';
import faqs from '../data/faqs.json';
import { breadcrumbList } from '../lib/schema';
import { dateModified, pageSources } from '../lib/lastmod';

const origin = new URL(Astro.site!).origin;
const crumbs = breadcrumbList(origin, [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Sıkça Sorulan Sorular', path: '/sss' },
]);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  ...dateModified(pageSources('sss')),
  mainEntity: faqs.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a.replace(/\*\*([^*]+)\*\*/g, '$1').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1'),
    },
  })),
};
---
<Layout
  title={faqs.page.metaTitle}
  description={faqs.page.metaDescription}
  schema={[faqSchema, crumbs]}
>
  <section class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-6 pt-10 pb-16 sm:py-16">
    <nav aria-label="Sayfa konumu" class="flex flex-wrap items-center gap-y-1 text-sm text-inkMuted mb-3">
      <a href="/" class="inline-flex items-center min-h-[2.75rem] py-2 hover:text-teal transition">Ana Sayfa</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="text-ink font-semibold">Sıkça Sorulan Sorular</span>
    </nav>

    <div class="section-num">{faqs.page.kicker}</div>
    <h1 class="display text-page-title tracking-tightest text-ink mt-2">{faqs.page.title}</h1>
    <p class="text-inkMuted mt-3 leading-relaxed">{faqs.page.lead}</p>

    <p class="text-inkMuted mt-3 leading-relaxed">Kart gelmiyor ya da bir dosya açılmıyor mu? O zaman <a href="/yardim/sss/" class="text-link">sorun giderme rehberine bak</a>.</p>
    <search class="mt-8">
      <label for="faq-q" class="block text-sm font-medium mb-2">Sorularda ara</label>
      <div class="search-field flex items-center gap-2 px-4 rounded-lg border border-line bg-white">
        <input id="faq-q" type="search" autocomplete="off" placeholder={faqs.page.searchPlaceholder} class="flex-1 min-w-0 py-3 text-base bg-transparent outline-none" />
        <button id="faq-clear" type="button" hidden class="text-link">Temizle</button>
      </div>
      <p id="faq-count" role="status" class="text-sm text-inkMuted mt-2">Tüm {faqs.items.length} soru listeleniyor</p>
    </search>
    <p id="faq-empty" hidden class="text-inkMuted mt-8 leading-relaxed">Buna uyan bir soru yok. Aramanı kısalt ya da <a href="/destek/" class="text-link">destek sayfasından yazabilirsin</a>.</p>
    <div class="mt-10"><FaqList /></div>
  </section>
</Layout>

<script>
  const query = document.getElementById('faq-q') as HTMLInputElement;
  const clear = document.getElementById('faq-clear') as HTMLButtonElement;
  const count = document.getElementById('faq-count')!;
  const empty = document.getElementById('faq-empty')!;
  const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-faq-group]')];
  const normalize = (value: string) => value.toLocaleLowerCase('tr').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ı/g, 'i');
  const searchable = items.map((element) => ({ element, text: normalize(element.textContent ?? '') }));
  function filter() {
    const tokens = normalize(query.value.trim()).split(/\s+/).filter(Boolean);
    let found = 0;
    searchable.forEach(({ element, text }) => {
      element.hidden = !tokens.every((token) => text.includes(token));
      if (!element.hidden) found++;
    });
    groups.forEach((group) => { group.hidden = ![...group.querySelectorAll<HTMLDetailsElement>('details')].some((item) => !item.hidden); });
    clear.hidden = !query.value;
    empty.hidden = found > 0;
    count.textContent = tokens.length ? `${found} soru eşleşti` : `Tüm ${items.length} soru listeleniyor`;
  }
  function openLinkedQuestion(moveFocus = false) {
    const summary = document.getElementById(window.location.hash.slice(1));
    const detail = summary?.closest<HTMLDetailsElement>('details[data-faq-item]');
    if (!summary || !detail) return;
    if (detail.hidden) {
      query.value = '';
      filter();
    }
    detail.open = true;
    requestAnimationFrame(() => {
      if (moveFocus) summary.focus({ preventScroll: true });
      summary.scrollIntoView({ block: 'start', behavior: 'instant' });
    });
  }
  window.addEventListener('hashchange', () => openLinkedQuestion(true));
  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (location.hash && link?.href === location.href) openLinkedQuestion(true);
  });
  openLinkedQuestion();

  query.addEventListener('input', filter);
  clear.addEventListener('click', () => { query.value = ''; filter(); query.focus(); });
  query.addEventListener('keydown', (event) => { if (event.key === 'Escape') { query.value = ''; filter(); } });
</script>
