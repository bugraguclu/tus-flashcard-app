{
  "name": "tusankim-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "TusAnkiM — TUS aralıklı tekrar ve doğrulanmış kart referans web sitesi.",
  "scripts": {
    "dev": "astro dev",
    "data:build": "node scripts/build-data.mjs",
    "data:fsrs": "node --experimental-transform-types scripts/precompute-fsrs.mjs",
    "data": "npm run data:build && npm run data:fsrs",
    "build": "astro check && astro build",
    "verify": "node scripts/verify-site.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "astro": "^7.3.2",
    "autoprefixer": "^10.5.5",
    "marked": "^15.0.7",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.0",
    "jszip": "^3.10.2",
    "typescript": "^5.8.2"
  }
}
