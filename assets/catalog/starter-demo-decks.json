    {
      "id": "deck-biyokimya-2026-2-t041",
      "deckId": "biyokimya",
      "course": "Biyokimya",
      "topic": "2026/2 TUS · T041",
      "activeCloze": 1,
      "parts": [
        {
          "type": "text",
          "value": "Cilt biyopsisiyle tanı konabilen nefrit → "
        },
        {
          "type": "cloze",
          "index": 1,
          "answer": "Alport"
        },
        {
          "type": "text",
          "value": "\n\nBiyopsi → "
        },
        {
          "type": "cloze",
          "index": 12,
          "answer": "tip 4 kollajen alfa-5 zinciri"
        },
        {
          "type": "text",
          "value": " boyanması yok"
        }
      ],
      "extra": "Bulgu X'e bağlı (COL4A5) formda görülür; kadın taşıyıcılarda mozaik boyanma olur, otozomal formlarda cilt biyopsisi normaldir."
    },
    {
      "id": "deck-biyokimya-2025-2-t040",
      "deckId": "biyokimya",
      "course": "Biyokimya",
      "topic": "2025/2 TUS · T040",
      "activeCloze": 1,
      "parts": [
        {
          "type": "cloze",
          "index": 1,
          "answer": "AFP"
        },
        {
          "type": "text",
          "value": " > 400 ng/mL + BT'de "
        },
        {
          "type": "cloze",
          "index": 1,
          "answer": "hipervasküler"
        },
        {
          "type": "text",
          "value": " kitle → doğrudan HCC tanısı (biyopsiye gerek yok)\n\n"
        },
        {
          "type": "cloze",
          "index": 1,
          "answer": "Kalsitonin"
        },
        {
          "type": "text",
          "value": " > 200 pg/mL + tiroit "
        },
        {
          "type": "cloze",
          "index": 1,
          "answer": "nodülü"
        },
        {
          "type": "text",
          "value": " → doğrudan medüller tiroit kanseri tanısı"
        }
      ],
      "extra": "Güncel AASLD ve EASL ölçütlerinde sirotik hastada HCC tanısı AFP'den bağımsız olarak dinamik BT/MR'de arteriyel fazda kontrastlanma ve geç fazda yıkanma (washout) bulgusuyla konur."
    },
    {
      "id": "deck-biyokimya-2025-1-t032",
      "deckId": "biyokimya",
      "course": "Biyokimya",
      "topic": "2025/1 TUS · T032",
      "activeCloze": 1,
      "parts": [
        {
          "type": "text",
          "value": "Vernal konjonktivit → tip "
        },
        {
          "type": "cloze",
          "index": 1,
          "answer": "1"
        },
        {
          "type": "text",
          "value": " hipersensitivite reaksiyonu özellikleri taşır ama hastaların yaklaşık yarısında öncesinde duyarlanma "
        },
        {
          "type": "cloze",
          "index": 1,
          "answer": "gösterilemez"
        },
        {
          "type": "text",
          "value": " ("
        },
        {
          "type": "cloze",
          "index": 1,
          "answer": "yalnız IgE aracılı değildir"
        },
        {
          "type": "text",
          "value": ")"
        }
      ],
      "extra": "IgE aracılı (tip 1) reaksiyona Th2 lenfosit aracılı (tip 4) inflamasyon eşlik eder; hastaların yaklaşık yarısında deri prik testi ve spesifik IgE negatiftir."
    },
    {
