    {
      "id": "deck-fhe-2026-1-t019",
      "deckId": "fhe",
      "course": "FHE",
      "topic": "2026/1 TUS · T019",
      "activeCloze": 1,
      "parts": [
        {
          "type": "text",
          "value": "Karaciğerde İto hücrelerini (hepatik stellat hücreler) uyararak aktive eden sitokinler:\n\n"
        },
        {
          "type": "cloze",
          "index": 1,
          "answer": "TNF-alfa"
        },
        {
          "type": "text",
          "value": "\n\nIL-"
        },
        {
          "type": "cloze",
          "index": 1,
          "answer": "17"
        },
        {
          "type": "text",
          "value": "\n\nTGF-beta\n\nPDGF\n\nReaktif oksijen ürünleri"
        }
      ],
      "extra": "Uyarılmış İto hücreleri miyofibroblastlara dönüşerek kollajen sentezler ve hepatik fibrozise yol açar."
    },
    {
      "id": "deck-biyokimya-2026-2-t033",
