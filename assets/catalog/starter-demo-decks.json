      "topic": "2026/1 TUS · T028",
      "activeCloze": 1,
      "parts": [
        {
          "type": "text",
          "value": "Poiseuille denklemine göre vasküler direnç (R) = "
        },
        {
          "type": "cloze",
          "index": 1,
          "answer": "(8 · viskozite (η) · damar uzunluğu (L)) / (π · r4)"
