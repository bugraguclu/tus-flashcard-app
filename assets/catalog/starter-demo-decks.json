    {
      "id": "deck-mikrobiyoloji-2025-2-t056",
      "deckId": "mikrobiyoloji",
      "course": "Mikrobiyoloji",
      "topic": "2025/2 TUS · T056",
      "activeCloze": 1,
      "parts": [
        {
          "type": "text",
          "value": "Antiviraller\n\nKondilom tedavisinde "
        },
        {
          "type": "cloze",
          "index": 1,
          "answer": "TLR7"
        },
        {
          "type": "text",
          "value": " agonisti immünomodülatör: "
        },
        {
          "type": "cloze",
          "index": 2,
          "answer": "imikimod"
        },
        {
          "type": "text",
          "value": "\n\nCOVID-19 tedavisinde RNA bağımlı RNA polimeraz inhibitörü: "
        },
        {
          "type": "cloze",
          "index": 3,
          "answer": "remdesivir"
        },
        {
          "type": "text",
          "value": "\n\nİnfluenza ve COVID-19 tedavisinde RNA bağımlı RNA polimeraz inhibitörü: "
        },
        {
          "type": "cloze",
          "index": 3,
          "answer": "favipiravir"
        },
        {
          "type": "text",
          "value": "\n\nEnterovirüs ve rinovirüs solunum yolu enfeksiyonlarında viral kapside bağlanan ajan: "
        },
        {
          "type": "cloze",
          "index": 2,
          "answer": "plekonaril"
        }
      ],
      "extra": "Plekonaril onay almamış deneysel bir ilaçtır. Favipiravir FDA ve EMA onayı almamıştır; COVID-19'da randomize çalışmalarda hastaneye yatışı ve ölümü azaltmamıştır."
    },
